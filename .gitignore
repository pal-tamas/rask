# Claude Code
.claude/settings.local.json

# Linked git worktrees created by tooling live INSIDE the repo, so without this an IDE opened on the repo
# root indexes a complete second copy of the framework per worktree. Every component type then exists
# N times over, the generator injects its chain entries into each copy, and a bare `Div` stops resolving
# to an entry — CS0119 on essentially every file, with nothing wrong in the code itself.
.claude/worktrees/
.claude/scheduled_tasks.lock

# Other
*.swp
*.bak
*.cache
# Rask.Cache is a source package, not a build artifact — but its directory name matches the *.cache glob
# above on case-insensitive filesystems, which would ignore the whole package. Re-include it (its own
# bin/obj build output is still ignored by the [Bb]in/ and [Oo]bj/ rules, and *.cache files within still match).
!src/Rask.Cache/
*.dbmdl
*.dbproj.schemaview
*.publishsettings
publish/
PublishProfiles/
*.[Pp]ublish.xml

# Derived favicon — copied from assets/favicon.svg by example csproj targets.
Rask.Example.Server/wwwroot/favicon.svg
Rask.Example.Wasm.Host/wwwroot/

# Generated MSBuild task assembly — built by Rask.Wasm.Tasks and copied here on every
# build (see CopyTaskAssemblyToRaskWasmBuild). Its MVID/timestamp/PDB-hash differ per
# build environment, so committing it made it perpetually dirty in git.
src/Rask.Wasm/build/Rask.Wasm.Tasks.dll
src/Rask.Spa.Hosting/build/Rask.Spa.Tasks.dll
src/Rask.Tailwind/build/Rask.Tailwind.Tasks.dll
src/Rask.Core/build/Rask.TypeScript.Tasks.dll

# Ad-hoc SQLite load-harness runs (the committed reference lives in Baselines/).
benchmarks/Rask.Benchmarks.Sqlite/Results/

# The WASM browser bundles are build output: esbuild writes them from Browser/main.ts and
# Resources/*.ts. They lived in git while the build assembled them by pasting files together at
# `// @@RASK_*@@` markers, because the spliced result was the only readable form of the whole
# runtime. The TypeScript is that form now.
src/Rask.Wasm/Browser/main.js
src/Rask.Wasm/Browser/rask.wasm.js
src/Rask.Wasm/Browser/rask-sw.js
