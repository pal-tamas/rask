<Project>

  <!--
    In-repo auto-import for Rask build integration.
    Imports unconditionally; each targets file gates its own work
    (Rask.Spa.Hosting checks for a client folder and @(ProjectReference); Rask.Wasm gates
    on $(RaskWasm)). Downstream NuGet consumers get the
    same auto-import via build/ in each .nupkg.
  -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Wasm\build\Rask.Wasm.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Wasm\build\Rask.Wasm.targets') "/>

  <!--
    Rask.Spa.Hosting gates itself on resolving exactly one front-end client, and the convention arm of
    that resolution requires a package.json next to the sibling project. That guard is load-bearing in
    this repo: Rask.Cqrs.Server has a sibling Rask.Cqrs.Client, and without it every build of that
    project would start looking for a bundler.
  -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Spa.Hosting\build\Rask.Spa.Hosting.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Spa.Hosting\build\Rask.Spa.Hosting.targets') "/>

  <!--
    Rask.Meta.Hosting does nothing without RaskMetaFramework, so this import costs every other project
    in the repo one property check. In-repo the samples reference the project rather than the package,
    and a ProjectReference does not carry a package's build/ folder — so without this the six meta
    samples would compile their C# and never install, build or publish a front end at all.
  -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Meta.Hosting\build\Rask.Meta.Hosting.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Meta.Hosting\build\Rask.Meta.Hosting.targets') "/>

  <!--
    Rask.External gates itself on the project having a package.json — an island cannot be bundled
    without one, and that single file probe is what keeps this import free for the ~100 projects in
    this repo that have no front end. Without it, every project would walk its own source tree looking
    for a .tsx on every evaluation, design-time builds included.
  -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.External\build\Rask.External.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.External\build\Rask.External.targets') "/>

  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Core\build\Rask.Core.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Core\build\Rask.Core.targets') "/>

  <!--
    Tailwind, on the same terms as Rask.Core: unconditional here, gating itself on whether the project
    has a Styles/app.css to compile. This is the in-repo half of what src\RaskTailwindBuildPack.targets
    ships to consumers inside Rask.Server and Rask.Wasm — the samples get it here so that no sample has
    to hand-wire what a scaffolded app never wires at all.
  -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Tailwind\build\Rask.Tailwind.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Tailwind\build\Rask.Tailwind.targets') "/>

  <!--
    The kit's build hook, which writes its compiled stylesheet into the app's wwwroot so a browser can
    cache it instead of re-reading 36.8 KB inlined in every document. A package consumer gets this
    automatically; in-repo a ProjectReference does not carry it, so it is imported here like the rest.
  -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Ui\build\Rask.Ui.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Ui\build\Rask.Ui.targets') "/>

  <!--
    The devtools gate: RaskDevTools (Debug by default), the Rask.DevTools.IsEnabled feature switch, and the
    Release-publish exclusion. Imported unconditionally, like Rask.Core's: a package consumer gets the same
    file from the package's build/ and buildTransitive/ folders, and in-repo a ProjectReference carries
    neither. For a project that does not reference Rask.DevTools the switch finds no bootstrap and the
    exclusion names a package it does not have, so both cost nothing.
  -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.DevTools\buildTransitive\Rask.DevTools.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.DevTools\buildTransitive\Rask.DevTools.targets') "/>

  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Server\build\Rask.Server.Browser.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Server\build\Rask.Server.Browser.targets') "/>

  <!--
    Auto-enable the repo's git hooks (pre-commit: dotnet format + unit; pre-push: browser E2E) so a fresh
    clone picks them up on first build — no manual `git config core.hooksPath .githooks`. The hook contents
    live in .githooks/; this only points git at them. Skipped in CI (GitHub sets CI=true) and during IDE
    design-time builds, and only runs inside a git working copy (.git present — a directory in the main
    clone, a file in a worktree), so a restored/consumed package never triggers it. Hooks stay advisory:
    bypass any with the git no-verify flag, RASK_SKIP_UNIT=1, or RASK_SKIP_E2E=1. See .github/CONTRIBUTING.md.

    READ before writing (#964). `git config` with no per-worktree flag writes the COMMON config, so a build
    in a linked worktree writes the main checkout's .git/config — and the write takes .git/config.lock. Several
    worktrees build concurrently on this machine, so an ordinary build could fail to take that lock and
    report `could not lock config file … File exists` as MSB3073, a warnings-as-errors build failure whose
    real cause was another worktree building at the same time. Re-asserting a value that is already set is
    what needed the lock: the value is written once and never changes, so every build after the first now
    does a lock-free read and stops. A genuine failure to configure the hooks still warns, which matters —
    an unconfigured core.hooksPath runs NO hooks and says nothing, and that is how two attribution trailers
    once reached main.
  -->
  <Target Name="RaskConfigureGitHooks" BeforeTargets="Build"
          Condition=" '$(CI)' != 'true' And '$(DesignTimeBuild)' != 'true'
                      And Exists('$(MSBuildThisFileDirectory).githooks')
                      And Exists('$(MSBuildThisFileDirectory).git') ">
    <!--
      IgnoreExitCode because a `get` of an unset key exits 1, which is the fresh-clone case this target
      exists to serve, not an error.
    -->
    <Exec Command="git config --get core.hooksPath"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ContinueOnError="true"
          IgnoreExitCode="true"
          EchoOff="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_RaskGitHooksPath" />
    </Exec>

    <Exec Command="git config core.hooksPath .githooks"
          Condition=" '$(_RaskGitHooksPath)' != '.githooks' "
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ContinueOnError="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low" />
  </Target>

  <!--
    The public-API gate (docs/api-style.md).

    Microsoft.CodeAnalysis.PublicApiAnalyzers tracks every public member in a checked-in
    PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt pair. RS0016 (a public member missing from the
    files) and RS0017 (a file entry with no member behind it) are compiler warnings, so the repo's
    TreatWarningsAsErrors turns them into build failures — which is the point: a public-surface change
    cannot land without showing up as a reviewable diff in the same PR.

    Placed here rather than in Directory.Build.props because it keys off $(IsPackable), and a project
    sets that in its own body — after the .props are imported, before the .targets are.
  -->
  <PropertyGroup>
    <!--
      src/ only. A sample and a test project are applications, not surfaces anyone consumes, and they
      leave IsPackable at its default — so without this they are tracked too, and `rask new`'s own
      output starts failing a gate about the framework's API.
    -->
    <_RaskInSrc>false</_RaskInSrc>
    <_RaskInSrc Condition=" $(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src')) ">true</_RaskInSrc>

    <RaskPublicApiTracked Condition=" '$(RaskPublicApiTracked)' == '' AND '$(_RaskInSrc)' == 'true' AND '$(IsPackable)' != 'false' ">true</RaskPublicApiTracked>
    <!--
      Rask.Core is IsPackable=false, but only because it is bundled into every host package rather
      than shipped on its own. Its public surface — the engine AND the HTML/SVG element family — is the
      one every component author writes against, so it is tracked like any other.
    -->
    <RaskPublicApiTracked Condition=" '$(_RaskInSrc)' == 'true' AND '$(MSBuildProjectName)' == 'Rask.Core' ">true</RaskPublicApiTracked>
    <!--
      Build-time tooling: Roslyn generators, their code fixes, and MSBuild tasks. Their public types
      exist because the compiler and MSBuild have to construct them by name — nobody writes code
      against them, so a diff in that surface tells a reviewer nothing.
    -->
    <RaskPublicApiTracked Condition=" $(MSBuildProjectName.EndsWith('.Generators')) OR $(MSBuildProjectName.EndsWith('.Tasks')) OR '$(MSBuildProjectName)' == 'Rask.Generators.CodeFixes' ">false</RaskPublicApiTracked>
    <RaskPublicApiTracked Condition=" '$(RaskPublicApiTracked)' == '' ">false</RaskPublicApiTracked>
  </PropertyGroup>

  <ItemGroup Condition=" '$(RaskPublicApiTracked)' == 'true' ">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
    <!--
      Per target framework, uniformly — including the projects that have only one today.
      Rask.Core, Rask.Wasm, Rask.SQLite.Browser and Rask build for net10.0 and
      net10.0-browser, and their surfaces genuinely differ, so one flat file per project would
      report every browser-only member as missing on the desktop build and vice versa. Keeping the
      layout the same everywhere means a project that gains a second framework later gets a new
      empty baseline to fill in, rather than a gate that quietly starts contradicting itself.
    -->
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI\$(TargetFramework)\PublicAPI.Shipped.txt" Condition=" Exists('$(MSBuildProjectDirectory)\PublicAPI\$(TargetFramework)\PublicAPI.Shipped.txt') "/>
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt" Condition=" Exists('$(MSBuildProjectDirectory)\PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt') "/>
  </ItemGroup>

  <!--
    The Exists() conditions above are what let a project be added before its baseline is written. They
    are also how this gate would come to pass by not running: delete the two files, or add a framework
    and forget them, and the analyzer has nothing to compare against, reports nothing, and the build is
    green. Say so out loud instead.
  -->
  <Target Name="RaskVerifyPublicApiBaseline" BeforeTargets="CoreCompile"
          Condition=" '$(RaskPublicApiTracked)' == 'true' AND '$(TargetFramework)' != '' ">
    <Error Condition=" !Exists('$(MSBuildProjectDirectory)\PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt') "
           Text="$(MSBuildProjectName) is covered by the public-API gate but has no baseline for $(TargetFramework). Create PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt (first line '#nullable enable') and PublicAPI.Shipped.txt (empty), then build: every public member is reported as RS0016 with the exact line to record. See docs/api-style.md. To exempt this project instead, set &lt;RaskPublicApiTracked&gt;false&lt;/RaskPublicApiTracked&gt; in its .csproj and say why." />
  </Target>

</Project>
