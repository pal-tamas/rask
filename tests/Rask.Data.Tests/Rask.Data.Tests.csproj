<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared.DbCollection\DbCollectionGuard.cs" Link="DbCollectionGuard.cs"/>
    <Compile Include="..\..\src\Rask.Data\Browser\BrowserData.cs" Link="Browser\BrowserData.cs"/>
    <Compile Include="..\..\src\Rask.Data\Browser\QueryDataChanges.cs" Link="Browser\QueryDataChanges.cs"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
    <!-- Security: pulls the patched SQLitePCLRaw 3.x bundle over the 2.1.11 one
         Microsoft.Data.Sqlite / EF Core pin (CVE-2025-6965). A direct reference is the only
         lever under CPM — transitive pinning does not move it. See Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Cqrs"/>
    <Using Include="Rask.Data"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Data\Rask.Data.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Cqrs\Rask.Cqrs.csproj"/>
    <!-- Rask.Data's browser wiring (src/Rask.Data/Browser) compiles only into its browser build, and this project
         builds for the server one, so BrowserDataTests links those files in and supplies what they reference. -->
    <ProjectReference Include="..\..\src\Rask.Query\Rask.Query.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Batteries.Generators\Rask.Batteries.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
