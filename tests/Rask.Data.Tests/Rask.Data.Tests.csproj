<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- DraftFiling (ValueCollectionNullabilityTests) is the shape RASK111 warns about, kept to pin its NULL column. -->
    <NoWarn>$(NoWarn);RASK111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared.DbCollection\SqliteFileGuard.cs" Link="SqliteFileGuard.cs"/>
    <Compile Include="..\Shared.Sqlite\InMemorySqlite.cs" Link="InMemorySqlite.cs"/>
    <Compile Include="..\..\src\Rask.Data\Browser\BrowserData.cs" Link="Browser\BrowserData.cs"/>
    <Compile Include="..\..\src\Rask.Data\Browser\BrowserDataScope.cs" Link="Browser\BrowserDataScope.cs"/>
    <Compile Include="..\..\src\Rask.Data\Browser\QueryDataChanges.cs" Link="Browser\QueryDataChanges.cs"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
    <!-- Offline only: the SQL a lock read is sent as on SQL Server (ForUpdateSqlServerReadTests). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"/>
    <!-- Security: pulls the patched SQLitePCLRaw 3.x bundle over the 2.1.11 one
         Microsoft.Data.Sqlite / EF Core pin (CVE-2025-6965). A direct reference is the only
         lever under CPM — transitive pinning does not move it. See Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Cqrs"/>
    <Using Include="Rask.Data"/>
    <Using Include="Rask.Values"/>
    <Using Include="Rask.Values.Range" Alias="Range"/>
    <Using Include="Rask.Tests.Shared"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Data\Rask.Data.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Cqrs\Rask.Cqrs.csproj"/>
    <!-- The FluentValidation rules an aggregate states (FluentDomainValidationTests) reach the save through it. -->
    <ProjectReference Include="..\..\src\Rask.Validation.FluentValidation\Rask.Validation.FluentValidation.csproj"/>
    <!-- Rask.Data's browser wiring (src/Rask.Data/Browser) compiles only into its browser build, and this project
         builds for the server one, so BrowserDataTests links those files in and supplies what they reference. -->
    <ProjectReference Include="..\..\src\Rask.Query\Rask.Query.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Batteries.Generators\Rask.Batteries.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
    <!-- The value objects' Create/TryCreate/Check: the Rask package's generator writes them. -->
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
