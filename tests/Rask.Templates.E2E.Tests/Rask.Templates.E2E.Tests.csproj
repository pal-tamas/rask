<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The TEMPLATE gate: every template `rask new` offers is scaffolded for real and built for real.

    It exists because a template that is only unit-tested can scaffold an app that does not compile, with
    every unit test green.

    Separate from Rask.Cli.E2E.Tests, which keeps the CLI-BEHAVIOUR gates (watch, deploy, devhost, the
    tutorial chapters) and the finer-grained artifact assertions. The split is by subject: that project
    asks "does the CLI do the right thing", this one asks "does what it wrote compile and run".

    ENV-GUARDED: RASK_TEMPLATE_E2E=1 packs this commit's packages and builds every template — minutes.
  -->

  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="Microsoft.Playwright"/>
    <PackageReference Include="Spectre.Console.Testing"/>
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Cli"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Cli\Rask.Cli.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Source-linked for the same reason Rask.Cli.E2E.Tests links them: the pack-to-a-local-feed
         plumbing is shared infrastructure owned by Rask.Cli.Tests, not tests of its own. -->
    <Compile Include="..\Rask.Cli.Tests\CliBuildE2E.cs" Link="CliBuildE2E.cs"/>
    <Compile Include="..\Rask.Cli.Tests\RepoPins.cs" Link="RepoPins.cs"/>
    <Compile Include="..\Rask.Cli.Tests\TestDoubles.cs" Link="TestDoubles.cs"/>
    <Compile Include="..\Shared.TestFiles\RepoFiles.cs" Link="RepoFiles.cs"/>
    <!-- The loopback-port reservation and the browser fixture, source-linked rather than
         copied: both carry hard-won detail (an OS-assigned port can still be taken between
         reserving and binding it) that a second copy would lose the first time it drifted. -->
    <Compile Include="..\Rask.Site.E2E.Tests\Infrastructure\LoopbackPort.cs" Link="LoopbackPort.cs"/>
    <Compile Include="..\Rask.Site.E2E.Tests\Infrastructure\PlaywrightFixture.cs" Link="PlaywrightFixture.cs"/>
    <Using Include="Rask.Site.E2E.Tests.Infrastructure"/>
    <Using Include="Rask.TestFiles"/>
    <!-- The linked files declare namespace Rask.Cli.Tests; the tests here are Rask.Templates.E2E.Tests. -->
    <Using Include="Rask.Cli.Tests"/>
  </ItemGroup>

</Project>
