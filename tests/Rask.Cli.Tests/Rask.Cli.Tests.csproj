<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <!-- Spectre's own test doubles: `TestConsoleInput` scripts the key presses an interactive
         SelectionPrompt reads, which a StringReader of whole lines cannot express. -->
    <PackageReference Include="Spectre.Console.Testing"/>
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Cli"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Cli\Rask.Cli.csproj"/>
    <!-- Test-only, and deliberately not a reference Rask.Cli itself takes: the CLI owns `docker stop -t`
         and the framework owns HostOptions.ShutdownTimeout, so the two numbers live in assemblies that
         cannot see each other. SamplesShutdownBudgetTests resolves the options AddRask actually produces
         and checks them against the deploy ladder, which is what keeps the pair from drifting. -->
    <ProjectReference Include="..\..\src\Rask.Server\Rask.Server.csproj"/>
    <!-- AddRask's optional parameters are typed in Rask.Core, so calling it needs the reference even
         though this test never names one of those types. -->
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared.TestFiles\RepoFiles.cs" Link="RepoFiles.cs"/>
    <Using Include="Rask.TestFiles"/>
  </ItemGroup>

  <!-- Files these tests read from disk at runtime that no reference brings in. Never evaluated: it is
       read by scripts/lib/affected_projects.py, so a change to one of these runs these tests. A test
       that starts reading a new file outside this project must add it here. -->
  <ItemGroup Condition="false">
    <RaskTestReads Include="..\..\src\Rask.Ui\Styles\**" />
    <RaskTestReads Include="..\*.E2E.Tests\**" />
    <RaskTestReads Include="..\..\**\*.csproj" />
    <RaskTestReads Include="..\..\**\*.targets" />
    <RaskTestReads Include="..\..\**\*.props" />
    <RaskTestReads Include="..\..\rask.sh" />
    <RaskTestReads Include="..\..\rask.ps1" />
    <RaskTestReads Include="..\..\docs\installation.md" />
    <RaskTestReads Include="..\..\src\Rask.Tailwind\**" />
    <RaskTestReads Include="..\..\src\Rask.Tailwind.Tasks\**" />
  </ItemGroup>

</Project>
