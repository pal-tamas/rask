<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumer-shaped: this project is NOT in Rask.Core's InternalsVisibleTo allowlist, so it can only
       use Rask.Testing's PUBLIC API (and Core's public API) — the same surface a real consumer has. That
       is exactly what proves the shipped testing API is sufficient to test a component. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>


  <ItemGroup>
    <!-- A consumer registering a service for the component under test has DI available (their app pulls it
         in); this project needs it explicitly to exercise the Render(component, services) overload.
         Microsoft.JSInterop is NOT listed: it flows transitively from Rask.Testing, which is exactly how a
         consumer gets it — so TestJSRuntime is being used here over the same surface they'd have. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Core"/>
    <Using Include="Rask.Testing"/>
    <Using Include="Rask.Core.Components.Generated" Static="true"/>
    <Using Include="Rask.Html.Components.Generated" Static="true"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Testing\Rask.Testing.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <!-- Needed now that the tag family is a referenced LIBRARY rather than part of Rask.Core: framework
         entries used to arrive by inheritance from RaskMarkup, which needs no generator in the consumer,
         while a library's are injected into this project's own markup hosts - which does. -->
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
