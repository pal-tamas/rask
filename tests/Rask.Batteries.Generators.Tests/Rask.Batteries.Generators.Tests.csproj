<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Generators.TestSupport"/>
  </ItemGroup>

  <!-- Shared with Rask.Generators.Tests so every generator is driven identically. -->
  <ItemGroup>
    <Compile Include="..\Shared.GeneratorTests\GeneratorHarness.cs" Link="GeneratorHarness.cs"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      Drive the generators manually, so reference the analyzer (and the runtimes) as normal assemblies
      rather than as analyzers. One suite covers all three battery generators now that they share an
      assembly; the harness resolves a test compilation's references by assembly name, so every runtime
      a generated snippet compiles against has to be referenced here.
    -->
    <ProjectReference Include="..\..\src\Rask.Batteries.Generators\Rask.Batteries.Generators.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Cqrs\Rask.Cqrs.csproj"/>
    <!-- For its [assembly: RaskCqrsTransport]: the codec generator emits nothing for a compilation that
         references no transport, so a codec test without it passes against an empty run. -->
    <ProjectReference Include="..\..\src\Rask.Cqrs.Client\Rask.Cqrs.Client.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Data\Rask.Data.csproj"/>
    <!-- The component and routes generators, as a plain assembly, with the Rask.Core they generate against:
         a component prop typed as a generated model can only be checked by compiling the model generator's
         output together with theirs, and the model generator lives here. -->
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Jobs\Rask.Jobs.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Outbox\Rask.Outbox.csproj"/>
  </ItemGroup>

</Project>
