<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!--
      This project has no scoped component assets. Its .ts files are the Node fixtures below, which
      drive framework modules against a stub DOM in a subprocess — so the scoped-TS glob must not
      claim them and RASK017 must not ask them to name a component they are not paired with.

      A property rather than an item Remove: the csproj body evaluates before Directory.Build.targets
      imports Rask.Core.targets, so there is no item to remove yet.
    -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Testing"/>
    <Using Include="Rask.TestSupport"/>
    <!-- Tag factories and the routing/form/fragment irregulars are all emitted by the
         source generator into Rask.Core.Components.Components and Rask.Core.Routing.Components.
         Tests use them unqualified via these two static imports. -->
    <Using Include="Rask.Core.Components"/>
    <Using Include="Rask.Html.Components"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Server\Rask.Server.csproj"/>
    <ProjectReference Include="..\Rask.TestSupport\Rask.TestSupport.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    The Node fixtures. Each Live/*Fixture.ts drives a real framework module — the morph, the diff
    codec — against a stub DOM in a node subprocess, and its C# test asserts the JSON it prints.

    They IMPORT what they test, so esbuild bundles each one into a self-contained .mjs beside the
    test assembly. Before this they read the module off disk and evaluated it with
    `new Function(src + "return { morph, … }")`, because the shared modules were bare declarations
    meant to be pasted into a host's scope. Nothing checked that the names in that string still
    existed, and it stops working the moment the module has real `export`s.

    Bundled during the BUILD rather than from the test, so a fixture that no longer compiles fails
    the build with the compiler's message instead of failing a test with node's.
  -->
  <ItemGroup>
    <_RaskNodeFixture Include="Live\*Fixture.ts;Browser\*Fixture.ts"/>
  </ItemGroup>

  <!-- DependsOnTargets: see PackagingContractTests.Every_generated_task_call_site_waits_for_the_reference_that_produces_it.
       Inert at AfterTargets="Build", stated so the invariant holds without an exemption (#878). -->
  <Target Name="_RaskBundleNodeFixtures" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences"
          Inputs="@(_RaskNodeFixture);@(_RaskNodeFixtureDependency)"
          Outputs="@(_RaskNodeFixture->'$(OutDir)node-fixtures/%(Filename).mjs')">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <!--
      Never minified, whatever the configuration. A fixture's failure output is read by a person
      diagnosing a morph bug, and node's stack trace has to name something.
    -->
    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;%(_RaskNodeFixture.FullPath)&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --outfile=&quot;$(OutDir)node-fixtures/%(_RaskNodeFixture.Filename).mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!--
    The framework modules the fixtures import. Listed so an edit to the morph re-bundles them —
    a target's Inputs does not expand wildcards.
  -->
  <ItemGroup>
    <_RaskNodeFixtureDependency Include="..\..\src\Rask.Core\Resources\**\*.ts"
                                Exclude="..\..\src\Rask.Core\Resources\**\*.d.ts"/>
  </ItemGroup>

</Project>
