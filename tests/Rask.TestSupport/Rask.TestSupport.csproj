<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Shared test-helper library, not a test project: references xunit.v3.assert (for Assert in
         Markup) but ships no test runner, so dotnet test must not try to execute it. -->
    <IsTestProject>false</IsTestProject>
    <!-- ScriptFixtures/fixture.ts is the API the test projects' fixtures import, not a component's scoped TypeScript. -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Rask.Testing\AttributeScan.cs" Link="AttributeScan.cs"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.assert"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <!-- ScriptFixture's engine: the *Fixture.ts harnesses run in-process on it, so no test needs Node. -->
    <PackageReference Include="Jint"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The web globals every fixture runs after, read by WebGlobals. -->
    <EmbeddedResource Include="ScriptFixtures\web-globals.js" LogicalName="Rask.TestSupport.ScriptFixtures.web-globals.js"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <!-- The shipped testing package is the base these helpers layer on: MarkupAssert wraps its public
         Markup scanner rather than keeping a second copy. This also puts Rask.Testing on the compile path
         of every project that uses TestSupport, so the public API is what our own suites build against. -->
    <ProjectReference Include="..\..\src\Rask.Testing\Rask.Testing.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
