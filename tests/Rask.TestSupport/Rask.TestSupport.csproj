<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Shared test-helper library, not a test project: references xunit (for Assert in
         Markup) but ships no test runner, so dotnet test must not try to execute it. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <!-- The shipped testing package is the base these helpers layer on: MarkupAssert wraps its public
         Markup scanner rather than keeping a second copy. This also puts Rask.Testing on the compile path
         of every project that uses TestSupport, so the public API is what our own suites build against. -->
    <ProjectReference Include="..\..\src\Rask.Testing\Rask.Testing.csproj"/>
  </ItemGroup>

</Project>
