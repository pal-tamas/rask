<Project>

  <!--
    Bundles a test project's Node fixtures. Each @(_RaskNodeFixture) drives a real framework module against a stub
    DOM in a node subprocess, and its C# test asserts the JSON it prints (see NodeFixture.Run).

    A project lists its fixtures as _RaskNodeFixture and, when they import framework sources, those sources as
    _RaskNodeFixtureDependency — so an edit to the module under test re-bundles, which a target's Inputs cannot
    work out from a wildcard on its own — and then imports this file. One definition, because the copies it
    replaces in Rask.Core.Tests, Rask.External.Tests and Rask.Wasm.Tests differed only in those two lists.

    The fixtures IMPORT what they test, so esbuild bundles each one into a self-contained .mjs in node-fixtures/
    beside the test assembly. Bundled during the BUILD rather than from the test, so a fixture that no longer
    compiles fails the build with the compiler's message instead of failing a test with node's.
  -->

  <!-- DependsOnTargets: see PackagingContractTests.Every_generated_task_call_site_waits_for_the_reference_that_produces_it.
       Inert at AfterTargets="Build", stated so the invariant holds without an exemption (#878). -->
  <Target Name="_RaskBundleNodeFixtures" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences"
          Inputs="@(_RaskNodeFixture);@(_RaskNodeFixtureDependency)"
          Outputs="@(_RaskNodeFixture->'$(OutDir)node-fixtures/%(Filename).mjs')">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <!--
      Never minified, whatever the configuration. A fixture's failure output is read by a person diagnosing the
      module it drives, and node's stack trace has to name something.
    -->
    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;%(_RaskNodeFixture.FullPath)&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --outfile=&quot;$(OutDir)node-fixtures/%(_RaskNodeFixture.Filename).mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

</Project>
