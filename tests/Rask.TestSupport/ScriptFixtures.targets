<Project>

  <!--
    Bundles a test project's script fixtures. Each @(_RaskScriptFixture) drives a real framework module against a stub
    DOM, run in-process on Jint by ScriptFixture.Run, and its C# test asserts the value it reports.

    A project lists its fixtures as _RaskScriptFixture and, when they import framework sources, those sources as
    _RaskScriptFixtureDependency — so an edit to the module under test re-bundles, which a target's Inputs cannot
    work out from a wildcard on its own — and then imports this file.

    The fixtures IMPORT what they test, so esbuild bundles each one into a self-contained ES module in
    script-fixtures/ beside the test assembly. platform=neutral: the bundle is for a bare ECMAScript engine, so an
    import of a Node built-in fails here, at build time, rather than as a module Jint cannot find. Bundled during the
    BUILD rather than from the test, so a fixture that no longer compiles fails the build with the compiler's message.
  -->

  <ItemGroup>
    <!-- The API every fixture imports (args, report, readText, addModule); an edit to it re-bundles them all. -->
    <_RaskScriptFixtureDependency Include="$(MSBuildThisFileDirectory)ScriptFixtures\fixture.ts"/>
  </ItemGroup>

  <!-- DependsOnTargets: see PackagingContractTests.Every_generated_task_call_site_waits_for_the_reference_that_produces_it.
       Inert at AfterTargets="Build", stated so the invariant holds without an exemption (#878). -->
  <Target Name="_RaskBundleScriptFixtures" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences"
          Inputs="@(_RaskScriptFixture);@(_RaskScriptFixtureDependency)"
          Outputs="@(_RaskScriptFixture->'$(OutDir)script-fixtures/%(Filename).mjs')">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)script-fixtures"/>

    <!--
      Never minified, whatever the configuration. A fixture's failure output is read by a person diagnosing the
      module it drives, and the stack trace has to name something.
    -->
    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;%(_RaskScriptFixture.FullPath)&quot; --bundle --format=esm --platform=neutral --target=es2022 --log-level=warning --outfile=&quot;$(OutDir)script-fixtures/%(_RaskScriptFixture.Filename).mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

</Project>
