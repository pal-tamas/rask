<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <!-- IBuildEngine, to drive the task the way MSBuild does. Unlike the task project, this one
         needs the assemblies at RUNTIME: there is no MSBuild host here to provide them, so
         ExcludeAssets="runtime" would leave the tests loading a Microsoft.Build.Framework that is
         not on disk. Matches Rask.Wasm.Tasks.Tests. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.TypeScript.Tasks\Rask.TypeScript.Tasks.csproj"/>
    <!--
      For ExternalSourceScan, which decides whether a `.ts` beside a `.cs` is a scoped asset or an
      island module (#938). The sweep below mirrors the build's file list, and the build's file list
      is now partitioned by that scan — restating the rule here would be a second place for it to be
      wrong, and the failure it produces is a red gate on code that is perfectly correct.
    -->
    <ProjectReference Include="..\..\src\Rask.External.Tasks\Rask.External.Tasks.csproj"/>
  </ItemGroup>

  <!-- The repo-walking helper, source-linked rather than referenced: it prunes build output, vendored
       dependencies and the scaffolder's template payload, so this sweep never type-checks a template's
       TypeScript against dependencies only a scaffolded app installs. -->
  <ItemGroup>
    <Compile Include="..\Shared.TestFiles\RepoFiles.cs" Link="RepoFiles.cs"/>
    <Using Include="Rask.TestFiles"/>
  </ItemGroup>

</Project>
