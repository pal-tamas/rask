<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This project has no scoped component assets. Its .ts files are the script fixtures below, which
      drive the built browser bundle on an in-process JS engine — so the scoped-TS glob must not claim them and
      RASK017 must not ask them to name a component they are not paired with.

      A property rather than an item Remove: the csproj body evaluates before Directory.Build.targets
      imports Rask.Core.targets, so there is no item to remove yet.
    -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RASK014</NoWarn>

    <!--
      WasmHotReloadBridge early-returns unless MetadataUpdater.IsSupported, which the SDK turns OFF in
      Release — and the unit gate runs Release. Without this the bridge tests would subscribe to
      nothing and assert against a counter nobody increments: green, and proving nothing.

      The switch needs BOTH halves; DOTNET_MODIFIABLE_ASSEMBLIES=debug has no MSBuild property, hence
      the runsettings. WasmHotReloadBridgeTests.The_feature_switch_is_on_in_this_assembly guards it.

      Safe to enable assembly-wide here, unlike on Rask.Server.Tests: these tests raise the Applied
      event directly rather than running the coordinator, so no other class's sessions get pulled into
      a repaint loop. Sessions do start registering in the (weak, static) hot-reload registry, but
      nothing in this assembly ever walks it.
    -->
    <MetadataUpdaterSupport>true</MetadataUpdaterSupport>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/hotreload.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Testing"/>
    <Using Include="Rask.TestSupport"/>
    <Using Include="Rask.TestSupport.Bytes" Static="true"/>
    <Using Include="Rask.Wasm.Tests.Infrastructure.WasmSessionHarness" Static="true"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Wasm\Rask.Wasm.csproj"/>
    <ProjectReference Include="..\Rask.TestSupport\Rask.TestSupport.csproj"/>
    <!-- EventListenerTests: a component that handles a published event, registered by the battery generator. -->
    <ProjectReference Include="..\..\src\Rask.Batteries.Generators\Rask.Batteries.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    The script fixtures. Each JSInterop/*Fixture.ts drives the BUILT browser bundle with a stub DOM,
    in-process on Jint (ScriptFixture.Run), and its C# test asserts the value it reports — the browser-side
    halves of the boot-failure surface and the head-asset gate, neither of which a C# assertion over the
    file's text could reach.

    Bundled during the BUILD rather than from the test, so a fixture that no longer compiles fails the
    build with the compiler's message instead of failing a test. They take the bundle's path as an
    argument and import it at runtime, so nothing here depends on the framework sources.
  -->
  <ItemGroup>
    <_RaskScriptFixture Include="JSInterop\*Fixture.ts"/>
    <!-- OfflineCacheFixture imports this one source directly; an edit to it has to re-bundle the fixture. -->
    <_RaskScriptFixtureDependency Include="..\..\src\Rask.Wasm\Resources\rask-offline-cache.ts"/>
  </ItemGroup>

  <Import Project="..\Rask.TestSupport\ScriptFixtures.targets"/>

  <!-- Files these tests read from disk at runtime that no reference brings in. Never evaluated: it is
       read by scripts/lib/affected_projects.py, so a change to one of these runs these tests. A test
       that starts reading a new file outside this project must add it here. -->
  <ItemGroup Condition="false">
    <RaskTestReads Include="..\..\src\Rask.Site\wwwroot\index.html" />
    <RaskTestReads Include="..\..\src\Rask.Wasm\**" />
  </ItemGroup>

</Project>
