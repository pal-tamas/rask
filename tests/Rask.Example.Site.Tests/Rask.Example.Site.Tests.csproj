<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <!-- This project opts out of the in-repo consumer implicit usings (see Directory.Build.props): it
         references neither host nor Bootstrap/validation, so those injected global usings would not
         resolve. Rask.Core is still needed by hand for `Component` — the markup entries themselves arrive
         by inheritance from RaskMarkup, not from a using. -->
    <Using Include="Rask.Core"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\src\Rask.Testing\Rask.Testing.csproj"/>
  </ItemGroup>

  <!-- The landing app is a browser-WASM project (net10.0-browser), so it cannot be referenced from a
       net10.0 test project — the sources under test are LINKED instead, the same way
       Rask.Example.Playground.Tests links the playground's compiler. Only files that are pure markup
       with no IJSRuntime or host dependency can be linked: they compile and render here unchanged, and
       the generator emits their factories into this compilation. -->
  <ItemGroup>
    <Compile Include="..\..\samples\Rask.Example.Site\FlowAnimation.cs"
             LinkBase="Site"/>
    <Compile Include="..\..\samples\Rask.Example.Site\FlowAnimation.Nodes.cs"
             LinkBase="Site"/>
    <Compile Include="..\..\samples\Rask.Example.Site\FlowAnimation.Draw.cs"
             LinkBase="Site"/>
    <Compile Include="..\..\samples\Rask.Example.Site\FlowAnimation.Scenes.cs"
             LinkBase="Site"/>
    <Compile Include="..\..\samples\Rask.Example.Site\FlowAnimation.Styles.cs"
             LinkBase="Site"/>
    <Compile Include="..\..\samples\Rask.Example.Site\InstallTabs.cs"
             LinkBase="Site"/>
  </ItemGroup>

</Project>
