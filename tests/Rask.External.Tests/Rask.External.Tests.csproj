<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The sibling test project for src/Rask.External. These tests declare REAL islands and render them,
    rather than asserting on generator output as text: the thing that has to work is the whole seam —
    the attribute is discovered, the partial is generated, the host element serializes, the props JSON
    matches what the front end will be typed against. A test over generated source would pass while
    any one of those was broken.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- The *Fixture.ts here are node harnesses, not scoped assets: they pair with no component, so
         the scoped-TS convention would report each as an orphan (RASK017). Same reason
         Rask.Core.Tests and Rask.Wasm.Tests set it. -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>

    <!--
      RASKISLAND004 demoted to a message, and ONLY in this project (#1042).

      Thirteen of the fourteen islands below are declared inline in a test source with no front-end file
      beside them on purpose — they exist to be RENDERED, so that the attribute is discovered, the
      partial generated, the host element serialized and the props JSON checked against what a front end
      would be typed against. A module would add nothing any of those assert, and for a .vue or a
      .svelte it would drag vue-tsc, svelte-check and an npm install into a project that deliberately
      builds with nothing installed. So the build is right that their chunks will not exist, and there
      is nothing here to fix.

      DEMOTED, NOT DISABLED, and the distinction is the whole point. RaskExternalPropTypes=false silences
      all thirteen in one line — it is what tests/Rask.Site.Tests legitimately does, having the site's .cs
      without its front-end files (#938) — but it also turns off the prop-types WRITE, and Dial.ts's
      type-check is exactly that write: rename Value on Dial in C# and Dial.ts stops compiling, which
      fails this build. Turning the switch off to quiet a warning would disable the thing one of these
      tests asserts.

      Dial keeps the signal. It is the one island here with a module, so if island discovery ever stopped
      claiming Dial.ts — the #938 failure this check is the Roslyn-side guard against — the message still
      names it, and the type-check silently stopping is what the message would be reporting.

      MSBuildWarningsAsMessages rather than NoWarn: NoWarn is the Roslyn switch and does not reach a
      warning an MSBuild task logs. This is also why the code exists at all — until #1042 the warning had
      none, and a codeless task warning cannot be suppressed by anybody, here or in a consumer's app.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);RASKISLAND004</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <!-- IslandNodeFloorGateTests drives the real node probe, so it skips where node is absent. -->
    <PackageReference Include="Xunit.SkippableFact"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Core"/>
    <Using Include="Rask.Core.Components"/>
    <Using Include="Rask.External"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.External\Rask.External.csproj"/>
    <!-- For NodeFixture: the client runtime is exercised as the JavaScript it ships, in node. -->
    <ProjectReference Include="..\Rask.TestSupport\Rask.TestSupport.csproj"/>
    <!-- The island generator has to RUN here: it is what turns the [Island] classes below into host
         elements, and the markup-host entries are injected per compilation. -->
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    The Node fixture, bundled exactly as Rask.Core.Tests bundles its own (#871). The fixture IMPORTS
    the client runtime rather than reading it off disk, so esbuild resolves the real module and a
    fixture that no longer compiles fails the BUILD instead of failing a test with node's message.
  -->
  <ItemGroup>
    <!-- PreactAdapterFixture is excluded because it needs npm packages and therefore its own target
         below; everything else here bundles with nothing installed. -->
    <_RaskNodeFixture Include="*Fixture.ts" Exclude="PreactAdapterFixture.ts"/>
  </ItemGroup>

  <Target Name="_RaskBundleNodeFixtures" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences"
          Inputs="@(_RaskNodeFixture);@(_RaskNodeFixtureDependency)"
          Outputs="@(_RaskNodeFixture->'$(OutDir)node-fixtures/%(Filename).mjs')">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <!-- Never minified: a failure here is read by a person, and node's stack has to name something. -->
    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;%(_RaskNodeFixture.FullPath)&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --outfile=&quot;$(OutDir)node-fixtures/%(_RaskNodeFixture.Filename).mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!-- The module the fixture imports. Listed so editing the runtime re-bundles: Inputs takes no glob. -->
  <ItemGroup>
    <_RaskNodeFixtureDependency Include="..\..\src\Rask.External\wwwroot\*.js"/>
  </ItemGroup>

  <!--
    ==========================================================================================
    The Preact adapter fixture (#963).
    ==========================================================================================

    PreactAdapterFixture.ts drives src/Rask.External/client/preact.ts against the REAL preact and a
    real DOM, so it needs two npm packages that no other fixture here does.

    They are installed under obj/, NOT into a shared per-user cache. A cache keyed by version would be
    installed once for the whole machine and is what the esbuild/tsgo resolver does — but that resolver
    unpacks into a temp directory and moves it into place, and `npm install` has no equivalent. Two
    worktrees running their gates at once would then install into the same tree concurrently. obj/ is
    per worktree, costs one 2-second install per checkout, and cannot be raced.

    `obj/preact-fixture` rather than $(IntermediateOutputPath): the install is configuration-neutral,
    and Debug and Release should not each pay for their own copy. Same reasoning as
    _RaskExternalStableObj in Rask.External.targets.

    Note the location: a package.json here would NOT make this project bundlable — _RaskExternalBundlable
    probes $(MSBuildProjectDirectory)/package.json exactly, and obj/ is excluded from every island glob.
    A package.json at the project root would turn this test project into an island app and run vite
    over its 13 fixture components.
  -->
  <PropertyGroup>
    <!-- Pinned, and the only copy of either number. Listed in the check-dependency-updates skill. -->
    <RaskPreactFixtureVersion Condition="'$(RaskPreactFixtureVersion)' == ''">10.29.8</RaskPreactFixtureVersion>
    <RaskHappyDomFixtureVersion Condition="'$(RaskHappyDomFixtureVersion)' == ''">20.14.0</RaskHappyDomFixtureVersion>

    <!-- The one switch that turns the whole thing off, for a build with no npm and no network. The
         test then reports SKIPPED rather than passing, so a machine that never runs it says so. -->
    <RaskPreactFixture Condition="'$(RaskPreactFixture)' == ''">true</RaskPreactFixture>

    <_PreactFixtureRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/obj/preact-fixture'))</_PreactFixtureRoot>
    <_PreactFixtureModules>$(_PreactFixtureRoot)/node_modules</_PreactFixtureModules>
    <_PreactFixtureStamp>$(_PreactFixtureRoot)/.installed</_PreactFixtureStamp>
  </PropertyGroup>

  <!--
    IgnoreExitCode, and a stamp written only when the packages actually arrived.

    A missing npm, a proxy, an offline machine: none of those should fail a build of the C# framework,
    and none of them should look like success either. So the install is allowed to fail quietly, the
    stamp is conditioned on the installed trees being THERE rather than on the exit code, and the
    bundle below is conditioned on the stamp. What reaches a person is a SKIPPED test naming the
    reason — the one outcome that is neither a red build nor a silent pass.

    Failure therefore costs a retry on every build rather than being remembered. That is deliberate:
    the alternative caches "this machine cannot" past the moment it can again.
  -->
  <Target Name="_RaskRestorePreactFixture" AfterTargets="Build"
          Condition="'$(RaskPreactFixture)' == 'true' AND '$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectFullPath)" Outputs="$(_PreactFixtureStamp)">
    <MakeDir Directories="$(_PreactFixtureRoot)"/>

    <!-- Exact versions, no ranges: a fixture that quietly moved to a new preact minor would be
         reporting on a version nobody chose. -->
    <WriteLinesToFile File="$(_PreactFixtureRoot)/package.json" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="{&quot;name&quot;:&quot;rask-preact-fixture&quot;,&quot;private&quot;:true,&quot;type&quot;:&quot;module&quot;,&quot;dependencies&quot;:{&quot;preact&quot;:&quot;$(RaskPreactFixtureVersion)&quot;,&quot;happy-dom&quot;:&quot;$(RaskHappyDomFixtureVersion)&quot;}}"/>

    <Exec Command="npm install --no-audit --no-fund --loglevel=error"
          WorkingDirectory="$(_PreactFixtureRoot)"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          ContinueOnError="true"/>

    <Touch Files="$(_PreactFixtureStamp)" AlwaysCreate="true"
           Condition="Exists('$(_PreactFixtureModules)/preact/package.json') AND Exists('$(_PreactFixtureModules)/happy-dom/package.json')"/>

    <Message Importance="high" Text="Rask.External.Tests: npm could not install preact@$(RaskPreactFixtureVersion) + happy-dom@$(RaskHappyDomFixtureVersion) into '$(_PreactFixtureRoot)', so PreactAdapterTests will report SKIPPED."
             Condition="!Exists('$(_PreactFixtureStamp)')"/>
  </Target>

  <!--
    The aliases are what let the adapter — which lives in src/Rask.External/client, nowhere near this
    node_modules — resolve `preact` at all: esbuild walks up from the IMPORTING file, and no ancestor
    of the adapter has a node_modules. esbuild has no NODE_PATH equivalent on its command line either,
    so an alias per package is the whole mechanism.

    The banner is for happy-dom, which pulls in `ws` and requires `events` at load. Bundled to ESM
    there is no `require` in scope, and esbuild's shim throws "Dynamic require of ... is not
    supported" before the fixture's first line runs.
  -->
  <!-- ResolveProjectReferences for the reason the sibling target states: ResolveTypeScriptToolTask is
       loaded from a generated Rask.TypeScript.Tasks.dll that exactly that reference edge produces
       (#878). Inert at AfterTargets="Build", stated so the invariant holds without an exemption. -->
  <Target Name="_RaskBundlePreactFixture" AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences;_RaskRestorePreactFixture"
          Condition="'$(RaskPreactFixture)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND Exists('$(_PreactFixtureStamp)')"
          Inputs="PreactAdapterFixture.ts;$(_PreactFixtureStamp);@(_RaskNodeFixtureDependency);..\..\src\Rask.External\client\preact.ts;..\..\src\Rask.External\client\adapter.ts"
          Outputs="$(OutDir)node-fixtures/PreactAdapterFixture.mjs">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;PreactAdapterFixture.ts&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --alias:preact=&quot;$(_PreactFixtureModules)/preact&quot; --alias:preact/hooks=&quot;$(_PreactFixtureModules)/preact/hooks&quot; --alias:happy-dom=&quot;$(_PreactFixtureModules)/happy-dom&quot; &quot;--banner:js=import{createRequire as __raskRequire}from 'node:module';const require=__raskRequire(import.meta.url);&quot; --outfile=&quot;$(OutDir)node-fixtures/PreactAdapterFixture.mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

</Project>
