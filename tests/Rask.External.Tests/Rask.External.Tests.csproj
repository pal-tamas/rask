<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The sibling test project for src/Rask.External. These tests declare REAL islands and render them,
    rather than asserting on generator output as text: the thing that has to work is the whole seam —
    the attribute is discovered, the partial is generated, the host element serializes, the props JSON
    matches what the front end will be typed against. A test over generated source would pass while
    any one of those was broken.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- The *Fixture.ts here are node harnesses, not scoped assets: they pair with no component, so
         the scoped-TS convention would report each as an orphan (RASK017). Same reason
         Rask.Core.Tests and Rask.Wasm.Tests set it. -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Core"/>
    <Using Include="Rask.Core.Components"/>
    <Using Include="Rask.Html.Components"/>
    <Using Include="Rask.External"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <ProjectReference Include="..\..\src\Rask.External\Rask.External.csproj"/>
    <!-- For NodeFixture: the client runtime is exercised as the JavaScript it ships, in node. -->
    <ProjectReference Include="..\Rask.TestSupport\Rask.TestSupport.csproj"/>
    <!-- The island generator has to RUN here: it is what turns the [Island] classes below into host
         elements, and the markup-host entries are injected per compilation. -->
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    The Node fixture, bundled exactly as Rask.Core.Tests bundles its own (#871). The fixture IMPORTS
    the client runtime rather than reading it off disk, so esbuild resolves the real module and a
    fixture that no longer compiles fails the BUILD instead of failing a test with node's message.
  -->
  <ItemGroup>
    <_RaskNodeFixture Include="*Fixture.ts"/>
  </ItemGroup>

  <Target Name="_RaskBundleNodeFixtures" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences"
          Inputs="@(_RaskNodeFixture);@(_RaskNodeFixtureDependency)"
          Outputs="@(_RaskNodeFixture->'$(OutDir)node-fixtures/%(Filename).mjs')">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <!-- Never minified: a failure here is read by a person, and node's stack has to name something. -->
    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;%(_RaskNodeFixture.FullPath)&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --outfile=&quot;$(OutDir)node-fixtures/%(_RaskNodeFixture.Filename).mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!-- The module the fixture imports. Listed so editing the runtime re-bundles: Inputs takes no glob. -->
  <ItemGroup>
    <_RaskNodeFixtureDependency Include="..\..\src\Rask.External\wwwroot\*.js"/>
  </ItemGroup>

</Project>
