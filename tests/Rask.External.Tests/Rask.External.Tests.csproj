<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The sibling test project for src/Rask.External. These tests declare REAL islands and render them,
    rather than asserting on generator output as text: the thing that has to work is the whole seam —
    the attribute is discovered, the partial is generated, the host element serializes, the props JSON
    matches what the front end will be typed against. A test over generated source would pass while
    any one of those was broken.
  -->
  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- The *Fixture.ts here are node harnesses, not scoped assets: they pair with no component, so
         the scoped-TS convention would report each as an orphan (RASK017). Same reason
         Rask.Core.Tests and Rask.Wasm.Tests set it. -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>

    <!--
      RASKISLAND004 demoted to a message, and ONLY in this project (#1042).

      Thirteen of the fourteen islands below are declared inline in a test source with no front-end file
      beside them on purpose — they exist to be RENDERED, so that the attribute is discovered, the
      partial generated, the host element serialized and the props JSON checked against what a front end
      would be typed against. A module would add nothing any of those assert, and for a .vue or a
      .svelte it would drag vue-tsc, svelte-check and an npm install into a project that deliberately
      builds with nothing installed. So the build is right that their chunks will not exist, and there
      is nothing here to fix.

      DEMOTED, NOT DISABLED, and the distinction is the whole point. RaskExternalPropTypes=false silences
      all thirteen in one line — it is what tests/Rask.Site.Tests legitimately does, having the site's .cs
      without its front-end files (#938) — but it also turns off the prop-types WRITE, and Dial.ts's
      type-check is exactly that write: rename Value on Dial in C# and Dial.ts stops compiling, which
      fails this build. Turning the switch off to quiet a warning would disable the thing one of these
      tests asserts.

      Dial keeps the signal. It is the one island here with a module, so if island discovery ever stopped
      claiming Dial.ts — the #938 failure this check is the Roslyn-side guard against — the message still
      names it, and the type-check silently stopping is what the message would be reporting.

      MSBuildWarningsAsMessages rather than NoWarn: NoWarn is the Roslyn switch and does not reach a
      warning an MSBuild task logs. This is also why the code exists at all — until #1042 the warning had
      none, and a codeless task warning cannot be suppressed by anybody, here or in a consumer's app.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);RASKISLAND004</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit.v3"/>
    <!-- IslandNodeFloorGateTests drives the real node probe, so it skips where node is absent. -->
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Core"/>
    <Using Include="Rask.Core.Components"/>
    <Using Include="Rask.External"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Rask.TestFiles"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.External\Rask.External.csproj"/>
    <!-- For NodeFixture: the client runtime is exercised as the JavaScript it ships, in node. -->
    <ProjectReference Include="..\Rask.TestSupport\Rask.TestSupport.csproj"/>
    <!-- The island generator has to RUN here: it is what turns the [Island] classes below into host
         elements, and the markup-host entries are injected per compilation. -->
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    The Node fixtures, bundled by the target every fixture-running test project shares (#871). A fixture
    IMPORTS the client runtime rather than reading it off disk, so esbuild resolves the real module and a
    fixture that no longer compiles fails the BUILD instead of failing a test with node's message.
  -->
  <ItemGroup>
    <!-- The adapter fixtures are excluded because they need npm packages and therefore their own targets
         below; everything else here bundles with nothing installed. -->
    <_RaskNodeFixture Include="*Fixture.ts"
                      Exclude="PreactAdapterFixture.ts;LitAdapterFixture.ts;ReactAdapterFixture.ts;VueAdapterFixture.ts;SolidAdapterFixture.ts;SvelteAdapterFixture.ts;AngularAdapterFixture.ts;IslandRoutesFixture.ts"/>
  </ItemGroup>

  <Import Project="..\Rask.TestSupport\NodeFixtures.targets"/>

  <!-- The module the fixture imports. Listed so editing the runtime re-bundles: Inputs takes no glob. -->
  <ItemGroup>
    <_RaskNodeFixtureDependency Include="..\..\src\Rask.External\wwwroot\*.js"/>
  </ItemGroup>

  <!--
    ==========================================================================================
    The adapter fixtures (#963).
    ==========================================================================================

    PreactAdapterFixture.ts drives src/Rask.External/client/preact.ts against the REAL preact and a
    real DOM; the React, Vue and Solid fixtures drive their adapters' children the same way against the
    real react/react-dom, vue and solid-js. Lit needs only the DOM. So one install serves all of them,
    and it holds the npm packages no other fixture here needs.

    They are installed under obj/, NOT into a shared per-user cache. A cache keyed by version would be
    installed once for the whole machine and is what the esbuild/tsgo resolver does — but that resolver
    unpacks into a temp directory and moves it into place, and `npm install` has no equivalent. Two
    worktrees running their gates at once would then install into the same tree concurrently. obj/ is
    per worktree, costs one install per checkout, and cannot be raced.

    `obj/preact-fixture` rather than $(IntermediateOutputPath): the install is configuration-neutral,
    and Debug and Release should not each pay for their own copy. Same reasoning as
    _RaskExternalStableObj in Rask.External.targets. The Preact-named properties and path predate the
    other frameworks joining the install, and keep their names so a build passing them still works.

    Note the location: a package.json here would NOT make this project bundlable — _RaskExternalBundlable
    probes $(MSBuildProjectDirectory)/package.json exactly, and obj/ is excluded from every island glob.
    A package.json at the project root would turn this test project into an island app and run vite
    over its 13 fixture components.
  -->
  <PropertyGroup>
    <!-- Pinned, and the only copy of each number. Listed in the check-dependency-updates skill. -->
    <RaskPreactFixtureVersion Condition="'$(RaskPreactFixtureVersion)' == ''">10.29.8</RaskPreactFixtureVersion>
    <RaskHappyDomFixtureVersion Condition="'$(RaskHappyDomFixtureVersion)' == ''">20.14.0</RaskHappyDomFixtureVersion>
    <RaskReactFixtureVersion Condition="'$(RaskReactFixtureVersion)' == ''">19.3.0</RaskReactFixtureVersion>
    <RaskVueFixtureVersion Condition="'$(RaskVueFixtureVersion)' == ''">3.5.42</RaskVueFixtureVersion>
    <RaskSolidFixtureVersion Condition="'$(RaskSolidFixtureVersion)' == ''">1.9.15</RaskSolidFixtureVersion>
    <RaskSvelteFixtureVersion Condition="'$(RaskSvelteFixtureVersion)' == ''">5.57.1</RaskSvelteFixtureVersion>
    <!-- One number for @angular/core, compiler, common and platform-browser: Angular refuses a mixed set. -->
    <RaskAngularFixtureVersion Condition="'$(RaskAngularFixtureVersion)' == ''">22.2.1</RaskAngularFixtureVersion>
    <RaskRxjsFixtureVersion Condition="'$(RaskRxjsFixtureVersion)' == ''">7.8.2</RaskRxjsFixtureVersion>

    <!-- The one switch that turns the whole thing off, for a build with no npm and no network. The
         tests then report SKIPPED rather than passing, so a machine that never runs them says so. -->
    <RaskPreactFixture Condition="'$(RaskPreactFixture)' == ''">true</RaskPreactFixture>

    <_PreactFixtureRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/obj/preact-fixture'))</_PreactFixtureRoot>
    <_PreactFixtureModules>$(_PreactFixtureRoot)/node_modules</_PreactFixtureModules>
    <_PreactFixtureStamp>$(_PreactFixtureRoot)/.installed</_PreactFixtureStamp>

    <!-- happy-dom pulls in `ws` and requires `events` at load. Bundled to ESM there is no `require` in scope, and
         esbuild's shim throws "Dynamic require of ... is not supported" before a fixture's first line runs. -->
    <_RaskFixtureRequireBanner>&quot;--banner:js=import{createRequire as __raskRequire}from 'node:module';const require=__raskRequire(import.meta.url);&quot;</_RaskFixtureRequireBanner>
  </PropertyGroup>

  <!--
    IgnoreExitCode, and a stamp written only when the packages actually arrived.

    A missing npm, a proxy, an offline machine: none of those should fail a build of the C# framework,
    and none of them should look like success either. So the install is allowed to fail quietly, the
    stamp is conditioned on the installed trees being THERE rather than on the exit code, and the
    bundles below are conditioned on the stamp. What reaches a person is a SKIPPED test naming the
    reason — the one outcome that is neither a red build nor a silent pass.

    Failure therefore costs a retry on every build rather than being remembered. That is deliberate:
    the alternative caches "this machine cannot" past the moment it can again.
  -->
  <Target Name="_RaskRestorePreactFixture" AfterTargets="Build"
          Condition="'$(RaskPreactFixture)' == 'true' AND '$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectFullPath)" Outputs="$(_PreactFixtureStamp)">
    <MakeDir Directories="$(_PreactFixtureRoot)"/>

    <!-- Exact versions, no ranges: a fixture that quietly moved to a new minor would be reporting on a
         version nobody chose. -->
    <WriteLinesToFile File="$(_PreactFixtureRoot)/package.json" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="{&quot;name&quot;:&quot;rask-preact-fixture&quot;,&quot;private&quot;:true,&quot;type&quot;:&quot;module&quot;,&quot;dependencies&quot;:{&quot;preact&quot;:&quot;$(RaskPreactFixtureVersion)&quot;,&quot;happy-dom&quot;:&quot;$(RaskHappyDomFixtureVersion)&quot;,&quot;react&quot;:&quot;$(RaskReactFixtureVersion)&quot;,&quot;react-dom&quot;:&quot;$(RaskReactFixtureVersion)&quot;,&quot;vue&quot;:&quot;$(RaskVueFixtureVersion)&quot;,&quot;solid-js&quot;:&quot;$(RaskSolidFixtureVersion)&quot;,&quot;svelte&quot;:&quot;$(RaskSvelteFixtureVersion)&quot;,&quot;@angular/core&quot;:&quot;$(RaskAngularFixtureVersion)&quot;,&quot;@angular/compiler&quot;:&quot;$(RaskAngularFixtureVersion)&quot;,&quot;@angular/common&quot;:&quot;$(RaskAngularFixtureVersion)&quot;,&quot;@angular/platform-browser&quot;:&quot;$(RaskAngularFixtureVersion)&quot;,&quot;rxjs&quot;:&quot;$(RaskRxjsFixtureVersion)&quot;},&quot;overrides&quot;:{&quot;seroval&quot;:&quot;^1.6.8&quot;,&quot;seroval-plugins&quot;:&quot;^1.6.8&quot;}}"/>

    <Exec Command="npm install --no-audit --no-fund --loglevel=error"
          WorkingDirectory="$(_PreactFixtureRoot)"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          ContinueOnError="true"/>

    <Touch Files="$(_PreactFixtureStamp)" AlwaysCreate="true"
           Condition="Exists('$(_PreactFixtureModules)/preact/package.json') AND Exists('$(_PreactFixtureModules)/happy-dom/package.json') AND Exists('$(_PreactFixtureModules)/react-dom/package.json') AND Exists('$(_PreactFixtureModules)/vue/package.json') AND Exists('$(_PreactFixtureModules)/solid-js/package.json') AND Exists('$(_PreactFixtureModules)/svelte/package.json') AND Exists('$(_PreactFixtureModules)/@angular/platform-browser/package.json') AND Exists('$(_PreactFixtureModules)/@angular/compiler/package.json')"/>

    <Message Importance="high" Text="Rask.External.Tests: npm could not install preact@$(RaskPreactFixtureVersion), happy-dom@$(RaskHappyDomFixtureVersion), react@$(RaskReactFixtureVersion), vue@$(RaskVueFixtureVersion), solid-js@$(RaskSolidFixtureVersion), svelte@$(RaskSvelteFixtureVersion) and Angular $(RaskAngularFixtureVersion) into '$(_PreactFixtureRoot)', so the adapter tests will report SKIPPED."
             Condition="!Exists('$(_PreactFixtureStamp)')"/>
  </Target>

  <!--
    The aliases are what let an adapter — which lives in src/Rask.External/client, nowhere near this
    node_modules — resolve its framework at all: esbuild walks up from the IMPORTING file, and no ancestor
    of the adapter has a node_modules. esbuild has no NODE_PATH equivalent on its command line either,
    so an alias per package is the whole mechanism.
  -->
  <!-- ResolveProjectReferences for the reason the sibling target states: ResolveTypeScriptToolTask is
       loaded from a generated Rask.TypeScript.Tasks.dll that exactly that reference edge produces
       (#878). Inert at AfterTargets="Build", stated so the invariant holds without an exemption. -->
  <Target Name="_RaskBundlePreactFixture" AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences;_RaskRestorePreactFixture"
          Condition="'$(RaskPreactFixture)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND Exists('$(_PreactFixtureStamp)')"
          Inputs="PreactAdapterFixture.ts;$(_PreactFixtureStamp);@(_RaskNodeFixtureDependency);..\..\src\Rask.External\client\preact.ts;..\..\src\Rask.External\client\adapter.ts"
          Outputs="$(OutDir)node-fixtures/PreactAdapterFixture.mjs">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;PreactAdapterFixture.ts&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --alias:preact=&quot;$(_PreactFixtureModules)/preact&quot; --alias:preact/hooks=&quot;$(_PreactFixtureModules)/preact/hooks&quot; --alias:happy-dom=&quot;$(_PreactFixtureModules)/happy-dom&quot; $(_RaskFixtureRequireBanner) --outfile=&quot;$(OutDir)node-fixtures/PreactAdapterFixture.mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!--
    The Lit adapter fixture: happy-dom and nothing else, so it borrows the install rather than paying for a second one,
    and is bundled exactly when that install arrived.
  -->
  <Target Name="_RaskBundleLitFixture" AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences;_RaskRestorePreactFixture"
          Condition="'$(RaskPreactFixture)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND Exists('$(_PreactFixtureStamp)')"
          Inputs="LitAdapterFixture.ts;$(_PreactFixtureStamp);@(_RaskNodeFixtureDependency);..\..\src\Rask.External\client\lit.ts;..\..\src\Rask.External\client\adapter.ts"
          Outputs="$(OutDir)node-fixtures/LitAdapterFixture.mjs">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;LitAdapterFixture.ts&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --alias:happy-dom=&quot;$(_PreactFixtureModules)/happy-dom&quot; $(_RaskFixtureRequireBanner) --outfile=&quot;$(OutDir)node-fixtures/LitAdapterFixture.mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!--
    The React adapter fixture: children rendered by the real react-dom. NODE_ENV is defined so react resolves one build
    rather than branching on `process.env` at every call; the value is a single-quoted JS string so it survives both sh
    and cmd quoting.
  -->
  <Target Name="_RaskBundleReactFixture" AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences;_RaskRestorePreactFixture"
          Condition="'$(RaskPreactFixture)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND Exists('$(_PreactFixtureStamp)')"
          Inputs="ReactAdapterFixture.ts;$(_PreactFixtureStamp);@(_RaskNodeFixtureDependency);..\..\src\Rask.External\client\react.ts;..\..\src\Rask.External\client\adapter.ts"
          Outputs="$(OutDir)node-fixtures/ReactAdapterFixture.mjs">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;ReactAdapterFixture.ts&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --alias:react=&quot;$(_PreactFixtureModules)/react&quot; --alias:react-dom=&quot;$(_PreactFixtureModules)/react-dom&quot; --alias:happy-dom=&quot;$(_PreactFixtureModules)/happy-dom&quot; &quot;--define:process.env.NODE_ENV='production'&quot; $(_RaskFixtureRequireBanner) --outfile=&quot;$(OutDir)node-fixtures/ReactAdapterFixture.mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!-- The Vue adapter fixture: children as the default slot, rendered by the real vue runtime. The defines are the
       compile-time flags vue's bundler builds read, set as a bundler would. -->
  <Target Name="_RaskBundleVueFixture" AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences;_RaskRestorePreactFixture"
          Condition="'$(RaskPreactFixture)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND Exists('$(_PreactFixtureStamp)')"
          Inputs="VueAdapterFixture.ts;$(_PreactFixtureStamp);@(_RaskNodeFixtureDependency);..\..\src\Rask.External\client\vue.ts;..\..\src\Rask.External\client\adapter.ts"
          Outputs="$(OutDir)node-fixtures/VueAdapterFixture.mjs">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;VueAdapterFixture.ts&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --alias:vue=&quot;$(_PreactFixtureModules)/vue&quot; --alias:happy-dom=&quot;$(_PreactFixtureModules)/happy-dom&quot; --define:__VUE_OPTIONS_API__=true --define:__VUE_PROD_DEVTOOLS__=false --define:__VUE_PROD_HYDRATION_MISMATCH_DETAILS__=false &quot;--define:process.env.NODE_ENV='production'&quot; $(_RaskFixtureRequireBanner) --outfile=&quot;$(OutDir)node-fixtures/VueAdapterFixture.mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!-- The Solid adapter fixture: children through a reconciled store, rendered by the real solid-js. Each entry is
       aliased to its BROWSER build file, and that is load-bearing: an alias to the package directory turns
       `solid-js/web` into a path, which esbuild resolves through that folder's main/module fields rather than the
       package's export conditions — the SERVER build, whose render throws "Client-only API called on the server
       side". The exact keys win over the package prefix, and web.js imports `solid-js` through the same alias as the
       fixture and the adapter, so all three share one Solid instance. -->
  <Target Name="_RaskBundleSolidFixture" AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences;_RaskRestorePreactFixture"
          Condition="'$(RaskPreactFixture)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND Exists('$(_PreactFixtureStamp)')"
          Inputs="SolidAdapterFixture.ts;$(_PreactFixtureStamp);@(_RaskNodeFixtureDependency);..\..\src\Rask.External\client\solid.ts;..\..\src\Rask.External\client\adapter.ts"
          Outputs="$(OutDir)node-fixtures/SolidAdapterFixture.mjs">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;SolidAdapterFixture.ts&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --alias:solid-js=&quot;$(_PreactFixtureModules)/solid-js/dist/solid.js&quot; --alias:solid-js/web=&quot;$(_PreactFixtureModules)/solid-js/web/dist/web.js&quot; --alias:solid-js/store=&quot;$(_PreactFixtureModules)/solid-js/store/dist/store.js&quot; --alias:happy-dom=&quot;$(_PreactFixtureModules)/happy-dom&quot; $(_RaskFixtureRequireBanner) --outfile=&quot;$(OutDir)node-fixtures/SolidAdapterFixture.mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!--
    The Svelte adapter fixture, and the one bundle here that esbuild cannot make on its own: `.svelte` is a template
    language and `$state` in svelte.svelte.ts is a compiler rune. So the SHIPPED adapter sources and the two fixture
    components go through Svelte's own compiler first (SvelteFixtureCompile.mjs — what @sveltejs/vite-plugin-svelte
    does in an app, types stripped by esbuild before the rune module is compiled, as there), and esbuild bundles the
    JavaScript that comes out.

    The compiled files land BESIDE the fixture install's node_modules, so their `svelte/internal/client` imports
    resolve by walking up, through the package's export conditions — `browser`, or Svelte hands over its server
    build, whose mount throws. They keep their `.svelte` names, hence the loader.

    Needs node itself, which the other bundles do not (esbuild is a native binary). The install stamp does not prove
    node is on PATH for THIS build, so it is probed, and without it the fixture is not bundled and the test reports
    SKIPPED. With it, a compile error fails the build.
  -->
  <PropertyGroup>
    <_SvelteFixtureOut>$(_PreactFixtureRoot)/svelte</_SvelteFixtureOut>
    <_SvelteClient>../../src/Rask.External/client</_SvelteClient>
  </PropertyGroup>

  <Target Name="_RaskBundleSvelteFixture" AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences;_RaskRestorePreactFixture"
          Condition="'$(RaskPreactFixture)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND Exists('$(_PreactFixtureStamp)')"
          Inputs="SvelteAdapterFixture.ts;SvelteFixtureCompile.mjs;SvelteFixture/FixtureCounter.svelte;SvelteFixture/FixtureBadge.svelte;$(_PreactFixtureStamp);@(_RaskNodeFixtureDependency);$(_SvelteClient)/svelte.svelte.ts;$(_SvelteClient)/RaskHost.svelte;$(_SvelteClient)/RaskTree.svelte;$(_SvelteClient)/adapter.ts"
          Outputs="$(OutDir)node-fixtures/SvelteAdapterFixture.mjs">
    <Exec Command="node --version" IgnoreExitCode="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_SvelteFixtureNodeExit"/>
    </Exec>

    <Message Importance="high" Text="Rask.External.Tests: node is not on PATH, so the Svelte adapter fixture was not compiled and SvelteAdapterTests will report SKIPPED."
             Condition="'$(_SvelteFixtureNodeExit)' != '0'"/>

    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)"
                               Condition="'$(_SvelteFixtureNodeExit)' == '0'">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures" Condition="'$(_SvelteFixtureNodeExit)' == '0'"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;$(_SvelteClient)/svelte.svelte.ts&quot; --format=esm --target=esnext --log-level=warning --outfile=&quot;$(_SvelteFixtureOut)/stripped/svelte.svelte.ts&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="'$(_SvelteFixtureNodeExit)' == '0'"/>

    <Exec Command="node &quot;SvelteFixtureCompile.mjs&quot; &quot;$(_PreactFixtureModules)&quot; &quot;$(_SvelteFixtureOut)&quot; &quot;$(_SvelteFixtureOut)/stripped/svelte.svelte.ts&quot; &quot;$(_SvelteClient)/RaskHost.svelte&quot; &quot;$(_SvelteClient)/RaskTree.svelte&quot; &quot;SvelteFixture/FixtureCounter.svelte&quot; &quot;SvelteFixture/FixtureBadge.svelte&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="'$(_SvelteFixtureNodeExit)' == '0'"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;SvelteAdapterFixture.ts&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --conditions=browser --loader:.svelte=js --alias:rask-svelte-fixture=&quot;$(_SvelteFixtureOut)&quot; --alias:happy-dom=&quot;$(_PreactFixtureModules)/happy-dom&quot; $(_RaskFixtureRequireBanner) --outfile=&quot;$(OutDir)node-fixtures/SvelteAdapterFixture.mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="'$(_SvelteFixtureNodeExit)' == '0'"/>
  </Target>

  <!--
    The Angular adapter fixture: the real @angular/core and @angular/platform-browser, with components compiled by
    Angular's JIT compiler at run time, so the bundle needs no Angular build step and no decorator transform.

    NODE_PATH instead of an alias per package. An alias turns `@angular/core` into a PATH, and Angular publishes
    through `exports` alone: its entry points (`@angular/core/primitives/signals`, `@angular/common/http`, …) import
    each other by package name, and an aliased prefix would send every one of those to a folder with no package.json
    in it. esbuild reads NODE_PATH from its environment, which resolves them as packages, exports and all.
  -->
  <Target Name="_RaskBundleAngularFixture" AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences;_RaskRestorePreactFixture"
          Condition="'$(RaskPreactFixture)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND Exists('$(_PreactFixtureStamp)')"
          Inputs="AngularAdapterFixture.ts;$(_PreactFixtureStamp);@(_RaskNodeFixtureDependency);..\..\src\Rask.External\client\angular.ts;..\..\src\Rask.External\client\adapter.ts"
          Outputs="$(OutDir)node-fixtures/AngularAdapterFixture.mjs">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;AngularAdapterFixture.ts&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning --alias:happy-dom=&quot;$(_PreactFixtureModules)/happy-dom&quot; $(_RaskFixtureRequireBanner) --outfile=&quot;$(OutDir)node-fixtures/AngularAdapterFixture.mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="NODE_PATH=$(_PreactFixtureModules)"/>
  </Target>

  <!--
    IslandRoutesFixture.ts imports `@rask/routes` the way an island does. The module is the one THIS build
    generated from this project's own [Route] pages, so it is bundled apart from the others: after the build
    has written it, with the alias the generated Vite config gives a real island.
  -->
  <Target Name="_RaskBundleRoutesFixture" AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="IslandRoutesFixture.ts;$(_RaskExternalTypes)routes.ts"
          Outputs="$(OutDir)node-fixtures/IslandRoutesFixture.mjs">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)node-fixtures"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;IslandRoutesFixture.ts&quot; --bundle --format=esm --platform=node --target=node20 --log-level=warning &quot;--alias:@rask/routes=$(_RaskExternalTypes)routes.ts&quot; --outfile=&quot;$(OutDir)node-fixtures/IslandRoutesFixture.mjs&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!-- IslandRoutesTests type-checks front-end code against that module with the compiler the build pins.
       The build already knows how to find it, so it leaves the path where the test can read it. -->
  <Target Name="_RaskNameTsgoForTests" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ResolveTypeScriptToolTask Tool="tsgo"
                               Version="$(RaskTsgoVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskTestTsgoPath"/>
    </ResolveTypeScriptToolTask>
    <WriteLinesToFile File="$(OutDir)node-fixtures/tsgo.path" Lines="$(_RaskTestTsgoPath)"
                      Overwrite="true" WriteOnlyWhenDifferent="true"/>
  </Target>

  <!-- Files these tests read from disk at runtime that no reference brings in. Never evaluated: it is
       read by scripts/lib/affected_projects.py, so a change to one of these runs these tests. A test
       that starts reading a new file outside this project must add it here. -->
  <ItemGroup Condition="false">
    <RaskTestReads Include="..\..\src\Rask.External\**" />
  </ItemGroup>

</Project>
