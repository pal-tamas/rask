<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The browser-WASM app the browser host's own journeys (tests/Rask.Wasm.E2E.Tests) drive: a page that says who it
    is drawn for and calls its own server's API, and a sign-in page. Published by scripts/run-wasm-e2e-local.sh; the
    journeys serve the publish from an ASP.NET host in their own process, which also issues and takes the cookie.
    The same shape as the `wasm` template, minus its styling.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RaskWasm>true</RaskWasm>
    <IsPackable>false</IsPackable>
    <RaskPublicApiTracked>false</RaskPublicApiTracked>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RunAOTCompilation Condition=" '$(RaskWasmAot)' == 'true' ">true</RunAOTCompilation>
    <RunAOTCompilation Condition=" '$(RaskWasmAot)' != 'true' and '$(WasmBuildNative)' != 'false' ">false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <!-- Hungarian is one of the fixture's languages (Program.cs): ICU ships, so hu-HU is a culture of its own. -->
    <RaskGlobalization>true</RaskGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Wasm\Rask.Wasm.csproj"/>
    <!-- AddLocalization(): what a WASM app adds for resources of its own (the server has it in its framework). -->
    <PackageReference Include="Microsoft.Extensions.Localization"/>
    <!-- PrivateAssets="all" from the above, so an in-repo app names them itself. -->
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Auth.Client\Rask.Auth.Client.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
