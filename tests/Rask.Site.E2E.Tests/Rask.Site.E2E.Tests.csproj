<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This project has no scoped component assets. Its .ts files are the browser fixtures below, so
      the scoped-TS glob must not claim them and RASK017 must not ask them to name a component they
      are not paired with.
    -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Rask.Site.E2E.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <!-- Reads back the PDF the PDF guide's demo downloads. -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The debugger files no Release publish may carry; the CLI E2E asks the same of a scaffold's publish. -->
    <Compile Include="..\Shared.TestFiles\DebuggerFreePublish.cs" Link="DebuggerFreePublish.cs"/>
  </ItemGroup>

  <!--
    An ordering edge and nothing else: _RaskBundleBrowserFixtures below runs ResolveTypeScriptToolTask
    out of the assembly this project builds. Without the edge a solution build may reach this project
    first and fail with MSB4062 — it did, on a four-core runner.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.TypeScript.Tasks\Rask.TypeScript.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <!-- WaitForRaskWasmTests: the browser-test wait the package ships, driven against the WebAssembly host. -->
    <ProjectReference Include="..\..\src\Rask.Testing.Playwright\Rask.Testing.Playwright.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- How many test classes run at once (xunit.runner.json), each with a page of its own in the ONE
         browser and over the ONE static host the assembly fixtures share (Infrastructure/ExampleAppCollections.cs).
         Four: a CI runner has four cores, and a page booting the WASM runtime takes most of one. A
         class's own tests still run one after another. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Browser fixtures. BrowserFixtures/*.ts are entry points that publish a framework module on
    `window` so a Playwright test can drive it directly, for behaviour only a real browser has — the
    live selectedOptions list, the split between an option's `selected` attribute and its property.

    Bundled during the BUILD, so one that no longer compiles fails the build with the compiler's
    message rather than a journey with a ReferenceError.

    iife, not esm: the test injects the bundle with AddScriptTagAsync, and a module script would defer
    past the point the test starts driving it.
  -->
  <ItemGroup>
    <_RaskBrowserFixture Include="BrowserFixtures\*.ts" />
    <_RaskBrowserFixtureDependency Include="..\..\src\Rask.Core\Resources\**\*.ts" Exclude="..\..\src\Rask.Core\Resources\**\*.d.ts" />
  </ItemGroup>

  <!-- DependsOnTargets: inert at AfterTargets="Build", stated so the generated-task ordering
       invariant holds without an exemption (#878). -->
  <Target Name="_RaskBundleBrowserFixtures" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences" Inputs="@(_RaskBrowserFixture);@(_RaskBrowserFixtureDependency)" Outputs="@(_RaskBrowserFixture->'$(OutDir)browser-fixtures/%(Filename).js')">
    <ResolveTypeScriptToolTask Tool="esbuild" Version="$(RaskEsbuildVersion)" CacheRoot="$(RaskTypeScriptCacheRoot)" Registry="$(RaskTypeScriptRegistry)" Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath" />
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)browser-fixtures" />

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;%(_RaskBrowserFixture.FullPath)&quot; --bundle --format=iife --target=es2020 --log-level=warning --outfile=&quot;$(OutDir)browser-fixtures/%(_RaskBrowserFixture.Filename).js&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
