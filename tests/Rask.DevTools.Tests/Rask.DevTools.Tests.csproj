<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- No scoped component assets: the .ts files here are Node fixtures (see Host/), which the scoped-TS glob must
         not claim. A property, because the csproj body evaluates before Rask.Core.targets adds the items. -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>

    <!--
      The probe's hook sites, observable in every configuration. RaskDevTools defaults to Debug only, and it becomes a
      runtime switch in the ENTRY app's config — this test project — so a Release run (which is what the unit gate runs)
      would leave RaskDevToolsHook.Active null and no seam would ever fire: the tests that drive a real page and expect
      its traffic or its component tree would pass or fail for reasons having nothing to do with the devtools.
      Rask.Core.Tests forces it on for the same reason.
    -->
    <RaskDevTools>true</RaskDevTools>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.TestHost"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.DevTools\Rask.DevTools.csproj"/>
    <!-- Rask.Core is PrivateAssets="all" from Rask.DevTools (it ships transitively from a host package),
         so an in-repo consumer must reference it directly. -->
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <!-- Same reason: the devtools' Server face references the host PrivateAssets="all". -->
    <ProjectReference Include="..\..\src\Rask.Server\Rask.Server.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
    <!-- NodeFixture, which runs the host-script fixtures below. -->
    <ProjectReference Include="..\Rask.TestSupport\Rask.TestSupport.csproj"/>
    <!-- The panel is drawn with Rask.Ui, which Rask.DevTools references privately: an app brings its own copy, and so
         does this test host. -->
    <ProjectReference Include="..\..\src\Rask.Ui\Rask.Ui.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The Server tests' host, shared rather than copied: the endpoint tests need the same AddRask/UseRask
         wiring a real app gets. -->
    <Compile Include="..\Rask.Server.Tests\Infrastructure\RaskTestHost.cs" Link="Infrastructure\RaskTestHost.cs"/>
    <Compile Include="..\Rask.Server.Tests\Infrastructure\WebSocketHelper.cs" Link="Infrastructure\WebSocketHelper.cs"/>
    <Compile Include="..\Shared.TestFiles\RepoFiles.cs" Link="RepoFiles.cs"/>
    <Using Include="Rask.TestFiles"/>
  </ItemGroup>

  <!-- The host script's Node fixtures: each drives a Resources/ module against a stub DOM. -->
  <ItemGroup>
    <_RaskNodeFixture Include="Host\*Fixture.ts"/>
    <_RaskNodeFixtureDependency Include="..\..\src\Rask.DevTools\Resources\**\*.ts"
                                Exclude="..\..\src\Rask.DevTools\Resources\**\*.d.ts"/>
  </ItemGroup>

  <Import Project="..\Rask.TestSupport\NodeFixtures.targets"/>

</Project>
