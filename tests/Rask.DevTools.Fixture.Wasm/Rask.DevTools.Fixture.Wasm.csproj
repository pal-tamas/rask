<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The smallest browser-WASM app that carries Rask.DevTools, published by hand to prove the gate on the
    trimmed bundle: a Debug publish carries the devtools assembly and a Release publish carries none of
    it. The same shape as the `wasm` template, minus its styling, which has nothing to say about the gate.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RaskWasm>true</RaskWasm>
    <IsPackable>false</IsPackable>
    <RaskPublicApiTracked>false</RaskPublicApiTracked>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RunAOTCompilation Condition=" '$(RaskWasmAot)' == 'true' ">true</RunAOTCompilation>
    <RunAOTCompilation Condition=" '$(RaskWasmAot)' != 'true' and '$(WasmBuildNative)' != 'false' ">false</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Wasm\Rask.Wasm.csproj"/>
    <ProjectReference Include="..\..\src\Rask.DevTools\Rask.DevTools.csproj"/>
    <!-- PrivateAssets="all" from both of the above, so an in-repo app names it itself. -->
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
