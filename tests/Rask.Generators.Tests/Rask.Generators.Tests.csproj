<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators.CodeFixes\Rask.Generators.CodeFixes.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <!-- Rask.Server (and, transitively, the ASP.NET Core shared framework) so AuthBeforeRaskAnalyzer
         tests can resolve the real UseRask / UseAuthentication symbols in their test compilations. -->
    <ProjectReference Include="..\..\src\Rask.Server\Rask.Server.csproj"/>
    <!-- The other analyzer assembly, referenced as a plain library (not as an analyzer) so
         DiagnosticDescriptorTests can enumerate the WHOLE RASK family by reflection. RASK028/029 and
         RASK053 live here, as does RASK035 via the shared RegistryGeneratorBase; a family-wide
         invariant that skipped them would be checking part of a rule. The jobs and outbox generators
         used to be two more, each compiling its own copy of RASK035's descriptor. -->
    <ProjectReference Include="..\..\src\Rask.Batteries.Generators\Rask.Batteries.Generators.csproj"/>
    <!-- The FIFTH assembly to allocate in this space, and the reason this list must be checked rather
         than trusted: RASK067-070 landed here while another branch held RASK067, and nothing went red
         — RS1019 only sees one compilation, and the reflection sweep below only sees the assemblies
         named here. An id collision is invisible until someone reads two docs sections with the same
         number. -->
    <ProjectReference Include="..\..\src\Rask.Api.Generators\Rask.Api.Generators.csproj"/>
    <!-- The island base classes, so ExternalGenerator's own diagnostics can be tested. The generator
         resolves ReactComponent/LitComponent/VueComponent/SvelteComponent by metadata name and does
         nothing at all when none of them is present, so without this reference every test of it would
         pass by generating nothing. -->
    <ProjectReference Include="..\..\src\Rask.External\Rask.External.csproj"/>
  </ItemGroup>

</Project>
