<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This project has no scoped component assets. Its .ts files are the browser fixtures below, so
      the scoped-TS glob must not claim them and RASK017 must not ask them to name a component they
      are not paired with.
    -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Rask.Examples.E2E.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest"/>
    <!-- Caps cross-collection parallelism for LOCAL full-suite runs (see xunit.runner.json).
         Each browser-host collection fixture boots a full `dotnet run` host plus a Chromium
         page, so unbounded parallelism over-subscribes a small box. CI no longer depends on
         this cap: ci.yml's `e2e` job shards one host per runner (matrix), so each runner runs
         a single collection and there is no cross-collection contention. The value here only
         bounds how many hosts boot at once when a developer runs the whole E2E suite locally. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\Rask.Example.Server\Rask.Example.Server.csproj"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\samples\Rask.Example.EfCore\Rask.Example.EfCore.csproj"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\samples\Rask.Example.Shop\Rask.Example.Shop.csproj"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\samples\Rask.Example.Auth\Rask.Example.Auth.csproj"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\samples\Rask.Example.Auth.Jwt\Rask.Example.Auth.Jwt.csproj"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\samples\Rask.Example.Auth.WasmCookie.Host\Rask.Example.Auth.WasmCookie.Host.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"/>
    <ProjectReference Include="..\..\samples\Rask.Example.Auth.WasmJwt.Host\Rask.Example.Auth.WasmJwt.Host.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"/>
    <ProjectReference Include="..\..\samples\Rask.Example.Wasm.Host\Rask.Example.Wasm.Host.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"/>
  </ItemGroup>

  <!--
    Browser fixtures. BrowserFixtures/*.ts are entry points that publish a framework module on
    `window` so a Playwright test can drive it directly, for behaviour only a real browser has — the
    live selectedOptions list, the split between an option's `selected` attribute and its property.

    Bundled during the BUILD, so one that no longer compiles fails the build with the compiler's
    message rather than a journey with a ReferenceError.

    iife, not esm: the test injects the bundle with AddScriptTagAsync, and a module script would defer
    past the point the test starts driving it.
  -->
  <ItemGroup>
    <_RaskBrowserFixture Include="BrowserFixtures\*.ts"/>
    <_RaskBrowserFixtureDependency Include="..\..\src\Rask.Core\Resources\*.ts"
                                   Exclude="..\..\src\Rask.Core\Resources\*.d.ts"/>
  </ItemGroup>

  <Target Name="_RaskBundleBrowserFixtures" AfterTargets="Build"
          Inputs="@(_RaskBrowserFixture);@(_RaskBrowserFixtureDependency)"
          Outputs="@(_RaskBrowserFixture->'$(OutDir)browser-fixtures/%(Filename).js')">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(OutDir)browser-fixtures"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;%(_RaskBrowserFixture.FullPath)&quot; --bundle --format=iife --target=es2020 --log-level=warning --outfile=&quot;$(OutDir)browser-fixtures/%(_RaskBrowserFixture.Filename).js&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

</Project>
