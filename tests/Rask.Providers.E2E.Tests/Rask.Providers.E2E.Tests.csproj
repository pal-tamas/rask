<Project Sdk="Microsoft.NET.Sdk">

  <!-- Real database servers, started by the suite itself on Testcontainers (ProviderServer.cs) — in CI, or where
       RASK_PROVIDERS_LOCAL=1 says Docker may be used; never a hand-started server. Anywhere else the server facts
       report SKIPPED and the SQLite legs still run. The .E2E.Tests suffix keeps it out of the unit gate;
       scripts/run-providers-local.sh is what runs it. -->
  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- DatabaseStorageTests creates the adopted tables from the DDL the storage guide publishes. -->
  <ItemGroup Condition="false">
    <RaskTestReads Include="..\..\docs\file-storage.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The two mappings of a one-value value object, compared by EF's migration differ on every provider. -->
    <Compile Include="..\Rask.Data.Tests\ValueObjectMappingShapes.cs" Link="ValueObjectMappingShapes.cs"/>
    <Compile Include="..\Rask.Data.Tests\NamingShapes.cs" Link="NamingShapes.cs"/>
    <!-- The value collections of every nullability, asked of every provider. -->
    <Compile Include="..\Rask.Data.Tests\ValueCollectionNullabilityShapes.cs" Link="ValueCollectionNullabilityShapes.cs"/>
    <!-- An aggregate's children as a hand-written List and view, and as one HasMany: no migration between them on every provider. -->
    <Compile Include="..\Rask.Data.Tests\HandListedShapes.cs" Link="HandListedShapes.cs"/>
    <Compile Include="..\Rask.Data.Tests\ListedShapes.cs" Link="ListedShapes.cs"/>
    <!-- The jobs' clock, moved by hand while the poll ticks for real: the stop and limit tests on every provider. -->
    <Compile Include="..\Rask.Jobs.Tests\FakeTimeProvider.cs" Link="FakeTimeProvider.cs"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Hosting"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="Testcontainers.MsSql"/>
    <PackageReference Include="Testcontainers.PostgreSql"/>
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
    <Using Include="Rask.Cqrs"/>
    <Using Include="Rask.Data"/>
    <Using Include="Rask.Values"/>
    <Using Include="Rask.Values.Range" Alias="Range"/>
    <Using Include="Rask.Background"/>
    <Using Include="Rask.Postgres"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Postgres\Rask.Postgres.csproj"/>
    <ProjectReference Include="..\..\src\Rask.SqlServer\Rask.SqlServer.csproj"/>
    <!-- AddRaskData(...).OwnsSchema(): migrate-on-start against a server that does not have the database yet. -->
    <ProjectReference Include="..\..\src\Rask.Server\Rask.Server.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Data\Rask.Data.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Jobs\Rask.Jobs.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Cache\Rask.Cache.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Logging\Rask.Logging.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Storage\Rask.Storage.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Batteries.Generators\Rask.Batteries.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
    <!-- The value objects' Create/TryCreate/Check: the Rask package's generator writes them. -->
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
