<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    An app whose Program.cs refuses to start without a setting no test gives it, for Rask.Testing.Database.Tests:
    a test that sets up its own database must never boot it, and a boot that should not happen fails loudly.
  -->
  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RaskPublicApiTracked>false</RaskPublicApiTracked>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Server\Rask.Server.csproj"/>
    <!-- PrivateAssets="all" from the host, so an in-repo app names it itself. -->
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
