<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Browser journeys against a Rask.Server app: server-rendered live pages, driven by the real rask.js in a
    real Chromium. Rask.Site.E2E.Tests cannot carry these — the site is a WebAssembly app with no server
    pages — and the unit suites cannot either, because an in-memory TestServer has no port a browser can
    reach. So each fixture here starts Kestrel in THIS process on a loopback port.

    In-process on purpose: an out-of-process `dotnet run` host would need MinVer's version identity to
    resolve (see run-e2e-local.sh), and would put a build and a process start inside every journey.
  -->
  <PropertyGroup>
    <TargetFramework>$(RaskTestTarget)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Rask.Server.E2E.Tests</RootNamespace>
    <NoWarn>$(NoWarn);RASK014</NoWarn>
    <!--
      EditorOnServerTests draws a Ui.Editor. A Server APP gets the engine in its wwwroot with nothing said
      (Microsoft.NET.Sdk.Web); this is a test library that hosts Kestrel itself, so it says it is such a host.
    -->
    <RaskUiEditorEngine>true</RaskUiEditorEngine>
  </PropertyGroup>

  <!--
    A web project serves its wwwroot from the project folder; this is a test project whose host runs from
    bin/, so what the opt-in wrote travels there. Named, not globbed: the files appear during the build.
  -->
  <ItemGroup>
    <None Include="wwwroot\js\rask-ui-editor.js" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="wwwroot\js\rask-ui-editor.LICENSES.txt" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Server\Rask.Server.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Web\Rask.Web.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <!-- One browser install and launch story for every browser suite. -->
    <Compile Include="..\Rask.Site.E2E.Tests\Infrastructure\PlaywrightFixture.cs" Link="Infrastructure\PlaywrightFixture.cs"/>
  </ItemGroup>

</Project>
