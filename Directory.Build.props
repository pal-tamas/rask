<Project>

  <PropertyGroup>
    <Authors>Tamás Pál</Authors>
    <Company>Tamás Pál</Company>
    <Copyright>© Tamás Pál</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- A concise, nuget.org-friendly README (absolute image/link URLs); the 75KB root
         README with relative links does not render well on the gallery. -->
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <!-- Square gallery/IDE icon (NuGet rejects SVG, so a PNG derived from assets/rask-icon.svg).
         Packed for every packable project by the IsPackable ItemGroup below. -->
    <PackageIcon>rask-icon.png</PackageIcon>
    <!-- The site, not the repository: RepositoryUrl already names the repository, and nuget.org renders
         the two as separate links. This one is labelled "Project website" on every package page, which is
         a link from nuget.org to the docs a reader actually wants — for twenty packages. -->
    <PackageProjectUrl>https://rask.sh/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pal-tamas/rask.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The fallback for a package that names no tags of its own — Rask, Rask.Server, Rask.Wasm and the other
         hosts. nuget.org search matches tags, and "web component framework wasm net10" matched nothing a
         .NET developer looking for a web framework types. -->
    <PackageTags>web framework components csharp dotnet aspnetcore webassembly wasm ssr blazor-alternative one-person-framework sqlite net10</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!--
      Pinned at evaluation time, deliberately, and NOT left to MinVer.

      MinVer sets AssemblyVersion from a TARGET (to $(MinVerMajor).0.0.0 — 0.0.0.0 for our 0.x line).
      Hot reload does not run targets: Roslyn's EnC service compiles in-process from the project's
      EVALUATED properties, where MinVer has not run and the SDK falls back to Version 1.0.0 →
      AssemblyVersion 1.0.0.0. So every hot-reload emit disagreed with the assembly already loaded and
      Roslyn refused it outright:

        error CS7038: Failed to emit module 'X': Changing the version of an assembly reference is not
        allowed during debugging: 'Rask.Bootstrap, Version=0.0.0.0' changed version to '1.0.0.0'

      That made the FIRST save of every `rask dev` session on this repo's own samples fail for a reason
      that had nothing to do with the edit — and it would hit any app that project-references Rask.
      Pinning it here makes evaluation and target agree. AssemblyVersion is the binary-compat identity
      and is meant to be stable anyway; the real version still rides on FileVersion/InformationalVersion,
      which MinVer keeps stamping.

      It only ever bit the PACKABLE projects, which is why it survived so long: MinVer is referenced
      under `Condition=" '$(IsPackable)' != 'false' "` below, so an unpackable project reads 1.0.0.0
      both on disk and under EnC and never mismatches. The error named Rask.Bootstrap, never Rask.Core —
      and anyone investigating via Rask.Core sees nothing wrong.

      0.0.0.0 is right only while the major is 0. AssemblyVersionStabilityTests fails when the shipped
      major leaves 0.x, so this gets moved rather than silently understating compatibility at v1.0.0.
    -->
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!--
    Code-quality gate (enforced by the rask-ship skill, codified here so a plain `dotnet build`
    enforces it too): .NET analyzers on, code-style run in-build, warnings are errors. The repo
    builds clean today — keep it that way. Only Roslyn compiler/analyzer warnings escalate;
    MSBuild-engine warnings (e.g. the transient MSB3026 copy-retry under parallel build) do not.
    Code-style severities come from .editorconfig (suggestions stay suggestions, not errors).
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Emit the XML doc file so the public API's /// comments reach consumer IntelliSense (tooltips,
      parameter hints) via the NuGet package. Only framework/library projects need it — test,
      benchmark, and sample projects are never consumed as packages, so generating (and validating)
      their doc comments is pure noise. CS1591 (missing XML comment on a public member) is suppressed
      rather than escalated: we ship the docs we have without forcing a full-coverage documentation
      sweep across every public member under warnings-as-errors.
    -->
    <GenerateDocumentationFile Condition=" !$(MSBuildProjectName.EndsWith('.Tests')) AND !$(MSBuildProjectName.StartsWith('Rask.Benchmarks')) AND !$(MSBuildProjectName.StartsWith('Rask.Site')) ">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!--
    AnalysisLevel stays at the SDK default mode: the repo builds clean there, so warnings-as-errors
    locks in that clean state. Raising it (e.g. <AnalysisLevel>latest-recommended</AnalysisLevel>)
    surfaces ~33 extra CA findings — some worth doing (CA1865/CA1859), some that clash with
    the documented hot-path design (CA1051 on RenderFrame's deliberately-public fields). Promote the
    level in a focused PR that fixes/justifies each finding with benchmark evidence — not here.

    CA1305 (IFormatProvider) has since been promoted on its own, scoped to src/Rask.Core/**, in
    .editorconfig — a single severity line rather than a level bump, so it brought none of the others
    with it. Rask.Core is where wire formats live (reconciliation keys, DOM event payloads, field-path
    indices), and those must stay invariant even when a render runs under a user's culture.
  -->

  <ItemGroup Condition=" '$(IsPackable)' != 'false' ">
    <None Include="$(MSBuildThisFileDirectory)NUGET.md" Pack="true" PackagePath="" Visible="false"/>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false"/>
    <None Include="$(MSBuildThisFileDirectory)assets\rask-icon.png" Pack="true" PackagePath="" Visible="false"/>
  </ItemGroup>

  <ItemGroup Condition=" '$(IsPackable)' != 'false' ">
    <PackageReference Include="MinVer" PrivateAssets="all"/>
  </ItemGroup>

  <!--
    In-repo auto-import for Rask implicit-usings props. Only Rask.Site* opts in — the published site is
    the in-repo stand-in for a downstream consumer, who picks up the same <Using> items via NuGet's
    auto-import of build/$(PackageId).props. Framework projects (Rask.Core, Rask.Server, Rask.Wasm,
    etc.) deliberately don't get the implicit static usings because method-group names like
    Doctype()/Div()/Span() clash with the like-named classes they define.
  -->
  <PropertyGroup>
    <!--
      Every condition below is keyed off THIS rather than $(MSBuildProjectName), so that a project's
      prerender companion is treated as the project it compiles.

      <RaskPrerender> generates `obj/rask-prerender/{App}.Prerender.csproj` out of the app's own sources
      and builds it under this same Directory.Build.props. When the conditions here were keyed off the
      raw project name, a by-name exclusion spared the app and not its `.Prerender` companion, so the
      companion was handed `global using Rask.Validation.*;` for packages the app deliberately does not
      reference and failed to compile with CS0234 before rendering a single page. The companion must
      see exactly what the app sees.
    -->
    <_RaskUsingsName>$(MSBuildProjectName)</_RaskUsingsName>
    <_RaskUsingsName Condition=" $(MSBuildProjectName.EndsWith('.Prerender')) ">$(MSBuildProjectName.Substring(0, $([MSBuild]::Subtract($(MSBuildProjectName.Length), 10))))</_RaskUsingsName>

    <!-- The published site (src/Rask.Site) and its test project want the consumer usings: it is the
         app they were written for, and it renders C# components on the WASM host. Matched by prefix so
         Rask.Site.Tests comes along; _RaskUsingsName has already stripped '.Prerender', so the prerender
         companion resolves through this same line rather than needing one of its own.

         A missing entry here does not read as a missing property — it reads as several hundred CS0246s
         in a tree that was only moved, which is a long way from the one line that caused it.

         NOT the E2E suite, and that exclusion is the whole reason this is not a bare prefix any more.
         The browser suite was Rask.Examples.E2E.Tests until every project took its area's name;
         renaming it to Rask.Site.E2E.Tests made it match this prefix for the first time, and it
         promptly failed to compile with CS0234 on Rask.Core, Rask.Cqrs and Rask.Validation —
         assemblies it does not reference and should not, because it drives a PUBLISHED BUNDLE over
         HTTP and never renders a C# component. A prefix condition is a name-shaped assumption, and
         this is what it costs when the names change. -->
    <_RaskInRepoImplicitUsings>false</_RaskInRepoImplicitUsings>
    <_RaskInRepoImplicitUsings Condition=" $(_RaskUsingsName.StartsWith('Rask.Site')) AND !$(_RaskUsingsName.Contains('.E2E')) ">true</_RaskInRepoImplicitUsings>

    <!--
      FluentValidation and Rask.Cqrs each inject their own global using (imported below). A downstream
      consumer gets those from the NuGet package's build/*.props; an in-repo ProjectReference does not,
      so they are imported by hand for the projects that actually reference the libraries.
      DataAnnotations is NOT in here any more — it moved into Rask.Core, which every host already
      carries, so there is no package to reference and no using to inject.

      Both are keyed to the same set as the consumer usings today, because src/Rask.Site references
      both. They stay separate properties rather than collapsing into _RaskInRepoImplicitUsings: an
      in-repo app that drops either ProjectReference has to be able to drop the using with it, and a
      global using naming an assembly the project does not have is a CS0246 with no obvious cause.

      The DB-backed pillars (Rask.Data, Outbox, Jobs, Mail, Cache, Logging) had a third property here
      that only the Shop sample set. Nothing in the repo references them by project any more, so it
      could never be true and its six imports could never fire; they are gone rather than left as
      machinery that reads like it does something.
    -->
    <_RaskInRepoValidationUsings>$(_RaskInRepoImplicitUsings)</_RaskInRepoValidationUsings>
    <_RaskInRepoCqrsUsings>$(_RaskInRepoImplicitUsings)</_RaskInRepoCqrsUsings>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Server\build\Rask.Server.props"
          Condition=" '$(_RaskInRepoImplicitUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Server\build\Rask.Server.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Wasm\build\Rask.Wasm.props"
          Condition=" '$(_RaskInRepoImplicitUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Wasm\build\Rask.Wasm.props') "/>
  <!-- Knobs only (defaults for the front-end build), so unlike the implicit-usings props above this one
       is imported everywhere: the matching .targets reads these defaults, and a consumer gets both
       automatically from the package's build/ folder. -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Spa.Hosting\build\Rask.Spa.Hosting.props"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Spa.Hosting\build\Rask.Spa.Hosting.props') "/>
  <!-- Knobs only again, and the quietest of the three: the meta targets do nothing at all unless a
       project sets RaskMetaFramework, so this is inert in every project in the repo. It also declares RaskEmitTypeScript compiler-visible, which is what makes the CQRS
       generator project a meta host's message records into TypeScript. -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Meta.Hosting\build\Rask.Meta.Hosting.props"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Meta.Hosting\build\Rask.Meta.Hosting.props') "/>
  <!-- Same reasoning: knobs only. The island targets gate their own work on the project having a
       package.json, so this is inert in every project that has no front-end file. -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.External\build\Rask.External.props"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.External\build\Rask.External.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Validation.FluentValidation\build\Rask.Validation.FluentValidation.props"
          Condition=" '$(_RaskInRepoValidationUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Validation.FluentValidation\build\Rask.Validation.FluentValidation.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Cqrs\build\Rask.Cqrs.props"
          Condition=" '$(_RaskInRepoCqrsUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Cqrs\build\Rask.Cqrs.props') "/>

  <!--
    The Tailwind defaults, for every project in the repo. Unconditional (unlike the battery usings
    above) because they are only defaults: a project with no Styles/app.css never runs the compiler,
    so the properties simply go unused.
  -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Tailwind\build\Rask.Tailwind.props"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Tailwind\build\Rask.Tailwind.props') "/>

</Project>
