<Project>

  <PropertyGroup>
    <Authors>Tamás Pál</Authors>
    <Company>Tamás Pál</Company>
    <Copyright>© Tamás Pál</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- A concise, nuget.org-friendly README (absolute image/link URLs); the 75KB root
         README with relative links does not render well on the gallery. -->
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <!-- Square gallery/IDE icon (NuGet rejects SVG, so a PNG derived from assets/rask-icon.svg).
         Packed for every packable project by the IsPackable ItemGroup below. -->
    <PackageIcon>rask-icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/pal-tamas/rask</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pal-tamas/rask.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>web component framework wasm net10</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!--
    Code-quality gate (enforced by the rask-ship skill, codified here so a plain `dotnet build`
    enforces it too): .NET analyzers on, code-style run in-build, warnings are errors. The repo
    builds clean today — keep it that way. Only Roslyn compiler/analyzer warnings escalate;
    MSBuild-engine warnings (e.g. the transient MSB3026 copy-retry under parallel build) do not.
    Code-style severities come from .editorconfig (suggestions stay suggestions, not errors).
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Emit the XML doc file so the public API's /// comments reach consumer IntelliSense (tooltips,
      parameter hints) via the NuGet package. Only framework/library projects need it — test,
      benchmark, and sample projects are never consumed as packages, so generating (and validating)
      their doc comments is pure noise. CS1591 (missing XML comment on a public member) is suppressed
      rather than escalated: we ship the docs we have without forcing a full-coverage documentation
      sweep across every public member under warnings-as-errors.
    -->
    <GenerateDocumentationFile Condition=" !$(MSBuildProjectName.EndsWith('.Tests')) AND !$(MSBuildProjectName.StartsWith('Rask.Benchmarks')) AND !$(MSBuildProjectName.StartsWith('Rask.Example')) ">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!--
    AnalysisLevel stays at the SDK default mode: the repo builds clean there, so warnings-as-errors
    locks in that clean state. Raising it (e.g. <AnalysisLevel>latest-recommended</AnalysisLevel>)
    surfaces ~33 extra CA findings — some worth doing (CA1305/CA1865/CA1859), some that clash with
    the documented hot-path design (CA1051 on RenderFrame's deliberately-public fields). Promote the
    level in a focused PR that fixes/justifies each finding with benchmark evidence — not here.
  -->

  <ItemGroup Condition=" '$(IsPackable)' != 'false' ">
    <None Include="$(MSBuildThisFileDirectory)NUGET.md" Pack="true" PackagePath="" Visible="false"/>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false"/>
    <None Include="$(MSBuildThisFileDirectory)assets\rask-icon.png" Pack="true" PackagePath="" Visible="false"/>
  </ItemGroup>

  <ItemGroup Condition=" '$(IsPackable)' != 'false' ">
    <PackageReference Include="MinVer" PrivateAssets="all"/>
  </ItemGroup>

  <!--
    In-repo auto-import for Rask implicit-usings props. Only the Rask.Example.*
    and Rask.Examples.* projects opt in — they're the in-repo stand-ins for
    downstream consumers, who pick up the same <Using> items via NuGet's auto-
    import of build/$(PackageId).props. Framework projects (Rask.Core, Rask.Server,
    Rask.Wasm, etc.) deliberately don't get the implicit static usings because
    method-group names like Doctype()/Div()/Span() clash with the like-named
    classes they define.
  -->
  <PropertyGroup>
    <_RaskInRepoImplicitUsings>false</_RaskInRepoImplicitUsings>
    <!-- Rask.Example.Playground.Tests opts OUT of the consumer implicit-usings: unlike the other example
         test projects it references neither the Wasm/Server hosts nor Bootstrap/validation (it links the
         playground's portable compiler sources and references types by name), so the injected global
         usings would fail to resolve. Exclude it by name rather than all '.Tests' (Shared.Tests /
         Server.Tests do want the usings and reference the libs that back them). -->
    <_RaskInRepoImplicitUsings Condition=" $(MSBuildProjectName.StartsWith('Rask.Example.')) AND '$(MSBuildProjectName)' != 'Rask.Example.Playground.Tests' ">true</_RaskInRepoImplicitUsings>
    <!--
      The validation packages inject their own global usings (Rask.Validation.* below). Downstream
      consumers only get them by referencing the validation NuGet package; in-repo we'd otherwise force
      every Rask.Example.* project to reference the validation libs just to satisfy the generated usings.
      The auth samples (Rask.Example.Auth*) don't use validation, and the EF Core sample
      (Rask.Example.EfCore) uses Rask.Core's inline Validate: lambdas only — so skip those usings for them.
      The Native + Server example (Rask.Example.Native.Server) is a thin native shell over a remote server
      that references neither Rask.Example.Shared nor the validation/Bootstrap libs, so it skips them too.
      The marketing landing site (Rask.Example.Site) is a standalone WASM app (its own hand-styled design,
      no Shared/Bootstrap/validation), so it skips them as well.
    -->
    <_RaskExampleValidationUsings>$(_RaskInRepoImplicitUsings)</_RaskExampleValidationUsings>
    <_RaskExampleValidationUsings Condition=" $(MSBuildProjectName.StartsWith('Rask.Example.Auth')) OR $(MSBuildProjectName.StartsWith('Rask.Example.EfCore')) OR $(MSBuildProjectName.StartsWith('Rask.Example.Sqlite')) OR '$(MSBuildProjectName)' == 'Rask.Example.Native.Server' OR '$(MSBuildProjectName)' == 'Rask.Example.Playground' OR '$(MSBuildProjectName)' == 'Rask.Example.Site' OR $(MSBuildProjectName.StartsWith('Rask.Example.Shop')) ">false</_RaskExampleValidationUsings>
    <!-- The showcase trio (Rask.Example.Shared + the Server/Wasm hosts that reference it) pulls in
         Rask.Bootstrap; the Auth/EfCore standalone samples don't reference it, so they must not get
         its global static usings (the namespace wouldn't resolve). Same set as the validation usings. -->
    <_RaskExampleBootstrapUsings>$(_RaskExampleValidationUsings)</_RaskExampleBootstrapUsings>
    <!-- Shop is the exception to "same set": `rask new` references Rask.Bootstrap (the shell and the
         scaffolded pages use Bs* components) but not the validation packages, so it needs one and not
         the other. -->
    <_RaskExampleBootstrapUsings Condition=" $(MSBuildProjectName.StartsWith('Rask.Example.Shop')) ">true</_RaskExampleBootstrapUsings>
    <!-- The CQRS demo slice lives in the showcase Shared library; the Shop sample (the committed output
         of `rask new`, whose every generated feature handler dispatches through the mediator) is the
         other in-repo example that references Rask.Cqrs. Scope the global `using Rask.Cqrs;` to those. -->
    <_RaskExampleCqrsUsings>false</_RaskExampleCqrsUsings>
    <_RaskExampleCqrsUsings Condition=" '$(MSBuildProjectName)' == 'Rask.Example.Shared' OR $(MSBuildProjectName.StartsWith('Rask.Example.Shop')) ">true</_RaskExampleCqrsUsings>
    <!--
      The Shop sample is the only in-repo example that references the DB-backed pillars. A NuGet consumer
      gets each package's global usings from its build/*.props automatically; an in-repo ProjectReference
      does not, so import them explicitly for that project (and its test project).
    -->
    <_RaskExampleOpfUsings Condition=" $(MSBuildProjectName.StartsWith('Rask.Example.Shop')) ">true</_RaskExampleOpfUsings>
  </PropertyGroup>

  <!--
    Mirrors the framework-vs-consumer split above for the global static usings
    the source generator emits (Rask.Core.Components.Components +
    Rask.Core.Routing.Components + per-namespace Components). Framework and
    in-repo test projects opt out — they reference the Component classes by
    type and would see method/type ambiguity if the factory namespaces were
    globally imported. Rask.Example.* and downstream NuGet consumers get the
    default (true), so writing Div(...)/Counter(...) in the render tree just
    works.
  -->
  <PropertyGroup>
    <RaskGlobalUsings Condition=" '$(RaskGlobalUsings)' == '' AND $(MSBuildProjectName.StartsWith('Rask.')) AND !$(MSBuildProjectName.StartsWith('Rask.Example.')) ">false</RaskGlobalUsings>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Server\build\Rask.Server.props"
          Condition=" '$(_RaskInRepoImplicitUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Server\build\Rask.Server.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Wasm\build\Rask.Wasm.props"
          Condition=" '$(_RaskInRepoImplicitUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Wasm\build\Rask.Wasm.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Validation.DataAnnotations\build\Rask.Validation.DataAnnotations.props"
          Condition=" '$(_RaskExampleValidationUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Validation.DataAnnotations\build\Rask.Validation.DataAnnotations.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Validation.FluentValidation\build\Rask.Validation.FluentValidation.props"
          Condition=" '$(_RaskExampleValidationUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Validation.FluentValidation\build\Rask.Validation.FluentValidation.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Bootstrap\build\Rask.Bootstrap.props"
          Condition=" '$(_RaskExampleBootstrapUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Bootstrap\build\Rask.Bootstrap.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Cqrs\build\Rask.Cqrs.props"
          Condition=" '$(_RaskExampleCqrsUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Cqrs\build\Rask.Cqrs.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Data\build\Rask.Data.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Data\build\Rask.Data.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Outbox\build\Rask.Outbox.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Outbox\build\Rask.Outbox.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Jobs\build\Rask.Jobs.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Jobs\build\Rask.Jobs.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Mail\build\Rask.Mail.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Mail\build\Rask.Mail.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Cache\build\Rask.Cache.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Cache\build\Rask.Cache.props') "/>

</Project>
