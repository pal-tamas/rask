<Project>

  <PropertyGroup>
    <Authors>Tamás Pál</Authors>
    <Company>Tamás Pál</Company>
    <Copyright>© Tamás Pál</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- A concise, nuget.org-friendly README (absolute image/link URLs); the 75KB root
         README with relative links does not render well on the gallery. -->
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <!-- Square gallery/IDE icon (NuGet rejects SVG, so a PNG derived from assets/rask-icon.svg).
         Packed for every packable project by the IsPackable ItemGroup below. -->
    <PackageIcon>rask-icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/pal-tamas/rask</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pal-tamas/rask.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>web component framework wasm net10</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!--
      Pinned at evaluation time, deliberately, and NOT left to MinVer.

      MinVer sets AssemblyVersion from a TARGET (to $(MinVerMajor).0.0.0 — 0.0.0.0 for our 0.x line).
      Hot reload does not run targets: Roslyn's EnC service compiles in-process from the project's
      EVALUATED properties, where MinVer has not run and the SDK falls back to Version 1.0.0 →
      AssemblyVersion 1.0.0.0. So every hot-reload emit disagreed with the assembly already loaded and
      Roslyn refused it outright:

        error CS7038: Failed to emit module 'X': Changing the version of an assembly reference is not
        allowed during debugging: 'Rask.Bootstrap, Version=0.0.0.0' changed version to '1.0.0.0'

      That made the FIRST save of every `rask dev` session on this repo's own samples fail for a reason
      that had nothing to do with the edit — and it would hit any app that project-references Rask.
      Pinning it here makes evaluation and target agree. AssemblyVersion is the binary-compat identity
      and is meant to be stable anyway; the real version still rides on FileVersion/InformationalVersion,
      which MinVer keeps stamping.

      It only ever bit the PACKABLE projects, which is why it survived so long: MinVer is referenced
      under `Condition=" '$(IsPackable)' != 'false' "` below, so an unpackable project reads 1.0.0.0
      both on disk and under EnC and never mismatches. The error named Rask.Bootstrap, never Rask.Core —
      and anyone investigating via Rask.Core sees nothing wrong.

      0.0.0.0 is right only while the major is 0. AssemblyVersionStabilityTests fails when the shipped
      major leaves 0.x, so this gets moved rather than silently understating compatibility at v1.0.0.
    -->
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!--
    Code-quality gate (enforced by the rask-ship skill, codified here so a plain `dotnet build`
    enforces it too): .NET analyzers on, code-style run in-build, warnings are errors. The repo
    builds clean today — keep it that way. Only Roslyn compiler/analyzer warnings escalate;
    MSBuild-engine warnings (e.g. the transient MSB3026 copy-retry under parallel build) do not.
    Code-style severities come from .editorconfig (suggestions stay suggestions, not errors).
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Emit the XML doc file so the public API's /// comments reach consumer IntelliSense (tooltips,
      parameter hints) via the NuGet package. Only framework/library projects need it — test,
      benchmark, and sample projects are never consumed as packages, so generating (and validating)
      their doc comments is pure noise. CS1591 (missing XML comment on a public member) is suppressed
      rather than escalated: we ship the docs we have without forcing a full-coverage documentation
      sweep across every public member under warnings-as-errors.
    -->
    <GenerateDocumentationFile Condition=" !$(MSBuildProjectName.EndsWith('.Tests')) AND !$(MSBuildProjectName.StartsWith('Rask.Benchmarks')) AND !$(MSBuildProjectName.StartsWith('Rask.Example')) ">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!--
    AnalysisLevel stays at the SDK default mode: the repo builds clean there, so warnings-as-errors
    locks in that clean state. Raising it (e.g. <AnalysisLevel>latest-recommended</AnalysisLevel>)
    surfaces ~33 extra CA findings — some worth doing (CA1865/CA1859), some that clash with
    the documented hot-path design (CA1051 on RenderFrame's deliberately-public fields). Promote the
    level in a focused PR that fixes/justifies each finding with benchmark evidence — not here.

    CA1305 (IFormatProvider) has since been promoted on its own, scoped to src/Rask.Core/**, in
    .editorconfig — a single severity line rather than a level bump, so it brought none of the others
    with it. Rask.Core is where wire formats live (reconciliation keys, DOM event payloads, field-path
    indices), and those must stay invariant even when a render runs under a user's culture.
  -->

  <ItemGroup Condition=" '$(IsPackable)' != 'false' ">
    <None Include="$(MSBuildThisFileDirectory)NUGET.md" Pack="true" PackagePath="" Visible="false"/>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false"/>
    <None Include="$(MSBuildThisFileDirectory)assets\rask-icon.png" Pack="true" PackagePath="" Visible="false"/>
  </ItemGroup>

  <ItemGroup Condition=" '$(IsPackable)' != 'false' ">
    <PackageReference Include="MinVer" PrivateAssets="all"/>
  </ItemGroup>

  <!--
    In-repo auto-import for Rask implicit-usings props. Only the Rask.Example.*
    and Rask.Examples.* projects opt in — they're the in-repo stand-ins for
    downstream consumers, who pick up the same <Using> items via NuGet's auto-
    import of build/$(PackageId).props. Framework projects (Rask.Core, Rask.Server,
    Rask.Wasm, etc.) deliberately don't get the implicit static usings because
    method-group names like Doctype()/Div()/Span() clash with the like-named
    classes they define.
  -->
  <PropertyGroup>
    <!--
      Every condition below is keyed off THIS rather than $(MSBuildProjectName), so that a project's
      prerender companion is treated as the project it compiles.

      <RaskPrerender> generates `obj/rask-prerender/{App}.Prerender.csproj` out of the app's own sources
      and builds it under this same Directory.Build.props. Its name starts with `Rask.Example.`, so it
      picked up the in-repo consumer usings — but the by-name EXCLUSIONS below spared `Rask.Example.Site`
      and not `Rask.Example.Site.Prerender`, so the companion was handed `global using
      Rask.Validation.*;` for packages the app deliberately does not reference, and failed to compile
      with CS0234 before rendering a single page. The companion must see exactly what the app sees.
    -->
    <_RaskUsingsName>$(MSBuildProjectName)</_RaskUsingsName>
    <_RaskUsingsName Condition=" $(MSBuildProjectName.EndsWith('.Prerender')) ">$(MSBuildProjectName.Substring(0, $([MSBuild]::Subtract($(MSBuildProjectName.Length), 10))))</_RaskUsingsName>

    <_RaskInRepoImplicitUsings>false</_RaskInRepoImplicitUsings>
    <!-- Rask.Example.Playground.Tests and Rask.Example.Site.Tests opt OUT of the consumer implicit-usings:
         unlike the other example test projects they reference neither the Wasm/Server hosts nor
         Bootstrap/validation (they link portable sources out of a browser-WASM sample and reference types
         by name), so the injected global usings would fail to resolve. Exclude them by name rather than
         all '.Tests' (Shared.Tests / Server.Tests do want the usings and reference the libs that back
         them). Rask.Example.Razor opts out for the same reason from the other side: it is a Razor
         Class Library holding a plain .razor, references no Rask package at all — that is the point of
         it, since a hosted Blazor component knows nothing about Rask — and the injected usings would
         name assemblies it does not have.

         Rask.Example.Meta.* opts out from the same side, and by prefix rather than one name at a
         time because there are six of them: a meta host renders no C# components. It references
         Rask.Cqrs and Rask.Meta.Hosting and nothing else, so the injected Rask.Core / Rask.Html /
         validation usings name assemblies it does not have — the front end is TypeScript, which is
         the entire point of the lane. -->
    <_RaskInRepoImplicitUsings Condition=" $(_RaskUsingsName.StartsWith('Rask.Example.')) AND !$(_RaskUsingsName.StartsWith('Rask.Example.Meta.')) AND '$(_RaskUsingsName)' != 'Rask.Example.Playground.Tests' AND '$(_RaskUsingsName)' != 'Rask.Example.Site.Tests' AND '$(_RaskUsingsName)' != 'Rask.Example.Razor' ">true</_RaskInRepoImplicitUsings>
    <!--
      FluentValidation injects its own global using (Rask.Validation.FluentValidation below). Downstream
      consumers only get it by referencing that NuGet package; in-repo we'd otherwise force every
      Rask.Example.* project to reference the validation lib just to satisfy the generated using.
      DataAnnotations is NOT in here any more — it moved into Rask.Core, which every host already
      carries, so there is no package to reference and no using to inject.
      The auth samples (Rask.Example.Auth*) don't use validation, and the EF Core sample
      (Rask.Example.EfCore) uses Rask.Core's inline Validate: lambdas only — so skip those usings for them.
      The marketing landing site (Rask.Example.Site) is a standalone WASM app (its own hand-styled design,
      no Shared/Bootstrap/validation), so it skips them as well. So does the browser-jobs sample
      (Rask.Example.Wasm.Jobs) — note it must be matched by its exact name, since the showcase it sits
      next to (Rask.Example.Wasm) does want these usings.
    -->
    <_RaskExampleValidationUsings>$(_RaskInRepoImplicitUsings)</_RaskExampleValidationUsings>
    <_RaskExampleValidationUsings Condition=" $(_RaskUsingsName.StartsWith('Rask.Example.Auth')) OR $(_RaskUsingsName.StartsWith('Rask.Example.EfCore')) OR $(_RaskUsingsName.StartsWith('Rask.Example.Sqlite')) OR '$(_RaskUsingsName)' == 'Rask.Example.Playground' OR '$(_RaskUsingsName)' == 'Rask.Example.Site' OR '$(_RaskUsingsName)' == 'Rask.Example.Wasm.Jobs' OR $(_RaskUsingsName.StartsWith('Rask.Example.Shop')) ">false</_RaskExampleValidationUsings>
<!-- The CQRS demo slice lives in the showcase Shared library; the Shop sample (the committed output
         of `rask new`, whose every generated feature handler dispatches through the mediator) is the
         other in-repo example that references Rask.Cqrs. Scope the global `using Rask.Cqrs;` to those. -->
    <_RaskExampleCqrsUsings>false</_RaskExampleCqrsUsings>
    <_RaskExampleCqrsUsings Condition=" '$(_RaskUsingsName)' == 'Rask.Example.Shared' OR $(_RaskUsingsName.StartsWith('Rask.Example.Shop')) ">true</_RaskExampleCqrsUsings>
    <!--
      The Shop sample is the only in-repo example that references the DB-backed pillars. A NuGet consumer
      gets each package's global usings from its build/*.props automatically; an in-repo ProjectReference
      does not, so import them explicitly for that project (and its test project).
    -->
    <_RaskExampleOpfUsings Condition=" $(_RaskUsingsName.StartsWith('Rask.Example.Shop')) ">true</_RaskExampleOpfUsings>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Server\build\Rask.Server.props"
          Condition=" '$(_RaskInRepoImplicitUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Server\build\Rask.Server.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Wasm\build\Rask.Wasm.props"
          Condition=" '$(_RaskInRepoImplicitUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Wasm\build\Rask.Wasm.props') "/>
  <!-- Knobs only (defaults for the front-end build), so unlike the implicit-usings props above this one
       is imported everywhere: the matching .targets reads these defaults, and a consumer gets both
       automatically from the package's build/ folder. -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Spa.Hosting\build\Rask.Spa.Hosting.props"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Spa.Hosting\build\Rask.Spa.Hosting.props') "/>
  <!-- Knobs only again, and the quietest of the three: the meta targets do nothing at all unless a
       project sets RaskMetaFramework, so this is inert in every project in the repo but the meta
       samples. It also declares RaskEmitTypeScript compiler-visible, which is what makes the CQRS
       generator project a meta host's message records into TypeScript. -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Meta.Hosting\build\Rask.Meta.Hosting.props"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Meta.Hosting\build\Rask.Meta.Hosting.props') "/>
  <!-- Same reasoning: knobs only. The island targets gate their own work on the project having a
       package.json, so this is inert in every project that has no front-end file. -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.External\build\Rask.External.props"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.External\build\Rask.External.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Validation.FluentValidation\build\Rask.Validation.FluentValidation.props"
          Condition=" '$(_RaskExampleValidationUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Validation.FluentValidation\build\Rask.Validation.FluentValidation.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Cqrs\build\Rask.Cqrs.props"
          Condition=" '$(_RaskExampleCqrsUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Cqrs\build\Rask.Cqrs.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Data\build\Rask.Data.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Data\build\Rask.Data.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Outbox\build\Rask.Outbox.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Outbox\build\Rask.Outbox.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Jobs\build\Rask.Jobs.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Jobs\build\Rask.Jobs.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Mail\build\Rask.Mail.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Mail\build\Rask.Mail.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Cache\build\Rask.Cache.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Cache\build\Rask.Cache.props') "/>
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Logging\build\Rask.Logging.props"
          Condition=" '$(_RaskExampleOpfUsings)' == 'true' AND Exists('$(MSBuildThisFileDirectory)src\Rask.Logging\build\Rask.Logging.props') "/>

  <!--
    The Tailwind defaults, for every project in the repo. Unconditional (unlike the battery usings
    above) because they are only defaults: a project with no Styles/app.css never runs the compiler,
    so the properties simply go unused.
  -->
  <Import Project="$(MSBuildThisFileDirectory)src\Rask.Tailwind\build\Rask.Tailwind.props"
          Condition=" Exists('$(MSBuildThisFileDirectory)src\Rask.Tailwind\build\Rask.Tailwind.props') "/>

</Project>
