<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The tag family lives in Rask.Html now; this project names tags unqualified. -->

    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet needs Release builds; this project is hand-run, not part of `dotnet test`. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!--
      CS0436: our private IgnoresAccessChecksToAttribute (Infrastructure/IgnoresAccessChecks.cs)
              conflicts with the runtime-internal declaration in System.Runtime.CompilerServices.
              The runtime honours either declaration; the warning is noise.
      CS0618: Microsoft.AspNetCore.Components.RenderTree.Renderer carries Obsolete[ messages
              warning non-framework code away from inheriting it. Benchmarks deliberately do.
      BL0006: Blazor analyzer that fires on use of low-level RenderTree APIs. Intentional here.
      RASK022: these benchmarks deliberately render keyless lists to measure the raw render
               hot path against Blazor's equally-keyless BuildRenderTree. Adding Key: would
               add per-row key handling and skew the comparison — keep them keyless on purpose.
    -->
    <NoWarn>$(NoWarn);0436;0618;BL0006;RASK022</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Copied to the output dir so the payload-bytes regression check reads the committed baseline at
         runtime regardless of the working directory (resolved from AppContext.BaseDirectory in CI). -->
    <None Include="Baselines\vs-blazor-payload-bytes.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.App carries Microsoft.AspNetCore.Components{,.Web,.Server} as part of
      the shared framework. Same pattern as Rask.Server / Rask.Wasm.Hosting use to pick up the
      WebSocket / static-file stack. The Blazor side of the comparison renders via HtmlRenderer
      and Renderer subclasses out of these assemblies.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
