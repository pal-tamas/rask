<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- A load harness, not a BenchmarkDotNet suite: it drives sustained concurrent load and reports
         throughput, tail latency and error rates, which BDN does not measure. Release only, hand-run.
         Split out of Rask.Benchmarks (as Rask.Benchmarks.VsBlazor is) because it needs EF Core, which that
         project should not carry, and because a minutes-long soak has no place in a filtered BDN sweep. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.SQLite\Rask.SQLite.csproj"/>
    <ProjectReference Include="..\..\src\Rask.SQLite.EntityFrameworkCore\Rask.SQLite.EntityFrameworkCore.csproj"/>
  </ItemGroup>

</Project>
