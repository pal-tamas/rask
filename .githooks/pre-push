#!/usr/bin/env bash
# Pre-push gate: the attribution guard, then the unit suite scoped to this push.
#
# HARD BUDGET: under a minute, the same one .githooks/pre-commit runs to. That budget is the whole
# design of this file. Every gate that could not fit moved out — the browser E2E, the CLI build gate,
# watch, deploy, meta publish and the installer are now run by hand (scripts/run-all-gates.sh runs the
# set), and the benchmark byte-gates run only when you ask for them. The list and the
# reasons are repeated at the gate itself, and printed on every push, so nobody has to read this file
# to learn what is no longer covered.
#
# Enable the hooks once with:  git config core.hooksPath .githooks
# Bypass:  git push --no-verify
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

# --- Attribution guard (cheap, and first) ------------------------------------
#
# .githooks/commit-msg already rejects Co-authored-by / Generated-with footers at
# commit time — but ONLY when core.hooksPath is set. A fresh clone that never ran
# that config, or an agent committing in a new worktree, bypasses it in silence.
# That is exactly how two AI trailers reached main and put two extra accounts on
# GitHub's contributor list, which counts co-authors and not just authors. Taking
# them back off cost a rewrite of all 970 commits and a force-push of main plus
# 18 release tags.
#
# So the rule is re-checked here, against the commits actually being pushed. This
# is the last boundary at which the fix is still free: one line, one amend.
# shellcheck source=../scripts/lib/attribution.sh
. "$root/scripts/lib/attribution.sh"

zero="0000000000000000000000000000000000000000"
offending=""

# git feeds the hook "<local ref> <local sha> <remote ref> <remote sha>" per ref, ON STDIN, and stdin
# can only be read once. It is captured here because two things now need it: the attribution guard
# below, and the deletion check after it. Reading it inline in the loop — which is what this did —
# left nothing for a second reader, so any later question about what is being pushed had to be
# answered by guessing.
push_refs="$(cat)"

pushes_content=0

# shellcheck disable=SC2086
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue          # the empty line a here-string appends
  [ "$local_sha" = "$zero" ] && continue   # branch deletion — nothing to inspect
  pushes_content=1

  if [ "$remote_sha" = "$zero" ]; then
    # New branch: everything on it that no remote already has.
    range_args="$local_sha --not --remotes"
  else
    range_args="$remote_sha..$local_sha"
  fi

  # shellcheck disable=SC2086  # range_args is deliberately word-split into rev-list
  for sha in $(git rev-list $range_args); do
    if git log -1 --format=%B "$sha" | rask_message_has_attribution; then
      offending="$offending$(git log -1 --format='  %h %s' "$sha")
"
    fi
  done
done <<EOF
$push_refs
EOF

if [ -n "$offending" ]; then
  cat >&2 <<EOF
✖ pre-push: these commits carry an attribution trailer:

$offending
  This repository credits a single contributor. GitHub counts Co-authored-by
  trailers toward the contributor list, so pushing these adds accounts that only
  a full history rewrite can remove.

  Fix with:  git rebase -i --exec 'git commit --amend --no-edit' <base>
  or, for the tip commit:  git commit --amend

  Install the commit-time guard so this never reaches push again:
      git config core.hooksPath .githooks
EOF
  exit 1
fi
# -----------------------------------------------------------------------------

# --- Deletion-only pushes run nothing ----------------------------------------
#
# `git push origin --delete <branch>` sends one ref line whose LOCAL sha is all zeroes: no commit
# reaches the remote, no tree changes, and there is nothing a build or a browser journey could have
# an opinion about. The hook ran the whole gate on it anyway — the full browser E2E suite, both
# payload-bytes baselines and the capacity smokes — because every gate below is written in terms of
# "is this push path-relevant", and a deletion matches those filters the same way any other push does.
#
# Found by deleting a merged branch and watching ~40 minutes of browser suite start up behind it. The
# attribution loop above had the right idea all along (`local_sha = $zero` -> nothing to inspect); it
# just kept the conclusion to itself.
#
# Only when EVERY ref is a deletion. A push that deletes one branch and updates another still has
# content on it, and that content gets the gate.
if [ "$pushes_content" -eq 0 ]; then
  echo "pre-push: every ref in this push is a DELETION — no commits reach the remote, so there is"
  echo "          nothing to build or test. Skipping the gates."
  exit 0
fi
# -----------------------------------------------------------------------------

# --- The unit gate, scoped to this push -------------------------------------
#
# ONE gate now, and a hard budget: this hook must finish in under a minute, the same budget
# .githooks/pre-commit runs to. Everything that could not fit has moved, and where it went is spelled
# out below rather than left for someone to discover.
#
# What runs: the unit/integration suite, scoped to the projects THIS PUSH can reach.
# scripts/run-unit-local.sh does the scoping (scripts/lib/affected_projects.py owns the graph) and
# falls back to the whole solution for anything it cannot map precisely.
#
# The range is origin/main...HEAD, not the tip commit. A push is many commits, and scoping to the last
# one would leave a file changed earlier in the same push untested — the exact shape of gap this hook
# exists to prevent.
#
# WHAT THIS HOOK NO LONGER RUNS, and where it went:
#
#   * The browser E2E journeys   -> scripts/run-e2e-local.sh          (run it by hand)
#   * The benchmark byte-gates   -> scripts/run-benchmarks-local.sh   (ONLY when you ask; no hook,
#                                                                     no CI, not in run-all-gates)
#   * The CLI build gate         -> scripts/run-cli-build-e2e.sh      (run it by hand)
#   * The watch hot-reload gate  -> scripts/run-watch-e2e.sh          (run it by hand)
#   * The deploy gate            -> scripts/run-deploy-e2e-local.sh   (run it by hand)
#   * The meta publish gate      -> scripts/run-meta-publish-e2e.sh   (run it by hand)
#   * The installer gate         -> scripts/run-install-e2e-local.sh  (run it by hand)
#
# Be clear about the cost of that: NONE of those run automatically any more. The browser suite in
# particular has caught most of the false greens in this repository's casebook, and it cannot fit in a
# minute — its first step is `dotnet publish src/Rask.Site -c Release`, a WASM bundle, before Chromium
# even opens. `scripts/run-all-gates.sh` runs the whole set when you want the old guarantee back;
# before a release, run it.
if [ "${RASK_SKIP_UNIT:-}" = "1" ]; then
  echo "pre-push: RASK_SKIP_UNIT=1 set — skipping the unit gate."
else
  set +e
  RASK_TEST_SCOPE=affected \
  RASK_SCOPE_RANGE="origin/main...HEAD" \
  "$root/scripts/run-unit-local.sh"
  unit_status=$?
  set -e

  if [ "$unit_status" -ne 0 ]; then
    echo >&2
    echo "pre-push: the unit gate FAILED — push aborted." >&2
    echo "          Fix it, or bypass with 'git push --no-verify' or RASK_SKIP_UNIT=1." >&2
    # A flat 1, not the gate's own status. `dotnet test` and a missing script report different
    # non-zero codes (1 vs 127), and a hook that leaks those makes "did the gate fail or did it fail
    # to RUN?" indistinguishable to anything scripting around it.
    exit 1
  fi
fi

# Said on every push, deliberately. A gate that quietly stopped covering something is this
# repository's most expensive recurring failure, and the fix for it is not silence.
echo
echo "pre-push: unit gate passed. NOT run here (see .githooks/pre-push for why):"
echo "          browser E2E · CLI build · watch · deploy · meta publish · installer."
echo "          Benchmarks run ONLY on request: scripts/run-benchmarks-local.sh"
echo "          Run the full set with: scripts/run-all-gates.sh"
