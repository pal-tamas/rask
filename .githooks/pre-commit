#!/usr/bin/env bash
# Pre-commit: seconds, never minutes. The format check, the warnings-as-errors build and the unit
# suite run in CI on every push (.github/workflows/ci.yml), not here.
#
# They used to run here, scoped and budgeted to a minute — a budget that only held on an idle
# machine. With several worktrees committing at once each gate shrank to two cores and took ten
# minutes and more, so the gate that was meant to be cheap became the thing everyone waited for.
# CI is free for a public repository and nobody waits on it.
#
# What is left is what costs under a second and is published the moment it lands.
# Enable once with:  git config core.hooksPath .githooks  (commit-msg + pre-commit + pre-push)
# Bypass with 'git commit --no-verify'. The full local gate is still scripts/run-unit-local.sh.
set -euo pipefail

# The Counter sample is written on three front doors — README.md, NUGET.md and the site hero — and
# scripts/tests/front-doors.test.sh is the only thing pinning them to each other. CI runs it too
# (through scripts/run-unit-local.sh), but a front door that disagrees with the other two is live on
# GitHub and nuget.org as soon as it is pushed, so the two root files are checked here as well.
#
# `grep -E … >/dev/null`, never `grep -q`: with `set -o pipefail`, `-q` exits on the first match, git
# takes SIGPIPE writing the rest, and a large staged change reads as "no match".
front_doors='^(README\.md|NUGET\.md)$'

if git diff --cached --name-only | grep -E "$front_doors" >/dev/null; then
  fd_root="$(git rev-parse --show-toplevel)"
  if [ -x "$fd_root/scripts/tests/front-doors.test.sh" ] \
     && ! "$fd_root/scripts/tests/front-doors.test.sh"; then
    echo "pre-commit: the Counter sample differs between its front doors — see above." >&2
    exit 1
  fi
fi
