#!/usr/bin/env bash
# Pre-commit gate: enforce formatting (dotnet format) and the local unit/integration suite before a
# code commit.
#
# Both were moved OUT of CI — they run locally instead, and this hook enforces them on commit.
# Enable it once with:  git config core.hooksPath .githooks  (installs commit-msg + pre-commit + pre-push)
#
# Runs ONLY when the staged change touches code (src/, tests/, benchmarks/, Rask.slnx, Directory.*), so
# docs-only / workflow-only commits stay fast. Bypass any commit with 'git commit --no-verify' or
# RASK_SKIP_UNIT=1.
set -euo pipefail

if [ "${RASK_SKIP_UNIT:-}" = "1" ]; then
  echo "pre-commit: RASK_SKIP_UNIT=1 set — skipping the local format + unit gate."
  exit 0
fi

if ! git diff --cached --name-only | grep -qE '^(src/|tests/|benchmarks/|Rask\.slnx$|Directory\.)'; then
  echo "pre-commit: no code changes staged — skipping the format + unit gate."
  exit 0
fi

root="$(git rev-parse --show-toplevel)"

echo "pre-commit: running the local format + unit gate (staged code changes detected)."
echo "            build -> dotnet format whitespace --verify-no-changes -> tests. bypass with"
echo "            'git commit --no-verify' or RASK_SKIP_UNIT=1."
if ! "$root/scripts/run-unit-local.sh"; then
  echo "pre-commit: format + unit gate FAILED — commit aborted. Fix it (e.g. 'dotnet format whitespace" >&2
  echo "            Rask.slnx' then restage), or bypass with --no-verify." >&2
  exit 1
fi
