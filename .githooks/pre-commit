#!/usr/bin/env bash
# Pre-commit gate: enforce formatting (dotnet format) and the local unit/integration suite before a
# code commit.
#
# Both were moved OUT of CI — they run locally instead, and this hook enforces them on commit.
# Enable it once with:  git config core.hooksPath .githooks  (installs commit-msg + pre-commit + pre-push)
#
# Runs ONLY when the staged change touches code (src/, tests/, benchmarks/, Rask.slnx, Directory.*), so
# docs-only / workflow-only commits stay fast. Bypass any commit with 'git commit --no-verify' or
# RASK_SKIP_UNIT=1.
set -euo pipefail

if [ "${RASK_SKIP_UNIT:-}" = "1" ]; then
  echo "pre-commit: RASK_SKIP_UNIT=1 set — skipping the local format + unit gate."
  exit 0
fi

# `grep -E … >/dev/null`, never `grep -q`. With `set -o pipefail`, `-q` makes the gate skip PRECISELY
# when there is most to check: grep exits on the first match, git takes SIGPIPE writing the rest, and the
# pipeline reports failure — so a large staged change reads as "no code changes" and sails through
# unchecked, while a small one gates normally. It let a 421-file commit touching all of src/ past.
#
# samples/ and docs/ are in here for the same reason src/ is: the suite genuinely gates them.
#
#   samples/ is compiled, analyzer-checked, warnings-as-errors code with its own test projects. More than
#   that, Rask.Example.Shared.Tests compiles samples/Rask.Example.Shared and owns DemoMarkup.golden.txt —
#   so a samples-only commit could break a committed golden with nothing objecting.
#
#   docs/ is an input to the tests, not just prose: DocsIndexTests walks docs/**/*.md on disk for
#   reachability from docs/README.md, and GuidesTests holds the GuideCatalog parity guard in both
#   directions. A new page committed on its own skipped exactly the checks written to catch it.
#
# Leaving these out meant a whole feature could land ungated — the playground tutorial was largely a
# samples/ + docs/ change, and reported "no code changes staged".
if ! git diff --cached --name-only | grep -E '^(src/|samples/|docs/|tests/|benchmarks/|Rask\.slnx$|Directory\.)' >/dev/null; then
  echo "pre-commit: no code changes staged — skipping the format + unit gate."
  exit 0
fi

root="$(git rev-parse --show-toplevel)"

echo "pre-commit: running the local format + unit gate (staged code changes detected)."
echo "            build -> dotnet format --verify-no-changes -> tests. bypass with"
echo "            'git commit --no-verify' or RASK_SKIP_UNIT=1."
if ! "$root/scripts/run-unit-local.sh"; then
  echo "pre-commit: format + unit gate FAILED — commit aborted. Fix it (e.g. 'dotnet format Rask.slnx'" >&2
  echo "            then restage), or bypass with --no-verify." >&2
  exit 1
fi
