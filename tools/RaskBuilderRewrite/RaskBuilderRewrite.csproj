<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stage E's migration tool: rewrites `Foo(A: x, B: y)[…]` into `Foo.A(x).B(y)[…]` against the REAL
    generated factory signatures. Deliberately outside Rask.slnx — it is a repo tool, not shipped code,
    and building it as part of the solution would put a Roslyn dependency in every gate for no gain.

    Run it with:  dotnet run (project tools/RaskBuilderRewrite) passing a project path and, to write,
    the apply switch. Program.cs documents the argument list.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RaskGlobalUsings>false</RaskGlobalUsings>
    <RootNamespace>Rask.Tools.BuilderRewrite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
  </ItemGroup>

</Project>
