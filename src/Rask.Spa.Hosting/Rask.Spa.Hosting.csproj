<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rask.Spa.Hosting</RootNamespace>

    <PackageId>Rask.Spa.Hosting</PackageId>
    <Title>Rask — Single-Page App Host</Title>
    <Description>ASP.NET Core host for a built single-page app: a front end from any bundler (React, Vue, Angular) or a Rask WebAssembly app written in C#. `app.MapRaskSpa()` serves the build output with correct MIME types, cache headers that follow what the build guarantees, precompressed siblings and a SPA fallback that still 404s a missing asset. The build runs the front end's own `npm ci` and `npm run build` and publishes the bundle beside the app; a referenced WebAssembly client is published by the build and served with hot reload under `rask dev`. Depends on nothing else in Rask.</Description>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <!-- SpaHostingOptions binds Rask:Spa. The configuration binding source generator writes that bind at
       compile time, so no reflection binder runs; the SDK leaves it off unless a project asks. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!--
    Deliberately no reference to Rask.Core or Rask.Wasm. Serving a build output needs neither: a
    WebAssembly bundle's scoped assets are files the publish already baked, so this host has no
    Component to load and no registry to fill — and staying free of them is what lets this package
    serve a plain ASP.NET app too, exactly as Rask.Cqrs.Server does. The one consequence is that
    RaskPath.Normalize is out of reach, so SpaPath carries its own copy.
  -->

  <ItemGroup>
    <!--
      Serving details and the host defaults shared with Rask.Server,
      source-linked rather than referenced: the hosts must not depend on each other. Same arrangement
      as src/Rask.Generators.Shared.
    -->
    <Compile Include="..\Rask.Hosting.Shared\*.cs" Link="Shared\%(Filename)%(Extension)"/>
  </ItemGroup>

  <ItemGroup>
    <!-- An app VS Code's F5 launched starts the bundler's dev server itself (SpaDevServer). Named file by file:
         the rest of Rask.Hosting.Shared\Dev is the .test dev host, which this lane never serves on. -->
    <Compile Include="..\Rask.Hosting.Shared\Dev\EditorDevSession.cs" Link="Shared\Dev\EditorDevSession.cs"/>
    <Compile Include="..\Rask.Hosting.Shared\Dev\DevScript.cs" Link="Shared\Dev\DevScript.cs"/>
    <Compile Include="..\Rask.Hosting.Shared\Dev\DevServerProcess.cs" Link="Shared\Dev\DevServerProcess.cs"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Spa.Hosting.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
    <None Include="build\**" Pack="true" PackagePath="buildTransitive\%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>

</Project>
