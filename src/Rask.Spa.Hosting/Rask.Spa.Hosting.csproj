<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rask.Spa.Hosting</RootNamespace>

    <!--
      client/client.ts and client/query.ts are package CONTENT — vendored into a consumer's bundler
      project and compiled by their toolchain, never by ours. Without this they would be treated as
      scoped component assets: compiled into obj/ and then reported as orphans (RASK017), because
      there is no Component named `client` beside them.

      A property rather than an <_RaskScopedTs Remove="…"/>, because this project body is evaluated
      before Directory.Build.targets imports Rask.Core.targets, so there is no item list here yet to
      remove anything from.
    -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>

    <PackageId>Rask.Spa.Hosting</PackageId>
    <Title>Rask — TypeScript Single-Page App Host</Title>
    <Description>ASP.NET host for a built TypeScript single-page app — React, Vue, Angular, whichever bundler. `app.UseRaskSpa()` serves the bundler's dist/ with correct MIME types, bundler-aware cache headers, precompressed siblings and a SPA fallback that still 404s a missing asset. Pairs with Rask.Cqrs.Server, which gives the client a typed JSON wire and generates its TypeScript from your C# message records; a client that is not TypeScript is refused at build time rather than served half a guarantee. Depends on nothing else in Rask.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <!--
    Deliberately no reference to Rask.Core, Rask.Html or Rask.Wasm. A TypeScript SPA has no Component, no
    scoped assets and no live session, so there is nothing to depend on — and staying free of them is
    what lets this package serve a plain ASP.NET app too, exactly as Rask.Cqrs.Server does. The one
    consequence is that RaskPath.Normalize is out of reach, so SpaPath carries its own copy.
  -->

  <ItemGroup>
    <!--
      Serving details shared with Rask.Wasm.Hosting, source-linked rather than referenced: the two
      hosts must not depend on each other. Same arrangement as src/Rask.Generators.Shared.
    -->
    <Compile Include="..\Rask.Hosting.Shared\*.cs" Link="Shared\%(Filename)%(Extension)"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      Build-order-only edge to the MSBuild task project, which drops Rask.Spa.Tasks.dll into build/
      here (CopyTaskAssemblyToHostingBuildFolders) for <UsingTask> to load and for the build\** Pack glob to
      collect. The DLL is a generated artifact, gitignored rather than committed, so this reference is
      what guarantees it exists before this project builds or packs. ReferenceOutputAssembly="false"
      keeps it purely an ordering edge — no compile reference, no nupkg dependency, and no cross-TFM
      (net10.0 vs netstandard2.0) compatibility check. Same arrangement as Rask.Wasm/Rask.Wasm.Tasks.
    -->
    <ProjectReference Include="..\Rask.Spa.Tasks\Rask.Spa.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Spa.Hosting.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      The generated task assembly is named EXPLICITLY, and excluded from the glob beside it, because
      a glob is expanded at project EVALUATION — before any target runs, including the build of the
      ProjectReference above that produces this DLL. On a tree where it is not already on disk the
      glob matches nothing, and `dotnet pack` then SUCCEEDS and ships a package whose <UsingTask>
      points at a file that is not in it; the consumer fails with MSB4062, and a second pack on the
      same machine is correct because the first build left the DLL behind (#852).

      A literal Include needs the file only when the item is copied, which is after the reference has
      built — so the DLL is collected, and if it is ever genuinely missing the pack FAILS instead of
      quietly shipping without it. That is the real repair: the failure mode stops being silent.

      The glob stays for build/*.props and build/*.targets, which are committed and so cannot be
      missing at evaluation — keeping it means a new committed import still ships without anyone
      remembering to list it.
    -->
    <None Include="build\**" Exclude="build\Rask.Spa.Tasks.dll" Pack="true" PackagePath="build\"/>
    <None Include="build\Rask.Spa.Tasks.dll" Pack="true" PackagePath="build\"/>
    <!--
      The TypeScript client, shipped as source the way Rask.Wasm ships Browser/main.js. It is written
      into a scaffolded client by `rask new` and refreshed on build while its header line is intact,
      so upgrading the package upgrades the client. Not published to npm: that would mean a second
      release train to keep wire-locked to this one, for ~400 lines.
    -->
    <None Include="client\**" Pack="true" PackagePath="client\"/>
    <!--
      The browser layer, packed FROM Rask.Core rather than copied into this project, so there is one
      source of truth for code two very different consumers run: Rask's own Server and WASM clients
      bundle it through Resources/browser/globals.ts, and a TypeScript front end imports these same
      files. A copy here would be a second implementation of the WebAuthn base64url dance and the
      push subscription's flat-vs-nested shape, and the two would drift.

      Packing across a directory boundary rather than taking a ProjectReference is deliberate: this
      package depends on nothing else in Rask (see the header), and reaching for source at pack time
      does not change that — the same reach the host projects' esbuild targets already make.

      globals.ts is excluded. It exists to publish the window.__rask* namespaces that .NET resolves
      dotted identifiers against; a front end imports the modules and has no use for it.
    -->
    <None Include="..\Rask.Core\Resources\browser\*.ts"
          Exclude="..\Rask.Core\Resources\browser\globals.ts"
          Pack="true"
          PackagePath="client\browser\"/>
  </ItemGroup>

</Project>
