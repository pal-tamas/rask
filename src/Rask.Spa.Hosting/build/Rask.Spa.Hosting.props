<Project>

  <!--
    Consumer-facing knobs for Rask.Spa.Hosting's build. Override in your host project, or with -p:.
    Knobs only, so this file is harmless to import into a project that serves no WebAssembly client.
  -->
  <PropertyGroup>
    <!--
      Whether a referenced Rask WebAssembly client is published before this project builds. False skips the
      publish, and the host serves the client's build output instead — which is the only way hot reload can
      reach the browser, since a published bundle is trimmed.

      RaskDevSession is that dev session: ONE switch, passed by `rask dev` and by the scaffolded VS Code build
      task alike, that each Rask package expands into what it needs. An explicit RaskSpaBuild still wins.
    -->
    <RaskSpaBuild Condition="'$(RaskSpaBuild)' == '' AND '$(RaskDevSession)' == 'true'">false</RaskSpaBuild>
    <RaskSpaBuild Condition="'$(RaskSpaBuild)' == ''">true</RaskSpaBuild>

    <!-- Where the published client is copied inside the publish output, and the first place MapRaskSpa
         looks at runtime. Change it only if the host already owns a wwwroot of its own. -->
    <RaskSpaPublishDir Condition="'$(RaskSpaPublishDir)' == ''">wwwroot</RaskSpaPublishDir>
  </PropertyGroup>

</Project>
