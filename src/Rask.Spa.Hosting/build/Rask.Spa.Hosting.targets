<Project>

  <!--
    `$(_RaskSdkDotnet) build` / `publish` — this build's own SDK, never a bare `dotnet` that re-resolves one
    from the app's global.json and then loads the parent SDK's inherited MSBuild paths into the wrong
    runtime. The reasoning is in Rask.Server's Rask.Server.Client.targets; the definition is identical in
    every package that shells out, and NestedDotnetContractTests holds it so.
  -->
  <PropertyGroup>
    <_RaskSdkDotnet Condition=" '$(_RaskSdkDotnet)' == '' AND '$(DOTNET_HOST_PATH)' != '' AND Exists('$(MSBuildBinPath)/dotnet.dll') ">&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(MSBuildBinPath)/dotnet.dll&quot;</_RaskSdkDotnet>
    <_RaskSdkDotnet Condition=" '$(_RaskSdkDotnet)' == '' ">dotnet</_RaskSdkDotnet>
  </PropertyGroup>

  <!--
    Rask.Spa.Hosting build integration: a Rask WebAssembly client in its own project, served by this host:

        <ProjectReference Include="..\Shop.Client\Shop.Client.csproj"
                          ReferenceOutputAssembly="false"
                          SkipGetTargetFrameworkProperties="true"/>

    The two metadata flags are what MSBuild needs to reference a browser-wasm project from a server host
    without linking its output. The client is recognised by the <RaskWasm>true</RaskWasm> in its own
    project file, read with XmlPeek. The probe runs in every project, one XmlPeek per ProjectReference,
    because a target's Condition is evaluated before its DependsOnTargets run and so cannot wait for it;
    everything after it no-ops when it finds nothing. The client's framework is asked of MSBuild once one
    client is found (below).

    Then:
      1. `dotnet publish` the client before this project builds.
      2. Bake its publish/wwwroot as Rask.SpaDistDir, so `app.MapRaskSpa()` resolves with no arguments.
         The path is absolute and belongs to the build machine, which is why step 3 exists.
      3. On publish, copy the bundle into this app's RaskSpaPublishDir, where MapRaskSpa looks first.

    Everything no-ops when no client is found, because this file is imported into EVERY project of every
    consumer.

    RaskSpaBuild=false, which a dev session sets, skips the publish and bakes the client's build-output
    manifest instead. That is a precondition for WebAssembly hot reload, not an optimisation: a published
    bundle is trimmed, and trimming folds MetadataUpdater.IsSupported to false. Skipping costs nothing
    extra — ReferenceOutputAssembly="false" leaves BuildReference on, so this project's ordinary build
    already builds the client and writes that manifest. RaskWasm=false skips the publish as well, for a
    build that never serves the bundle.
  -->
  <Target Name="_RaskSpaProbeWasmClient" Outputs="%(ProjectReference.Identity)">
    <XmlPeek XmlInputPath="%(ProjectReference.FullPath)"
             Query="/Project/PropertyGroup/RaskWasm/text()"
             Condition="'%(ProjectReference.FullPath)' != ''">
      <Output TaskParameter="Result" PropertyName="_RaskSpaWasmProbe"/>
    </XmlPeek>
    <ItemGroup>
      <_RaskSpaWasmClient Include="%(ProjectReference.FullPath)" Condition="'$(_RaskSpaWasmProbe)' == 'true'"/>
    </ItemGroup>
    <PropertyGroup>
      <_RaskSpaWasmProbe></_RaskSpaWasmProbe>
    </PropertyGroup>
  </Target>

  <Target Name="_RaskSpaComputeWasmClient" DependsOnTargets="_RaskSpaProbeWasmClient">
    <Error Condition="'@(_RaskSpaWasmClient->Count())' &gt; '1'"
           Code="RASKSPA006"
           Text="Rask.Spa.Hosting: a host serves one WebAssembly client, and this project references @(_RaskSpaWasmClient->Count()): @(_RaskSpaWasmClient). Serve each from its own host."/>

    <!--
      The client's framework, asked of MSBuild rather than read off the file: the bundle and manifest paths
      name it.

      An XmlPeek of a literal <TargetFramework> element, with net10.0-browser assumed otherwise, is right for
      one .NET version only. A client whose framework comes from a Directory.Build.props or a property, or
      that targets another version, would bake a path under bin/<config>/net10.0-browser/ that no publish
      writes, and the host would answer its whole app with 404s from a green build.

      GetTargetFrameworks is the ProjectReference protocol's own question, answered by the client's full
      evaluation. The host's TargetFramework and RuntimeIdentifier are removed so its own face is not pushed
      onto a project with a different SDK. Only the one matched client is evaluated, so a host with no
      WebAssembly client pays nothing.

      "Exactly one" is COUNTED from the list, never read off HasSingleTargetFramework: MSBuild sets that flag
      from which property a project uses, so a one-entry <TargetFrameworks>net10.0-browser</TargetFrameworks>
      reports false although it names one framework, which is all the paths need.
    -->
    <MSBuild Projects="@(_RaskSpaWasmClient)"
             Targets="GetTargetFrameworks"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
             Condition="'@(_RaskSpaWasmClient->Count())' == '1'">
      <Output TaskParameter="TargetOutputs" ItemName="_RaskSpaWasmClientFrameworks"/>
    </MSBuild>
    <ItemGroup Condition="'@(_RaskSpaWasmClient->Count())' == '1'">
      <_RaskSpaWasmFramework Include="%(_RaskSpaWasmClientFrameworks.TargetFrameworks)"/>
    </ItemGroup>
    <Error Condition="'@(_RaskSpaWasmClient->Count())' == '1' AND '@(_RaskSpaWasmFramework->Count())' == '0'"
           Code="RASKSPA008"
           Text="Rask.Spa.Hosting: the WebAssembly client @(_RaskSpaWasmClient) reported no target framework, so the bundle it publishes cannot be located."/>
    <Error Condition="'@(_RaskSpaWasmClient->Count())' == '1' AND '@(_RaskSpaWasmFramework->Count())' &gt; '1'"
           Code="RASKSPA009"
           Text="Rask.Spa.Hosting: the WebAssembly client @(_RaskSpaWasmClient) must build for exactly one framework for its bundle to be served, but it targets '@(_RaskSpaWasmFramework)'. Give it a single &lt;TargetFramework&gt;, such as net10.0-browser."/>
    <PropertyGroup Condition="'@(_RaskSpaWasmClient->Count())' == '1'">
      <_RaskSpaWasmProject>%(_RaskSpaWasmClient.FullPath)</_RaskSpaWasmProject>
      <_RaskSpaWasmBin>$([System.IO.Path]::GetDirectoryName('%(_RaskSpaWasmClient.FullPath)'))/bin/$(Configuration)/@(_RaskSpaWasmFramework)</_RaskSpaWasmBin>
      <_RaskSpaWasmDist>$(_RaskSpaWasmBin)/publish/wwwroot</_RaskSpaWasmDist>
      <_RaskSpaWasmDevManifest>$(_RaskSpaWasmBin)/$([System.IO.Path]::GetFileNameWithoutExtension('%(_RaskSpaWasmClient.FullPath)')).staticwebassets.runtime.json</_RaskSpaWasmDevManifest>
    </PropertyGroup>
  </Target>

  <Target Name="_RaskSpaPublishWasmClient" BeforeTargets="BeforeBuild" DependsOnTargets="_RaskSpaComputeWasmClient">
    <PropertyGroup>
      <_RaskSpaDoWasmPublish Condition="'$(_RaskSpaWasmProject)' != '' AND '$(RaskWasm)' != 'false' AND '$(RaskSpaBuild)' != 'false' AND '$(DesignTimeBuild)' != 'true'">true</_RaskSpaDoWasmPublish>
    </PropertyGroup>
    <Message Importance="high"
             Condition="'$(_RaskSpaWasmProject)' != '' AND '$(RaskSpaBuild)' == 'false'"
             Text="Rask.Spa.Hosting: serving the build output of $(_RaskSpaWasmProject) (RaskSpaBuild=false, no publish)"/>
    <Message Importance="high"
             Condition="'$(_RaskSpaDoWasmPublish)' == 'true'"
             Text="Rask.Spa.Hosting: publishing $(_RaskSpaWasmProject) ($(Configuration))"/>
    <!--
      -nodeReuse:false: a reused node outlives the nested publish, keeps this build's inherited stdout
      open, and a `dotnet test` parent then hangs after its build waiting on it. -v:minimal rather than
      quiet, because the scoped-asset bake reports what it wrote at High importance and a quiet publish
      hid a bundle that shipped without /_rask/a/.
    -->
    <Exec Condition="'$(_RaskSpaDoWasmPublish)' == 'true'"
          Command="$(_RaskSdkDotnet) publish &quot;$(_RaskSpaWasmProject)&quot; -c $(Configuration) --nologo -v:minimal -nodeReuse:false"/>
  </Target>

  <Target Name="_RaskSpaSetWasmClientMetadata" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="_RaskSpaComputeWasmClient">
    <ItemGroup Condition="'$(_RaskSpaWasmProject)' != ''">
      <AssemblyMetadata Include="Rask.SpaDistDir" Value="$(_RaskSpaWasmDist)"/>
      <AssemblyMetadata Include="Rask.SpaWasmClient" Value="$(_RaskSpaWasmProject)"/>
      <!-- Only when the publish was skipped, so a manifest left over from an earlier session is never
           served by a build that published. -->
      <AssemblyMetadata Include="Rask.SpaDevManifest" Value="$(_RaskSpaWasmDevManifest)"
                        Condition="'$(RaskSpaBuild)' == 'false'"/>
      <!-- A dev-session build (VS Code's F5 task). Only when set; same key and rule as Rask.Core.targets. -->
      <AssemblyMetadata Include="Rask.DevSession" Value="true" Condition="'$(RaskDevSession)' == 'true'"/>
    </ItemGroup>
  </Target>

  <Target Name="_RaskSpaCollectWasmClientPublishAssets"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="_RaskSpaComputeWasmClient">
    <ItemGroup Condition="'$(_RaskSpaWasmDist)' != '' AND Exists('$(_RaskSpaWasmDist)')">
      <_RaskSpaWasmFile Include="$(_RaskSpaWasmDist)/**/*"/>
      <ResolvedFileToPublish Include="@(_RaskSpaWasmFile)">
        <RelativePath>$(RaskSpaPublishDir)/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Message Importance="high"
             Condition="'@(_RaskSpaWasmFile)' != ''"
             Text="Rask.Spa.Hosting: publishing @(_RaskSpaWasmFile->Count()) file(s) from $(_RaskSpaWasmDist) into $(RaskSpaPublishDir)/"/>
  </Target>

</Project>
