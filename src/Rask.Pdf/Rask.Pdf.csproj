<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not packed yet: the solution is what the nightly packs, and Rask.Pdf ships once Pdf.From, the deploy image
         and the guide are in. Its public names are recorded from the first slice all the same. -->
    <IsPackable>false</IsPackable>
    <RaskPublicApiTracked>true</RaskPublicApiTracked>

    <PackageId>Rask.Pdf</PackageId>
    <Title>Rask.Pdf — a PDF from a Rask page or component</Title>
    <Description>Prints HTML to PDF with the headless Chromium installed beside the app, over the browser's own DevTools pipe: real fonts, every script, a table heading repeated on every page. Zero dependencies; never downloads a browser.</Description>
    <PackageTags>pdf print chromium headless report dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Server only: the PDF is drawn by a Chromium process the app starts, so there is no browser face. Hosting
       (IHostedService, configuration, logging) comes with the shared framework, not a package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Pdf.Tests"/>
  </ItemGroup>

</Project>
