<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Pdf</PackageId>
    <Title>Rask.Pdf — a PDF from a Rask page or component</Title>
    <Description>A PDF of a Rask page or component, as the calling user sees it: await Pdf.From(Routes.Report(id)). Rendered on the server like a first GET, [Authorize] first; drawn by a pinned Chrome for Testing headless shell that the build fetches (checksum verified) and the container image carries — never downloaded at run time. Real fonts and every script, table headings repeated on every page, a footer and page numbers. Zero NuGet dependencies: Rask drives the browser over its own DevTools pipe.</Description>
    <PackageTags>pdf html-to-pdf print report chromium headless puppeteer dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship this package's own README instead of the framework overview Directory.Build.props packs by default. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- Server only: the PDF is drawn by a Chromium process the app starts, so there is no browser face. Hosting
       (IHostedService, configuration, logging) comes with the shared framework, not a package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Pdf.Tests"/>
  </ItemGroup>

  <!-- Pdf.From takes a route or a component, and reaches the server host's render through Core's
       IPrintablePages; Rask.Server implements it. -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj"/>
  </ItemGroup>

  <!-- Rask:Pdf binds through the one registration every server-side options type uses, with the binding source
       generator writing the bind at compile time (no reflection binder for the trimmer to lose). -->
  <ItemGroup>
    <Compile Include="..\Rask.Hosting.Shared\RaskOptionsRegistration.cs" Link="Shared\RaskOptionsRegistration.cs"/>
  </ItemGroup>

  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!-- The pinned browser: the build fetches it for an app (build/Rask.Pdf.targets), and the assembly carries the
       version so the locator finds that same copy in the user's Rask cache. -->
  <Import Project="build\Rask.Pdf.ChromePin.props" />

  <ItemGroup>
    <AssemblyMetadata Include="RaskPdfChromeVersion" Value="$(RaskPdfChromeVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Rask.Pdf.props" Pack="true" PackagePath="build/" Visible="false" />
    <None Include="build\Rask.Pdf.targets" Pack="true" PackagePath="build/" Visible="false" />
    <None Include="build\Rask.Pdf.ChromePin.props" Pack="true" PackagePath="build/" Visible="false" />
    <None Include="buildTransitive\Rask.Pdf.props" Pack="true" PackagePath="buildTransitive/" Visible="false" />
    <None Include="buildTransitive\Rask.Pdf.targets" Pack="true" PackagePath="buildTransitive/" Visible="false" />
  </ItemGroup>

</Project>
