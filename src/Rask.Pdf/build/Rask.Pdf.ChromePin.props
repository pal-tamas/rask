<Project>

  <!--
    THE PINNED BROWSER: the Chrome for Testing headless shell Rask.Pdf prints with in development, in CI and in the
    container image. One version, one SHA-256 per platform, checked before anything is unpacked. Google publishes
    no checksums for these archives, so the hashes are ours: taken when the pin moves, by the dependency check
    (.claude/skills/check-dependency-updates, scripts/upstream/chrome-for-testing-pin.sh), never at build time.

    Read by the build (build/Rask.Pdf.targets), by the scaffolded Dockerfile through it, and by Rask.Pdf itself,
    which looks for this version in the user's Rask cache (the assembly carries it as metadata).
  -->
  <PropertyGroup>
    <RaskPdfChromeVersion>155.0.8059.79</RaskPdfChromeVersion>
    <RaskPdfChromeSha256_linux64>4cea4c32b501aa43cc2b81eb45734af991a6a82feded48380d6dfaf96642a1c1</RaskPdfChromeSha256_linux64>
    <RaskPdfChromeSha256_linux_arm64>72d938cabad9674610939c72ef2d3faf20214a4418c3b4e94c1cebca683e767b</RaskPdfChromeSha256_linux_arm64>
    <RaskPdfChromeSha256_mac_arm64>5f51504ead3d41815111cd73e79c4979df3a4e6aedc7cf6fe2b042ae037363b5</RaskPdfChromeSha256_mac_arm64>
    <RaskPdfChromeSha256_mac_x64>36a1da728fc936770a0edc52989b74d8d3a194e8747f490e372a210853ad831c</RaskPdfChromeSha256_mac_x64>
    <RaskPdfChromeSha256_win64>c4cc49fa7908cf018600b04c95918d336565d90f9c72241fd83dacd9ec41855c</RaskPdfChromeSha256_win64>
  </PropertyGroup>

</Project>
