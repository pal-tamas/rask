<Project>

  <!--
    THE PINNED BROWSER: the Chrome for Testing headless shell Rask.Pdf prints with in development, in CI and in the
    container image. One version, one SHA-256 per platform, checked before anything is unpacked. Google publishes
    no checksums for these archives, so the hashes are ours: taken when the pin moves, by the dependency check
    (.claude/skills/check-dependency-updates, scripts/upstream/chrome-for-testing-pin.sh), never at build time.

    Read by the build (build/Rask.Pdf.targets), by the scaffolded Dockerfile through it, and by Rask.Pdf itself,
    which looks for this version in the user's Rask cache (the assembly carries it as metadata).
  -->
  <PropertyGroup>
    <RaskPdfChromeVersion>156.0.8078.73</RaskPdfChromeVersion>
    <RaskPdfChromeSha256_linux64>77eb8d52798efc7a857ab61abcc62a456d8ea9635b02341d06dffee2761768c8</RaskPdfChromeSha256_linux64>
    <RaskPdfChromeSha256_linux_arm64>98c084708f0f1fa4ed589ad601cc79b437f0cebe60ffc9794af78a085c01a2a7</RaskPdfChromeSha256_linux_arm64>
    <RaskPdfChromeSha256_mac_arm64>512c7d34cd5b65d617a39a48915b490eed4208a63e9d47b0fd7893e83be85765</RaskPdfChromeSha256_mac_arm64>
    <RaskPdfChromeSha256_mac_x64>be798095cd693357a7a6a0e7a0c4ebd81563e16f51225eb98aacc906d6326519</RaskPdfChromeSha256_mac_x64>
    <RaskPdfChromeSha256_win64>e6d26810df71efd0a3dfd0f7246d75d279ebdf8a8ec153d1ac44069657298628</RaskPdfChromeSha256_win64>
  </PropertyGroup>

</Project>
