<Project>

  <!--
    THE PINNED BROWSER: the Chrome for Testing headless shell Rask.Pdf prints with in development, in CI and in the
    container image. One version, one SHA-256 per platform, checked before anything is unpacked. Google publishes
    no checksums for these archives, so the hashes are ours: taken when the pin moves, by the dependency check
    (.claude/skills/check-dependency-updates, scripts/upstream/chrome-for-testing-pin.sh), never at build time.

    Read by the build (build/Rask.Pdf.targets), by the scaffolded Dockerfile through it, and by Rask.Pdf itself,
    which looks for this version in the user's Rask cache (the assembly carries it as metadata).
  -->
  <PropertyGroup>
    <RaskPdfChromeVersion>158.0.8127.36</RaskPdfChromeVersion>
    <RaskPdfChromeSha256_linux64>2d3a23017323c54fd457a678e4351f895c4076d8050e39d5aa6247f93448b73a</RaskPdfChromeSha256_linux64>
    <RaskPdfChromeSha256_linux_arm64>176ee5c55486c22de43128871189061365ea28e881fc96016fd18e7cb59437c8</RaskPdfChromeSha256_linux_arm64>
    <RaskPdfChromeSha256_mac_arm64>c24d40a3786322ff3a5e3ac6eed162226cbaf07ebe468715407827226b0f8897</RaskPdfChromeSha256_mac_arm64>
    <RaskPdfChromeSha256_mac_x64>e0c5d07d8f5bcc5bdd5ef370e7daf3770856b585fcc9eecf441c7e3bb2e3d1cf</RaskPdfChromeSha256_mac_x64>
    <RaskPdfChromeSha256_win64>9655950dfeddf565561cd64cfe8ee716ccd6482fa3798503b632219efc65a71e</RaskPdfChromeSha256_win64>
  </PropertyGroup>

</Project>
