<Project>

  <!--
    THE PINNED BROWSER: the Chrome for Testing headless shell Rask.Pdf prints with in development, in CI and in the
    container image. One version, one SHA-256 per platform, checked before anything is unpacked. Google publishes
    no checksums for these archives, so the hashes are ours: taken when the pin moves, by the dependency check
    (.claude/skills/check-dependency-updates, scripts/upstream/chrome-for-testing-pin.sh), never at build time.

    Read by the build (build/Rask.Pdf.targets), by the scaffolded Dockerfile through it, and by Rask.Pdf itself,
    which looks for this version in the user's Rask cache (the assembly carries it as metadata).
  -->
  <PropertyGroup>
    <RaskPdfChromeVersion>157.0.8103.50</RaskPdfChromeVersion>
    <RaskPdfChromeSha256_linux64>7bf0d41e424efd1d6281c4162993ab9dc5de92fac213c211614905a71c057d0f</RaskPdfChromeSha256_linux64>
    <RaskPdfChromeSha256_linux_arm64>55add1fa634756811fd644094ec226fc7e405be698fb07dbf0634bca689e293a</RaskPdfChromeSha256_linux_arm64>
    <RaskPdfChromeSha256_mac_arm64>082e3fe8fcfac75aec2ef0949d70e8d2254a99ea465450e287e6c06a3f1863ed</RaskPdfChromeSha256_mac_arm64>
    <RaskPdfChromeSha256_mac_x64>886beb07d8237b8acc2b879843a3506b3a56284264b82c806c7d80546e24e0ad</RaskPdfChromeSha256_mac_x64>
    <RaskPdfChromeSha256_win64>9e59432baf484387bdc9cc4a8efca499fb558aeda93e536eb8b859a065ddb884</RaskPdfChromeSha256_win64>
  </PropertyGroup>

</Project>
