<Project>

  <!--
    THE PINNED BROWSER: the Chrome for Testing headless shell Rask.Pdf prints with in development, in CI and in the
    container image. One version, one SHA-256 per platform, checked before anything is unpacked. Google publishes
    no checksums for these archives, so the hashes are ours: taken when the pin moves, by the dependency check
    (.claude/skills/check-dependency-updates, scripts/upstream/chrome-for-testing-pin.sh), never at build time.

    Read by the build (build/Rask.Pdf.targets), by the scaffolded Dockerfile through it, and by Rask.Pdf itself,
    which looks for this version in the user's Rask cache (the assembly carries it as metadata).
  -->
  <PropertyGroup>
    <RaskPdfChromeVersion>155.0.8059.84</RaskPdfChromeVersion>
    <RaskPdfChromeSha256_linux64>a5d71b91aa996fef00517cd212b2dfb816b43055edefbe727e6fd562d4ae1f9c</RaskPdfChromeSha256_linux64>
    <RaskPdfChromeSha256_linux_arm64>0c83c2520b513835c712590781adbdbcab4c14ca04d4809be5055ff2c8937a51</RaskPdfChromeSha256_linux_arm64>
    <RaskPdfChromeSha256_mac_arm64>7f111980bcb41e908d0fa3e969a625e7777ff683c1fc43fd7759d05ec3ffe52b</RaskPdfChromeSha256_mac_arm64>
    <RaskPdfChromeSha256_mac_x64>3c5bf34eb8daa874e8b50edf900eab618b74c1b9596e596340278eeba4ff1ae1</RaskPdfChromeSha256_mac_x64>
    <RaskPdfChromeSha256_win64>5ca590a4968864e219ea25ccd134597ef8898a733a4698c07fc3e8b2c480fef4</RaskPdfChromeSha256_win64>
  </PropertyGroup>

</Project>
