<Project>

  <!--
    THE PINNED BROWSER: the Chrome for Testing headless shell Rask.Pdf prints with in development, in CI and in the
    container image. One version, one SHA-256 per platform, checked before anything is unpacked. Google publishes
    no checksums for these archives, so the hashes are ours: taken when the pin moves, by the dependency check
    (.claude/skills/check-dependency-updates, scripts/upstream/chrome-for-testing-pin.sh), never at build time.

    Read by the build (build/Rask.Pdf.targets), by the scaffolded Dockerfile through it, and by Rask.Pdf itself,
    which looks for this version in the user's Rask cache (the assembly carries it as metadata).
  -->
  <PropertyGroup>
    <RaskPdfChromeVersion>157.0.8103.38</RaskPdfChromeVersion>
    <RaskPdfChromeSha256_linux64>deafffa74660b34853a4119c361fd427ac8c9fcb62db51ddb8a797cd83a4ba2d</RaskPdfChromeSha256_linux64>
    <RaskPdfChromeSha256_linux_arm64>b9b910a57b2a15eb3e55000a2339f93a973934a413ebfc6e585a50ec6c42fd6c</RaskPdfChromeSha256_linux_arm64>
    <RaskPdfChromeSha256_mac_arm64>e6a6b13551aa12f951d0891d79282606b13742837c8fa0505e1272bae116ce82</RaskPdfChromeSha256_mac_arm64>
    <RaskPdfChromeSha256_mac_x64>79821745d0a72d2ba752d981284ed0a9e6fa320dad133596941a17dba6186de3</RaskPdfChromeSha256_mac_x64>
    <RaskPdfChromeSha256_win64>1ff4540855478ba0848e03f1ef8d455f77d058b38285df91bc34273788a73446</RaskPdfChromeSha256_win64>
  </PropertyGroup>

</Project>
