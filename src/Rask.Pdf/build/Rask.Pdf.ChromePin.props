<Project>

  <!--
    THE PINNED BROWSER: the Chrome for Testing headless shell Rask.Pdf prints with in development, in CI and in the
    container image. One version, one SHA-256 per platform, checked before anything is unpacked. Google publishes
    no checksums for these archives, so the hashes are ours: taken when the pin moves, by the dependency check
    (.claude/skills/check-dependency-updates, scripts/upstream/chrome-for-testing-pin.sh), never at build time.

    Read by the build (build/Rask.Pdf.targets), by the scaffolded Dockerfile through it, and by Rask.Pdf itself,
    which looks for this version in the user's Rask cache (the assembly carries it as metadata).
  -->
  <PropertyGroup>
    <RaskPdfChromeVersion>157.0.8103.78</RaskPdfChromeVersion>
    <RaskPdfChromeSha256_linux64>f90329720fb61e5a76da9b6b509b6ad12a484c9c5df0359403e935177c6d153a</RaskPdfChromeSha256_linux64>
    <RaskPdfChromeSha256_linux_arm64>912fbf877e53de34d7b3cca5104f3b95607d41bd35412ccc6cd2a599ff0c0dbf</RaskPdfChromeSha256_linux_arm64>
    <RaskPdfChromeSha256_mac_arm64>17bf66d53c1b1104dcb641c5b331cd4ac5d200c778f5feed0934a0b92deaf8d6</RaskPdfChromeSha256_mac_arm64>
    <RaskPdfChromeSha256_mac_x64>f1a6a9561eaf1f409849538de663695d36d72fbf1ebca4d42e47c7b5f2a157f3</RaskPdfChromeSha256_mac_x64>
    <RaskPdfChromeSha256_win64>2138c1583d25d6f3abec5269943b2f430207d87a539895aa9e90cc4697ec0e1f</RaskPdfChromeSha256_win64>
  </PropertyGroup>

</Project>
