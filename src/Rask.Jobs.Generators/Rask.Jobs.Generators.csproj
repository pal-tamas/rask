<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
  </ItemGroup>

  <!--
    The jobs and outbox registry generators are the same generator over a different marker interface.
    They shipped as byte-identical copies and drifted into an identical naming bug, so the logic now
    lives in one place and is linked into both analyzer assemblies (they can't share a project
    reference: each has to be a self-contained analyzer). Everything shared is internal, so the two
    assemblies get independent copies with no type-identity conflict.
  -->
  <ItemGroup>
    <Compile Include="..\Rask.Generators.Shared\RegistryGeneratorBase.cs" Link="Shared\RegistryGeneratorBase.cs"/>
    <Compile Include="..\Rask.Generators.Shared\SymbolRegistration.cs" Link="Shared\SymbolRegistration.cs"/>
    <Compile Include="..\Rask.Generators.Shared\SymbolLocation.cs" Link="Shared\SymbolLocation.cs"/>
    <Compile Include="..\Rask.Generators.Shared\DiagnosticHelp.cs" Link="Shared\DiagnosticHelp.cs"/>
    <Compile Include="..\Rask.Generators.Shared\IsExternalInit.cs" Link="Shared\IsExternalInit.cs"/>
  </ItemGroup>

</Project>
