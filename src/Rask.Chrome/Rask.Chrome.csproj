<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rask.Chrome is the home for the screen chrome vocabulary — the bars AROUND a page (header, tab bar) and
    the Screen base class that declares them. It sits beside Rask.Core rather than inside it:

      • Rask.Core        — the render engine, routing, lifecycle, and the tags that engine builds.
      • Rask.Chrome (here) — Screen + the portable bars (AppBar, TabStrip, TabItem, BarButton, BarIcon).
      • Rask.Native.Components — the platform-exact bars (NativeHeaderBar, NativeTabBar, NativeToolbar, …),
        which is the escape hatch when the portable subset is not enough.

    It is NOT in Rask.Native, even though native shells are where chrome is most visible. Rask.Native is the
    mobile HOST package (IsPackable=true: INativeWebView, NativeAppHost, the platform bridge, iOS/Android
    TFMs). Putting Screen there would force a shared UI project to reference a WebView host from its Server
    and WASM builds just to name a base class.

    Like Rask.Core and Rask.Client, this is IsPackable=false: its DLL is bundled into the lib/ folder of
    EVERY host package (Server, WASM, Native) rather than published on its own — the same treatment
    Rask.Client gets, one tier down. That is what makes one Screen subclass compile and render on all three.

    Core keeps exactly one seam for it: the internal IScreenChrome interface the serializer type-tests to
    know a component has chrome slots to walk. Core names no chrome type.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Rask.Chrome</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj" PrivateAssets="all"/>
    <!-- The factory generator, so the bars get their `AppBar.Title(...)` chain entries like any component. -->
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Chrome.Tests"/>
    <!-- The chrome descriptor and TabStrip.DeriveSelected are a framework contract between this assembly
         and the hosts, not something an app calls — so they stay internal and the hosts are named here.
         All three need it now: every model has to be able to PRODUCE a descriptor, because in the remote
         models it is the server or WASM session that renders the bars, not the native one. -->
    <InternalsVisibleTo Include="Rask.Native"/>
    <InternalsVisibleTo Include="Rask.Server"/>
    <InternalsVisibleTo Include="Rask.Wasm"/>
  </ItemGroup>

</Project>
