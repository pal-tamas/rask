<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Testing.Data</PackageId>
    <Title>Rask.Testing.Data — test helpers for a Rask app's data</Title>
    <Description>The half of Rask.Testing that needs Rask.Data, so a component-only test project never pulls in EF Core. Test.Make&lt;Vin&gt;() is a value object its rules accept: it reads the rules the record hands its Text, Number, Whole, Day, Moment, Range or Value base — lengths and a simple pattern, bounds and scale, a Value record's members — and makes it through the generated Create, so its own Rules() agree too. Reference it beside Rask.Testing from the test project of an app that stores data.</Description>
    <PackageTags>rask testing unit-test value-object test-data entity-framework dotnet net11</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework overview
       that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test.Make extends Rask.Testing's Test, so a test reads Test.Make<Vin>() beside Test.Refuses(…). -->
    <ProjectReference Include="..\Rask.Testing\Rask.Testing.csproj"/>
    <!-- The value-object bases and the rules they were handed (Rask.Data's internal DeclaredRules). -->
    <ProjectReference Include="..\Rask.Data\Rask.Data.csproj"/>
  </ItemGroup>

</Project>
