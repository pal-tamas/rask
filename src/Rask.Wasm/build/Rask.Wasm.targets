<Project>

  <!--
    Rask.Wasm build integration.

    A consuming WASM project (a Microsoft.NET.Sdk.WebAssembly project that sets
    <RaskWasm>true</RaskWasm> and references Rask.Wasm) gets wired in here:
      1. The framework boot files (index.html shell, main.js, rask.wasm.js) are
         staged into the project's wwwroot so the WebAssembly SDK discovers them as
         static web assets — removing the per-app wwwroot boilerplate.
      2. Scoped CSS/JS are baked to /_rask/a/{hash}.{ext} in the build- and
         publish-output wwwroot so a plain static host serves them.

    Fingerprinting + the import map come from the SDK itself (the consumer sets
    <OverrideHtmlAssetPlaceholders>true), not from this file. Sub-path deploys use
    the SDK's <StaticWebAssetBasePath>.

    Auto-imported in this repo via Directory.Build.targets at the repo root.
    Downstream NuGet consumers get the same auto-import via the build/ folder packed
    into the .nupkg. Both paths import unconditionally; everything is gated by
    <RaskWasm> so non-WASM consumers pay nothing.
  -->

  <!--
    Rask.Core's build integration (scoped-CSS/JS globs + CompilerVisibleProperty), packed alongside this
    file by src\RaskCoreBuildPack.targets. NuGet auto-imports only build/<PackageId>.{props,targets}, so
    it has to be pulled in from here — without it a consuming WASM app gets no scoped CSS/JS at all (#544).

    The Exists guard is NOT cosmetic: this file is also imported in-repo by Directory.Build.targets, where
    Rask.Core.targets has no sibling here (it is packed from Rask.Core's own build/ folder), and an
    unguarded import of a missing file is MSB4019 across every project in the repo.
  -->
  <!-- Build-time prerendering. Gates itself on RaskPrerender, so importing it always costs an app
       that has not opted in nothing. -->
  <Import Project="$(MSBuildThisFileDirectory)Rask.Wasm.Prerender.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)Rask.Wasm.Prerender.targets') "/>

  <Import Project="$(MSBuildThisFileDirectory)Rask.Core.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)Rask.Core.targets') "/>

  <!--
    Contribute the framework boot JS (main.js, rask.wasm.js) as computed static web assets
    at the app root, so every consuming WASM project gets them served at /main.js and
    /rask.wasm.js without copying framework files into its own tree (no drift). main.js
    imports './_framework/dotnet.js' (resolved through the SDK import map) and dynamically
    imports './rask.wasm.js' — both resolve from the root. The page shell wwwroot/index.html
    is NOT contributed here: it must be a real file in the consumer's wwwroot (committed in
    the samples/templates) so the wwwroot/** glob sees it at evaluation and the SDK's
    <OverrideHtmlAssetPlaceholders> pass fills its import map / preload placeholders.
  -->
  <Target Name="_RaskAddFrameworkBootAssets"
          BeforeTargets="GenerateComputedBuildStaticWebAssets"
          Condition=" '$(RaskWasm)' == 'true' ">
    <ItemGroup>
      <_RaskBootAsset Include="$(MSBuildThisFileDirectory)..\Browser\main.js"/>
      <_RaskBootAsset Include="$(MSBuildThisFileDirectory)..\Browser\rask.wasm.js"/>
      <!-- Default PWA service worker (offline app-shell cache + Web Push), served at {root}/rask-sw.js. -->
      <_RaskBootAsset Include="$(MSBuildThisFileDirectory)..\Browser\rask-sw.js"/>
    </ItemGroup>
    <DefineStaticWebAssets CandidateAssets="@(_RaskBootAsset)"
                           SourceType="Computed"
                           SourceId="$(PackageId)"
                           ContentRoot="$(MSBuildThisFileDirectory)..\Browser\"
                           BasePath="$(StaticWebAssetBasePath)"
                           RelativePathPattern="**"
                           FingerprintCandidates="false">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset"/>
      <Output TaskParameter="Assets" ItemName="_RaskBootStaticWebAsset"/>
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints Condition=" '@(_RaskBootStaticWebAsset)' != '' "
                                   CandidateAssets="@(_RaskBootStaticWebAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint"/>
    </DefineStaticWebAssetEndpoints>
  </Target>

  <ItemGroup Condition=" '$(RaskWasm)' == 'true' ">
    <!--
      Roots EnumerateAll + the kindred bake-only public surface so the trimmer doesn't
      drop them in release-mode WASM publishes. Without this the bake task at publish
      time loads a trimmed Rask.Core.dll, fails to find EnumerateAll, logs the API-
      mismatch warning, and the published wwwroot ships without /_rask/a/ files.
    -->
    <TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)Rask.Wasm.Trim.xml"/>
  </ItemGroup>

  <!--
    Scoped-asset bake task registration. The task forces the generator-emitted
    __RaskScopedCss/JsRegistration classes to populate the in-MSBuild ScopedAssetRegistry,
    then writes each registered entry to {BundleDir}/_rask/a/{hash}.{ext}. It's loaded from a
    sibling DLL produced by Rask.Wasm.Tasks (Rask.Wasm's build copies it here).

    Do NOT gate this UsingTask Condition on Exists(...Rask.Wasm.Tasks.dll). A UsingTask
    Condition is evaluated at project-evaluation time, which precedes the build-order edge
    (Rask.Wasm's ReferenceOutputAssembly="false" reference to Rask.Wasm.Tasks) that produces
    and copies the DLL here. The DLL is a generated artifact (gitignored), so on a clean
    checkout it is absent at evaluation — an Exists guard here would skip registration, then
    the bake target's own Exists guard (now true) would fire BakeScopedAssetsTask against an
    unregistered task → MSB4036. AssemblyFile-based UsingTasks load lazily (only when the task
    is invoked), and the bake target keeps its Exists guard, so registering unconditionally is safe.
  -->
  <UsingTask TaskName="Rask.Wasm.Tasks.BakeScopedAssetsTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.Wasm.Tasks.dll"
             Condition=" '$(RaskWasm)' == 'true' "/>

  <!--
    Scoped-asset bake → static web assets. The generator emits per-component scoped CSS/JS
    that the runtime references at /_rask/a/{hash}.{ext}. We materialise those bytes into an
    intermediate staging dir and register them as *computed* static web assets, so the SDK
    pipeline serves them in dev (`dotnet run` via the manifest) and copies them into the
    published wwwroot — under the same /_rask/a/{hash}.{ext} URL, fingerprinting disabled
    (the {hash} is already a content hash; SDK fingerprinting would break the runtime's URL).

    The bake reads the app's own compiled assembly (@(IntermediateAssembly)) plus the
    referenced, pre-trim copy-local dlls (Rask.Core et al via @(ReferenceCopyLocalPaths)) —
    NOT the IL-trimmed publish copies, whose [ModuleInitializer]s throw outside the WASM
    runtime. DependsOnTargets="ResolveReferences;Compile" guarantees both are available, and
    the target is wired into GenerateComputed{Build,Publish}StaticWebAssets (below) so it
    runs while the SDK is assembling the asset set, for both build and publish.
  -->
  <Target Name="_RaskBakeScopedStaticWebAssets"
          DependsOnTargets="ResolveReferences;Compile"
          Condition=" '$(RaskWasm)' == 'true' AND Exists('$(MSBuildThisFileDirectory)Rask.Wasm.Tasks.dll') ">
    <PropertyGroup>
      <_RaskScopedStageDir>$(IntermediateOutputPath)rask-scoped\</_RaskScopedStageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_RaskScopedStageDir)"/>
    <MakeDir Directories="$(_RaskScopedStageDir)"/>
    <ItemGroup>
      <_RaskBakeInputAssemblies Include="@(IntermediateAssembly)"/>
      <_RaskBakeInputAssemblies Include="@(ReferenceCopyLocalPaths)" Condition=" '%(Extension)' == '.dll' "/>
    </ItemGroup>
    <BakeScopedAssetsTask BundleDir="$(_RaskScopedStageDir)" Assemblies="@(_RaskBakeInputAssemblies)"/>
    <!-- Records that the bake actually ran, which _RaskVerifyPublishedScopedAssets needs to tell "this
         project has no scoped assets" apart from "the bake was skipped". An empty staging dir means the
         former only if we got this far. -->
    <PropertyGroup>
      <_RaskScopedBakeRan>true</_RaskScopedBakeRan>
    </PropertyGroup>
    <ItemGroup>
      <_RaskScopedBaked Include="$(_RaskScopedStageDir)**\*"/>
    </ItemGroup>
    <DefineStaticWebAssets Condition=" '@(_RaskScopedBaked)' != '' "
                           CandidateAssets="@(_RaskScopedBaked)"
                           SourceType="Computed"
                           SourceId="$(PackageId)"
                           ContentRoot="$(_RaskScopedStageDir)"
                           BasePath="$(StaticWebAssetBasePath)"
                           RelativePathPattern="**"
                           FingerprintCandidates="false">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset"/>
      <Output TaskParameter="Assets" ItemName="_RaskScopedStaticWebAsset"/>
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints Condition=" '@(_RaskScopedStaticWebAsset)' != '' "
                                   CandidateAssets="@(_RaskScopedStaticWebAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint"/>
    </DefineStaticWebAssetEndpoints>
  </Target>

  <!-- Contribute in the build computed pass only; the assets are AssetKind=All so they flow
       into the publish manifest too. Adding them in both passes double-registers the same
       ItemSpec and trips the SDK's duplicate-key guard. -->
  <PropertyGroup Condition=" '$(RaskWasm)' == 'true' ">
    <GenerateComputedBuildStaticWebAssetsDependsOn>$(GenerateComputedBuildStaticWebAssetsDependsOn);_RaskBakeScopedStaticWebAssets</GenerateComputedBuildStaticWebAssetsDependsOn>
  </PropertyGroup>

  <!--
    Sub-path deploys (e.g. GitHub Pages under /<repo>/). Set <RaskPathBase> in the csproj or
    pass /p:RaskPathBase=/<repo> at publish: we rewrite the published index.html's
    <base href="/"> to <base href="/<repo>/">. Everything else the SDK emits — the import
    map, the preload <link>, the <script src="main.js"> and the runtime's own /_rask/a/{hash}
    URLs — is document-relative (no leading slash), so a corrected <base href> is all that's
    needed to resolve every asset under the sub-path. The runtime's getBasePath() (reads
    document.baseURI in rask.wasm.js) likewise picks up the prefix on first paint.

    Unlike the SDK's <StaticWebAssetBasePath> (which relocates assets into a wwwroot/<repo>/
    subtree but leaves <base href="/"> untouched, breaking deep-link reloads), this keeps the
    root-relative layout and only fixes the base href. It runs on the published output, so
    dev (`dotnet run` at the origin root) keeps <base href="/">.

    Normalization: "myapp" / "/myapp" / "/myapp/" all become <base href="/myapp/">; "/" / ""
    stay "/" (no rewrite) — matches RaskPath.Normalize plus the trailing slash <base> needs.
  -->
  <Target Name="_RaskRewriteBaseHref"
          AfterTargets="Publish"
          Condition=" '$(RaskWasm)' == 'true' AND '$(RaskPathBase)' != '' AND '$(RaskPathBase)' != '/' ">
    <PropertyGroup>
      <_RaskNormalizedBase>$(RaskPathBase.TrimEnd('/'))</_RaskNormalizedBase>
      <_RaskNormalizedBase Condition=" !$(_RaskNormalizedBase.StartsWith('/')) ">/$(_RaskNormalizedBase)</_RaskNormalizedBase>
    </PropertyGroup>

    <!--
      EVERY published page, not just the root one. Prerendering writes a directory per route
      (about/index.html, docs/intro/index.html), and each is a whole document carrying its own
      <base href="/"> from the shell it was spliced into. Rewriting only the root left every
      prerendered sub-page resolving main.js against its own directory — /about/main.js — which is
      the exact failure the <base href> exists to prevent, on the pages a crawler is most likely to
      land on first. The item is globbed inside the target because prerendering runs earlier in this
      same AfterTargets="Publish" chain, so these files do not exist at evaluation time.

      The base is ABSOLUTE, so one value is correct at every depth.
    -->
    <ItemGroup>
      <_RaskPublishedPage Include="$(PublishDir)wwwroot\**\index.html"/>
    </ItemGroup>

    <!--
      WriteLinesToFile, not File::WriteAllText: MSBuild's property-function whitelist has no writer.
      The read is escaped by MSBuild on the way into the property, so a document's semicolons do not
      split it into separate lines and its percent-escapes (a data: URI's %3C, say) survive verbatim.
    -->
    <WriteLinesToFile File="%(_RaskPublishedPage.FullPath)"
                      Lines="$([System.IO.File]::ReadAllText('%(_RaskPublishedPage.FullPath)').Replace('&lt;base href=&quot;/&quot;/&gt;', '&lt;base href=&quot;$(_RaskNormalizedBase)/&quot;/&gt;'))"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"/>

    <Message Importance="High"
             Condition=" '@(_RaskPublishedPage)' != '' "
             Text="Rask: rewrote &lt;base href&gt; to &quot;$(_RaskNormalizedBase)/&quot; in @(_RaskPublishedPage->Count()) published page(s)"/>
  </Target>

  <!--
    Fail the publish if the scoped assets were baked but did not reach the published wwwroot.

    The bake stages into obj/…/rask-scoped/_rask/a and registers the files as computed static web assets
    in the BUILD pass, relying on AssetKind=All to carry them into the publish manifest. That link can be
    broken without anything erroring — most reliably by building the project once in each WasmBuildNative
    mode, since the two share one obj/ and only one of them leaves the staging the publish reads. The
    result is a published bundle with no /_rask/a/ at all: the app builds, publishes, boots and renders,
    and only the scoped CSS/JS is quietly absent.

    That silence is the whole problem. Every scoped-asset URL 404s in the browser, and for an app whose
    scoped JS owns something load-bearing (the playground's editor, say) it presents as a hung page rather
    than a missing file — sending you to debug the app instead of the build. This is exactly what happened
    in #650/#652, twice, to two different people.

    Comparing staged-vs-published is what makes this precise rather than a guess: a project with no scoped
    assets stages nothing, publishes nothing and is silently fine, while a project that staged files and
    published none is unambiguously broken. BakeScopedAssetsTask's own FailOnEmpty cannot cover this — it
    only fires when the bake RUNS and writes zero, and here the bake ran perfectly well, just not into the
    staging this publish consumed.
  -->
  <Target Name="_RaskVerifyPublishedScopedAssets"
          AfterTargets="Publish"
          Condition=" '$(RaskWasm)' == 'true' ">
    <PropertyGroup>
      <_RaskVerifyStageDir>$(IntermediateOutputPath)rask-scoped\</_RaskVerifyStageDir>
    </PropertyGroup>
    <ItemGroup>
      <_RaskStagedScopedAsset Include="$(_RaskVerifyStageDir)_rask\a\**\*"/>
      <_RaskPublishedScopedAsset Include="$(PublishDir)wwwroot\_rask\a\**\*"/>
    </ItemGroup>
    <!-- Baked, but nothing shipped. -->
    <Error Condition=" '@(_RaskStagedScopedAsset)' != '' AND '@(_RaskPublishedScopedAsset)' == '' "
           Text="Rask: the scoped assets were baked but none reached the published output. $(_RaskVerifyStageDir)_rask/a contains @(_RaskStagedScopedAsset->Count()) file(s), while $(PublishDir)wwwroot/_rask/a has none, so every /_rask/a/ URL would 404 in the browser and any component relying on its scoped JS would never initialise. This usually means the project was built in both WasmBuildNative modes through one obj/ — clear $(IntermediateOutputPath) and publish again."/>

    <!--
      Never baked at all, and nothing shipped. This is the case the staged-vs-published check above cannot
      see: with the staging dir absent, "no scoped assets" and "the bake was skipped" look identical from
      the outside — and it is the second one that actually happened in #650, where the publish produced no
      _rask and no staging either. The bake target unconditionally RemoveDir+MakeDirs its staging, so a
      missing staging dir is proof it did not run; _RaskScopedBakeRan records that it did.

      Both halves of the condition are needed. An incremental publish can legitimately skip the whole
      build pass, and therefore the bake, while the previously published assets are still sitting in
      wwwroot and perfectly correct — requiring the published side to ALSO be empty keeps that case quiet.
    -->
    <Error Condition=" '$(_RaskScopedBakeRan)' != 'true' AND '@(_RaskPublishedScopedAsset)' == '' "
           Text="Rask: the scoped-asset bake did not run during this publish and $(PublishDir)wwwroot/_rask/a is empty, so any scoped CSS/JS this app has would 404 in the browser and any component relying on it would never initialise. The bake target (_RaskBakeScopedStaticWebAssets) is skipped when RaskWasm is not 'true' or when Rask.Wasm.Tasks.dll is missing next to Rask.Wasm.targets — check both, then clear $(IntermediateOutputPath) and publish again."/>
  </Target>

  <!--
    Globalization for a WASM app: RaskGlobalization decides whether ICU ships.

    OFF by default, because ICU is roughly 2.6 MB of icudt*.dat and most apps format nothing
    culture-sensitive. An app that does turns it on with one line:

      <RaskGlobalization>true</RaskGlobalization>

    Owned here rather than written by hand in every app's csproj so that the two properties which have
    to move together cannot drift apart. PredefinedCulturesOnly is the trap: it DEFAULTS to true
    whenever InvariantGlobalization is true, and under it CultureInfo.GetCultureInfo("hu-HU") does not
    quietly fall back — it THROWS. Setting it explicitly on the opt-in path means a stray
    InvariantGlobalization elsewhere in a build cannot silently re-arm that.

    The WasmBuildNative guard is preserved from the per-app property this replaces. InvariantGlobalization=true
    forces a native relink, which conflicts with the fast unit gate (-p:WasmBuildNative=false) — and with
    no runtime produced, invariant globalization is irrelevant anyway. Note the direction: turning
    globalization ON removes the property entirely and so removes that relink trigger, which makes the
    fast gate strictly happier, not less so.
  -->
  <PropertyGroup Condition=" '$(RaskWasm)' == 'true' ">
    <RaskGlobalization Condition=" '$(RaskGlobalization)' == '' ">false</RaskGlobalization>
    <!--
      Snapshot before the overwrite below, so the conflict check further down can still tell an app's
      own InvariantGlobalization from ours. By the time this file is imported the WebAssembly SDK has
      already defaulted the property to false, so "unset" and "explicitly false" are indistinguishable
      here — but an explicit TRUE can only have come from the app, which is the case worth catching.
    -->
    <_RaskAppInvariantGlobalization>$(InvariantGlobalization)</_RaskAppInvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RaskWasm)' == 'true' AND '$(RaskGlobalization)' != 'true'
                             AND '$(WasmBuildNative)' != 'false' ">
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RaskWasm)' == 'true' AND '$(RaskGlobalization)' == 'true' ">
    <InvariantGlobalization>false</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!--
      Asks for FULL ICU. Read the next paragraph before believing it works.

      This is spelled correctly as of #853 — it was `WasmIncludeFullIcu` before, and the SDK's property
      is `WasmIncludeFullIcuData`. MSBuild has no unknown-property diagnostic, so the misspelling set a
      name nobody read, silently, for as long as it existed. FullIcuPropertyNameTests pins the spelling
      against the SDK's own targets so it cannot drift back.

      It still does not change what a Rask app publishes, and that is MEASURED, not assumed: publishing
      the WASM showcase with this true and false gives byte-identical output, three ICU shards either
      way. The property is honoured in _GetWasmGenerateAppBundleDependencies (BrowserWasmApp.targets),
      which belongs to the WasmAppBuilder bundle path; a Rask app publishes through
      Microsoft.NET.Sdk.WebAssembly, whose static-web-assets pipeline never runs that target and has no
      ICU handling of its own. Kept correctly spelled rather than removed, because it IS the right
      request — nothing on this path grants it.

      So the shard is still chosen at boot from navigator.languages[0], by the VISITOR'S BROWSER rather
      than by the languages the app ships: an en+hu app opened in an English browser loads EFIGS, which
      has no Hungarian, and with PredefinedCulturesOnly=false above hu-HU RESOLVES, does not throw, and
      formats dates in English. That limitation is live and documented in docs/localization.md; #853
      carries the options for closing it, each with a size trade-off.
    -->
    <WasmIncludeFullIcuData Condition=" '$(WasmIncludeFullIcuData)' == '' ">true</WasmIncludeFullIcuData>
  </PropertyGroup>

  <!--
    The one failure mode the properties above cannot express: an app asks for globalization and ALSO
    sets InvariantGlobalization=true by hand. The SDK would honour the invariant flag, every culture
    would format identically, and the app would look like it had simply been given wrong translations.
    Fail the build instead of shipping that.
  -->
  <Target Name="_RaskGlobalizationConflict" BeforeTargets="Build"
          Condition=" '$(RaskWasm)' == 'true' AND '$(RaskGlobalization)' == 'true' AND '$(_RaskAppInvariantGlobalization)' == 'true' ">
    <Error Text="Rask: RaskGlobalization is true but InvariantGlobalization is also true, so the runtime would ship without culture data and every culture would format identically — CultureInfo.GetCultureInfo(&quot;hu-HU&quot;) would throw. Remove the InvariantGlobalization property; RaskGlobalization owns it."/>
  </Target>

  <!--
    Tailwind. Packed alongside this file by src\RaskTailwindBuildPack.targets, and imported from here
    because NuGet auto-imports only build/<PackageId>.{props,targets}. Referencing this host package is
    the whole of how an app gets Tailwind: there is no Rask.Tailwind package to add and no flag to pass.

    It gates itself on the project having a stylesheet to compile, so importing it unconditionally costs
    a project without one nothing.

    The Exists guard is for the source tree: Rask.Tailwind.targets is packed from Rask.Tailwind's own
    build/ folder and has no sibling here, so in-repo projects take the Directory.Build.targets route
    instead and this import is a no-op.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Rask.Tailwind.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)Rask.Tailwind.targets') "/>

</Project>
