<Project>

  <!--
    Build-time prerendering for a browser-WebAssembly app.

    Such an app has no server, so the first thing anything receives is the boot shell: a spinner, and
    the word "Loading". The real markup does not exist until megabytes of runtime have downloaded, so
    that is what a crawler indexes and what a social card previews.

    This renders each route to real HTML at publish and writes it beside the bundle. The bundle still
    boots and takes the page over; the difference is what arrives before it does.

    Opt in with <RaskPrerender>true</RaskPrerender>. Publish-only, like the bundle itself.

    HOW IT RUNS: a browser-wasm assembly cannot execute on the desktop, so the app's own sources are
    compiled a second time for net10.0 into a companion project in obj/, and that is what renders. The
    companion compiles Program.cs TOO — deliberately. That file is where the app registers its
    services, and a page that injects anything would otherwise find nothing registered.
    WasmHostBuilder.RunAsync sees RASK_PRERENDER_OUT and prerenders instead of booting, so the app's
    real entry point drives it and there is no second place to keep registrations in sync.
  -->

  <PropertyGroup>
    <RaskPrerender Condition=" '$(RaskPrerender)' == '' ">false</RaskPrerender>
    <RaskPrerenderCompanionDir Condition=" '$(RaskPrerenderCompanionDir)' == '' ">$(BaseIntermediateOutputPath)rask-prerender\</RaskPrerenderCompanionDir>
    <RaskPrerenderCompanionName Condition=" '$(RaskPrerenderCompanionName)' == '' ">$(AssemblyName).Prerender</RaskPrerenderCompanionName>
    <RaskPrerenderCompanionProject>$(RaskPrerenderCompanionDir)$(RaskPrerenderCompanionName).csproj</RaskPrerenderCompanionProject>
    <!--
      A SIBLING of the companion's project directory, never a child. The companion globs its own folder
      for sources, so building into it would make each run an input to the next.
    -->
    <RaskPrerenderCompanionOutput Condition=" '$(RaskPrerenderCompanionOutput)' == '' ">$(BaseIntermediateOutputPath)rask-prerender-bin\</RaskPrerenderCompanionOutput>
  </PropertyGroup>

  <Target Name="RaskGeneratePrerenderCompanion" Condition=" '$(RaskPrerender)' == 'true' ">

    <!--
      No framework version to sniff and no source-tree escape hatch: the companion carries the app's OWN
      references, so it reaches Rask.Wasm exactly the way the app does — as a package in a consuming app,
      as a project inside this repo. An earlier version named the framework packages itself and had to
      ask which form to use; carrying the references removed the question.
    -->

    <ItemGroup>
      <!--
        The app's packages minus the ones its SDK injected. Microsoft.NET.Sdk.WebAssembly.Pack and
        Microsoft.NET.ILLink.Tasks arrive implicitly from the WebAssembly SDK, mean nothing to a desktop
        build, and carry versions the SDK owns — which Central Package Management then refuses, because
        under CPM a PackageReference may not name its own version.
      -->
      <_RaskAppPackage Include="@(PackageReference)"
                       Condition=" '%(PackageReference.IsImplicitlyDefined)' != 'true' "/>
    </ItemGroup>

    <ItemGroup>
      <!--
        %2A is '*' and %3B is ';', escaped. These lines are DATA, but MSBuild reads an item Include as a
        file glob and splits it on semicolons — so an unescaped wildcard line matches nothing on disk and
        vanishes from the output entirely, and a line carrying a semicolon is cut in two.
      -->
      <_RaskPrerenderLine Include="&lt;Project Sdk=&quot;Microsoft.NET.Sdk&quot;&gt;"/>
      <_RaskPrerenderLine Include="  &lt;!-- GENERATED by Rask on publish. Edits are lost%3B change the app instead. --&gt;"/>
      <_RaskPrerenderLine Include="  &lt;PropertyGroup&gt;"/>
      <_RaskPrerenderLine Include="    &lt;TargetFramework&gt;net10.0&lt;/TargetFramework&gt;"/>
      <_RaskPrerenderLine Include="    &lt;OutputType&gt;Exe&lt;/OutputType&gt;"/>
      <_RaskPrerenderLine Include="    &lt;Nullable&gt;$(Nullable)&lt;/Nullable&gt;"/>
      <_RaskPrerenderLine Include="    &lt;ImplicitUsings&gt;$(ImplicitUsings)&lt;/ImplicitUsings&gt;"/>
      <_RaskPrerenderLine Include="    &lt;LangVersion&gt;$(LangVersion)&lt;/LangVersion&gt;"/>
      <_RaskPrerenderLine Include="    &lt;RootNamespace&gt;$(RootNamespace)&lt;/RootNamespace&gt;"/>
      <_RaskPrerenderLine Include="    &lt;AssemblyName&gt;$(RaskPrerenderCompanionName)&lt;/AssemblyName&gt;"/>
      <_RaskPrerenderLine Include="    &lt;EnableDefaultCompileItems&gt;false&lt;/EnableDefaultCompileItems&gt;"/>
      <!-- The app's own analyzers would re-report what the real build already reported. -->
      <_RaskPrerenderLine Include="    &lt;RunAnalyzers&gt;false&lt;/RunAnalyzers&gt;"/>
      <!--
        Nor may a warning fail this build, for the same reason and one stronger one: the companion's
        reference closure is NOT the app's. It targets net10.0, so a multi-targeted dependency resolves
        its non-browser face — and the Rask metapackage's net10.0 face carries the server-only pieces
        the browser app never saw, Rask.Dashboard among them. Two components that never met in the app
        meet here, and RASK040 (a warning) became an error under warnings-as-errors and failed the
        whole publish. That diagnostic is about which chain entries the app gets; the companion only
        renders, and the real build is what judges the app's own code.
      -->
      <_RaskPrerenderLine Include="    &lt;TreatWarningsAsErrors&gt;false&lt;/TreatWarningsAsErrors&gt;"/>
      <_RaskPrerenderLine Include="    &lt;WarningsAsErrors&gt;&lt;/WarningsAsErrors&gt;"/>
      <_RaskPrerenderLine Include="  &lt;/PropertyGroup&gt;"/>

      <!--
        Program.cs is INCLUDED, unlike the browser companion's. It is where the services are registered,
        and RunAsync prerenders rather than boots when RASK_PRERENDER_OUT is set.
      -->
      <_RaskPrerenderLine Include="  &lt;ItemGroup&gt;"/>
      <_RaskPrerenderLine Include="    &lt;Compile Include=&quot;$(MSBuildProjectDirectory)\%2A%2A\%2A.cs&quot; /&gt;"/>
      <_RaskPrerenderLine Include="    &lt;Compile Remove=&quot;$(MSBuildProjectDirectory)\obj\%2A%2A&quot; /&gt;"/>
      <_RaskPrerenderLine Include="    &lt;Compile Remove=&quot;$(MSBuildProjectDirectory)\bin\%2A%2A&quot; /&gt;"/>
      <_RaskPrerenderLine Include="  &lt;/ItemGroup&gt;"/>

      <!--
        THE APP'S OWN REFERENCES, carried over rather than re-listed. The companion compiles the app's
        sources, so it needs everything they compile against — its shared class library, its component
        packages, all of it. Naming only the framework's packages here compiles an app that has no
        dependencies and nothing else, which is not an app anyone writes.

        Analyzer references are re-emitted with their metadata: dropping OutputItemType would reference
        a generator as a library, and dropping ReferenceOutputAssembly would try to link one.
      -->
      <_RaskPrerenderLine Include="  &lt;ItemGroup&gt;"/>
      <_RaskPrerenderLine Include="@(ProjectReference->WithMetadataValue('OutputItemType', 'Analyzer')->'    &lt;ProjectReference Include=&quot;%(FullPath)&quot; OutputItemType=&quot;Analyzer&quot; ReferenceOutputAssembly=&quot;false&quot; /&gt;')"/>
      <_RaskPrerenderLine Include="@(ProjectReference->WithMetadataValue('ReferenceOutputAssembly', '')->'    &lt;ProjectReference Include=&quot;%(FullPath)&quot; /&gt;')"/>
      <_RaskPrerenderLine Include="@(_RaskAppPackage->'    &lt;PackageReference Include=&quot;%(Identity)&quot; Version=&quot;%(Version)&quot; /&gt;')"
                          Condition=" '%(_RaskAppPackage.Version)' != '' "/>
      <_RaskPrerenderLine Include="@(_RaskAppPackage->'    &lt;PackageReference Include=&quot;%(Identity)&quot; /&gt;')"
                          Condition=" '%(_RaskAppPackage.Version)' == '' "/>
      <_RaskPrerenderLine Include="  &lt;/ItemGroup&gt;"/>
      <_RaskPrerenderLine Include="&lt;/Project&gt;"/>
    </ItemGroup>

    <MakeDir Directories="$(RaskPrerenderCompanionDir)"/>
    <WriteLinesToFile File="$(RaskPrerenderCompanionProject)" Lines="@(_RaskPrerenderLine)"
                      Overwrite="true" WriteOnlyWhenDifferent="true"/>

    <Message Importance="high" Text="Rask: generated the prerender companion at $(RaskPrerenderCompanionProject)"/>
  </Target>

  <Target Name="RaskPrerenderPages"
          Condition=" '$(RaskPrerender)' == 'true' "
          DependsOnTargets="RaskGeneratePrerenderCompanion"
          AfterTargets="Publish">

    <Message Importance="high" Text="Rask: prerendering pages into $(PublishDir)wwwroot"/>

    <!--
      A separate process, like the browser companion's publish: this project carries a different SDK
      and target framework, and building it in-process shares the global properties of the build that
      started it. nodeReuse:false because a reused node holds the previous build's assemblies loaded,
      and this is a nested build of a project that did not exist when the outer one began.
    -->
    <Exec Command="dotnet build &quot;$(RaskPrerenderCompanionProject)&quot; -c $(Configuration) -o &quot;$(RaskPrerenderCompanionOutput)&quot; --nologo -v:minimal -nodeReuse:false"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>

    <!--
      ConsoleToMSBuild so the summary line below can be read back. StandardOutputImportance keeps the
      per-route log visible in a normal build, as it was before it was captured — a capture that also
      silenced the skip list would trade one blind spot for another.
    -->
    <!--
      RaskPathBase travels with it. A browser boot reads the prefix off <base href>; there is no
      document here, so without this the pass renders every PathBase-prefixed URL against an empty
      prefix and bakes root-relative paths — `/_rask/a/x.css` rather than `/docs/_rask/a/x.css`. A
      <base href> cannot rescue those: it only applies to RELATIVE URLs, and a leading slash means the
      origin root. Under a sub-path deploy the page then loads none of its own scoped assets.
    -->
    <Exec Command="dotnet &quot;$(RaskPrerenderCompanionOutput)$(RaskPrerenderCompanionName).dll&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="RASK_PRERENDER_OUT=$(PublishDir)wwwroot;RASK_PRERENDER_PATH_BASE=$(RaskPathBase)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="high">
      <Output TaskParameter="ConsoleOutput" ItemName="_RaskPrerenderLog"/>
    </Exec>

    <!--
      Asked of what the PASS REPORTED, not of the filesystem. The obvious check — glob the output for
      an index.html — cannot work here, and quietly did not: the root route's own output is
      wwwroot/index.html, which is the boot shell the SDK published moments earlier. That file is
      there whether the pass wrote every page, one page, or none, so the glob was non-empty in all
      three cases and the warning below could never fire. A publish that prerendered nothing looked
      exactly like one that worked, which is the single thing this guard exists to tell apart.

      So the pass prints a summary line and the build reads it back. `written=0` is an unambiguous
      statement by the only component that knows.
    -->
    <PropertyGroup>
      <_RaskPrerenderLogText>@(_RaskPrerenderLog, '%0A')</_RaskPrerenderLogText>
      <_RaskPrerenderWroteNothing>false</_RaskPrerenderWroteNothing>
      <_RaskPrerenderWroteNothing Condition="$(_RaskPrerenderLogText.Contains('result written=0'))">true</_RaskPrerenderWroteNothing>
      <_RaskPrerenderReported>false</_RaskPrerenderReported>
      <_RaskPrerenderReported Condition="$(_RaskPrerenderLogText.Contains('result written='))">true</_RaskPrerenderReported>
    </PropertyGroup>

    <Warning Condition=" '$(_RaskPrerenderWroteNothing)' == 'true' "
             Text="Rask: prerendering ran and wrote no pages. Every route was either parameterised, faulted, or did not settle within the budget — see the log above for which. The bundle still serves them at runtime, so this is a lost optimisation rather than a broken site."/>

    <!--
      The pass not reporting at all is a different failure from it reporting zero — an older
      Rask.Wasm on the companion's reference graph, or a run that died before its summary. Saying
      nothing here would restore exactly the silence this target was rewritten to remove.
    -->
    <Warning Condition=" '$(_RaskPrerenderReported)' != 'true' "
             Text="Rask: prerendering ran but reported no summary line, so the build cannot tell how many pages it wrote. Treat the published bundle as un-prerendered until this is explained."/>
  </Target>

</Project>
