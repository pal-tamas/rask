<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rask.Wasm</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>Rask.Wasm</PackageId>
    <Title>Rask — Browser WASM Runtime</Title>
    <Description>Rask browser-WASM runtime. Boots a Rask App in the browser via dotnet WASM. Ships the JS boot scripts, the framework page shell, and an MSBuild integration that wires them into a WasmGenerateAppBundle project. Includes Rask.Core and the Rask source generators.</Description>
  </PropertyGroup>


  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <IsTrimmable>true</IsTrimmable>
    <!-- Runs the trim + AOT Roslyn analysers over the runtime's browser code so the
         warnings-as-errors build continuously guarantees a full-AOT (RunAOTCompilation=true)
         publish stays clean — no native relink needed on every build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <DefineConstants>$(DefineConstants);RASK_BROWSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj" PrivateAssets="all"/>
    <!-- The HTML/SVG element family, split out of Rask.Core.Components. Every host renders HTML,
         so every host carries it; bundled into lib/ next to Rask.Core.dll below. -->
    <ProjectReference Include="..\Rask.Html\Rask.Html.csproj" PrivateAssets="all"/>
    <!--
      Build-order-only dependency on the MSBuild task project. Rask.Wasm.Tasks compiles
      Rask.Wasm.Tasks.dll and (via its CopyTaskAssemblyToRaskWasmBuild target) drops it into
      build/ here, where build/Rask.Wasm.targets loads it through <UsingTask AssemblyFile=...>
      and where the build\** Pack glob picks it up for the nupkg. The DLL is a generated build
      artifact (gitignored, not committed), so this reference guarantees it exists before
      Rask.Wasm builds or packs. ReferenceOutputAssembly="false" + SkipGetTargetFrameworkProperties
      keep it purely an ordering edge: no compile reference, no nupkg dependency, no cross-TFM
      (net10.0-browser vs netstandard2.0) compatibility check.
    -->
    <ProjectReference Include="..\Rask.Wasm.Tasks\Rask.Wasm.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <!--
      IHostedService, so AddHostedService means the same thing here as on the server (see
      WasmHostedServices). Abstractions only — no generic host, no reflection, nothing that would
      trouble the browser trimmer.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    <!--
      Rask.Core uses Microsoft.AspNetCore.Authorization (in RouteAuthorizationGuard).
      On the WASM track there's no Microsoft.AspNetCore.App framework reference, so we
      surface this dep at the package boundary so consumers can restore it.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authorization"/>
    <!--
      Same reasoning: this project uses Microsoft.JSInterop directly (JSInterop/WasmJSRuntime,
      WasmLiveSession, the Browser/* wrappers), but it only ever arrived transitively through the
      PrivateAssets="all" Rask.Core reference — which deliberately keeps Core out of the nuspec, so
      the dep was never declared for consumers to restore.
    -->
    <PackageReference Include="Microsoft.JSInterop"/>
    <!--
      Same reasoning again, and the one that was missed: Rask.Core pools its StringBuilders through
      Microsoft.Extensions.ObjectPool (RaskStringBuilderPool.Shared, on the render path in Component,
      Live/LivePayload and HeadAssetRegistry). Core is bundled into lib/ with PrivateAssets="all", so its
      package dependencies never reach the nuspec, and nothing else this package declares brings ObjectPool
      in transitively — Rask.Server is only immune because Microsoft.AspNetCore.App carries it, and the WASM
      track has no framework reference. Without this line a consumer restoring the published package boots
      and then dies with a FileNotFoundException on the first render. See #742; pinned by
      PackageDependencyTests.
    -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool"/>
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Wasm.Tests"/>
  </ItemGroup>

  <!--
    Browser-shipped assets live under Browser/ and are wired into a consumer's WASM build via
    build/Rask.Wasm.targets, which sets WasmMainJSPath and appends to WasmExtraFilesToDeploy.
    Browser/ and build/ are packed at the package root so the auto-import in the consumer's project
    sees them under the package's top-level folders, matching the in-repo layout that
    Directory.Build.targets imports from.

    All three .js files there are BUILD OUTPUT and are not tracked in git — the readable form is the
    TypeScript they are bundled from. They were tracked while the build assembled them by pasting
    files together at `// @@RASK_*@@` markers, because the spliced result was the only place the
    whole runtime could be read as one thing. Edit Resources/*.ts and Browser/main.ts instead.
  -->
  <ItemGroup>
    <None Include="Browser\index.html" Pack="true" PackagePath="Browser\"/>
    <None Include="Browser\main.js" Pack="true" PackagePath="Browser\"/>
    <None Include="Browser\rask.wasm.js" Pack="true" PackagePath="Browser\"/>
    <None Include="Browser\rask-sw.js" Pack="true" PackagePath="Browser\"/>
    <!--
      The task DLLs are named explicitly and excluded from the glob: a glob is expanded at project
      EVALUATION, before the ProjectReference that produces them has built, so on a tree where they
      are not already on disk the pack SUCCEEDS and ships a package whose <UsingTask> points at a
      file that is not in it. A literal Include needs the file only when the item is copied, so it is
      collected — and a genuinely missing one is NU5019 rather than a silent omission (#852).
    -->
    <None Include="build\**"
          Exclude="build\Rask.Wasm.Tasks.dll;build\Rask.TypeScript.Tasks.dll"
          Pack="true" PackagePath="build\"/>
    <None Include="build\Rask.Wasm.Tasks.dll" Pack="true" PackagePath="build\"/>
    <None Include="build\Rask.TypeScript.Tasks.dll" Pack="true" PackagePath="build\"/>
  </ItemGroup>

  <!--
    Every file the browser bundles can reach, so an edit to any of them re-bundles. Stated as
    ItemGroups rather than in the targets' Inputs because a target's Inputs does not expand
    wildcards — it would treat the pattern as a literal filename and rebuild unconditionally.
  -->
  <ItemGroup>
    <_RaskWasmSharedTs Include="..\Rask.Core\Resources\*.ts"
                       Exclude="..\Rask.Core\Resources\rask-sw-shared.ts;..\Rask.Core\Resources\*.d.ts"/>
    <_RaskWasmClientTs Include="Resources\rask.wasm.ts;Resources\rask-wasm-api.ts;@(_RaskWasmSharedTs)"/>
    <_RaskWasmMainTs Include="Browser\main.ts"/>
    <_RaskWasmSwTs Include="Resources\rask-sw.ts;..\Rask.Core\Resources\rask-sw-shared.ts"/>
  </ItemGroup>

  <PropertyGroup>
    <_RaskEsbuildMinify Condition=" '$(Configuration)' == 'Release' ">--minify</_RaskEsbuildMinify>
    <!--
      The browser bundles are the same bytes for every TargetFramework, and this project
      multi-targets: without this, both inner builds run the same esbuild command against the same
      output path at the same time. One inner build owns them.
    -->
    <_RaskBundleBrowserAssets Condition=" '$(TargetFramework)' == 'net10.0-browser' ">true</_RaskBundleBrowserAssets>
  </PropertyGroup>

  <!--
    The WASM client runtime. Resources/rask.wasm.ts is the host entry point: it IMPORTS the shared
    modules it needs from Rask.Core/Resources and esbuild bundles the graph into Browser/rask.wasm.js.

    This replaces an MSBuild string-replace splice that pasted eleven files into one template at
    `// @@RASK_*@@` markers. The order was load-bearing, the cross-module references were implicit
    `window.__rask*` globals, and nothing checked either.

    Format is esm, not iife: .NET imports this module by name through JSHost.ImportAsync and main.js
    imports it for setExports, so its exports have to survive as real module exports.
  -->
  <Target Name="_RaskBundleClientJs" BeforeTargets="PrepareForBuild;AssignTargetPaths"
          Condition=" '$(_RaskBundleBrowserAssets)' == 'true' "
          Inputs="@(_RaskWasmClientTs)"
          Outputs="$(IntermediateOutputPath)rask-bundles\rask.wasm.stamp">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;$(MSBuildProjectDirectory)/Resources/rask.wasm.ts&quot; --bundle --format=esm --target=es2020 --log-level=warning --outfile=&quot;$(MSBuildProjectDirectory)/Browser/rask.wasm.js&quot; $(_RaskEsbuildMinify)"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
    <MakeDir Directories="$(IntermediateOutputPath)rask-bundles\"/>
    <Touch Files="$(IntermediateOutputPath)rask-bundles\rask.wasm.stamp" AlwaysCreate="true"/>
  </Target>

  <!--
    The boot hook. Browser/main.ts boots the .NET runtime and hands the assembly exports to the
    client runtime.

    Two imports stay EXTERNAL rather than being bundled in. `./_framework/dotnet.js` is the .NET
    runtime's own file, emitted by the WASM SDK into the published app and not ours to inline;
    `./rask.wasm.js` is the sibling bundle above, which .NET also imports by that name — inlining it
    would give the page two copies of the runtime, each with its own state.
  -->
  <Target Name="_RaskBundleMainJs" BeforeTargets="PrepareForBuild;AssignTargetPaths"
          Condition=" '$(_RaskBundleBrowserAssets)' == 'true' "
          Inputs="@(_RaskWasmMainTs)"
          Outputs="$(IntermediateOutputPath)rask-bundles\main.stamp">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;$(MSBuildProjectDirectory)/Browser/main.ts&quot; --bundle --format=esm --target=es2022 --log-level=warning --external:./_framework/* --external:./rask.wasm.js --outfile=&quot;$(MSBuildProjectDirectory)/Browser/main.js&quot; $(_RaskEsbuildMinify)"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
    <MakeDir Directories="$(IntermediateOutputPath)rask-bundles\"/>
    <Touch Files="$(IntermediateOutputPath)rask-bundles\main.stamp" AlwaysCreate="true"/>
  </Target>

  <!--
    Resources/rask-sw.ts holds the WASM worker's offline app-shell strategy and background-sync
    forwarding, and IMPORTS the Core shared push / notificationclick handlers; esbuild bundles the two
    into the served Browser/rask-sw.js. Replaces an MSBuild string-replace over a @@RASK_SW@@ marker,
    so the dependency is stated in the file that has it and checked by the compiler.

    Edit Resources/rask-sw.ts, never Browser/rask-sw.js — the latter is build output.
  -->
  <Target Name="_RaskBundleServiceWorker" BeforeTargets="PrepareForBuild;AssignTargetPaths"
          Condition=" '$(_RaskBundleBrowserAssets)' == 'true' "
          Inputs="@(_RaskWasmSwTs)"
          Outputs="$(IntermediateOutputPath)rask-bundles\rask-sw.stamp">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;$(MSBuildProjectDirectory)/Resources/rask-sw.ts&quot; --bundle --format=iife --target=es2019 --log-level=warning --outfile=&quot;$(MSBuildProjectDirectory)/Browser/rask-sw.js&quot; $(_RaskEsbuildMinify)"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
    <MakeDir Directories="$(IntermediateOutputPath)rask-bundles\"/>
    <Touch Files="$(IntermediateOutputPath)rask-bundles\rask-sw.stamp" AlwaysCreate="true"/>
  </Target>

  <!--
    Bundle Rask.Core.dll into each lib/{TFM}/ folder alongside Rask.Wasm.dll. NuGet's TFM
    folder convention writes net10.0-browser1.0 (with the explicit platform version) for
    the browser TFM, matching where it places Rask.Wasm.dll itself. PrivateAssets="all" on
    the Core ProjectReference keeps the Rask.Core "package" out of the nuspec dependency
    list — we pack its DLL explicitly here. The source generator goes at
    analyzers/dotnet/cs/ (the generator project sets IncludeBuildOutput=false so it does
    not flow with the consumer's build output).
  -->
  <!-- Analyzer + generator + IDE code-fix payload packed into analyzers/dotnet/cs/ (shared with Rask.Server). -->
  <Import Project="..\RaskAnalyzerPack.targets"/>
  <!-- Rask.Core's build integration packed to build/, imported by build/Rask.Wasm.targets. -->
  <Import Project="..\RaskCoreBuildPack.targets"/>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_RaskAddCoreToLib</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_RaskAddCoreToLib">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Core.dll"
                              PackagePath="lib/net10.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0' "/>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Core.dll"
                              PackagePath="lib/net10.0-browser1.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0-browser' "/>
      <!-- Ship Rask.Core's XML docs next to its bundled DLL so Core's public API surfaces
           IntelliSense for consumers too. -->
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Core.xml"
                              PackagePath="lib/net10.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0' "/>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Core.xml"
                              PackagePath="lib/net10.0-browser1.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0-browser' "/>
      <!-- Rask.Html.dll/.xml — the HTML/SVG element family, bundled on the same terms as Rask.Core. -->
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Html.dll"
                              PackagePath="lib/net10.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0' "/>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Html.dll"
                              PackagePath="lib/net10.0-browser1.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0-browser' "/>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Html.xml"
                              PackagePath="lib/net10.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0' "/>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Html.xml"
                              PackagePath="lib/net10.0-browser1.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0-browser' "/>
    </ItemGroup>
  </Target>

</Project>
