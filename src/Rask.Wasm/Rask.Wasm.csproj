<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rask.Wasm</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>Rask.Wasm</PackageId>
    <Title>Rask — Browser WASM Runtime</Title>
    <Description>Rask browser-WASM runtime. Boots a Rask App in the browser via dotnet WASM. Ships the JS boot scripts, the framework page shell, and an MSBuild integration that wires them into a WasmGenerateAppBundle project. Includes Rask.Core and the Rask source generators.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
    <IsTrimmable>true</IsTrimmable>
    <!-- Runs the trim + AOT Roslyn analysers over the runtime's browser code so the
         warnings-as-errors build continuously guarantees a full-AOT (RunAOTCompilation=true)
         publish stays clean — no native relink needed on every build. -->
    <IsAotCompatible>true</IsAotCompatible>
    <DefineConstants>$(DefineConstants);RASK_BROWSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj" PrivateAssets="all"/>
    <!-- Rask.Client: the WASM+Native-shared in-process client APIs (IShare). Bundled into lib/ below like
         Rask.Core (PrivateAssets="all" keeps it out of the nuspec dependency list). -->
    <ProjectReference Include="..\Rask.Client\Rask.Client.csproj" PrivateAssets="all"/>
    <!--
      Build-order-only dependency on the MSBuild task project. Rask.Wasm.Tasks compiles
      Rask.Wasm.Tasks.dll and (via its CopyTaskAssemblyToRaskWasmBuild target) drops it into
      build/ here, where build/Rask.Wasm.targets loads it through <UsingTask AssemblyFile=...>
      and where the build\** Pack glob picks it up for the nupkg. The DLL is a generated build
      artifact (gitignored, not committed), so this reference guarantees it exists before
      Rask.Wasm builds or packs. ReferenceOutputAssembly="false" + SkipGetTargetFrameworkProperties
      keep it purely an ordering edge: no compile reference, no nupkg dependency, no cross-TFM
      (net10.0-browser vs netstandard2.0) compatibility check.
    -->
    <ProjectReference Include="..\Rask.Wasm.Tasks\Rask.Wasm.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <!--
      Rask.Core uses Microsoft.AspNetCore.Authorization (in RouteAuthorizationGuard).
      On the WASM track there's no Microsoft.AspNetCore.App framework reference, so we
      surface this dep at the package boundary so consumers can restore it.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authorization"/>
    <!--
      Same reasoning: this project uses Microsoft.JSInterop directly (JSInterop/WasmJSRuntime,
      WasmLiveSession, the Browser/* wrappers), but it only ever arrived transitively through the
      PrivateAssets="all" Rask.Core reference — which deliberately keeps Core out of the nuspec, so
      the dep was never declared for consumers to restore.
    -->
    <PackageReference Include="Microsoft.JSInterop"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Wasm.Tests"/>
  </ItemGroup>

  <!--
    Browser-shipped assets (main.js + rask.wasm.js + index.html) live under Browser/ and are
    wired into a consumer's WASM build via build/Rask.Wasm.targets, which sets WasmMainJSPath
    and appends to WasmExtraFilesToDeploy. Browser/ and build/ are packed at the package root
    so the auto-import in the consumer's project sees them under the package's top-level
    folders, matching the in-repo layout that Directory.Build.targets imports from.

    rask.wasm.js itself is generated at build time by _RaskSpliceClientJs (below), which
    splices shared Rask.Core/Resources files into the template Resources/rask.wasm.js:
    rask-dom.js (the diff codec, at @@RASK_DOM@@), rask-morph.js (the full-HTML morph,
    at @@RASK_MORPH@@), and rask-api.js (framework interop helpers __raskEl/__raskApi, at
    @@RASK_API@@). The generated artifact lands directly in Browser/ so the existing
    Browser/** Pack glob picks it up.
  -->
  <!--
    Browser/ assets shipped in every NuGet package: main.js (the dotnet boot hook) and
    index.html (the framework page shell). rask.wasm.js is added separately below — its
    pack source switches between the source-tracked file (Debug) and the minified
    intermediate (Release) so the in-repo Browser/rask.wasm.js stays as the readable form
    while NuGet consumers get the minified bytes.
  -->
  <ItemGroup>
    <None Include="Browser\main.js" Pack="true" PackagePath="Browser\"/>
    <None Include="Browser\index.html" Pack="true" PackagePath="Browser\"/>
    <None Include="Browser\rask-sw.js" Pack="true" PackagePath="Browser\"/>
    <None Include="$(BaseIntermediateOutputPath)$(Configuration)\rask.wasm.js"
          Pack="true" PackagePath="Browser\rask.wasm.js"
          Condition=" '$(Configuration)' == 'Release' "/>
    <None Include="Browser\rask.wasm.js"
          Pack="true" PackagePath="Browser\rask.wasm.js"
          Condition=" '$(Configuration)' != 'Release' "/>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
  </ItemGroup>

  <Import Project="..\..\build\Rask.MinifyJs.targets"/>

  <!--
    Always write the unminified spliced JS to Browser/rask.wasm.js — that's the file the
    in-repo Rask.Example.Wasm project consumes via the framework targets (and the source
    contributors look at). NuGet consumers see whichever version is packed (above).
  -->
  <Target Name="_RaskSpliceClientJs" BeforeTargets="PrepareForBuild;AssignTargetPaths;_RaskMinifyClientJs"
          Inputs="Resources\rask.wasm.js;Resources\rask-wasm-api.js;..\Rask.Core\Resources\rask-dom.js;..\Rask.Core\Resources\rask-morph.js;..\Rask.Core\Resources\rask-api.js;..\Rask.Core\Resources\rask-events.js;..\Rask.Core\Resources\rask-pwa.js;..\Rask.Core\Resources\rask-input.js;..\Rask.Core\Resources\rask-scoped.js"
          Outputs="Browser\rask.wasm.js">
    <PropertyGroup>
      <_RaskWasmTemplate>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Resources\rask.wasm.js'))</_RaskWasmTemplate>
      <_RaskDomBody>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\Rask.Core\Resources\rask-dom.js'))</_RaskDomBody>
      <_RaskMorphBody>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\Rask.Core\Resources\rask-morph.js'))</_RaskMorphBody>
      <_RaskApiBody>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\Rask.Core\Resources\rask-api.js'))</_RaskApiBody>
      <_RaskEventsBody>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\Rask.Core\Resources\rask-events.js'))</_RaskEventsBody>
      <_RaskPwaBody>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\Rask.Core\Resources\rask-pwa.js'))</_RaskPwaBody>
      <_RaskWasmApiBody>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Resources\rask-wasm-api.js'))</_RaskWasmApiBody>
      <_RaskInputBody>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\Rask.Core\Resources\rask-input.js'))</_RaskInputBody>
      <_RaskScopedBody>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\Rask.Core\Resources\rask-scoped.js'))</_RaskScopedBody>
      <_RaskWasmJs>$(_RaskWasmTemplate.Replace('// @@RASK_DOM@@', '$(_RaskDomBody)').Replace('// @@RASK_MORPH@@', '$(_RaskMorphBody)').Replace('// @@RASK_API@@', '$(_RaskApiBody)').Replace('// @@RASK_EVENTS@@', '$(_RaskEventsBody)').Replace('// @@RASK_PWA@@', '$(_RaskPwaBody)').Replace('// @@RASK_WASM_API@@', '$(_RaskWasmApiBody)').Replace('// @@RASK_INPUT@@', '$(_RaskInputBody)').Replace('// @@RASK_SCOPED@@', '$(_RaskScopedBody)'))</_RaskWasmJs>
    </PropertyGroup>
    <WriteLinesToFile File="Browser\rask.wasm.js" Lines="$(_RaskWasmJs)" Overwrite="true" WriteOnlyWhenDifferent="true"/>
  </Target>

  <!--
    Release builds: write a minified copy to the intermediate dir. The pack item-group
    picks that up as Browser/rask.wasm.js inside the package, leaving the source-tracked
    Browser/rask.wasm.js readable for git diffs and IDE inspection. The minifier strips
    block comments, full-line // comments, and blank lines — state-aware so strings,
    template literals, and regex literals stay untouched.

    Split out from the splice target so each has its own Inputs/Outputs incremental check;
    otherwise the splice's up-to-date check skips the whole compound target.
  -->
  <Target Name="_RaskMinifyClientJs" BeforeTargets="PrepareForBuild;AssignTargetPaths"
          Condition=" '$(Configuration)' == 'Release' "
          Inputs="Browser\rask.wasm.js"
          Outputs="$(BaseIntermediateOutputPath)$(Configuration)\rask.wasm.js">
    <MakeDir Directories="$(IntermediateOutputPath)"/>
    <Copy SourceFiles="Browser\rask.wasm.js" DestinationFiles="$(BaseIntermediateOutputPath)$(Configuration)\rask.wasm.js"/>
    <RaskMinifyJs InputFile="$(BaseIntermediateOutputPath)$(Configuration)\rask.wasm.js"
                  OutputFile="$(BaseIntermediateOutputPath)$(Configuration)\rask.wasm.js"/>
  </Target>

  <!--
    Assemble the served service worker the same way as rask.wasm.js: splice the Core shared push /
    notificationclick handlers (rask-sw-shared.js, at @@RASK_SW@@) into the WASM SW template
    (Resources/rask-sw.js, which holds the offline app-shell strategy) and write the result to the
    tracked, served Browser/rask-sw.js. Edit Resources/rask-sw.js, not Browser/rask-sw.js.
  -->
  <Target Name="_RaskSpliceServiceWorker" BeforeTargets="PrepareForBuild;AssignTargetPaths"
          Inputs="Resources\rask-sw.js;..\Rask.Core\Resources\rask-sw-shared.js"
          Outputs="Browser\rask-sw.js">
    <PropertyGroup>
      <_RaskSwTemplate>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Resources\rask-sw.js'))</_RaskSwTemplate>
      <_RaskSwSharedBody>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\Rask.Core\Resources\rask-sw-shared.js'))</_RaskSwSharedBody>
      <_RaskSwJs>$(_RaskSwTemplate.Replace('// @@RASK_SW@@', '$(_RaskSwSharedBody)'))</_RaskSwJs>
    </PropertyGroup>
    <WriteLinesToFile File="Browser\rask-sw.js" Lines="$(_RaskSwJs)" Overwrite="true" WriteOnlyWhenDifferent="true"/>
  </Target>

  <!--
    Bundle Rask.Core.dll into each lib/{TFM}/ folder alongside Rask.Wasm.dll. NuGet's TFM
    folder convention writes net10.0-browser1.0 (with the explicit platform version) for
    the browser TFM, matching where it places Rask.Wasm.dll itself. PrivateAssets="all" on
    the Core ProjectReference keeps the Rask.Core "package" out of the nuspec dependency
    list — we pack its DLL explicitly here. The source generator goes at
    analyzers/dotnet/cs/ (the generator project sets IncludeBuildOutput=false so it does
    not flow with the consumer's build output).
  -->
  <!-- Analyzer + generator + IDE code-fix payload packed into analyzers/dotnet/cs/ (shared with Rask.Server). -->
  <Import Project="..\RaskAnalyzerPack.targets"/>
  <!-- Rask.Core's build integration packed to build/, imported by build/Rask.Wasm.targets. -->
  <Import Project="..\RaskCoreBuildPack.targets"/>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_RaskAddCoreToLib</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_RaskAddCoreToLib">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Core.dll"
                              PackagePath="lib/net10.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0' "/>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Core.dll"
                              PackagePath="lib/net10.0-browser1.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0-browser' "/>
      <!-- Ship Rask.Core's XML docs next to its bundled DLL so Core's public API surfaces
           IntelliSense for consumers too. -->
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Core.xml"
                              PackagePath="lib/net10.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0' "/>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Core.xml"
                              PackagePath="lib/net10.0-browser1.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0-browser' "/>
      <!-- Rask.Client.dll/.xml bundled next to Rask.Core.dll (same PrivateAssets="all" reasoning). -->
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Client.dll"
                              PackagePath="lib/net10.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0' "/>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Client.dll"
                              PackagePath="lib/net10.0-browser1.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0-browser' "/>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Client.xml"
                              PackagePath="lib/net10.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0' "/>
      <TfmSpecificPackageFile Include="$(OutputPath)Rask.Client.xml"
                              PackagePath="lib/net10.0-browser1.0/"
                              Condition=" '$(TargetFramework)' == 'net10.0-browser' "/>
    </ItemGroup>
  </Target>

</Project>
