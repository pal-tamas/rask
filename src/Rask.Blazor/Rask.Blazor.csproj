<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Both hosts. The renderer is the same on each — a hosted component is rendered to markup in
      process, which browser-WebAssembly can do as readily as a server can.

      TRIMMING is handled rather than disclaimed. ParameterView.SetParameterProperties reaches
      [Parameter] properties through Microsoft.AspNetCore.Components' own reflection, on the hosted
      type — so under PublishTrimmed (a WASM app's default) the trimmer removes the setters and the
      island renders EMPTY, with no analyser warning (the reflection is in another assembly), no
      exception, and nothing in the console. BlazorComponent<TComponent> annotates its type parameter
      with DynamicallyAccessedMembers(PublicProperties), which puts the requirement where the concrete
      type is known. Gated by the WASM showcase's Blazor island page, which publishes trimmed on every
      build, plus TrimmingContractTests. A component library reflecting BEYOND its parameters can
      still need a TrimmerRootAssembly; docs/blazor-components.md says so.

      This package is deliberately not in the Rask meta-package on either framework: it is opt-in, so
      an app that wants nothing to do with Blazor never pays for it. PackageShapeTests pins that.
    -->
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <RootNamespace>Rask.Blazor</RootNamespace>

    <!--
      BL0006 — "the types in Microsoft.AspNetCore.Components.RenderTree are not recommended for use
      outside of the Blazor framework."

      Hosting a Blazor renderer IS this package's entire purpose, so the warning is telling us
      something we already decided rather than something we should change. It fires on exactly one
      thing: BlazorIslandRenderer.UpdateDisplayAsync(in RenderBatch), the base method we must override
      to learn that a hosted component re-rendered itself — plus the sites that merely NAME that
      class, since the override puts a RenderTree type in its signature.

      What matters for the risk this warning is about: we never read RenderBatch, never index into it,
      and never depend on its shape. The override's body ignores the parameter entirely and re-reads
      the component's HTML instead. So a future change to those types cannot silently alter this
      package's behaviour — it can only fail to compile, loudly.

      Scoped to this project rather than the repo, and this project exists only to host Blazor.
    -->
    <NoWarn>$(NoWarn);BL0006</NoWarn>

    <PackageId>Rask.Blazor</PackageId>
    <Title>Rask — Blazor components</Title>
    <Description>Hosts a real Blazor component inside a Rask page. Derive a component from BlazorComponent&lt;T&gt; and the Razor SDK's own output — your Razor Class Library, MudBlazor, Radzen — renders server-side into the first HTTP response, with its parameters passed as live C# objects rather than serialized. The hosted component's own click and bind events fire over Rask's existing channel with no Blazor circuit. Works on the ASP.NET host and on WebAssembly, trimmed publish included.</Description>
    <PackageTags>web component framework net10 blazor razor interop islands</PackageTags>
  </PropertyGroup>

  <!--
    Server: Microsoft.AspNetCore.Components{,.Web} arrive through the shared framework, so nothing is
    packaged and Directory.Packages.props needs no entry — the same way
    benchmarks/Rask.Benchmarks.VsBlazor takes its Blazor dependency.
  -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <!--
    Browser: there is no shared framework to reference, so the identical types come from the package
    instead. This is the only difference between the two targets — no #if, no second code path.
  -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0-browser' ">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web"/>
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="all" — Rask.Core and Rask.Html are IsPackable=false, so without it the nuspec
         would list dependencies on packages that exist on no feed and every restore fails NU1101.
         Consumers get both from whichever host package they already reference. -->
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj" PrivateAssets="all"/>
    <ProjectReference Include="..\Rask.Html\Rask.Html.csproj" PrivateAssets="all"/>
    <!--
      The generator has to RUN here, not merely be available to consumers. A referenced library's
      components cannot be reached from a chain unless that library publishes its own
      RaskEntries{Assembly} class — which is what this emits. Without it BlazorComponent compiles,
      ships, and is simply unreachable at every call site, with nothing reporting why. It also
      publishes the required-property assembly attributes RASK038 reads across an assembly boundary.
    -->
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Blazor.Tests"/>
  </ItemGroup>

</Project>
