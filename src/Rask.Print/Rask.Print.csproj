<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Print</PackageId>
    <Title>Rask.Print — print a page from the browser, with no server engine</Title>
    <Description>Browser printing for a custom HTML page in a Rask app: Print.Only(...) and Print.Hide(...) show or hide a part of the page on paper, Print.Styles(PrintPage.Size("A4").Landscape().Margins("15mm")) writes the @page rule, and a button's .Print() opens the browser's print dialog, where "Save as PDF" makes the PDF. No Chromium, no PDF library, nothing on the server.</Description>
    <PackageTags>print printing pdf css-print media-print window-print dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Print.Tests"/>
  </ItemGroup>

  <!-- Rask.Core supplies the markup (Div, Style) and the click handler; Rask.Web supplies window.print() (MDN's
       Window.Print). Both arrive with Rask.Server and Rask.Wasm, as for Rask.Mail. -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\Rask.Web\Rask.Web.csproj"/>
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
