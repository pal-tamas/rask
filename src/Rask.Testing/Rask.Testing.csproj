<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Testing</PackageId>
    <Title>Rask.Testing — unit-test Rask components</Title>
    <Description>Test a Rask app the way a person uses it — no browser, no server, no WebSocket. Page.Visit("/products/new") opens a URL through the real router, and page.Type("Tea").Into("Name"), page.Click("Save") and page.Shows("Saved") find fields by their label and buttons by their text. Page.Render(component) renders one component whose Html reflects the current state; page.On("#save").Click() drives one element and Invoke(id) dispatches a handler by its data-rask-on-* id, each returning the re-rendered HTML. Mail.Fake(), Jobs.Fake(), Cache.Fake() and Clock.Fake() stand in for a battery or the clock for one test. Wraps Rask.Core's live-render + handler-dispatch seam. Reference from your test project; Rask.Core comes transitively from your app's Rask.Server / Rask.Wasm.</Description>
    <PackageTags>rask testing unit-test component-testing render dotnet net10</PackageTags>
  </PropertyGroup>


  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework overview
       that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
    <!-- The per-test app hook a test project on xUnit v3 compiles in (see build/Rask.Testing.targets). -->
    <Compile Remove="build\**" />
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="build\**" Pack="true" PackagePath="buildTransitive\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- TestJSRuntime implements IJSRuntime. A real dependency rather than bloat: Rask.Core already
         references Microsoft.JSInterop (so components can ctor-inject IJSRuntime), which puts this
         abstractions-only package in every consumer's graph transitively already. -->
    <PackageReference Include="Microsoft.JSInterop"/>
  </ItemGroup>

  <ItemGroup>
    <!-- For Page.Watching: the kit's tests watch every render they drive and fail on one a live session
         would answer with the whole page instead of a diff (tests/Rask.Ui.Tests/Live/DiffGuard.cs). -->
    <InternalsVisibleTo Include="Rask.Ui.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="all" keeps the (unpublished, IsPackable=false) Rask.Core "package" out of the
         nuspec: Rask.Testing is consumed alongside a host that already bundles Rask.Core.dll, so it
         resolves transitively — same pattern as Rask.Bootstrap. Core still resolves at compile time
         (and its InternalsVisibleTo grants the live-render/handler-dispatch access this wraps). -->
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj"/>
    <!-- The HTML/SVG element family, split out of Rask.Core.Components. Every host renders HTML,
         so every host carries it; bundled into lib/ next to Rask.Core.dll below. -->
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

</Project>
