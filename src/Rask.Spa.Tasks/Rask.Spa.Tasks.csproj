<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0 matches what MSBuild loads at build time: the task runs inside the MSBuild host
      process, which on Windows may still be full-framework MSBuild.exe. Same constraint, and same
      reasoning, as Rask.Wasm.Tasks.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Rask.Spa.Tasks</RootNamespace>

    <!-- Build-only: it ships inside Rask.Spa.Hosting's build/ folder, loaded by an explicit
         <UsingTask>, and is never a compile reference or a package of its own. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Both ExcludeAssets=runtime: MSBuild's own resolver provides these to a task at runtime, and
      shipping a second copy alongside the task risks loading two versions of the same assembly into
      one process. System.Reflection.Metadata in particular is what Roslyn's own build tasks use, so
      every MSBuild host that can compile C# already has it.
    -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all"/>
    <PackageReference Include="System.Reflection.Metadata" ExcludeAssets="runtime" PrivateAssets="all"/>
  </ItemGroup>

  <!--
    Deploy next to Rask.Spa.Hosting.targets so <UsingTask AssemblyFile="$(MSBuildThisFileDirectory)…"/>
    resolves identically for in-repo consumers and for NuGet consumers, which get build/ verbatim.
  -->
  <Target Name="CopyTaskAssemblyToRaskSpaBuild" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\Rask.Spa.Hosting\build\"
          SkipUnchangedFiles="true"/>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Spa.Tasks.Tests"/>
  </ItemGroup>

</Project>
