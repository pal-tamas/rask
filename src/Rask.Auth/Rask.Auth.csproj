<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <!--
      Styles/auth.css is a Tailwind INPUT, not a component's scoped stylesheet. Without this,
      Rask.Core's `**/*.css` glob claims it and the build reports RASK015 for a file that is not one —
      the same opt-out Rask.Ui takes for the same reason.
    -->
    <RaskScopedCssAutoInclude>false</RaskScopedCssAutoInclude>

    <PackageId>Rask.Auth</PackageId>
    <Title>Rask.Auth — accounts, sign-in, and the account lifecycle</Title>
    <Description>Register, sign in and sign out for a Rask app, on by default. Accounts are backed by ASP.NET Core Identity (versioned password hashing, lockout, security stamps) and exposed through Rask's own host-neutral surface — the same IUserProvider, Authorize component and [Authorize] routes work unchanged on the Server, WebAssembly, island, SPA and meta-framework hosts. Ships built-in overridable /login, /register and /logout pages plus the matching /api/auth endpoints, so a TypeScript front end gets the same flows. Email confirmation and password reset go out through the app's own mail queue, with /confirm-email, /forgot-password and /reset-password pages to match. The first account to register becomes the admin.</Description>
    <!-- Override the framework default tags (web/component/wasm) — this is the accounts/sign-in half. -->
    <PackageTags>authentication authorization identity login register aspnet-identity cookie-auth claims dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- SignInManager, the cookie handler and the authorization services are in the shared framework,
       not in the Identity EF stores package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <!-- The Microsoft.Extensions.* abstractions (DI, hosting, logging) come with the framework
       reference above; naming them here as well is what NU1510 rejects. -->
  <ItemGroup>
    <!-- Bearer is opt-in (AuthOptions.Bearer) and this is what validates and issues the tokens. The
         standard ASP.NET handler rather than anything hand-rolled: JWT validation is the last place to
         write our own crypto. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
  </ItemGroup>

  <!-- The pages and the host-neutral auth surface (IUserProvider, IAuthSignIn, Authorize) live in
       Core and Html. PrivateAssets="all" mirrors Rask.Dashboard: this package renders components, but
       a consumer gets Core through the host package rather than transitively through this one.
       Deliberately NOT Rask.Server — no battery references it, which is what keeps the meta-package
       free of reference cycles. -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj" PrivateAssets="all"/>

    <!-- The confirmation and reset links go out through the app's own mail queue. A REAL package
         dependency, not PrivateAssets: Rask.Mail is its own package rather than something a host
         re-packs, so the assembly has to travel with this one.

         The dependency is on the TYPE only. IMail is resolved from the container at send time, so an
         app that never calls AddRaskMail still registers, signs in and signs out — it is told it
         cannot send a reset link rather than silently queueing one nowhere. -->
    <ProjectReference Include="..\Rask.Mail\Rask.Mail.csproj"/>

    <!-- Emits this assembly's own Generated.* chain entries and the __RaskRoutesRegistry module
         initializer that registers the built-in [Route] pages into the host's RouteRegistry — the
         same way Rask.Dashboard ships /_rask. -->
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Rask.Batteries.Shared\BatteryModelCheck.cs" Link="Shared\BatteryModelCheck.cs"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Auth.Tests"/>
  </ItemGroup>

  <!-- Ship the global `using Rask.Auth;` to downstream consumers. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
  </ItemGroup>

  <!--
    These pages carry their own stylesheet, compiled here.

    They ship inside a package, so their class names are in a compiled assembly no application's
    Tailwind can scan — which rules out borrowing the host's sheet. Compiling here and embedding the
    result is what keeps the promise that they render on an app with no CSS of its own.

    A build-order edge only. Rask.Tailwind is netstandard2.0 and has no face this project could
    reference; SkipGetTargetFrameworkProperties and UndefineProperties are what stop MSBuild trying to
    match one. Copied from Rask.Ui, which compiles its sheet the same way.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Tailwind\Rask.Tailwind.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework"/>
  </ItemGroup>

  <PropertyGroup>
    <RaskTailwindInput>Styles/auth.css</RaskTailwindInput>
    <RaskTailwindOutput>obj/$(TargetFramework)/auth.generated.css</RaskTailwindOutput>
    <RaskTailwindMinify>true</RaskTailwindMinify>
  </PropertyGroup>

  <!--
    Added from a TARGET rather than a static ItemGroup, for the reason Rask.Ui records: a static
    item's Condition is evaluated before any target runs, so on a fresh clone the generated sheet does
    not exist yet, the item is silently absent, and the package ships with no stylesheet at all — the
    pages then render unstyled and a SECOND build embeds it, which is why every incremental tree
    looks fine.

    Single-target, so unlike Rask.Ui there is no outer build to pack from separately.
  -->
  <Target Name="EmbedRaskAuthStylesheet"
          AfterTargets="_RaskTailwindBuild"
          BeforeTargets="PrepareResourceNames">
    <Error Condition="!Exists('$(RaskTailwindOutput)')"
           Text="Rask.Auth: $(RaskTailwindOutput) was not produced. The built-in sign-in pages carry their own stylesheet, compiled by _RaskTailwindBuild from $(RaskTailwindInput); shipping without it renders every one of them unstyled."/>
    <ItemGroup>
      <EmbeddedResource Include="$(RaskTailwindOutput)" LogicalName="Rask.Auth.auth.css"/>
    </ItemGroup>
  </Target>

</Project>
