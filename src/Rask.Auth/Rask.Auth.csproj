<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Auth</PackageId>
    <Title>Rask.Auth — accounts, sign-in, and the account lifecycle</Title>
    <Description>Register, sign in and sign out for a Rask app, on by default. Accounts are the app's own User aggregate (PBKDF2 or bcrypt password hashing, passkeys beside the password, one revocable session row per signed-in device, sign-in throttling) and are exposed through Rask's own host-neutral surface — the same IUserProvider, Authorize component and [Authorize] routes work unchanged on the Server, WebAssembly, island, SPA and meta-framework hosts. rask new writes the /login, /register, /logout and /devices pages into the app, and the matching /api/auth endpoints give a TypeScript front end the same flows. Email confirmation and password reset go out through the app's own mail queue, with /confirm-email, /forgot-password and /reset-password pages scaffolded to match. The first account to register becomes the admin.</Description>
    <!-- Override the framework default tags (web/component/wasm) — this is the accounts/sign-in half. -->
    <PackageTags>authentication authorization login register passkeys webauthn sessions bcrypt cookie-auth claims dotnet net10 net11</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- The cookie handler, Data Protection and the authorization services are in the shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <!-- The Microsoft.Extensions.* abstractions (DI, hosting, logging) come with the framework
       reference above; naming them here as well is what NU1510 rejects. -->
  <ItemGroup>
    <!-- Bearer is opt-in (AuthOptions.Bearer) and this is what validates and issues the tokens. The
         standard ASP.NET handler rather than anything hand-rolled: JWT validation is the last place to
         write our own crypto. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
  </ItemGroup>

  <!-- The host-neutral auth surface (IUserProvider, IAuthSignIn, Authorize) lives in Core. PrivateAssets="all" mirrors Rask.Dashboard: this package renders components, but
       a consumer gets Core through the host package rather than transitively through this one.
       Deliberately NOT Rask.Server — no battery references it, which is what keeps the meta-package
       free of reference cycles. -->
  <ItemGroup>
    <!-- The /api/auth wire contract (paths, headers, DTOs). In Rask.Wire rather than Core so the
         server half and the browser half can both take it without either taking the renderer. -->
    <!-- The host-neutral half of this battery: the accounts, the /api/auth endpoints, the cookie and
         the options. This package is that plus the two things a renderer makes possible — an IAuth on
         the host's sign-in relay, and email bodies written as components. See RaskAuthHostServices. -->
    <ProjectReference Include="..\Rask.Auth.Api\Rask.Auth.Api.csproj"/>

    <ProjectReference Include="..\Rask.Wire\Rask.Wire.csproj"/>
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj" PrivateAssets="all"/>

    <!-- The confirmation and reset links go out through the app's own mail queue. A REAL package
         dependency, not PrivateAssets: Rask.Mail is its own package rather than something a host
         re-packs, so the assembly has to travel with this one.

         The dependency is on the TYPE only. IMail is resolved from the container at send time, so an
         app that never calls AddRaskMail still registers, signs in and signs out — it is told it
         cannot send a reset link rather than silently queueing one nowhere. -->
    <ProjectReference Include="..\Rask.Mail\Rask.Mail.csproj"/>

    <!-- Emits this assembly's own chain entries, which the email bodies are written with. The sign-in
         pages are not here: `rask new` writes them into the app's Features/Auth. -->
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Rask.Batteries.Shared\BatteryModelCheck.cs" Link="Shared\BatteryModelCheck.cs"/>
  </ItemGroup>

  <!-- AuthOptions binds Rask:Auth. The configuration binding source generator writes that bind at compile
       time, so no reflection binder runs; the SDK leaves it off unless a project asks. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Auth.Tests"/>
  </ItemGroup>

  <!-- Ship the global `using Rask.Auth;` to downstream consumers. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
  </ItemGroup>

</Project>
