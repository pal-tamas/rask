<Project>

  <!--
    Shared packing of Rask.Core's build integration (the scoped-CSS/JS <AdditionalFiles> globs and the
    three <CompilerVisibleProperty> entries) into each host package's build/ folder. Imported by the host
    packages (Rask.Server, Rask.Wasm). Both live at src/<Name>/, so the ..\Rask.Core
    relative path — evaluated relative to the IMPORTING project's directory — resolves identically from
    either of them, keeping the two packages' build payload in lockstep from one place.

    Rask.Core itself is IsPackable=false, so it cannot ship this file; and NuGet auto-imports only
    build/<PackageId>.{props,targets}, so a build/Rask.Core.targets is payload, not an entry point —
    each package's own build/<PackageId>.targets imports it (guarded on Exists, because the file is
    packed from Rask.Core's tree and so has no sibling in the source tree).

    Deliberately pack-only: nothing copies Rask.Core.targets into any src/<Name>/build/ folder on disk.
    That is what keeps the in-repo import (Directory.Build.targets) and the packaged import from ever
    both firing for the same project — the Exists guard is false in the repo. Rask.Core.targets is
    idempotent anyway, but structural impossibility beats a sentinel.
  -->
  <ItemGroup>
    <None Include="..\Rask.Core\build\Rask.Core.targets"
          Pack="true" PackagePath="build\" Visible="false"/>

    <!--
      The TypeScript compile task, loaded by the <UsingTask> in Rask.Core.targets. It rides along
      here rather than in its own package because scoped assets are a core feature with no opt-in:
      a component's sibling .ts has to compile wherever Rask.Core.targets is imported, so the glob,
      the compile and the task assembly have to arrive together or not at all.

      Unlike the .targets above, this file IS copied into the source tree (by
      Rask.TypeScript.Tasks.csproj, after its build) and is gitignored. That asymmetry is fine
      because a task assembly is not an entry point: nothing imports it, so an in-repo copy cannot
      double-fire the way a stray build/Rask.Core.targets would.
    -->
    <None Include="..\Rask.Core\build\Rask.TypeScript.Tasks.dll"
          Pack="true" PackagePath="build\" Visible="false"/>

    <!--
      The ambient declarations for Rask's own browser globals, compiled alongside every consumer's
      scoped TypeScript. Without it a component calling a [JSInvokable] would have to redeclare
      window.DotNet in its own app, and every app's copy would drift from the next.
    -->
    <None Include="..\Rask.Core\build\rask-globals.d.ts"
          Pack="true" PackagePath="build\" Visible="false"/>
  </ItemGroup>

  <!--
    Fail loud at pack time rather than silently shipping a package whose consumers get no scoped CSS/JS.
    A <None Include> of an absent file packs nothing and emits no error, and a missing
    build/<PackageId>.targets means NuGet never imports the payload above — which is exactly the defect
    this file exists to fix (#544), undetectable from the outside until someone unzips the .nupkg.
  -->
  <Target Name="_RaskVerifyCoreBuildPacked" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('..\Rask.Core\build\Rask.Core.targets')"
           Text="Rask.Core.targets not found at '..\Rask.Core\build\Rask.Core.targets' — it must ship in this package's build/ folder, or consumers get no scoped CSS/JS and no RaskScopedJsAutoInclude/RaskBuilderEntryInjection opt-outs." />
    <Error Condition="!Exists('build\$(PackageId).targets')"
           Text="build\$(PackageId).targets is missing — NuGet auto-imports only build/&lt;PackageId&gt;.{props,targets}, so without it the packed build/Rask.Core.targets is never imported by a consumer." />
    <!--
      Same failure mode, one package later: a <None Include> of an absent DLL packs nothing and says
      nothing, and the first sign would be MSB4062 ("could not load the ResolveTypeScriptToolTask
      task") in a consumer's build, naming a file they have never heard of. It is absent whenever
      Rask.TypeScript.Tasks has not been built into src/Rask.Core/build/ yet.
    -->
    <Error Condition="!Exists('..\Rask.Core\build\Rask.TypeScript.Tasks.dll')"
           Text="Rask.TypeScript.Tasks.dll is not in src/Rask.Core/build/ — build src/Rask.TypeScript.Tasks first (its CopyTaskAssemblyToRaskCoreBuild target puts it there). Without it the packed Rask.Core.targets declares a &lt;UsingTask&gt; pointing at nothing, and every consumer with a scoped .ts fails with MSB4062." />
  </Target>

</Project>
