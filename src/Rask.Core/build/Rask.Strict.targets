<Project>
  <!--
    <RaskStrict> — the quality gate an app opts into, built only from what the .NET SDK and Rask already ship
    (no third-party analyzer package). Set it in the app's Directory.Build.props so its test projects get it too:

      warnings  every check below runs, and reports as a WARNING — the day-one setting: the build stays green
                while the list is worked down
      errors    the same checks, and every warning fails the build (TreatWarningsAsErrors)
      true      the same as errors

    Empty or false changes nothing. What it turns on:
      - Nullable enable (an app's own `disable` included: strict is the switch that says otherwise)
      - the .NET analyzers at AnalysisLevel latest-recommended, unless the app chose a level itself
      - EnforceCodeStyleInBuild, so the .editorconfig's IDE rules report in `dotnet build`, not only in an editor
      - a documentation file, so IDE0005 (an unused using) runs in the build, without CS1591 (Rask.Strict.props)
      - CA1716 off (rask-strict.globalconfig): a Visual Basic keyword in a C# app's name, Features/Shared included
      - RASK130 a warning (rask-strict.globalconfig): an aggregate storing a bare string, number, moment or Guid
      - RASK140-RASK144 warnings (rask-strict.globalconfig): the machine's clock, Current.Service or [Key] in domain
        code, Task.WhenAll over database work in Db.Transaction, a [Compare] naming no property
      - RASK145 an error (rask-strict.globalconfig): an event raised about an entity just made that reads a key the
        database produces only on insert, so it carries 0
      - RASK184-RASK187 warnings (rask-strict.globalconfig): an aggregate throwing InvalidOperationException or
        ArgumentException, an aggregate loaded before the Db.Transaction that changes it, an Update that only runs an
        operation with a generated entry, a raw ExecuteUpdate/ExecuteDelete over an aggregate's rows
        operation with a generated entry
      - RASK133 a warning (rask-strict.globalconfig): an aggregate added, updated or removed on a DbContext and
        saved there, around its generated entries
      - RASK177 a warning (rask-strict.globalconfig): code written for one database — a provider's API, EF.Functions,
        raw SQL, SQL in the model — outside migrations and the call that selects the provider
      - in a test project, RASK116: a test named as a sentence, and CA1707 off, which forbids the underscores a
        sentence is joined with, and xUnit1051 off, since Rask.Testing supplies the test's token ambiently
        (rask-strict-tests.globalconfig)
      - at errors: TreatWarningsAsErrors, which also raises Rask's own RASK warnings to errors; a NuGet audit
        finding (NU1901-NU1904) and RASK130 stay warnings

    Read here, in the TARGETS, not in Rask.props: NuGet imports a package's props before the app's csproj is
    evaluated, so a props file never sees a <RaskStrict> written in the csproj. Every property set here is read
    by a target (Csc, the SDK's analyzer targets imported after this file), so it still takes effect. The one
    exception is the documentation file, which the SDK settles before this file: Rask.Strict.props turns it on
    for a <RaskStrict> in Directory.Build.props, and a csproj-only <RaskStrict> leaves IDE0005 to the editor.
  -->
  <PropertyGroup>
    <_RaskStrictLevel>$(RaskStrict.Trim().ToLowerInvariant())</_RaskStrictLevel>
    <_RaskStrictLevel Condition=" '$(_RaskStrictLevel)' == 'true' ">errors</_RaskStrictLevel>
    <_RaskStrictLevel Condition=" '$(_RaskStrictLevel)' == 'false' ">off</_RaskStrictLevel>
    <_RaskStrictLevel Condition=" '$(_RaskStrictLevel)' == '' ">off</_RaskStrictLevel>
    <_RaskStrictOn Condition=" '$(_RaskStrictLevel)' == 'warnings' Or '$(_RaskStrictLevel)' == 'errors' ">true</_RaskStrictOn>
    <_RaskStrictTestProject Condition=" '$(IsTestProject)' == 'true' Or $(MSBuildProjectName.EndsWith('.Tests')) ">true</_RaskStrictTestProject>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(_RaskStrictOn)' == 'true' ">
    <Nullable>enable</Nullable>
    <AnalysisLevel Condition=" '$(AnalysisLevel)' == '' ">latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- A NuGet audit finding (NU1901-NU1904: a package with a known vulnerability, low to critical) stays a warning:
       an advisory published against a dependency would otherwise fail every build of the app, a new one included,
       until the package is moved — the warning names it and the move is the app's to make. Appended, so an app's
       own WarningsNotAsErrors is kept. -->
  <PropertyGroup Condition=" '$(_RaskStrictLevel)' == 'errors' ">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- The same for a DEPENDENCY's trim and AOT findings at publish: the trimmer folds each referenced assembly's
         warnings into one, IL2104 (trim) or IL3053 (AOT), and the app cannot fix code it does not own (Microsoft.JSInterop
         is one today). The app's own assembly is reported warning by warning (IL2026, IL3050, …), and those stay errors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
    <!-- RASK130 (a bare string, number, moment or Guid on an aggregate or entity) says where a value object would carry
         the rules; moving an app's model onto value objects is work the app does one aggregate at a time, so the
         finding is shown, never a build that stops until all of it is done. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RASK130</WarningsNotAsErrors>
    <!-- The same for a build run with `-warnaserror`, which MSBuild's logger applies from its own list. -->
    <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);RASK130</MSBuildWarningsNotAsErrors>
  </PropertyGroup>

  <!-- A <RaskStrict> in the csproj alone comes too late for the documentation file, and the compiler's request
       for one would otherwise fail the build at errors. -->
  <PropertyGroup Condition=" '$(_RaskStrictOn)' == 'true' And '$(GenerateDocumentationFile)' != 'true' ">
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>

  <!-- EditorConfigFiles, the item Csc reads, not GlobalAnalyzerConfigFiles: Roslyn's targets fold that one into this
       one when they are imported, which is before this file, so an item added to it here would never reach Csc. -->
  <ItemGroup Condition=" '$(_RaskStrictOn)' == 'true' ">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)rask-strict.globalconfig"/>
  </ItemGroup>

  <ItemGroup Condition=" '$(_RaskStrictOn)' == 'true' And '$(_RaskStrictTestProject)' == 'true' ">
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)rask-strict-tests.globalconfig"/>
  </ItemGroup>

  <Target Name="_RaskStrictCheckLevel" BeforeTargets="CoreCompile"
          Condition=" '$(_RaskStrictLevel)' != 'off' And '$(_RaskStrictOn)' != 'true' ">
    <Error Text="&lt;RaskStrict&gt;$(RaskStrict)&lt;/RaskStrict&gt; is not a level Rask knows: write warnings (every check reports as a warning) or errors (every warning fails the build); true means errors, false turns it off."/>
  </Target>
</Project>
