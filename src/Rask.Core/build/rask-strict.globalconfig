# Added by Rask.Strict.targets to every project of an app that sets <RaskStrict>.
is_global = true

# A name that is a Visual Basic keyword (Shared, Select, Option, Get): an app is C#, and Features/Shared is where
# `rask new` keeps what features share. Rask turns it off in its own repository for the same reason.
dotnet_diagnostic.CA1716.severity = none

# An aggregate or entity that stores a bare string, number, moment or Guid where a value object would carry its rules
# (RASK130). A suggestion everywhere else; under <RaskStrict> a warning — at errors too, where it does not fail the
# build (Rask.Strict.targets keeps it out of TreatWarningsAsErrors).
dotnet_diagnostic.RASK130.severity = warning

# Domain code (an aggregate, an entity, a value object) and its data rules: suggestions everywhere else, warnings under
# <RaskStrict> — and, at errors, errors like every other warning. Each names one line to change.
#   RASK140  the machine's clock (DateTime.Now, Today, UtcNow, DateTimeOffset.Now, ToLocalTime) — Clock.Now / Wall / Today
#   RASK141  Current.Service<T>() inside an aggregate, an entity or a value object
#   RASK142  Task.WhenAll over database work inside Db.Transaction, whose work shares one connection
#   RASK143  [Key] on an aggregate or an entity, which is keyed by the Id it inherits
#   RASK144  [Compare("X")] naming a property the model does not have
#   RASK178  a Db.Transaction writing two different aggregates without manyAggregates: "why"
#   RASK184  throw new InvalidOperationException / ArgumentException inside an aggregate — Refuse.When / Unless
#   RASK185  an aggregate loaded before Db.Transaction and changed inside it — load it inside the block
#   RASK186  X.Update(id, x => x.M(…)) where M has a generated entry — X.M(id, …), which asks its roles
#   RASK187  ExecuteUpdate / ExecuteDelete over an aggregate's rows — X.UpdateWhere / X.DeleteWhere
#   RASK133  DbSet/DbContext Add, Update or Remove of an aggregate, then SaveChanges — its generated entry instead
dotnet_diagnostic.RASK140.severity = warning
dotnet_diagnostic.RASK141.severity = warning
dotnet_diagnostic.RASK142.severity = warning
dotnet_diagnostic.RASK143.severity = warning
dotnet_diagnostic.RASK144.severity = warning
dotnet_diagnostic.RASK178.severity = warning
dotnet_diagnostic.RASK184.severity = warning
dotnet_diagnostic.RASK185.severity = warning
dotnet_diagnostic.RASK186.severity = warning
dotnet_diagnostic.RASK187.severity = warning
dotnet_diagnostic.RASK133.severity = warning

# An event raised in an aggregate's constructor, or about an entity the same method just made, that reads a key the
# database produces only on insert (RASK145): the event carries 0 for good. A warning everywhere else; under <RaskStrict>
# an error, since the handlers that run after the commit are handed the wrong row.
dotnet_diagnostic.RASK145.severity = error

# A bare DateTime or DateTimeOffset held by an aggregate, an entity, a value object, a domain event or a read model
# (RASK147): time is a Moment (an instant, stored as UTC) or a Day. A warning everywhere else; under <RaskStrict> an
# error, since PostgreSQL refuses a DateTime that is not UTC only when the row is saved.
dotnet_diagnostic.RASK147.severity = error

# An entity keyed by Guid.CreateVersion7() or Guid.NewGuid() (RASK148): ids made in one millisecond sort either way, so
# the key is not the order the rows were made. A suggestion everywhere else; under <RaskStrict> an error — the quick-fix
# writes the typed id's New() or OrderedGuid.New().
dotnet_diagnostic.RASK148.severity = error

# Code written for one database (RASK177): a provider's or its driver's API, EF.Functions, raw SQL (FromSql*,
# ExecuteSql*, SqlQuery*), SQL in the model (HasColumnType, UseCollation, HasDefaultValueSql, HasComputedColumnSql,
# HasFilter, ToSqlQuery). The app's tests run on SQLite in memory; Rask proves only what it translates on all three
# databases. A suggestion everywhere else; a warning under <RaskStrict>, and an error at errors. Migrations, generated
# code and the call that selects the provider are not reported.
dotnet_diagnostic.RASK177.severity = warning

# An aggregate's children held by hand (RASK193): a private List<X> behind a read-only view, or a public List<X> /
# ICollection<X>, where one HasMany<X> says the same and only the aggregate changes it. A suggestion everywhere else;
# under <RaskStrict> an error — the quick-fix makes the move, and it is no migration.
dotnet_diagnostic.RASK193.severity = error
