<Project>

  <!--
    Rask.Core build integration.

    1. RaskGlobalUsings — exposed to the source generator so it can decide whether
       to emit RaskGlobalUsings.g.cs (the file with `global using static Rask.Core.Tags;`
       plus per-namespace `global using static {Ns}.Components;` lines). Defaults to
       true. Consumers that prefer explicit imports can set
       <RaskGlobalUsings>false</RaskGlobalUsings> in their csproj.

    2. Scoped-CSS sibling files — every `.css` file in the project tree is registered
       as <AdditionalFiles> so ComponentScopedCssGenerator can pair it with its
       component class (`Counter.cs` ↔ `Counter.css`). A `.css` file with no matching
       Component subclass in the same folder raises RASK015 at build time. Consumers
       that ship unrelated CSS files (global stylesheets, etc.) can either remove
       those entries from @(AdditionalFiles) or opt out entirely with
       <RaskScopedCssAutoInclude>false</RaskScopedCssAutoInclude>.

    Auto-imported in this repo via Directory.Build.targets at the repo root.
    Downstream NuGet consumers reach it a different way: Rask.Core is IsPackable=false,
    and NuGet auto-imports only build/<PackageId>.{props,targets}, so this file is packed
    into each host package's build/ folder by src\RaskCoreBuildPack.targets and imported
    from that package's own build/<PackageId>.targets.

    Only ever imported once per project: nothing copies this file into a host package's build/
    folder on disk, so the packaged route's Exists guard is false in the repo and the in-repo
    route is unreachable from a restored package. Note a same-file sentinel could NOT enforce
    that — MSBuild evaluates properties and items in separate passes, so a property set at the
    bottom of this file is already true when the ItemGroups below are evaluated, and every
    group would silently vanish.
  -->

  <!--
    RaskFactoryNavigation (default true) — exposed to the source generator. When true, each
    generated factory carries a `<see cref>` doc breadcrumb linking to its component type, so
    Quick-Doc / hover on `Foo(...)` offers a navigable link to `Foo`. (F12 still lands on the
    generated method — Roslyn/ReSharper navigate generated symbols to the generated file; use
    "Navigate to Type of Symbol" for a one-action jump to the component.) `[DebuggerStepThrough]`
    is always emitted regardless. Set <RaskFactoryNavigation>false</RaskFactoryNavigation> to drop
    the doc breadcrumb (e.g. if a project with documentation-file generation flags the crefs).
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="RaskGlobalUsings"/>
    <CompilerVisibleProperty Include="RaskScopedJsAutoInclude"/>
    <CompilerVisibleProperty Include="RaskFactoryNavigation"/>
  </ItemGroup>

  <ItemGroup Condition=" '$(RaskScopedCssAutoInclude)' != 'false' ">
    <AdditionalFiles Include="**\*.css"
                     Exclude="@(AdditionalFiles);bin\**;obj\**;node_modules\**;wwwroot\**"/>
  </ItemGroup>

  <!--
    Scoped-JS sibling files — every `.js` file in the project tree is registered as
    <AdditionalFiles> so ComponentScopedJsGenerator can pair it with its component
    class (`Counter.cs` ↔ `Counter.js`). A `.js` file with no matching Component
    subclass in the same folder raises RASK017 at build time. Resources\** and
    Browser\** are excluded so the framework's own runtime scripts (rask.js,
    rask.wasm.js, main.js, rask-morph.js, rask-scoped.js) don't get vacuumed up by
    consumers' builds. Opt out entirely with <RaskScopedJsAutoInclude>false</…>.
  -->
  <ItemGroup Condition=" '$(RaskScopedJsAutoInclude)' != 'false' ">
    <AdditionalFiles Include="**\*.js"
                     Exclude="@(AdditionalFiles);bin\**;obj\**;node_modules\**;wwwroot\**;Resources\**;Browser\**"/>
  </ItemGroup>

</Project>
