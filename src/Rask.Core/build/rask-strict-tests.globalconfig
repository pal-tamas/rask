# Added by Rask.Strict.targets to a test project of an app that sets <RaskStrict>.
is_global = true

# A test is named as a sentence. RASK116 ships switched off, because that is a convention; a strict app's tests
# are held to it.
dotnet_diagnostic.RASK116.severity = warning

# A sentence is words joined by underscores, which CA1707 (no underscores in a member name) forbids.
dotnet_diagnostic.CA1707.severity = none

# xUnit1051 asks every call that takes a CancellationToken to be passed TestContext.Current.CancellationToken. Rask
# supplies it already: Rask.Testing's xUnit v3 hook makes the test's token the ambient one, which every Rask call given
# none uses (Ambient.Or) — so `await Product.Create(model)` is cancelled with the test as written. xUnit1051 cannot be
# scoped to the callee (an analyzer's severity is per file, not per call), so it is off for the whole test project; a
# call into another library still takes the token by hand where cancelling it matters.
dotnet_diagnostic.xUnit1051.severity = none
