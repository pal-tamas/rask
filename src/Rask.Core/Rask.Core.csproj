<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-targets net10.0-browser purely so the trim + AOT Roslyn analysers run over Core's own
      source (they are ignored on plain net10.0 — NETSDK1210). Core is IsPackable=false (it ships
      transitively from the host packages), so the extra TFM changes no published package; it only
      gives the warnings-as-errors build continuous IL2xxx/IL3050 coverage for the framework's
      AOT-sensitive paths (routing, forms binding).
    -->
    <TargetFrameworks>$(RaskNetTargets);$(RaskBrowserTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      The `Rask` package: everything the server and the browser share — components, the element chain,
      routing, forms, the typed browser APIs, scoped CSS/TypeScript — plus the source generators and the
      build integration. Rask.Server and Rask.Wasm depend on it; a component library references it alone.
      The assembly keeps its name, Rask.Core, which the analyzers key on.
    -->
    <PackageId>Rask</PackageId>
    <Title>Rask — the shared core</Title>
    <Description>The core of Rask, a full-stack .NET web framework: C# components and the element chain, routing, forms, the typed browser APIs and scoped CSS/TypeScript, with the source generators and build integration that make them work. Shared by the server host (Rask.Server) and the browser host (Rask.Wasm); reference it on its own from a library of components.</Description>
    <IsAotCompatible Condition="'$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browser'">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Primitives"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.ObjectPool"/>
    <PackageReference Include="Microsoft.AspNetCore.Authorization"/>
    <!--
      IJSRuntime abstractions only — pulls in the contract + base JSRuntime class so user
      components can take IJSRuntime via ctor injection and Rask.Core can ship
      InvokeScopedAsync extensions. Does NOT drag in the Blazor renderer/circuit.
    -->
    <PackageReference Include="Microsoft.JSInterop"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Rask.Testing is a SHIPPED package that wraps Core's internal live-render + handler-invoke seam
         (RenderAsLiveRoot / TryInvokeHandlerAsync) into a supported public testing API. -->
    <InternalsVisibleTo Include="Rask.Testing"/>
    <InternalsVisibleTo Include="Rask.Core.Tests"/>
    <InternalsVisibleTo Include="Rask.Server"/>
    <InternalsVisibleTo Include="Rask.Server.Tests"/>
    <!-- Same surface as Rask.Server.Tests; a separate assembly so MetadataUpdaterSupport can be on. -->
    <InternalsVisibleTo Include="Rask.Server.HotReload.Tests"/>
    <InternalsVisibleTo Include="Rask.Wasm"/>
    <InternalsVisibleTo Include="Rask.Wasm.Tests"/>
    <!-- Islands render a host element whose subtree a foreign renderer owns, so they set Component's
         OpaqueSubtreeInternal — the seam the live diff and the client morph both read to stop at the
         island's border. -->
    <InternalsVisibleTo Include="Rask.Blazor"/>
    <InternalsVisibleTo Include="Rask.Blazor.Tests"/>
    <InternalsVisibleTo Include="Rask.External"/>
    <InternalsVisibleTo Include="Rask.External.Tests"/>
    <!-- Hosts cannot reference the devtools (the devtools reference the hosts), so they meet in Core: the
         loader and the probe seam live here, internal, and Rask.DevTools implements them. -->
    <InternalsVisibleTo Include="Rask.DevTools"/>
    <InternalsVisibleTo Include="Rask.DevTools.Tests"/>
    <!-- For Navigator.EnterHandler: the remote-dispatch file bridge extends Navigator, so its tests need
         the same handler scope Rask.Core.Tests uses to exercise Download. -->
    <InternalsVisibleTo Include="Rask.Cqrs.Client.Tests"/>
    <!-- Rask.Query observes the rendering component so a resolved fetch can re-render it, and opts
         that component out of the render cache in the same call. See LiveRenderContext.ObserveAmbientState. -->
    <InternalsVisibleTo Include="Rask.Query"/>
    <InternalsVisibleTo Include="Rask.Query.Tests"/>
    <InternalsVisibleTo Include="Rask.Providers.E2E.Tests"/>
    <InternalsVisibleTo Include="Rask.Auth"/>
    <InternalsVisibleTo Include="Rask.Auth.Tests"/>
    <InternalsVisibleTo Include="Rask.Benchmarks"/>
    <InternalsVisibleTo Include="Rask.Benchmarks.VsBlazor"/>
    <InternalsVisibleTo Include="Rask.Site.Tests"/>
    <!-- The dashboard's harness renders the console the way its mount does: against the console's own route
         table (RouteState.Table), which the main table no longer carries ([assembly: MountOnlyRoutes]). -->
    <InternalsVisibleTo Include="Rask.Dashboard.Tests"/>
  </ItemGroup>

  <!--
    The auth WIRE contract — the /api/auth paths and DTOs, and the AuthResult/AuthError pair IAuth
    answers with. In Rask.Wire rather than here because the accounts battery has to work on a host
    that carries no Rask.Core at all (#1069): Core is IsPackable=false and travels inside the host
    packages that render components, so anything that needs it is confined to those hosts. Rask.Wire
    is zero-dependency and trimming-clean, which is why it can sit under both halves.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Wire\Rask.Wire.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The devtools probe seam is read at a dozen render-path sites across Core; one project-wide
         import keeps each of them a one-line `RaskDevToolsHook.Active` check. -->
    <Using Include="Rask.Core.Diagnostics.DevTools"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>

    <!--
      Build-order-only dependency on the TypeScript task project, the same arrangement Rask.Wasm has
      with Rask.Wasm.Tasks. Rask.TypeScript.Tasks compiles the assembly and (via its
      CopyTaskAssemblyToRaskCoreBuild target) drops it into build/ here, where build/Rask.Core.targets
      loads it through <UsingTask AssemblyFile=…> and RaskCoreBuildPack.targets packs it into every
      host package.

      Without this edge the DLL exists only on a machine that happened to build the task project
      already: a clean clone would evaluate the UsingTask's Exists() guard as false, skip the compile
      target, and produce an app whose scoped TypeScript silently never compiled. The guard is what
      keeps that from being an error, so nothing would say so.

      ReferenceOutputAssembly="false" keeps it purely an ordering edge — no compile reference and no
      nupkg dependency on a netstandard2.0 build-only assembly.
    -->
    <ProjectReference Include="..\Rask.TypeScript.Tasks\Rask.TypeScript.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
  </ItemGroup>

  <!-- This package's own readme, in place of the framework overview Directory.Build.props packs by default. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md"/>
    <None Remove="NUGET.md"/>
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false"/>
  </ItemGroup>

  <!--
    The build integration, packed from here into build/ (a direct reference) and buildTransitive/ (an app
    that reaches this package through Rask.Server or Rask.Wasm, which is every app). build/Rask.targets is
    the entry point NuGet auto-imports; Rask.Core.targets is the payload it pulls in.

    The task DLL is named literally, not left to the glob: a glob is expanded at evaluation, before the
    ProjectReference that produces the DLL has built, so on a clean tree the glob packs nothing and pack
    still exits 0 (#852). The Error below makes a missing one fail the pack instead of a consumer's build.
  -->
  <ItemGroup>
    <None Include="build\**" Exclude="build\Rask.TypeScript.Tasks.dll" Pack="true" PackagePath="build\"/>
    <None Include="build\**" Exclude="build\Rask.TypeScript.Tasks.dll" Pack="true" PackagePath="buildTransitive\%(RecursiveDir)%(Filename)%(Extension)"/>
    <None Include="build\Rask.TypeScript.Tasks.dll" Pack="true" PackagePath="build\"/>
    <None Include="build\Rask.TypeScript.Tasks.dll" Pack="true" PackagePath="buildTransitive\Rask.TypeScript.Tasks.dll"/>
  </ItemGroup>

  <Target Name="_RaskVerifyBuildIntegrationPacked" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('build\Rask.TypeScript.Tasks.dll')"
           Text="build\Rask.TypeScript.Tasks.dll is missing — build Rask.TypeScript.Tasks before packing, or every consumer's scoped TypeScript silently never compiles."/>
  </Target>

  <!-- The analyzers, generator and IDE code-fixes, into analyzers/dotnet/cs/. -->
  <Import Project="..\RaskAnalyzerPack.targets"/>

</Project>
