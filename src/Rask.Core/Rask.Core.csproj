<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-targets net10.0-browser purely so the trim + AOT Roslyn analysers run over Core's own
      source (they are ignored on plain net10.0 — NETSDK1210). Core is IsPackable=false (it ships
      transitively from the host packages), so the extra TFM changes no published package; it only
      gives the warnings-as-errors build continuous IL2xxx/IL3050 coverage for the framework's
      AOT-sensitive paths (routing, forms binding).
    -->
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0-browser'">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Primitives"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.ObjectPool"/>
    <PackageReference Include="Microsoft.AspNetCore.Authorization"/>
    <!--
      IJSRuntime abstractions only — pulls in the contract + base JSRuntime class so user
      components can take IJSRuntime via ctor injection and Rask.Core can ship
      InvokeScopedAsync extensions. Does NOT drag in the Blazor renderer/circuit.
    -->
    <PackageReference Include="Microsoft.JSInterop"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Rask.Testing is a SHIPPED package that wraps Core's internal live-render + handler-invoke seam
         (RenderAsLiveRoot / TryInvokeHandlerAsync) into a supported public testing API. -->
    <InternalsVisibleTo Include="Rask.Testing"/>
    <InternalsVisibleTo Include="Rask.Core.Tests"/>
    <!-- The HTML/SVG element family, split out of Rask.Core.Components. It sits on the same internal
         seams the tag components always used while they lived here. -->
    <!-- Screen + the portable chrome bars. They implement Core's IScreenChrome seam explicitly, which is
         how Core walks a screen's chrome slots while naming no chrome type of its own. -->
    <InternalsVisibleTo Include="Rask.Html"/>
    <InternalsVisibleTo Include="Rask.Html.Tests"/>
    <!-- Rask.Bootstrap composes Core's components by FORWARDING its own carrier props into their
         generated factory arguments (`Button(OnClick: OnClick?.Fn)`), and a factory parameter is typed
         as the raw delegate — so it needs the carrier's internal Fn. Nothing public can stand in: a
         method group off the carrier (`h.Invoke`) would allocate a fresh delegate per handler per
         render and break the identity the wrap-preservation rule depends on. Retire this with the
         factory surface (Stage E), when forwarding becomes carrier-to-carrier. -->
    <InternalsVisibleTo Include="Rask.Bootstrap"/>
    <InternalsVisibleTo Include="Rask.Bootstrap.Tests"/>
    <InternalsVisibleTo Include="Rask.Server"/>
    <InternalsVisibleTo Include="Rask.Server.Tests"/>
    <!-- Same surface as Rask.Server.Tests; a separate assembly so MetadataUpdaterSupport can be on. -->
    <InternalsVisibleTo Include="Rask.Server.HotReload.Tests"/>
    <InternalsVisibleTo Include="Rask.Wasm"/>
    <InternalsVisibleTo Include="Rask.Wasm.Tests"/>
    <!-- For Navigator.EnterHandler: the remote-dispatch file bridge extends Navigator, so its tests need
         the same handler scope Rask.Core.Tests uses to exercise Download. -->
    <InternalsVisibleTo Include="Rask.Cqrs.Client.Tests"/>
    <InternalsVisibleTo Include="Rask.Benchmarks"/>
    <InternalsVisibleTo Include="Rask.Benchmarks.VsBlazor"/>
    <InternalsVisibleTo Include="Rask.Example.Shared.Tests"/>
    <InternalsVisibleTo Include="Rask.Example.Server.Tests"/>
    <InternalsVisibleTo Include="Rask.Example.Wasm.Tests"/>
    <InternalsVisibleTo Include="Rask.Example.Wasm.Host.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    build\Rask.Core.targets is deliberately NOT packed from here — IsPackable=false above makes any
    Pack="true" item on this project inert, which is exactly how it went unnoticed that consumers were
    getting no scoped CSS/JS (#544). It is packed into each host package's build/ folder by
    src\RaskCoreBuildPack.targets instead, and imported by that package's build/<PackageId>.targets.
  -->

</Project>
