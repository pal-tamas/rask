<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets);$(RaskBrowserTfm)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Xlsx</PackageId>
    <Title>Rask.Xlsx — an Excel workbook from a list of rows</Title>
    <Description>Writes an Excel workbook (.xlsx) from headings and rows with nothing but System.IO.Compression: bold frozen headings with a sort-and-filter button, fitted columns, amounts with thousands, days and moments, rows folded under the one before them, and a total row that follows the filter. Xlsx.Write(sheet, headings, rows) returns the file's bytes. Zero dependencies; runs on the server and in the browser.</Description>
    <PackageTags>xlsx excel spreadsheet export openxml workbook dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Xlsx.Tests"/>
  </ItemGroup>

</Project>
