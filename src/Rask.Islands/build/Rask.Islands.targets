<Project>

  <!--
    Rask.Islands build integration: turn the front-end files sitting beside components into one
    bundled chunk each, plus the manifest the client runtime resolves names through.

      1. Find the island sources (a .tsx/.jsx beside a .cs, or an explicit <RaskIsland> item).
      2. No islands -> stop. Nothing below runs, and node is never probed.
      3. Vendor the adapters into obj/, so the generated entries import a stable path.
      4. Write one entry module per island, plus the Vite config, into obj/.
      5. `npm ci` / `npm install`, then `vite build` with that config.

    Everything is conditioned on an island actually existing, because this file is imported into EVERY
    project of every consumer — same as Rask.Spa.Hosting.targets.

    The MSBuild rules that shape all of it, both learned the hard way in the SPA targets:

      * Item-list references are illegal in a property Condition (MSB4099), so "do we have islands?"
        cannot be a property computed from @(_RaskIslandFile). It is a target Condition instead.
      * Properties evaluate in an EARLIER PASS than items, so a property that reads @(SomeItem) reads
        nothing at all — silently, producing an empty string rather than an error.
  -->

  <PropertyGroup>
    <!--
      ABSOLUTE, deliberately. IntermediateOutputPath is relative to the project, and these paths are
      written into generated JavaScript as import specifiers — where a relative path with no leading
      './' is not a relative path at all but a BARE specifier, which the bundler resolves against
      node_modules and fails on. The failure names a package nobody wrote.
    -->
    <_RaskIslandsObj>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)rask-islands'))\</_RaskIslandsObj>
    <_RaskIslandsAdapters>$(_RaskIslandsObj)rask\</_RaskIslandsAdapters>
    <_RaskIslandsOut>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(RaskIslandsOutputDir)'))</_RaskIslandsOut>
    <_RaskIslandsManifest>$(_RaskIslandsOut)\manifest.json</_RaskIslandsManifest>

    <!--
      A project can only bundle islands if it has a package.json, so its absence is the cheapest
      correct gate — one file probe, and it is what makes this file free to import into every project
      of every consumer. The glob below would otherwise walk each project's source tree on every
      evaluation, design-time builds included, to discover that almost none of them have a .tsx.

      The cost of gating here is that "I added Chart.tsx and nothing happened" gets no diagnostic in a
      project that has no package.json. That is the trade taken deliberately: the bundle could not
      have run there anyway, the CLI's island scaffolding writes the package.json, and
      docs/islands.md says so up front.
    -->
    <_RaskIslandsBundlable Condition="Exists('$(MSBuildProjectDirectory)/package.json')">true</_RaskIslandsBundlable>

    <!-- Design-time builds are excluded everywhere below: an IDE reloading the project must never
         shell out to npm. -->
    <_RaskIslandsEnabled Condition="'$(RaskIslandsBuild)' != 'false' AND '$(DesignTimeBuild)' != 'true' AND '$(_RaskIslandsBundlable)' == 'true'">true</_RaskIslandsEnabled>
  </PropertyGroup>

  <!--
    The island sources.

    A .tsx/.jsx anywhere in the project pairs with the component of the same name beside it — the same
    convention scoped CSS and scoped JS already use, so there is nothing new to learn and nothing to
    register. Lit islands are NOT globbed: a Lit component is an ordinary .ts file and a glob for those
    would sweep up every piece of TypeScript in the project, so they are declared explicitly.

    The excludes are narrow on purpose. A **/* walk that reached node_modules would enumerate tens of
    thousands of files on every evaluation, costing far more than the build it feeds.
  -->
  <ItemGroup Condition="'$(_RaskIslandsBundlable)' == 'true'">
    <_RaskIslandFile Include="$(MSBuildProjectDirectory)/**/*.tsx;$(MSBuildProjectDirectory)/**/*.jsx"
                     Exclude="$(MSBuildProjectDirectory)/obj/**/*;$(MSBuildProjectDirectory)/bin/**/*;$(MSBuildProjectDirectory)/node_modules/**/*;$(MSBuildProjectDirectory)/wwwroot/**/*">
      <IslandName>%(Filename)</IslandName>
      <Runtime>react</Runtime>
    </_RaskIslandFile>

    <!-- Explicitly declared islands, for a runtime the glob cannot infer:
             <RaskIsland Include="widgets/gauge.ts" Runtime="lit"/> -->
    <_RaskIslandFile Include="@(RaskIsland)">
      <IslandName Condition="'%(RaskIsland.IslandName)' == ''">%(Filename)</IslandName>
      <Runtime Condition="'%(RaskIsland.Runtime)' == ''">lit</Runtime>
    </_RaskIslandFile>

    <_RaskIslandsAdapterSource Include="$(MSBuildThisFileDirectory)../client/*.ts"/>
  </ItemGroup>

  <UsingTask TaskName="Rask.Islands.Tasks.WriteIslandBuildInputsTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.Islands.Tasks.dll"/>

  <!--
    The adapters, vendored into obj/ rather than into the author's source tree. They are refreshed
    from the package on every build, which is what keeps the client half wire-locked to the C# half:
    upgrading Rask.Islands upgrades both together or the pair drifts.
  -->
  <Target Name="_RaskIslandsVendorAdapters"
          Condition="'$(_RaskIslandsEnabled)' == 'true'"
          Inputs="@(_RaskIslandsAdapterSource)"
          Outputs="@(_RaskIslandsAdapterSource->'$(_RaskIslandsAdapters)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(_RaskIslandsAdapterSource)" DestinationFolder="$(_RaskIslandsAdapters)"
          SkipUnchangedFiles="true"/>
  </Target>

  <!--
    AFTER the compile: the island's C# has to be valid before its front end is worth bundling, and a
    bundle that preceded the compile would build against a component the generator has not accepted.
  -->
  <Target Name="_RaskIslandsWriteInputs"
          AfterTargets="CoreCompile"
          DependsOnTargets="_RaskIslandsVendorAdapters"
          Condition="'$(_RaskIslandsEnabled)' == 'true' AND '@(_RaskIslandFile)' != ''">
    <WriteIslandBuildInputsTask Islands="@(_RaskIslandFile)"
                                IntermediateDirectory="$(_RaskIslandsObj)"
                                AdapterDirectory="$(_RaskIslandsAdapters)"
                                OutputDirectory="$(_RaskIslandsOut)"
                                ManifestPath="$(_RaskIslandsManifest)"
                                PublicBase="$(RaskIslandsPublicBase)">
      <Output TaskParameter="ConfigPath" PropertyName="_RaskIslandsConfig"/>
    </WriteIslandBuildInputsTask>
  </Target>

  <!-- Its own target with its own up-to-date check, because it is the expensive one. -->
  <Target Name="_RaskIslandsInstall"
          DependsOnTargets="_RaskIslandsWriteInputs"
          Condition="'$(_RaskIslandsEnabled)' == 'true' AND '@(_RaskIslandFile)' != ''"
          Inputs="$(MSBuildProjectDirectory)/package.json"
          Outputs="$(IntermediateOutputPath)rask-islands.install.stamp">
    <PropertyGroup>
      <_RaskIslandsInstall Condition="Exists('$(MSBuildProjectDirectory)/package-lock.json')">$(RaskIslandsInstallCommand)</_RaskIslandsInstall>
      <_RaskIslandsInstall Condition="'$(_RaskIslandsInstall)' == ''">$(RaskIslandsFirstInstallCommand)</_RaskIslandsInstall>
    </PropertyGroup>
    <Message Importance="high" Text="Rask.Islands: $(_RaskIslandsInstall) in $(MSBuildProjectDirectory)"/>
    <Exec Command="$(_RaskIslandsInstall)" WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"/>
    <MakeDir Directories="$(IntermediateOutputPath)"/>
    <Touch Files="$(IntermediateOutputPath)rask-islands.install.stamp" AlwaysCreate="true"/>
  </Target>

  <!--
    The manifest is listed first among the Outputs so that deleting the bundle by hand forces a
    rebuild even though the stamp file survives.
  -->
  <Target Name="_RaskIslandsBundle"
          AfterTargets="CoreCompile"
          DependsOnTargets="_RaskIslandsInstall"
          Condition="'$(_RaskIslandsEnabled)' == 'true' AND '@(_RaskIslandFile)' != ''"
          Inputs="@(_RaskIslandFile);$(_RaskIslandsConfig)"
          Outputs="$(_RaskIslandsManifest);$(IntermediateOutputPath)rask-islands.build.stamp">
    <Message Importance="high" Text="Rask.Islands: bundling @(_RaskIslandFile->Count()) island(s) ($(Configuration))"/>
    <Exec Command="$(RaskIslandsBuildCommand) &quot;$(_RaskIslandsConfig)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"/>
    <Error Condition="!Exists('$(_RaskIslandsManifest)')"
           Code="RASKISLAND002"
           Text="Rask.Islands: the bundler finished but wrote no manifest at '$(_RaskIslandsManifest)'. The client runtime resolves an island's chunk through that file, so every island on the page would fail to mount."/>
    <MakeDir Directories="$(IntermediateOutputPath)"/>
    <Touch Files="$(IntermediateOutputPath)rask-islands.build.stamp" AlwaysCreate="true"/>
  </Target>

</Project>
