<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Testing.Playwright</PackageId>
    <Title>Rask.Testing.Playwright — run a Rask app for Playwright browser tests, walk its pages, wait for it to settle</Title>
    <Description>Browser tests for a Rask app. RaskSite&lt;Program&gt; starts the app's own build as a process of its own on a free port, over a database of its own, waits for its health check, and hands out pages in one shared Chromium — signed out, or await site.SignedIn(site.Admin), signed in once and reused. await site.Walk("/orders") opens a page and fails on a console or page error, a failed request, a not-found or forbidden answer, a dropped connection, or a page wider than a phone; RaskSite.Pages&lt;Program&gt;() lists every page the app's route table can open without a value, for a walk-every-page test. await page.WaitForRask() waits until a page has settled: every event answered and its render on the page, every navigation landed, the connection open, what was typed sent — no sleeps, no DOM-quiet windows. The Rask answer to Laravel Dusk.</Description>
    <PackageTags>rask playwright e2e end-to-end browser-testing testing smoke walk settle livewire dusk dotnet net11</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework overview
       that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
    <!-- Records where each referenced app's build is, for RaskSite<Program> (see build/Rask.Testing.Playwright.targets).
         Twinned under buildTransitive/ like every hook, so a shared test-helper project that brings the package
         along records its consumer's apps too. -->
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="build\**" Pack="true" PackagePath="buildTransitive\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser driver the test project already uses. -->
    <PackageReference Include="Microsoft.Playwright"/>
  </ItemGroup>

  <ItemGroup>
    <!-- RaskSite.Pages<Program>() reads the app's route table. WaitForRask needs no Rask assembly — its contract is
         the data-rask-busy mark on the page — but a test project that references its app has Rask already. -->
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Testing.Playwright.Tests"/>
  </ItemGroup>

</Project>
