<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rask.Meta.Hosting</RootNamespace>

    <PackageId>Rask.Meta.Hosting</PackageId>
    <Title>Rask — Meta Framework Host</Title>
    <Description>ASP.NET host for a meta framework front end — Nuxt, TanStack Start, SolidStart, SvelteKit, Analog or Next.js — running beside your C# in ONE container. Kestrel owns the public port and answers /_rask itself; the framework's own Node server is a supervised child on loopback, and everything else is forwarded to it with WebSocket upgrade and unbuffered streaming intact. Pairs with Rask.Cqrs.Server, which gives server-side rendering a typed wire back into your C#. Distinct from Rask.Spa.Hosting, which serves a static bundle and needs no Node at runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      The one external dependency in this package, and a deliberate one. IHttpForwarder is YARP's
      low-level "direct forwarding" surface — no route table, no config model, just
      SendAsync(context, destination, invoker, config, transformer). It is the piece that already gets
      right the three things a hand-rolled HttpClient proxy gets wrong, and all three are mandatory
      here rather than nice to have: WebSocket (and HTTP/2 CONNECT) upgrade, UNBUFFERED response
      streaming — React Server Components and streaming SSR are the entire reason to adopt a meta
      framework, and buffering deletes the feature while every test still passes — and hop-by-hop
      header stripping. Reimplementing that is exactly the "prefer standard .NET APIs, don't reinvent"
      this repo warns against, and the package is Microsoft-published.
    -->
    <PackageReference Include="Yarp.ReverseProxy"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      Build-order-only edge to the MSBuild task project, which drops Rask.Spa.Tasks.dll into this
      package's build/ folder for <UsingTask> to load. ReferenceOutputAssembly is false because the
      task runs inside MSBuild, not inside this library — nothing here calls it.

      The same task the SPA lane loads, and deliberately not a second copy of it: what it does is read
      the generated contract constants out of the compiled assembly and write them as TypeScript,
      which is neither lane's private business.
    -->
    <ProjectReference Include="..\Rask.Spa.Tasks\Rask.Spa.Tasks.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Meta.Hosting.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      The build integration, shipped as MSBuild only — there is no task assembly here, so the glob is
      safe: every file it matches is committed, and none is produced by a build. That is the difference
      from Rask.Spa.Hosting, which has to name its generated task DLL explicitly because a glob is
      expanded at project EVALUATION and would silently pack nothing on a tree where the DLL is not yet
      on disk (#852).
    -->
    <!--
      The DLL is EXCLUDED from the glob and named on its own line, which is #852's lesson: a Pack glob
      is expanded at project EVALUATION, so on a tree where the task assembly is not yet on disk the
      glob silently packs nothing and the consumer gets a package whose <UsingTask> points at a file
      that was never shipped. Naming it fails loudly instead.
    -->
    <None Include="build\**" Exclude="build\Rask.Spa.Tasks.dll" Pack="true" PackagePath="build\"/>
    <None Include="build\Rask.Spa.Tasks.dll" Pack="true" PackagePath="build\"/>

    <!--
      Rask's browser layer, packed FROM Rask.Core rather than copied into this project, exactly as
      Rask.Spa.Hosting packs it. One source of truth for code three very different consumers run: the
      Server client and the WASM client bundle it through Resources/browser/globals.ts, and a meta
      framework's front end imports these same files as `@rask/browser/…`.

      Packing across a directory boundary rather than taking a ProjectReference keeps this package's
      dependency surface at one entry (Yarp.ReverseProxy) — the same reach the SPA package makes, and
      safe under the rule above because every file matched is committed source.

      globals.ts is excluded: it publishes the window.__rask* namespaces .NET resolves dotted
      identifiers against, and a front end has no use for it. It is also the one module in that
      directory with an import-time side effect, which would be a ReferenceError in a Node SSR pass.
    -->
    <None Include="..\Rask.Core\Resources\browser\*.ts"
          Exclude="..\Rask.Core\Resources\browser\globals.ts"
          Pack="true"
          PackagePath="client\browser"/>

    <!--
      The dispatcher, packed from Rask.Spa.Hosting's client/ for the same one-source-of-truth reason
      as the browser layer above. It is the wire, not an SPA concern: `client.ts` already carries the
      three seams a server render needs — an explicit `baseUrl` (a relative URL has no origin in
      Node), an injectable `fetch`, and an `onRequest` hook to attach the visitor's cookie — and its
      own `defaultBaseUrl()` says so, falling back to '' "outside a bundler (tests, SSR)".
    -->
    <None Include="..\Rask.Spa.Hosting\client\*.ts" Pack="true" PackagePath="client"/>
  </ItemGroup>

</Project>
