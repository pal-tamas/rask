<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted because this runs on both sides: a server uploading snapshots, and a WASM app
         syncing straight from the browser with no backend in between. -->
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>Rask.ObjectStore</PackageId>
    <Title>Rask.ObjectStore — S3 / Azure Blob client</Title>
    <Description>A small object-storage client for Rask: ranged reads, streaming writes, conditional create, prefix listing and delete, over Amazon S3 (and every S3-compatible store — Cloudflare R2, Google Cloud Storage via its S3 interop keys, MinIO, Backblaze B2, DigitalOcean Spaces) or Azure Blob Storage. Signs SigV4 itself and takes an Azure SAS as-is, so there is no cloud SDK to pull in. Runs server-side and in the browser under WebAssembly — the same client can upload a database snapshot from a host or sync a static site straight to a bucket with no backend. No external dependencies beyond Microsoft.Extensions.*.</Description>
    <PackageTags>s3 azure-blob object-storage sigv4 r2 minio gcs backblaze local-first dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README instead of the shared framework overview. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SigV4 signer is internal — it is an implementation detail of the S3 store, not API — but it is
         the one piece here that has to be exactly right, so the tests reach it directly. -->
    <InternalsVisibleTo Include="Rask.ObjectStore.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Options comes transitively with Http; there is no central PackageVersion for it and adding one
         would pin a version this package has no opinion about. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Http"/>
  </ItemGroup>

</Project>
