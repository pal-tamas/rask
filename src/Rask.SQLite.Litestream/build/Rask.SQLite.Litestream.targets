<Project>

  <!--
    Bundles the litestream binary for the target runtime next to an app that references Rask.SQLite.Litestream
    itself, so it needs no separate install. Fetched once into a per-user cache
    ($(RaskLitestreamCacheRoot)/<version>/<rid>), SHA-256-verified against the pinned checksum, and reused by every
    later build without touching the network.

    Only an app that wants it: one that has the package only through Rask.Server (every server app, SQL Server and
    PostgreSQL ones included) fetches nothing, because a scaffolded app runs litestream from its container image
    and a hand-wired one that never sets Rask:Litestream:ReplicaUrl never runs it at all. A GitHub outage used to
    fail such a build on a binary it had no use for (MSB3923).

    Nor does a plain build fail over it: the binary runs beside the PUBLISHED app, so an unreachable release host is
    a warning at build and an error only at publish. RaskLitestreamDownload=true/false overrides the decision. See
    build/Rask.SQLite.Litestream.props for the knobs.
  -->

  <Import Project="$(MSBuildThisFileDirectory)Rask.FetchVerifiedFile.targets"
          Condition="'$(_RaskFetchVerifiedFileImported)' != 'true' and Exists('$(MSBuildThisFileDirectory)Rask.FetchVerifiedFile.targets')" />
  <!-- In this repository the shared fetch lives in one place rather than beside each package's targets. -->
  <Import Project="$(MSBuildThisFileDirectory)../../Rask.Build.Shared/Rask.FetchVerifiedFile.targets"
          Condition="'$(_RaskFetchVerifiedFileImported)' != 'true' and Exists('$(MSBuildThisFileDirectory)../../Rask.Build.Shared/Rask.FetchVerifiedFile.targets')" />

  <!--
    Whether this app wants the binary. A property cannot test an item at evaluation (properties are all evaluated
    before any item), so the decision is a target's.
  -->
  <Target Name="_RaskDecideLitestream">
    <ItemGroup Condition="'$(RaskLitestreamDownload)' == ''">
      <_RaskLsDirectReference Include="@(PackageReference)" Condition="'%(Identity)' == 'Rask.SQLite.Litestream'" />
      <_RaskLsDirectReference Include="@(ProjectReference)" Condition="'%(Filename)' == 'Rask.SQLite.Litestream'" />
    </ItemGroup>
    <PropertyGroup>
      <_RaskLsWanted>$(RaskLitestreamDownload)</_RaskLsWanted>
      <_RaskLsWanted Condition="'$(_RaskLsWanted)' == '' and '@(_RaskLsDirectReference)' != ''">true</_RaskLsWanted>
      <_RaskLsWanted Condition="'$(_RaskLsWanted)' != 'true'">false</_RaskLsWanted>
    </PropertyGroup>
  </Target>

  <Target Name="_RaskResolveLitestreamAsset" DependsOnTargets="_RaskDecideLitestream">
    <PropertyGroup>
      <!-- Target RID, or the build host when building portable (no RID). -->
      <_RaskLsRid>$(RuntimeIdentifier)</_RaskLsRid>
      <_RaskLsHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_RaskLsHostArch>
      <_RaskLsRid Condition="'$(_RaskLsRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-$(_RaskLsHostArch)</_RaskLsRid>
      <_RaskLsRid Condition="'$(_RaskLsRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-$(_RaskLsHostArch)</_RaskLsRid>
      <_RaskLsRid Condition="'$(_RaskLsRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-$(_RaskLsHostArch)</_RaskLsRid>

      <!-- Map the RID to litestream's os/arch tokens. -->
      <_RaskLsOs Condition="$(_RaskLsRid.StartsWith('linux'))">linux</_RaskLsOs>
      <_RaskLsOs Condition="$(_RaskLsRid.StartsWith('osx'))">darwin</_RaskLsOs>
      <_RaskLsOs Condition="$(_RaskLsRid.StartsWith('win'))">windows</_RaskLsOs>

      <_RaskLsArch Condition="$(_RaskLsRid.EndsWith('arm64'))">arm64</_RaskLsArch>
      <_RaskLsArch Condition="$(_RaskLsRid.EndsWith('x64'))">x86_64</_RaskLsArch>
      <_RaskLsArch Condition="$(_RaskLsRid.EndsWith('arm')) and !$(_RaskLsRid.EndsWith('arm64'))">armv7</_RaskLsArch>

      <_RaskLsIsZip>false</_RaskLsIsZip>
      <_RaskLsIsZip Condition="'$(_RaskLsOs)' == 'windows'">true</_RaskLsIsZip>
      <_RaskLsExt>.tar.gz</_RaskLsExt>
      <_RaskLsExt Condition="'$(_RaskLsIsZip)' == 'true'">.zip</_RaskLsExt>
      <_RaskLsExeSuffix Condition="'$(_RaskLsOs)' == 'windows'">.exe</_RaskLsExeSuffix>

      <!-- Which os/arch combos litestream actually ships. -->
      <_RaskLsSupported>false</_RaskLsSupported>
      <_RaskLsSupported Condition="'$(_RaskLsOs)' == 'linux' and ('$(_RaskLsArch)' == 'x86_64' or '$(_RaskLsArch)' == 'arm64' or '$(_RaskLsArch)' == 'armv7')">true</_RaskLsSupported>
      <_RaskLsSupported Condition="'$(_RaskLsOs)' == 'darwin' and ('$(_RaskLsArch)' == 'x86_64' or '$(_RaskLsArch)' == 'arm64')">true</_RaskLsSupported>
      <_RaskLsSupported Condition="'$(_RaskLsOs)' == 'windows' and ('$(_RaskLsArch)' == 'x86_64' or '$(_RaskLsArch)' == 'arm64')">true</_RaskLsSupported>

      <_RaskLsAsset>litestream-$(RaskLitestreamVersion)-$(_RaskLsOs)-$(_RaskLsArch)$(_RaskLsExt)</_RaskLsAsset>
      <_RaskLsUrl>$(RaskLitestreamReleaseBaseUrl)/v$(RaskLitestreamVersion)/$(_RaskLsAsset)</_RaskLsUrl>

      <_RaskLsCacheDir>$([System.IO.Path]::Combine('$(RaskLitestreamCacheRoot)', '$(RaskLitestreamVersion)', '$(_RaskLsRid)'))$([System.IO.Path]::DirectorySeparatorChar)</_RaskLsCacheDir>
      <_RaskLsArchivePath>$(_RaskLsCacheDir)$(_RaskLsAsset)</_RaskLsArchivePath>
      <_RaskLsBinary>$(_RaskLsCacheDir)litestream$(_RaskLsExeSuffix)</_RaskLsBinary>

      <!-- Pinned SHA-256s for the default version. A user-supplied RaskLitestreamSha256 always wins. -->
      <_RaskLsSha Condition="'$(RaskLitestreamVersion)' == '0.5.18' and '$(_RaskLsOs)-$(_RaskLsArch)' == 'linux-x86_64'">d3687b9fd0f2e9426bbd3da828429ff3f1dfc5c9b74d54fdf028e4ee510e7dea</_RaskLsSha>
      <_RaskLsSha Condition="'$(RaskLitestreamVersion)' == '0.5.18' and '$(_RaskLsOs)-$(_RaskLsArch)' == 'linux-arm64'">922a09e6a7ac67f2095571894dc6382e94e1dd4cdd9674883ddf1a8e74ab982d</_RaskLsSha>
      <_RaskLsSha Condition="'$(RaskLitestreamVersion)' == '0.5.18' and '$(_RaskLsOs)-$(_RaskLsArch)' == 'linux-armv7'">cca21d9c7178da6acc6ac16c9eb8ede48989be5209868a4035a4211451cc39f6</_RaskLsSha>
      <_RaskLsSha Condition="'$(RaskLitestreamVersion)' == '0.5.18' and '$(_RaskLsOs)-$(_RaskLsArch)' == 'darwin-x86_64'">25846be4fc4a4e0b4fd9ac5d0e019c10ec70a4dc12fe84255f5607b8b9a520e0</_RaskLsSha>
      <_RaskLsSha Condition="'$(RaskLitestreamVersion)' == '0.5.18' and '$(_RaskLsOs)-$(_RaskLsArch)' == 'darwin-arm64'">6d3e0875e5416628ef3d274e8f7bb0ecc2a19cbbe76b9ba43efe9901d82a5c84</_RaskLsSha>
      <_RaskLsSha Condition="'$(RaskLitestreamVersion)' == '0.5.18' and '$(_RaskLsOs)-$(_RaskLsArch)' == 'windows-x86_64'">7cc9115cb3ff2ee4800d476a328ffca6e8f3504da15e010b8c9c8ef1b9ab811f</_RaskLsSha>
      <_RaskLsSha Condition="'$(RaskLitestreamVersion)' == '0.5.18' and '$(_RaskLsOs)-$(_RaskLsArch)' == 'windows-arm64'">8b896d6c2143766d98e063b234dac7c7dae4e6ddaa6036a0ebe329270910a584</_RaskLsSha>
      <_RaskLsSha Condition="'$(RaskLitestreamSha256)' != ''">$(RaskLitestreamSha256)</_RaskLsSha>
    </PropertyGroup>
  </Target>

  <!-- Bundled next to the app on build and publish, when it is wanted and fetched. -->
  <Target Name="_RaskBundleLitestream"
          Condition="'$(DesignTimeBuild)' != 'true'"
          DependsOnTargets="_RaskResolveLitestreamAsset;_RaskFetchLitestream"
          BeforeTargets="AssignTargetPaths">
    <ItemGroup Condition="'$(_RaskLsWanted)' == 'true' and '$(_RaskLsSupported)' == 'true' and Exists('$(_RaskLsBinary)')">
      <None Include="$(_RaskLsBinary)">
        <Link>litestream$(_RaskLsExeSuffix)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
  </Target>

  <!--
    Fetched only when not cached: a cache hit is one Exists() and no network at all. The archive is fetched and
    verified by RaskFetchVerifiedFile, then unpacked in a directory of this build's own and moved into the cache,
    so two projects building for the first time at once never share a half-written file.
  -->
  <Target Name="_RaskFetchLitestream" Condition="'$(_RaskLsWanted)' == 'true'">
    <Warning Condition="'$(_RaskLsSupported)' != 'true'"
             Text="Rask.SQLite.Litestream: litestream ships no binary for runtime '$(_RaskLsRid)'. Install litestream and set LitestreamOptions.ExecutablePath, or set RaskLitestreamDownload=false." />

    <PropertyGroup Condition="'$(_RaskLsSupported)' == 'true' and !Exists('$(_RaskLsBinary)')">
      <_RaskLsFetch>true</_RaskLsFetch>
      <_RaskLsStageDir>$(_RaskLsCacheDir).stage-$([System.Guid]::NewGuid().ToString('N'))$([System.IO.Path]::DirectorySeparatorChar)</_RaskLsStageDir>
      <_RaskLsArchivePath>$(_RaskLsStageDir)$(_RaskLsAsset)</_RaskLsArchivePath>
      <!-- Needed by a publish, not by a build: the binary runs beside the published app. -->
      <_RaskLsRequired>false</_RaskLsRequired>
      <_RaskLsRequired Condition="'$(_IsPublishing)' == 'true'">true</_RaskLsRequired>
    </PropertyGroup>

    <RaskFetchVerifiedFile Condition="'$(_RaskLsFetch)' == 'true'"
                           Url="$(_RaskLsUrl)"
                           DestinationFile="$(_RaskLsArchivePath)"
                           Sha256="$(_RaskLsSha)"
                           Product="Rask.SQLite.Litestream"
                           CacheDirectory="$(RaskLitestreamCacheRoot)"
                           Required="$(_RaskLsRequired)"
                           RetryWaits="$(_RaskFetchRetryWaits)"
                           Remedy="Or set RaskLitestreamDownload=false and run litestream from the container image (docs/sqlite.md).">
      <Output TaskParameter="Fetched" PropertyName="_RaskLsFetched" />
    </RaskFetchVerifiedFile>

    <!-- Extract the binary (litestream / litestream.exe), then move it into the cache. -->
    <Exec Condition="'$(_RaskLsFetched)' == 'true' and '$(_RaskLsIsZip)' != 'true'"
          Command="tar -xzf &quot;$(_RaskLsArchivePath)&quot; -C &quot;$(_RaskLsStageDir)&quot;" />
    <Unzip Condition="'$(_RaskLsFetched)' == 'true' and '$(_RaskLsIsZip)' == 'true'"
           SourceFiles="$(_RaskLsArchivePath)" DestinationFolder="$(_RaskLsStageDir)" />
    <Move Condition="'$(_RaskLsFetched)' == 'true' and !Exists('$(_RaskLsBinary)')"
          SourceFiles="$(_RaskLsStageDir)litestream$(_RaskLsExeSuffix)" DestinationFiles="$(_RaskLsBinary)" />
    <RemoveDir Condition="'$(_RaskLsFetch)' == 'true'" Directories="$(_RaskLsStageDir)" ContinueOnError="true" />
  </Target>

  <!-- A publish that wanted the binary and has none fails, rather than shipping an app whose backup cannot start. -->
  <Target Name="_RaskRequireLitestreamForPublish"
          BeforeTargets="PrepareForPublish"
          DependsOnTargets="_RaskResolveLitestreamAsset">
    <Error Condition="'$(_RaskLsWanted)' == 'true' and '$(_RaskLsSupported)' == 'true' and !Exists('$(_RaskLsBinary)')"
           Text="Rask.SQLite.Litestream: this publish bundles litestream, and '$(_RaskLsBinary)' was never fetched. Build once with network access (or seed $(RaskLitestreamCacheRoot)), or set RaskLitestreamDownload=false and run litestream from the container image." />
  </Target>

  <!-- MSBuild's copy doesn't carry the Unix exec bit, so restore it on the copied binary. -->
  <Target Name="_RaskChmodLitestreamBuild"
          AfterTargets="Build"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Condition="'$(_RaskLsWanted)' == 'true' and Exists('$(TargetDir)litestream')" Command="chmod +x &quot;$(TargetDir)litestream&quot;" />
  </Target>

  <Target Name="_RaskChmodLitestreamPublish"
          AfterTargets="Publish"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Condition="'$(_RaskLsWanted)' == 'true' and Exists('$(PublishDir)litestream')" Command="chmod +x &quot;$(PublishDir)litestream&quot;" />
  </Target>

</Project>
