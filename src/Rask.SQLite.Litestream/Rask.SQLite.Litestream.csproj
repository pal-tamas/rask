<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.SQLite.Litestream</PackageId>
    <Title>Rask.SQLite.Litestream — managed Litestream backup for SQLite</Title>
    <Description>Supervises the Litestream sidecar from inside your .NET app: restores the SQLite database from its replica on startup (if the local file is missing) and continuously streams the write-ahead log to S3/GCS/Azure/file storage for the life of the process, via a hosted background service. Pairs with Rask.SQLite's WAL default, which Litestream requires. Register with `services.AddRaskSqliteLitestream(...)` and call `RestoreSqliteFromLitestreamAsync()` before opening the database. Requires the `litestream` binary on the host (or a path you configure). Standalone: depends only on the Microsoft.Extensions hosting/DI abstractions.</Description>
    <!-- Override the framework default tags (web/component/wasm) — this is a standalone, host-agnostic
         backup supervisor with no web/UI coupling. -->
    <PackageTags>sqlite litestream backup replication wal disaster-recovery s3 hosted-service dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Update="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

</Project>
