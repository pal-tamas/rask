<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <!-- Ship as a .NET global/local tool: `dotnet tool install -g Rask.Cli` exposes `rask`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rask</ToolCommandName>
    <RollForward>Major</RollForward>
    <!--
      One framework on purpose, unlike the libraries: a tool is an application, and RollForward=Major already
      runs it on any newer runtime, so a second build would only double the package. See
      RaskVerifyTargetFrameworks in Directory.Build.targets.
    -->
    <RaskTargetFrameworksExempt>true</RaskTargetFrameworksExempt>

    <PackageId>Rask.Cli</PackageId>
    <Title>Rask.Cli — the `rask` command-line tool</Title>
    <Description>The `rask` .NET tool: a productivity front-door for the Rask framework. Scaffold a new project (`rask new`), run it with hot reload (`rask dev`), manage EF Core migrations and back the database up (`rask db`), and deploy to a single host over SSH with auto-HTTPS (`rask deploy`) — a thin wrapper over the .NET SDK. Run it with no arguments for an interactive new-project wizard. Install with `dotnet tool install -g Rask.Cli`.</Description>
    <PackageTags>rask cli dotnet-tool scaffolding tooling dotnet net10</PackageTags>

    <!-- This is an executable tool, not a consumed library: no public API surface to document. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- `rask db backup` has to take a *consistent* copy of a live SQLite database: with WAL on, the .db
         file alone is torn or stale, so it needs the Online Backup API. This is the tool's only package
         reference, and it buys the one thing that cannot be shelled out to — the SDK ships no sqlite
         verb, and requiring a `sqlite3` binary on the machine would trade a dependency we can pin for one
         we cannot. Remote backups still need nothing locally: they run inside a container on the host. -->
    <PackageReference Include="Microsoft.Data.Sqlite"/>
    <!-- Security: pulls the patched SQLitePCLRaw 3.x bundle over the 2.1.11 one Microsoft.Data.Sqlite
         pins (CVE-2025-6965). A direct reference is the only lever under CPM — transitive pinning does
         not move it. See Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"/>
    <!-- Spectre.Console renders every human-facing surface the tool has: the help pages, the
         `deploy status` and `doctor` tables, the deploy/bootstrap spinners, and the `rask new` wizard.
         Unlike the SQLite reference above, this one is not something that *cannot* be hand-rolled — the
         CLI did hand-roll it, in ~270 lines of ANSI escapes, `\r` overwrites and `PadRight` columns that
         never learned terminal width, wrapping or arrow-key selection. This is a deliberate trade of a
         dependency we pin for terminal-rendering code we would otherwise keep growing badly.

         Measured, not assumed: a self-contained `PublishTrimmed` build of this tool succeeds with zero IL
         warnings and runs, with Spectre.Console + Spectre.Console.Ansi trimming to ~0.7 MB. Nothing in the
         repo enforces trimming today (see the note in JsonOutput.cs), but the option stays open. -->
    <PackageReference Include="Spectre.Console"/>
  </ItemGroup>

  <!-- The template trees ARE the scaffolder's payload: `rask new` writes these bytes out, so editing a
       file under src/Rask.Templates/ changes what the next scaffold produces, with no second copy in C#
       to drift from it. They live in a sibling directory rather than under this project because a
       template holds .cs and .csproj files of its own, which this project's Compile glob and MSBuild's
       project discovery would otherwise pick up as source.

       LogicalName is set explicitly because the default resource name replaces directory separators
       with dots, which is ambiguous the moment a file is called Company.RaskServer.csproj — there is no
       way back to the path. Keeping '/' means the resource name IS the relative path. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Rask.Templates\**\*" Visible="false">
      <LogicalName>RaskTemplate/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
      <!-- WithCulture=false, or MSBuild reads a culture out of the FILENAME and routes the file into a
           satellite assembly: the server template's Resources/Strings.en.json becomes
           en/Rask.Cli.resources.dll and disappears from the payload. The scaffold then writes an app
           whose localization catalog is simply absent, with a green build and nothing said. Every
           template file is an opaque blob to us, never a culture resource. -->
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Cli.Tests" />
    <!-- The template gate scaffolds through the same generator dispatch NewCommand uses, so the arm
         under test is the one that ships rather than a re-implementation of the switch. -->
    <InternalsVisibleTo Include="Rask.Templates.E2E.Tests" />
    <InternalsVisibleTo Include="Rask.Cli.E2E.Tests" />
  </ItemGroup>

</Project>
