<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <!-- Ship as a .NET global/local tool: `dotnet tool install -g Rask.Cli` exposes `rask`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rask</ToolCommandName>
    <RollForward>Major</RollForward>

    <PackageId>Rask.Cli</PackageId>
    <Title>Rask.Cli — the `rask` command-line tool</Title>
    <Description>The `rask` .NET tool: a productivity front-door for the Rask framework. Scaffold a new project (`rask new`), run it with hot reload (`rask dev`), and inspect your environment (`rask info`) — a thin, dependency-free wrapper over the .NET SDK. Install with `dotnet tool install -g Rask.Cli`.</Description>
    <PackageTags>rask cli dotnet-tool scaffolding tooling dotnet net10</PackageTags>

    <!-- This is an executable tool, not a consumed library: no public API surface to document. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Update="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Cli.Tests" />
  </ItemGroup>

</Project>
