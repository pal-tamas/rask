<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Bootstrap</PackageId>
    <Description>Typed Bootstrap 5.3 components for Rask — discoverable C# factories (BsButton, BsCard, BsModal, …) that emit correct Bootstrap markup, interactive components (Modal/Dropdown/Accordion/Tabs/Offcanvas/Toast) driven by Rask's live runtime with zero JavaScript, IFormControl-bound form controls, color modes, and a typed BsIcon. Bundles Bootstrap 5.3.8 + Bootstrap Icons 1.13.1 as static web assets served from _content/Rask.Bootstrap; link them with BootstrapStyles().</Description>
    <PackageTags>web component framework wasm net10 bootstrap css ui components</PackageTags>

    <!-- Razor SDK packs wwwroot/ as static web assets under _content/$(PackageId); set the base
         path explicitly so both the packed NuGet and in-repo project references resolve to the
         same URL. No .razor/.cshtml files exist — the Razor SDK is used purely for the standard
         static-web-asset authoring + packaging pipeline. -->
    <StaticWebAssetBasePath>_content/Rask.Bootstrap</StaticWebAssetBasePath>

    <!-- This library is consumed from WASM (net10.0-browser) too, so it must stay free of any
         ASP.NET Core framework reference — the Razor SDK does not add one unless Razor components
         are used, and none are. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
  </ItemGroup>

</Project>
