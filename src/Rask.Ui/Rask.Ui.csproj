<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both faces, unlike Rask.Dashboard. The console is single-targeted net10.0 on purpose — its
         panels read a DbContext and a browser app has no database — but this kit is markup and nothing
         else, and the apps that need it most (the landing site, the docs showcase) are browser-WASM.
         The browser face also carries the trim/AOT annotations those apps publish under. -->
    <TargetFrameworks>$(RaskNetTargets);$(RaskBrowserTfm)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible Condition="'$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browser'">true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <!--
      This project has no scoped CSS. Rask.Core's auto-include globs every .css outside wwwroot as
      scoped CSS, and _RaskTailwindExcludeInputFromScopedCss exempts only $(RaskTailwindInput), so any
      second global stylesheet added here would be RASK015, "no matching component class". Opting out
      costs nothing: a kit component wanting scoped CSS would be a component whose styling its consumers
      cannot re-skin through the palette, which is not a component this package should have.
    -->
    <RaskScopedCssAutoInclude>false</RaskScopedCssAutoInclude>

    <PackageId>Rask.Ui</PackageId>
    <Title>Rask — UI Kit</Title>
    <Description>The Rask component kit: the chrome, controls, data display and overlays the framework's own surfaces are built from — shell, top bar, breadcrumb switcher, tab bar, buttons, search, status dots, metric rows, detail lists, code blocks, sheets and toasts. Mobile-first, Tailwind v4 only, and no JavaScript but the rich text editor's, which a page loads only when it draws one. An app with a Tailwind build compiles the kit into its one stylesheet with a single import; a precompiled sheet is embedded for a surface without one.</Description>
    <PackageTags>dotnet csharp aspnetcore webassembly net10 ui-kit components daisyui tailwind design-system mobile-first</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README instead of the shared framework overview Directory.Build.props
       packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md"/>
    <None Remove="NUGET.md"/>
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Ui.Tests"/>
  </ItemGroup>


  <ItemGroup>
    <!-- PrivateAssets="all": Rask.Core is IsPackable=false and ships transitively from
         the host packages, so listing them as nuspec dependencies would reference packages that exist
         on no feed and make Rask.Ui unrestorable. Guarded by PackageDependencyTests. -->
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj"/>

    <!-- Emits this assembly's own Generated.* factories, so a consuming app can open a chain on
         Ui.Button, Ui.Metric and the rest exactly as it does on a tag. -->
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>

    <!-- Build-order edge only: it puts Rask.Tailwind.Tasks.dll in Rask.Tailwind's build/ folder before
         the import loads it with <UsingTask>. Nothing is referenced and nothing flows. -->
    <!-- UndefineProperties="TargetFramework", like Rask.Dashboard's and Rask.Auth's copies of this
         reference: this project multi-targets, so each inner build carries TargetFramework as a GLOBAL
         property and hands it to everything it references. Rask.Tailwind is netstandard2.0 and has no
         net10.0-browser target, so the inner builds asked it for a face it does not have (NETSDK1005)
         before a line of this kit compiled. -->
    <ProjectReference Include="..\Rask.Tailwind\Rask.Tailwind.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework"/>
  </ItemGroup>

  <!--
    THE KIT'S OWN STYLESHEET, compiled here rather than by the consuming app.

    Tailwind is a compiler: it scans the project it runs in for the class names actually written. This
    kit ships as a compiled assembly, so an app's own Tailwind build cannot see these class names and
    would emit none of them — leaving every component rendered as unstyled HTML with nothing reporting
    it. Compiling here binds the stylesheet to the markup that needs it. Same arrangement as
    Rask.Dashboard, for the same reason.

    Unlike the console's, this sheet carries NO preflight and no html/body rules — see Styles/ui.precompiled.css.
    The console can ship a global reset because it is a mounted application owning its own document;
    an app consuming this kit owns its own, and a second reset landing on it is how a shared stylesheet
    quietly restyles somebody else's pages.

    The output path is spelled out rather than taken from $(IntermediateOutputPath): that property is
    computed by the SDK's bottom import, which has not run when this PropertyGroup is evaluated, so it
    expands to nothing and the stylesheet lands in the PROJECT ROOT — where the scoped-CSS glob picks it
    up and RASK015 fails the build for a component named "ui.generated". It carries $(TargetFramework)
    because this project multi-targets and the two inner builds would otherwise write one file.

    THE WHOLE GROUP IS CONDITIONED ON AN INNER BUILD. A multi-targeted project is evaluated once more
    with NO TargetFramework — the outer pass that dispatches to the inner ones — and there this path
    would read `obj//ui.generated.css`. Build never noticed, because the outer pass compiles nothing;
    PACK did, with `NU5019: File not found: obj/ui.generated.css`, since packing starts from that same
    TFM-less evaluation. Leaving the input unset there means the Tailwind compiler has nothing to
    compile, so it skips, so the target below never runs and never contributes a resource that does not
    exist. `dotnet build` and `dotnet pack` disagree about this, which is why both are run before this
    project is called finished.
  -->
  <PropertyGroup Condition=" '$(TargetFramework)' != '' ">
    <RaskTailwindInput>Styles/ui.precompiled.css</RaskTailwindInput>
    <RaskTailwindOutput>obj/$(TargetFramework)/ui.generated.css</RaskTailwindOutput>
    <!-- Every class that sheet defines, for an app's own Tailwind build to read (see PackRaskUiStylesheet
         and build/Rask.Ui.targets): the kit's class names are string literals in a compiled assembly,
         where no scan finds them, and this list is how they reach an app's ONE stylesheet. -->
    <RaskTailwindClassList>obj/$(TargetFramework)/rask-ui.classes.txt</RaskTailwindClassList>
    <RaskTailwindMinify>true</RaskTailwindMinify>
  </PropertyGroup>

  <!--
    Added from a TARGET rather than a static ItemGroup. A static item's Condition is evaluated when the
    project is EVALUATED, which is before any target runs — so on the first build in a fresh clone the
    generated stylesheet does not exist yet, the item is silently absent, and the package ships with no
    stylesheet at all. Nothing fails the build; components just render unstyled, and a SECOND build
    embeds it, which is why every incremental tree looks fine (#916).
  -->
  <Target Name="EmbedRaskUiStylesheet"
          AfterTargets="_RaskTailwindBuild"
          BeforeTargets="PrepareResourceNames">
    <Error Condition="!Exists('$(RaskTailwindOutput)')"
           Text="Rask.Ui: $(RaskTailwindOutput) was not produced. The kit's stylesheet is compiled by _RaskTailwindBuild from $(RaskTailwindInput) and embedded here; shipping without it renders every component unstyled."/>
    <ItemGroup>
      <EmbeddedResource Include="$(RaskTailwindOutput)" LogicalName="Rask.Ui.ui.css"/>

      <!--
        Packed beside the targets as well, so a consumer's build can COPY it into wwwroot without
        running code to pull it out of the assembly. Embedding alone is not enough for that: an
        EmbeddedResource is only reachable at run time, and the copy has to happen at build time.
      -->
      <None Include="$(RaskTailwindOutput)" Pack="true" PackagePath="build/ui.css" Visible="false"/>
      <None Include="$(RaskTailwindOutput)" Pack="true" PackagePath="buildTransitive/ui.css" Visible="false"/>
    </ItemGroup>
  </Target>

  <!--
    And again for the PACKAGE, because the item above never reaches it.

    This project multi-targets, so `dotnet pack` generates the nuspec in the OUTER, TFM-less build and
    the target above runs only in the inner ones — RaskTailwindOutput is unset outside them by design
    (see the PropertyGroup up top). An item added during an inner build is not in the outer build's
    collection, so `build/ui.css` was simply absent from every package this project has produced.

    It stayed invisible because the only consumer that copies the sheet is in this repository, where a
    ProjectReference reads it straight out of obj/ and never looks in the package. A package consumer
    setting RaskUiWriteStylesheet=true got the targets' own error instead, which reads as "you did not
    build the kit" and is not what happened.

    The sheet does not vary by TFM — it is Tailwind's scan of this project's sources — so the first
    face that built it is the right one to ship.
  -->
  <Target Name="PackRaskUiStylesheet"
          Condition=" '$(TargetFramework)' == '' "
          BeforeTargets="_GetPackageFiles">
    <!-- The faces THIS build targets, not `obj/*/`: a face the project no longer targets leaves its
         sheet behind in obj/, and a glob ships whichever one sorts last. -->
    <ItemGroup>
      <_RaskUiPackFace Include="$(TargetFrameworks)"/>
      <_RaskUiPackCandidate Include="obj/%(_RaskUiPackFace.Identity)/ui.generated.css"
                            Condition="Exists('obj/%(_RaskUiPackFace.Identity)/ui.generated.css')"/>
    </ItemGroup>

    <!-- Batched to ONE value: every built face is a match (net10.0 and net10.0-browser)
         and PackagePath takes a single file. The sheet is Tailwind's scan of this project's
         sources and does not vary by framework, so whichever one the batch ends on is the right bytes. -->
    <PropertyGroup Condition="'@(_RaskUiPackCandidate)' != ''">
      <_RaskUiPackStylesheet>%(_RaskUiPackCandidate.FullPath)</_RaskUiPackStylesheet>
    </PropertyGroup>

    <Error Condition="'$(_RaskUiPackStylesheet)' == ''"
           Text="Rask.Ui: no compiled stylesheet was found to pack (obj/&lt;tfm&gt;/ui.generated.css). Packing without it ships a package whose RaskUiWriteStylesheet target cannot find the sheet, and every consumer that opts in fails to build."/>

    <!-- The class list is written beside the sheet it was read out of, by the same inner build. -->
    <PropertyGroup>
      <_RaskUiPackClassList>$([System.IO.Path]::GetDirectoryName('$(_RaskUiPackStylesheet)'))/rask-ui.classes.txt</_RaskUiPackClassList>
    </PropertyGroup>

    <Error Condition="!Exists('$(_RaskUiPackClassList)')"
           Text="Rask.Ui: no class list was found to pack ($(_RaskUiPackClassList)). Without it an app that imports rask-ui.css compiles a sheet with none of the kit's classes in it, and every component renders unstyled."/>

    <ItemGroup>
      <None Include="$(_RaskUiPackStylesheet)" Pack="true" PackagePath="build/ui.css" Visible="false"/>
      <None Include="$(_RaskUiPackStylesheet)" Pack="true" PackagePath="buildTransitive/ui.css" Visible="false"/>
      <None Include="$(_RaskUiPackClassList)" Pack="true" PackagePath="build/rask-ui.classes.txt" Visible="false"/>
      <None Include="$(_RaskUiPackClassList)" Pack="true" PackagePath="buildTransitive/rask-ui.classes.txt" Visible="false"/>
    </ItemGroup>
  </Target>

  <!-- The build hooks a consumer gets from the package: see build/Rask.Ui.targets. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
    <None Include="build\**" Pack="true" PackagePath="buildTransitive\%(RecursiveDir)%(Filename)%(Extension)"/>

    <!--
      THE KIT AS TAILWIND SOURCE, so a consumer's ONE Tailwind build compiles it in.

      The sheet compiled above is for a surface with no Tailwind build of its own. An app that runs
      Tailwind must not link it beside its own output — two `@layer utilities`, ranked by link order, is
      how an app's `bg-white` came to beat the kit's `dark:bg-zinc-800` — so it gets the kit's sources
      instead and compiles them itself, with one line: `@import "./vendor/rask-ui.css";`.

      Four files, written into the app's Styles/vendor/ by build/Rask.Ui.targets:
        rask-ui.css          the line an app imports: layer order, Tailwind, the kit, the class list.
        rask-ui.kit.css      Styles/ui.css under the name an app sees — theme, `dark` variant, rules.
        rask-ui.classes.txt  every class the kit's components write (PackRaskUiStylesheet, above).
        daisyui.mjs          the daisyUI plugin the kit file loads; goes when daisyUI does.

      Tailwind's standalone engine carries no package tree to resolve `@plugin "daisyui"` the Node way,
      which is why the bundle travels and is named by relative path: no npm install, no node_modules.

      Not EmbeddedResources: the copy has to happen at BUILD time, before Tailwind runs.
    -->
    <None Include="Styles\rask-ui.css" Pack="true" PackagePath="build\" Visible="false"/>
    <None Include="Styles\rask-ui.css" Pack="true" PackagePath="buildTransitive\rask-ui.css" Visible="false"/>
    <None Include="Styles\ui.css" Pack="true" PackagePath="build\rask-ui.kit.css" Visible="false"/>
    <None Include="Styles\ui.css" Pack="true" PackagePath="buildTransitive\rask-ui.kit.css" Visible="false"/>
    <None Include="Styles\daisyui.mjs" Pack="true" PackagePath="build\" Visible="false"/>
    <None Include="Styles\daisyui.mjs" Pack="true" PackagePath="buildTransitive\daisyui.mjs" Visible="false"/>
  </ItemGroup>

  <!--
    THE EDITOR'S ENGINE: Resources/ui-editor.js, Tiptap and ProseMirror bundled with the kit's own wiring
    (Resources/editor/ui-editor.ts, built by Resources/editor/build.mjs and committed — the kit builds
    without Node). Packed beside the targets, which copy it into the wwwroot of every app that references the
    kit. NOT an EmbeddedResource: a browser-WASM app downloads this assembly whether or not it draws an
    editor, and 374 KB of script on every first load is exactly what a file fetched on demand prevents.
    The notices of the packages it bundles (all MIT) and of Lucide (ISC), which the toolbar's icons are
    drawn from, travel with it: at the package's root, and beside the targets, which write them next to
    the script.
  -->
  <ItemGroup>
    <None Include="Resources\ui-editor.js" Pack="true" PackagePath="build\rask-ui-editor.js" Visible="false"/>
    <None Include="Resources\ui-editor.js" Pack="true" PackagePath="buildTransitive\rask-ui-editor.js" Visible="false"/>
    <None Include="Resources\ui-editor.LICENSES.txt" Pack="true" PackagePath="rask-ui-editor.LICENSES.txt" Visible="false"/>
    <None Include="Resources\ui-editor.LICENSES.txt" Pack="true" PackagePath="build\rask-ui-editor.LICENSES.txt" Visible="false"/>
    <None Include="Resources\ui-editor.LICENSES.txt" Pack="true" PackagePath="buildTransitive\rask-ui-editor.LICENSES.txt" Visible="false"/>
  </ItemGroup>

</Project>
