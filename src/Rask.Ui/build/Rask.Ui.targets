<Project>

  <!--
    Writes the kit's stylesheet into the consuming app's wwwroot, so a browser can cache it.

    The kit used to be inlined into every document with `Style[Raw.Value(UiStylesheet.Css)]`, and the
    reasoning for that is recorded in UiStylesheet: a <style> is smaller than the machinery a static
    web asset needs (the Razor SDK, a _content/ path a host has to map), and it let this package ship
    as a plain assembly with no assets at all.

    What changed is the number. The sheet is 36.8 KB gzipped, and it was being paid on EVERY document
    of a site read page to page — see #1018. A file the browser caches costs that once. The machinery
    is avoided anyway: this copies a plain file, so there is still no Razor SDK and no _content/ path.

    UiStylesheet.Css stays. Rask.Dashboard still inlines, deliberately — it is mounted into somebody
    else's host, which references the dashboard rather than the kit and so never imports this file.
  -->

  <PropertyGroup>
    <!-- Where the sheet lands, relative to the consuming project. -->
    <RaskUiStylesheetOutput Condition="'$(RaskUiStylesheetOutput)' == ''">wwwroot/css/rask-ui.css</RaskUiStylesheetOutput>

    <!--
      OPT IN, not opt out. Referencing the kit is not the same as wanting a file in your wwwroot: a
      library that renders kit components into someone else's host wants no such file, and neither
      does the meta-package that merely re-exports it. Defaulting this on wrote the sheet into six
      projects, two of them libraries.

      An app that wants the cached sheet says so:
          <RaskUiWriteStylesheet>true</RaskUiWriteStylesheet>
      and links it with UiStylesheet.Href(). Everything else keeps UiStylesheet.Css and inlines.
    -->
    <RaskUiWriteStylesheet Condition="'$(RaskUiWriteStylesheet)' == ''">false</RaskUiWriteStylesheet>

    <!--
      Where the daisyUI plugin bundle lands. Beside the app's own Tailwind input by default, because
      Tailwind resolves a relative `@plugin` against the STYLESHEET's directory, not the project's —
      so an app writes `@plugin "./vendor/daisyui.mjs"` from Styles/app.css and this is the path that
      makes that true.
    -->
    <RaskUiDaisyUiPluginOutput Condition="'$(RaskUiDaisyUiPluginOutput)' == ''">Styles/vendor/daisyui.mjs</RaskUiDaisyUiPluginOutput>

    <!--
      OPT IN, like the stylesheet above and for the same reason: referencing the kit is not the same
      as wanting to compile daisyUI yourself.

      An app that draws with Ui* components alone needs nothing here — those classes are already in
      the sheet this package ships. This is for an app writing daisyUI class names in its OWN markup,
      which Tailwind can only emit if it runs the plugin over sources it can see. `rask new` turns it
      on, because a scaffolded app writes `card`/`btn`/`navbar` directly.
    -->
    <RaskUiWriteDaisyUiPlugin Condition="'$(RaskUiWriteDaisyUiPlugin)' == ''">false</RaskUiWriteDaisyUiPlugin>
  </PropertyGroup>

  <Target Name="_RaskUiResolveStylesheet">

    <!--
      Only for a project that actually draws with the kit, and decided HERE rather than in a property
      condition because an item list cannot be read twice at evaluation time (MSB4099).

      In-repo these targets are imported for EVERY project by Directory.Build.targets, since a
      ProjectReference does not carry a package's build hooks. Without this the sheet is written into
      the wwwroot of Rask.Core, Rask.Html, Rask.Generators and the rest — it was, on the first run:
      eleven copies of a 241 KB file, staged for commit. A package consumer reaches this only by
      referencing Rask.Ui, so the check costs them nothing.
    -->
    <ItemGroup>
      <_RaskUiKitReference Include="@(ProjectReference)"
                           Condition="$([System.String]::Copy('%(Identity)').Contains('Rask.Ui.csproj'))"/>
      <_RaskUiKitReference Include="@(PackageReference)" Condition="'%(Identity)' == 'Rask.Ui'"/>
    </ItemGroup>

    <PropertyGroup>
      <_RaskUiReferenced>false</_RaskUiReferenced>
      <_RaskUiReferenced Condition="'@(_RaskUiKitReference)' != ''">true</_RaskUiReferenced>
      <!-- The kit itself compiles the sheet; it does not consume it. -->
      <_RaskUiReferenced Condition="'$(MSBuildProjectName)' == 'Rask.Ui'">false</_RaskUiReferenced>
    </PropertyGroup>

    <ItemGroup Condition="'$(_RaskUiReferenced)' == 'true'">
      <!-- From the package: the compiled sheet packed beside these targets. -->
      <_RaskUiStylesheetSource Include="$(MSBuildThisFileDirectory)ui.css"
                               Condition="Exists('$(MSBuildThisFileDirectory)ui.css')"/>
    </ItemGroup>

    <!--
      In-repo there is no package, so the file above does not exist: a consumer references the PROJECT,
      and the sheet is still in Rask.Ui's own obj/. Conditioned on the packed item being empty so a
      package consumer never evaluates this path — the same shape as Rask.Meta.Hosting's in-repo
      fallback, and for the same reason: without it the in-repo build silently writes nothing and every
      page links a stylesheet that was never produced.

      NOT A HARD-CODED TFM, and that is the whole point of the two steps below.

      It was `obj/net10.0/ui.generated.css`. Rask.Ui multi-targets net10.0;net10.0-browser, so that
      path exists only if something built the net10.0 face — which a developer's machine always has,
      and a clean CI checkout building a browser-WASM app never does. The published site at rask.sh
      shipped ENTIRELY UNSTYLED for exactly this reason: the base colours and the whole daisyUI palette
      live in this sheet, so with it missing every colour token resolved to nothing. The page was
      structurally perfect and completely grey, and the only trace was one warning in a build log.

      So: the consumer's own TFM first, because that is the matching sheet, and any TFM the kit has
      built as the fallback — the generated CSS is Tailwind's scan of Rask.Ui's own sources and does
      not vary by target.
    -->
    <ItemGroup Condition="'$(_RaskUiReferenced)' == 'true' AND '@(_RaskUiStylesheetSource)' == ''">
      <_RaskUiStylesheetSource
          Include="$(MSBuildThisFileDirectory)../obj/$(TargetFramework)/ui.generated.css"
          Condition="Exists('$(MSBuildThisFileDirectory)../obj/$(TargetFramework)/ui.generated.css')"/>
    </ItemGroup>

    <ItemGroup Condition="'$(_RaskUiReferenced)' == 'true' AND '@(_RaskUiStylesheetSource)' == ''">
      <_RaskUiStylesheetCandidate Include="$(MSBuildThisFileDirectory)../obj/*/ui.generated.css"/>
    </ItemGroup>

    <!-- Batches to ONE value, because Copy pairs SourceFiles with a single DestinationFiles and two
         matches would fail the build on an argument-count mismatch rather than on anything real. -->
    <PropertyGroup Condition="'@(_RaskUiStylesheetCandidate)' != ''">
      <_RaskUiStylesheetFallback>%(_RaskUiStylesheetCandidate.FullPath)</_RaskUiStylesheetFallback>
    </PropertyGroup>

    <ItemGroup Condition="'$(_RaskUiStylesheetFallback)' != ''">
      <_RaskUiStylesheetSource Include="$(_RaskUiStylesheetFallback)"/>
    </ItemGroup>
  </Target>

  <Target Name="RaskUiWriteStylesheet"
          Condition="'$(RaskUiWriteStylesheet)' == 'true'"
          DependsOnTargets="_RaskUiResolveStylesheet"
          BeforeTargets="BeforeBuild">

    <!--
      FAILS rather than warns, and that is a change made after the warning shipped a broken site.

      This target only runs when the project set <RaskUiWriteStylesheet>true</RaskUiWriteStylesheet> —
      an explicit request for this file. There is no ambiguity left for a warning to be kind about: the
      project asked for the sheet, the sheet is not there, and continuing produces an app whose every
      colour resolves to nothing. That is not a degraded build, it is a broken one that looks fine
      until someone loads it.

      The warning form of this ran green through CI and deployed rask.sh entirely unstyled. A warning
      in a build log is not a gate.
    -->
    <Error Condition="'$(_RaskUiReferenced)' == 'true' AND '@(_RaskUiStylesheetSource)' == ''"
           Text="Rask.Ui: this project set RaskUiWriteStylesheet=true but the kit's stylesheet could not be found, so $(RaskUiStylesheetOutput) cannot be written and every kit colour would resolve to nothing. In this repository, build src/Rask.Ui first (it writes obj/&lt;tfm&gt;/ui.generated.css); from the package, the sheet ships beside these targets as build/ui.css."/>

    <MakeDir Condition="'@(_RaskUiStylesheetSource)' != ''"
             Directories="$([System.IO.Path]::GetDirectoryName('$(MSBuildProjectDirectory)/$(RaskUiStylesheetOutput)'))"/>

    <Copy Condition="'@(_RaskUiStylesheetSource)' != ''"
          SourceFiles="@(_RaskUiStylesheetSource)"
          DestinationFiles="$(MSBuildProjectDirectory)/$(RaskUiStylesheetOutput)"
          SkipUnchangedFiles="true"/>
  </Target>

  <!--
    Puts the daisyUI plugin bundle where the app's own Tailwind can load it.

    DependsOn the resolver above only to reuse its _RaskUiReferenced check — that target resolves
    items and nothing else, and the hard error for a missing sheet lives in RaskUiWriteStylesheet,
    which is separate. Running it here costs a few item evaluations and keeps one definition of
    "does this project actually draw with the kit".
  -->
  <Target Name="_RaskUiResolveDaisyUiPlugin" DependsOnTargets="_RaskUiResolveStylesheet">

    <ItemGroup Condition="'$(_RaskUiReferenced)' == 'true'">
      <!-- From the package: packed beside these targets. -->
      <_RaskUiDaisyUiSource Include="$(MSBuildThisFileDirectory)daisyui.mjs"
                            Condition="Exists('$(MSBuildThisFileDirectory)daisyui.mjs')"/>
    </ItemGroup>

    <!--
      In-repo there is no package, so the file above is absent and the bundle is still in the kit's
      own Styles/vendor. NO TARGET FRAMEWORK IN THIS PATH, and unlike the stylesheet above that is
      not a hazard to be worked around: the bundle is a SOURCE file that no build produces, so it is
      there in a clean checkout whether or not any face of the kit has ever been compiled. The
      stylesheet's two-step fallback exists because build output is per-TFM; this has no such
      problem.
    -->
    <ItemGroup Condition="'$(_RaskUiReferenced)' == 'true' AND '@(_RaskUiDaisyUiSource)' == ''">
      <_RaskUiDaisyUiSource
          Include="$(MSBuildThisFileDirectory)../Styles/vendor/daisyui.mjs"
          Condition="Exists('$(MSBuildThisFileDirectory)../Styles/vendor/daisyui.mjs')"/>
    </ItemGroup>
  </Target>

  <!--
    _RaskTailwindBuild EXPLICITLY, and not BeforeBuild alone.

    Rask.Tailwind also hooks BeforeBuild, and the order between two targets that share one
    BeforeTargets is import order — which is not something this file gets to decide. Naming the
    compile directly is what guarantees the plugin is on disk before anything tries to load it.
    BeforeBuild stays as the fallback for a project that has no Tailwind compile at all.
  -->
  <Target Name="RaskUiWriteDaisyUiPlugin"
          Condition="'$(RaskUiWriteDaisyUiPlugin)' == 'true'"
          DependsOnTargets="_RaskUiResolveDaisyUiPlugin"
          BeforeTargets="_RaskTailwindBuild;BeforeBuild">

    <!--
      FAILS rather than warns, for the reason the stylesheet target above records: the project asked
      for this file by name, and without it `@plugin "./vendor/daisyui.mjs"` cannot resolve. Tailwind
      reports that as an error of its own, but a long way from the property that caused it — and the
      app that gets there has a stylesheet with no daisyUI in it, which renders every `btn` and `card`
      in its markup as unstyled text on a green build.
    -->
    <Error Condition="'$(_RaskUiReferenced)' == 'true' AND '@(_RaskUiDaisyUiSource)' == ''"
           Text="Rask.Ui: this project set RaskUiWriteDaisyUiPlugin=true but the daisyUI plugin bundle could not be found, so $(RaskUiDaisyUiPluginOutput) cannot be written and every daisyUI class in this project's markup would render unstyled. In this repository it lives at src/Rask.Ui/Styles/vendor/daisyui.mjs; from the package it ships beside these targets as build/daisyui.mjs."/>

    <MakeDir Condition="'@(_RaskUiDaisyUiSource)' != ''"
             Directories="$([System.IO.Path]::GetDirectoryName('$(MSBuildProjectDirectory)/$(RaskUiDaisyUiPluginOutput)'))"/>

    <Copy Condition="'@(_RaskUiDaisyUiSource)' != ''"
          SourceFiles="@(_RaskUiDaisyUiSource)"
          DestinationFiles="$(MSBuildProjectDirectory)/$(RaskUiDaisyUiPluginOutput)"
          SkipUnchangedFiles="true"/>
  </Target>

</Project>
