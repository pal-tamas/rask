<Project>

  <!--
    How the kit's styles reach a project that draws with it. Two ways, and never both in one document:

    1. THROUGH THE PROJECT'S OWN TAILWIND BUILD (RaskUiWriteTailwindSources). An app whose stylesheet
       says `@import "./vendor/rask-ui.css";` is handed the kit's Tailwind sources and compiles ONE
       sheet. This is what `rask new` writes and what rask.sh does.

    2. AS A PRECOMPILED FILE (RaskUiWriteStylesheet), copied into wwwroot for a project with no Tailwind
       build of its own, linked with UiStylesheet.Href(). The sheet is also embedded in the assembly
       (UiStylesheet.Css) for a surface that inlines it — Rask.DevTools, drawn inside somebody else's
       page. It was once inlined into every document of every app; a file the browser caches costs its
       36.8 KB gzipped once (#1018), and copying a plain file needs no Razor SDK and no _content/ path.

    RaskUiCheckStylesheets refuses the two together: a precompiled kit sheet beside an app's own Tailwind
    output is two `@layer utilities` ranked by link order alone.
  -->

  <PropertyGroup>
    <!-- Where the sheet lands, relative to the consuming project. -->
    <RaskUiStylesheetOutput Condition="'$(RaskUiStylesheetOutput)' == ''">wwwroot/css/rask-ui.css</RaskUiStylesheetOutput>

    <!--
      OPT IN, not opt out. Referencing the kit is not the same as wanting a file in your wwwroot: a
      library that renders kit components into someone else's host wants no such file, and neither
      does a host package that merely re-exports it. Defaulting this on wrote the sheet into six
      projects, two of them libraries.

      An app that wants the cached sheet says so:
          <RaskUiWriteStylesheet>true</RaskUiWriteStylesheet>
      and links it with UiStylesheet.Href(). Everything else keeps UiStylesheet.Css and inlines.
    -->
    <RaskUiWriteStylesheet Condition="'$(RaskUiWriteStylesheet)' == ''">false</RaskUiWriteStylesheet>

    <!--
      THE KIT THROUGH THIS PROJECT'S OWN TAILWIND BUILD — one stylesheet, as a Flux app has.

      An app that runs Tailwind takes the kit in with one line in its stylesheet,

          @import "./vendor/rask-ui.css";

      and its build compiles Tailwind, the kit's theme and `dark` variant, and the classes the kit's
      components write, beside the classes the app writes. Every utility then exists ONCE, so
      Tailwind's own ordering holds between the two: a base utility before its variants, a shorthand
      before its longhands. The alternative — the app's sheet linked after the kit's precompiled one —
      is two `@layer utilities` in link order, where an app's `bg-white` beats the kit's
      `dark:bg-zinc-800` and its `m-0` beats the kit's `mt-auto`.

      Unset, this follows the stylesheet: on when $(RaskTailwindInput) imports rask-ui.css (or
      rask-ui.kit.css, for a sheet that composes the entry itself), off otherwise. Say true or false to
      decide it regardless.
    -->
    <RaskUiTailwind Condition="'$(RaskUiTailwind)' == ''">auto</RaskUiTailwind>

    <!--
      Where the kit's Tailwind sources land: beside the app's stylesheet, in vendor/, because Tailwind
      resolves `@import`, `@plugin` and `@source` against the FILE that names them. Unset, it is the
      stylesheet's own folder plus vendor/ — Styles/vendor/ for Styles/app.css.
    -->
    <RaskUiTailwindDirectory Condition="'$(RaskUiTailwindDirectory)' == '' AND '$(RaskTailwindInput)' != ''">$([System.IO.Path]::Combine('$([System.IO.Path]::GetDirectoryName('$(RaskTailwindInput)'))', 'vendor'))</RaskUiTailwindDirectory>

    <!--
      Whether the stylesheet imports the kit — read out of the file, at evaluation, because that line is
      the one thing an app author writes and a second switch in the csproj would be a second place to
      forget. A line that STARTS with the import, so prose mentioning it in a comment does not count.
    -->
    <_RaskUiSheetImportsKit>false</_RaskUiSheetImportsKit>
    <_RaskUiSheetImportsKit Condition="'$(RaskTailwindInput)' != '' AND Exists('$(MSBuildProjectDirectory)/$(RaskTailwindInput)')">$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/$(RaskTailwindInput)')), `^[ \t]*@import\s+["'][^"']*rask-ui[.\w]*\.css["']`, System.Text.RegularExpressions.RegexOptions.Multiline))</_RaskUiSheetImportsKit>
  </PropertyGroup>

  <!--
    Declares the written sheet as Content before it exists, so a FIRST build serves it.

    RaskUiWriteStylesheet below copies the file during the build, after this project was evaluated, and static web
    assets are discovered from what evaluation saw. On a clean checkout the file is not on disk at evaluation, so the
    first build's manifest had no css/rask-ui.css: a run with no rebuild after it, and a `dotnet publish` from a
    fresh clone (the Docker image's build) answered /css/rask-ui.css with 404 and every kit colour resolved to
    nothing. A second build found the file and hid it, which is why only the template journey saw it (#1105).

    A literal Include, not a glob: it does not consult the disk, so the item exists regardless and the file is only
    required when it is copied, after the target above has run. Rask.Tailwind declares its own output the same way.
    Guarded on !Exists so a later build, whose wwwroot glob already matches the file, does not declare it twice;
    Pack="false" because a served sheet reaches a package through static web assets, never as content.
  -->
  <ItemGroup Condition=" '$(RaskUiWriteStylesheet)' == 'true'
                         AND '$(RaskUiStylesheetOutput)' != ''
                         AND !Exists('$(MSBuildProjectDirectory)/$(RaskUiStylesheetOutput)') ">
    <Content Include="$(RaskUiStylesheetOutput)" Pack="false"/>
  </ItemGroup>

  <!--
    The precompiled sheet an EARLIER build wrote into wwwroot, when this project still linked it, is not
    content of a project that now compiles the kit in. The SDK's wwwroot glob has already picked it up by
    the time anything here runs, so it is taken back out — otherwise it is published and precached, and
    deleting it mid-build (RaskUiWriteTailwindSources does) fails static-web-asset discovery on a file
    the evaluation promised.
  -->
  <ItemGroup Condition=" '$(_RaskUiSheetImportsKit)' == 'true' AND '$(RaskUiTailwind)' != 'false'
                         AND '$(RaskUiWriteStylesheet)' != 'true' AND '$(RaskUiStylesheetOutput)' != '' ">
    <Content Remove="$(RaskUiStylesheetOutput)"/>
  </ItemGroup>

  <Target Name="_RaskUiResolveStylesheet">

    <!--
      Only for a project that actually draws with the kit, and decided HERE rather than in a property
      condition because an item list cannot be read twice at evaluation time (MSB4099).

      In-repo these targets are imported for EVERY project by Directory.Build.targets, since a
      ProjectReference does not carry a package's build hooks. Without this the sheet is written into
      the wwwroot of Rask.Core, Rask.Generators and the rest — it was, on the first run:
      eleven copies of a 241 KB file, staged for commit. A package consumer reaches this only by
      referencing Rask.Ui, so the check costs them nothing.
    -->
    <ItemGroup>
      <_RaskUiKitReference Include="@(ProjectReference)"
                           Condition="$([System.String]::Copy('%(Identity)').Contains('Rask.Ui.csproj'))"/>
      <!-- Or a host, which brings the kit: an app that names only Rask.Server or Rask.Wasm still draws with it.
           NOT `Rask`, the shared core — a component library that references it alone has no kit. -->
      <_RaskUiKitReference Include="@(PackageReference)"
                           Condition="'%(Identity)' == 'Rask.Ui' OR '%(Identity)' == 'Rask.Server' OR '%(Identity)' == 'Rask.Wasm'"/>
    </ItemGroup>

    <PropertyGroup>
      <_RaskUiReferenced>false</_RaskUiReferenced>
      <_RaskUiReferenced Condition="'@(_RaskUiKitReference)' != ''">true</_RaskUiReferenced>
      <!-- The kit itself compiles the sheet; it does not consume it. -->
      <_RaskUiReferenced Condition="'$(MSBuildProjectName)' == 'Rask.Ui'">false</_RaskUiReferenced>
    </PropertyGroup>

    <ItemGroup Condition="'$(_RaskUiReferenced)' == 'true'">
      <!-- From the package: the compiled sheet packed beside these targets. -->
      <_RaskUiStylesheetSource Include="$(MSBuildThisFileDirectory)ui.css"
                               Condition="Exists('$(MSBuildThisFileDirectory)ui.css')"/>
    </ItemGroup>

    <!--
      In-repo there is no package, so the file above does not exist: a consumer references the PROJECT,
      and the sheet is still in Rask.Ui's own obj/. Conditioned on the packed item being empty so a
      package consumer never evaluates this path. Without it the in-repo build silently writes nothing
      and every page links a stylesheet that was never produced.

      NOT A HARD-CODED TFM, and that is the whole point of the two steps below.

      It was `obj/net10.0/ui.generated.css`. Rask.Ui multi-targets net10.0;net10.0-browser, so that
      path exists only if something built the net10.0 face — which a developer's machine always has,
      and a clean CI checkout building a browser-WASM app never does. The published site at rask.sh
      shipped ENTIRELY UNSTYLED for exactly this reason: the base colours and the whole daisyUI palette
      live in this sheet, so with it missing every colour token resolved to nothing. The page was
      structurally perfect and completely grey, and the only trace was one warning in a build log.

      So: the consumer's own TFM first, because that is the matching sheet, and any TFM the kit has
      built as the fallback — the generated CSS is Tailwind's scan of Rask.Ui's own sources and does
      not vary by target.
    -->
    <ItemGroup Condition="'$(_RaskUiReferenced)' == 'true' AND '@(_RaskUiStylesheetSource)' == ''">
      <_RaskUiStylesheetSource
          Include="$(MSBuildThisFileDirectory)../obj/$(TargetFramework)/ui.generated.css"
          Condition="Exists('$(MSBuildThisFileDirectory)../obj/$(TargetFramework)/ui.generated.css')"/>
    </ItemGroup>

    <ItemGroup Condition="'$(_RaskUiReferenced)' == 'true' AND '@(_RaskUiStylesheetSource)' == ''">
      <_RaskUiStylesheetCandidate Include="$(MSBuildThisFileDirectory)../obj/*/ui.generated.css"/>
    </ItemGroup>

    <!-- Batches to ONE value, because Copy pairs SourceFiles with a single DestinationFiles and two
         matches would fail the build on an argument-count mismatch rather than on anything real. -->
    <PropertyGroup Condition="'@(_RaskUiStylesheetCandidate)' != ''">
      <_RaskUiStylesheetFallback>%(_RaskUiStylesheetCandidate.FullPath)</_RaskUiStylesheetFallback>
    </PropertyGroup>

    <ItemGroup Condition="'$(_RaskUiStylesheetFallback)' != ''">
      <_RaskUiStylesheetSource Include="$(_RaskUiStylesheetFallback)"/>
    </ItemGroup>
  </Target>

  <Target Name="RaskUiWriteStylesheet"
          Condition="'$(RaskUiWriteStylesheet)' == 'true'"
          DependsOnTargets="_RaskUiResolveStylesheet"
          BeforeTargets="BeforeBuild">

    <!--
      FAILS rather than warns, and that is a change made after the warning shipped a broken site.

      This target only runs when the project set <RaskUiWriteStylesheet>true</RaskUiWriteStylesheet> —
      an explicit request for this file. There is no ambiguity left for a warning to be kind about: the
      project asked for the sheet, the sheet is not there, and continuing produces an app whose every
      colour resolves to nothing. That is not a degraded build, it is a broken one that looks fine
      until someone loads it.

      The warning form of this ran green through CI and deployed rask.sh entirely unstyled. A warning
      in a build log is not a gate.
    -->
    <Error Condition="'$(_RaskUiReferenced)' == 'true' AND '@(_RaskUiStylesheetSource)' == ''"
           Text="Rask.Ui: this project set RaskUiWriteStylesheet=true but the kit's stylesheet could not be found, so $(RaskUiStylesheetOutput) cannot be written and every kit colour would resolve to nothing. In this repository, build src/Rask.Ui first (it writes obj/&lt;tfm&gt;/ui.generated.css); from the package, the sheet ships beside these targets as build/ui.css."/>

    <MakeDir Condition="'@(_RaskUiStylesheetSource)' != ''"
             Directories="$([System.IO.Path]::GetDirectoryName('$(MSBuildProjectDirectory)/$(RaskUiStylesheetOutput)'))"/>

    <Copy Condition="'@(_RaskUiStylesheetSource)' != ''"
          SourceFiles="@(_RaskUiStylesheetSource)"
          DestinationFiles="$(MSBuildProjectDirectory)/$(RaskUiStylesheetOutput)"
          SkipUnchangedFiles="true"/>
  </Target>

  <!--
    Does this project compile the kit into its own stylesheet? It has to draw with the kit, have a
    stylesheet for Tailwind to compile, and — unless RaskUiTailwind says otherwise — import the kit there.
  -->
  <Target Name="_RaskUiResolveTailwind" DependsOnTargets="_RaskUiResolveStylesheet">
    <PropertyGroup>
      <_RaskUiTailwindSheet Condition="'$(RaskTailwindInput)' != ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(RaskTailwindInput)'))</_RaskUiTailwindSheet>

      <_RaskUiHasTailwind>false</_RaskUiHasTailwind>
      <_RaskUiHasTailwind Condition="'$(_RaskUiReferenced)' == 'true' AND '$(_RaskUiTailwindSheet)' != '' AND Exists('$(_RaskUiTailwindSheet)')">true</_RaskUiHasTailwind>

      <_RaskUiImported>false</_RaskUiImported>
      <_RaskUiImported Condition="'$(_RaskUiHasTailwind)' == 'true'">$(_RaskUiSheetImportsKit)</_RaskUiImported>

      <_RaskUiTailwind>false</_RaskUiTailwind>
      <_RaskUiTailwind Condition="'$(_RaskUiHasTailwind)' == 'true' AND '$(RaskUiTailwind)' == 'true'">true</_RaskUiTailwind>
      <_RaskUiTailwind Condition="'$(_RaskUiHasTailwind)' == 'true' AND '$(RaskUiTailwind)' == 'auto' AND '$(_RaskUiImported)' == 'true'">true</_RaskUiTailwind>
    </PropertyGroup>
  </Target>

  <!--
    THE TWO SHEETS THAT MUST NOT MEET, refused at build rather than found in a browser.

    Both pairings below put the kit's precompiled sheet in a document beside the app's own Tailwind output.
    Each has an `@layer utilities`, and between two sheets the cascade has nothing left to go on but link
    order — so whichever is linked last wins every tie, base utility over variant included. It rendered a
    Flux modal white in dark mode (`.bg-white` from the app over `dark:bg-zinc-800` from the kit) with
    every class correct in the markup and every gate green.

    Errors, not warnings: RaskUiWriteStylesheet is an explicit request, and what it asks for here is the
    broken arrangement.
  -->
  <Target Name="RaskUiCheckStylesheets"
          DependsOnTargets="_RaskUiResolveTailwind"
          BeforeTargets="_RaskTailwindBuild;BeforeBuild">

    <Error Condition="'$(_RaskUiTailwind)' == 'true' AND '$(RaskUiWriteStylesheet)' == 'true'"
           Text="Rask.Ui: $(RaskTailwindInput) compiles the kit into this project's own stylesheet (it imports rask-ui.css), and RaskUiWriteStylesheet=true asks for the kit's precompiled sheet as well. That is the kit twice, in two sheets whose utilities are ranked by link order alone, so one of this app's utilities can outrank a kit variant (bg-white over dark:bg-zinc-800). Remove &lt;RaskUiWriteStylesheet&gt; from the project and any link to UiStylesheet.Href() from the app."/>

    <Error Condition="'$(_RaskUiHasTailwind)' == 'true' AND '$(_RaskUiTailwind)' != 'true' AND '$(RaskUiWriteStylesheet)' == 'true'"
           Text="Rask.Ui: this project compiles its own Tailwind stylesheet ($(RaskTailwindInput)) and RaskUiWriteStylesheet=true links the kit's precompiled sheet beside it. Two sheets each carry an `@layer utilities`, ranked by link order alone, so one of this app's utilities can outrank a kit variant (bg-white over dark:bg-zinc-800). Compile ONE sheet instead: in $(RaskTailwindInput) replace `@import &quot;tailwindcss&quot;;` (and any layer statement or daisyUI `@plugin` line) with `@import &quot;./vendor/rask-ui.css&quot;;`, and remove &lt;RaskUiWriteStylesheet&gt; from the project. See docs/ui-kit.md."/>

    <Error Condition="'$(_RaskUiHasTailwind)' == 'true' AND '$(_RaskUiImported)' == 'true' AND '$(RaskUiTailwind)' == 'false'"
           Text="Rask.Ui: $(RaskTailwindInput) imports the kit's Tailwind sources (rask-ui.css) but RaskUiTailwind=false tells the build not to write them, so the import cannot resolve. Remove one of the two."/>
  </Target>

  <Target Name="_RaskUiResolveTailwindSources" DependsOnTargets="_RaskUiResolveTailwind">

    <!-- From the package: packed beside these targets, under the names an app's sheet imports. -->
    <ItemGroup Condition="'$(_RaskUiTailwind)' == 'true' AND Exists('$(MSBuildThisFileDirectory)rask-ui.kit.css')">
      <_RaskUiTailwindSource Include="$(MSBuildThisFileDirectory)rask-ui.css" Name="rask-ui.css"/>
      <_RaskUiTailwindSource Include="$(MSBuildThisFileDirectory)rask-ui.kit.css" Name="rask-ui.kit.css"/>
      <_RaskUiTailwindSource Include="$(MSBuildThisFileDirectory)rask-ui.classes.txt" Name="rask-ui.classes.txt"/>
      <_RaskUiTailwindSource Include="$(MSBuildThisFileDirectory)daisyui.mjs" Name="daisyui.mjs"/>
    </ItemGroup>

    <!--
      In-repo there is no package: the three sources are in the kit's own Styles/ (ui.css is what ships as
      rask-ui.kit.css), and the class list is build output in its obj/ — per TFM, so the consumer's own
      face first and any face the kit has built as the fallback, exactly as for the precompiled sheet
      above and for the reason recorded there. The kit has been built by now: this runs as a hook on
      _RaskTailwindBuild, whose own dependencies resolve the project references first.
    -->
    <ItemGroup Condition="'$(_RaskUiTailwind)' == 'true' AND '@(_RaskUiTailwindSource)' == ''">
      <_RaskUiTailwindSource Include="$(MSBuildThisFileDirectory)../Styles/rask-ui.css" Name="rask-ui.css"/>
      <_RaskUiTailwindSource Include="$(MSBuildThisFileDirectory)../Styles/ui.css" Name="rask-ui.kit.css"/>
      <_RaskUiTailwindSource Include="$(MSBuildThisFileDirectory)../Styles/daisyui.mjs" Name="daisyui.mjs"/>
      <_RaskUiClassList Include="$(MSBuildThisFileDirectory)../obj/$(TargetFramework)/rask-ui.classes.txt"
                        Condition="Exists('$(MSBuildThisFileDirectory)../obj/$(TargetFramework)/rask-ui.classes.txt')"/>
    </ItemGroup>

    <ItemGroup Condition="'$(_RaskUiTailwind)' == 'true' AND '@(_RaskUiTailwindSource->Count())' == '3' AND '@(_RaskUiClassList)' == ''">
      <_RaskUiClassListCandidate Include="$(MSBuildThisFileDirectory)../obj/*/rask-ui.classes.txt"/>
    </ItemGroup>

    <!-- Batches to ONE value: the list does not vary by framework, and Copy takes one source per name. -->
    <PropertyGroup Condition="'@(_RaskUiClassListCandidate)' != ''">
      <_RaskUiClassListFallback>%(_RaskUiClassListCandidate.FullPath)</_RaskUiClassListFallback>
    </PropertyGroup>

    <ItemGroup>
      <_RaskUiClassList Include="$(_RaskUiClassListFallback)" Condition="'$(_RaskUiClassListFallback)' != ''"/>
      <_RaskUiTailwindSource Include="@(_RaskUiClassList)" Name="rask-ui.classes.txt"/>
      <_RaskUiTailwindMissing Include="@(_RaskUiTailwindSource)" Condition="!Exists('%(FullPath)')"/>
    </ItemGroup>
  </Target>

  <!--
    Puts the kit's Tailwind sources where the app's stylesheet imports them from.

    _RaskTailwindBuild EXPLICITLY, and not BeforeBuild alone. Rask.Tailwind also hooks BeforeBuild, and the
    order between two targets that share one BeforeTargets is import order — which is not something this
    file gets to decide. Naming the compile directly is what guarantees the files are on disk before
    Tailwind follows the import. BeforeBuild stays as the fallback.
  -->
  <Target Name="RaskUiWriteTailwindSources"
          DependsOnTargets="RaskUiCheckStylesheets;_RaskUiResolveTailwindSources"
          BeforeTargets="_RaskTailwindBuild;BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">

    <!--
      FAILS rather than warns. Without the class list the import still resolves and the sheet still
      compiles — with none of the kit's classes in it, so every component renders unstyled on a green
      build. That is the failure this whole file keeps recording.
    -->
    <Error Condition="'$(_RaskUiTailwind)' == 'true' AND ('@(_RaskUiTailwindSource->Count())' != '4' OR '@(_RaskUiTailwindMissing)' != '')"
           Text="Rask.Ui: $(RaskTailwindInput) compiles the kit in, but the kit's Tailwind sources could not all be found (found @(_RaskUiTailwindSource->Count()) of 4; missing on disk: @(_RaskUiTailwindMissing)), so $(RaskUiTailwindDirectory) cannot be written and the kit's components would render unstyled. In this repository, build src/Rask.Ui first (it writes obj/&lt;tfm&gt;/rask-ui.classes.txt); from the package they ship beside these targets as build/rask-ui.css, rask-ui.kit.css, rask-ui.classes.txt and daisyui.mjs."/>

    <PropertyGroup Condition="'$(_RaskUiTailwind)' == 'true'">
      <_RaskUiTailwindDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(RaskUiTailwindDirectory)'))</_RaskUiTailwindDirectory>
      <_RaskUiTailwindStamp>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)rask-ui.tailwind.stamp'))</_RaskUiTailwindStamp>
    </PropertyGroup>

    <Copy Condition="'$(_RaskUiTailwind)' == 'true'"
          SourceFiles="@(_RaskUiTailwindSource)"
          DestinationFiles="@(_RaskUiTailwindSource->'$(_RaskUiTailwindDirectory)/%(Name)')"
          SkipUnchangedFiles="true">
      <Output TaskParameter="WroteAtLeastOneFile" PropertyName="_RaskUiTailwindWrote"/>
    </Copy>

    <!--
      A copy keeps its source's timestamp, and a package's files are dated when the package was built —
      which can be before this app's last compile. So "the kit changed" is recorded in a stamp of its own
      and handed to the Tailwind compile as an input, or an upgraded kit would leave the sheet a version
      behind with everything up to date.
    -->
    <MakeDir Condition="'$(_RaskUiTailwind)' == 'true'"
             Directories="$([System.IO.Path]::GetDirectoryName('$(_RaskUiTailwindStamp)'))"/>

    <Touch Condition="'$(_RaskUiTailwind)' == 'true' AND ('$(_RaskUiTailwindWrote)' == 'true' OR !Exists('$(_RaskUiTailwindStamp)'))"
           Files="$(_RaskUiTailwindStamp)"
           AlwaysCreate="true"/>

    <ItemGroup Condition="'$(_RaskUiTailwind)' == 'true'">
      <_RaskTailwindSource Include="$(_RaskUiTailwindStamp)"/>
    </ItemGroup>

    <!--
      The precompiled sheet an earlier build wrote, when this project still linked it. Left in wwwroot it
      is published, precached and — by anything that still links it — loaded, which is the double include
      again from a file no property asks for any more.
    -->
    <Delete Condition="'$(_RaskUiTailwind)' == 'true' AND '$(RaskUiStylesheetOutput)' != '' AND Exists('$(MSBuildProjectDirectory)/$(RaskUiStylesheetOutput)')"
            Files="$(MSBuildProjectDirectory)/$(RaskUiStylesheetOutput)"/>
  </Target>

  <!--
    The kit's sheets in Styles/vendor/ are not scoped CSS. Rask auto-includes every **/*.css as a
    component's own stylesheet and expects a class of the same name beside it (RASK015) — true of nothing
    in that folder. Taken back out here, by folder, for the reason Rask.Tailwind takes its input out the
    same way: turning the convention off would un-scope every other .css in the project. On the first
    build the folder is empty at evaluation and nothing was included; this is for the second.
  -->
  <Target Name="_RaskUiExcludeTailwindSourcesFromScopedCss"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_RaskUiResolveTailwind"
          Condition="'$(RaskUiTailwindDirectory)' != ''">
    <ItemGroup Condition="'$(_RaskUiTailwind)' == 'true'">
      <AdditionalFiles Remove="$(RaskUiTailwindDirectory)/**/*.css"/>
    </ItemGroup>
  </Target>

  <!--
    Tells the host the kit is already in the app's stylesheet, so RaskApp and the WASM host link that one
    sheet and not the precompiled kit beside it. Read at runtime as the app assembly's Rask.Ui.Stylesheet
    metadata (RaskDocument), the same way Rask.Tailwind announces where the app's sheet is served.
  -->
  <Target Name="_RaskUiStylesheetMetadata"
          DependsOnTargets="_RaskUiResolveTailwind"
          BeforeTargets="GetAssemblyAttributes">
    <ItemGroup Condition="'$(_RaskUiTailwind)' == 'true'">
      <AssemblyMetadata Include="Rask.Ui.Stylesheet" Value="compiled-in"/>
    </ItemGroup>
  </Target>

  <!--
    THE EDITOR'S ENGINE, for every app that references the kit.

    Ui.Editor is Tiptap and ProseMirror in the browser: 374 KB, 117 KB gzipped. That is too much to hand
    every PAGE, so it is in neither Rask's runtime nor the kit's assembly (a browser-WASM app downloads
    every assembly up front, used or not). It is one static file, written into wwwroot here and fetched by
    a page the first time an editor mounts on it (UiEditor.ts, UiEditorEngine) — and by no page before that:
    nothing links it, nothing preloads it, and Rask's service worker caches only what a page asked for.

    NO SWITCH: Flux's editor needs no configuration, so neither does this one. An APP gets the file — a
    project built with the Web or the WebAssembly SDK — and a library that merely references the kit does
    not, since nothing serves a library's wwwroot. The cost of an editor nobody draws is 374 KB on disk in
    the publish folder and zero bytes on any page.

        <RaskUiEditorEngine>false</RaskUiEditorEngine>   an app that will never draw one keeps its wwwroot clean
        <RaskUiEditorEngine>true</RaskUiEditorEngine>    a host that is not a Web SDK project (a test host on Kestrel)

    A copied plain file, as the stylesheet is: it needs no Razor SDK and no _content/ path, and it is
    served by every host the same way — a Server app's static files, a browser-WASM app's publish folder.
    The path is fixed (UiEditorEngine.Path) because the component is what asks for it.
  -->
  <PropertyGroup>
    <RaskUiEditorEngine Condition="'$(RaskUiEditorEngine)' == '' AND ('$(UsingMicrosoftNETSdkWeb)' == 'true' OR '$(UsingMicrosoftNETSdkWebAssembly)' == 'true')">true</RaskUiEditorEngine>
    <RaskUiEditorEngine Condition="'$(RaskUiEditorEngine)' == ''">false</RaskUiEditorEngine>
    <_RaskUiEditorOutput>wwwroot/js/rask-ui-editor.js</_RaskUiEditorOutput>
    <!-- The notices of what the engine bundles (Tiptap, ProseMirror: MIT) and of the toolbar's Lucide icons
         (ISC). Those licences ask that the notice travel with every copy, and the app's wwwroot is one. -->
    <_RaskUiEditorNotices>wwwroot/js/rask-ui-editor.LICENSES.txt</_RaskUiEditorNotices>
  </PropertyGroup>

  <!--
    Does this project reference the kit? From the package these targets only exist where it does. In this
    repository they are imported into every project (Directory.Build.targets), so the reference is looked
    for: the kit itself, or a host that carries it.

    NOT THE SERVER HALF OF A ONE-PROJECT WEBASSEMBLY APP ($(RaskClient), Rask.Server.Client.targets). That app
    is one project built twice — this server, and a browser app generated from Client/ whose wwwroot is merged
    into this one's publish. Both reference the kit, both wrote the engine, and the publish found one relative
    path twice: NETSDK1152, and no wasm-hosted app published. The BROWSER half owns the file: the page that
    mounts an editor runs there, and MapRaskSpa serves that half's files in a build and in a publish alike.
    Read in an item's condition, never a property's: items are evaluated after every property of every
    import, so this holds whichever of the two packages' targets NuGet happens to import first.
  -->
  <ItemGroup Condition="'$(RaskUiEditorEngine)' == 'true' AND '$(RaskClient)' != 'true'">
    <_RaskUiEditorKit Include="package" Condition="Exists('$(MSBuildThisFileDirectory)rask-ui-editor.js')"/>
    <_RaskUiEditorKit Include="@(ProjectReference->WithMetadataValue('Filename', 'Rask.Ui'))"/>
    <_RaskUiEditorKit Include="@(ProjectReference->WithMetadataValue('Filename', 'Rask.Server'))"/>
    <_RaskUiEditorKit Include="@(ProjectReference->WithMetadataValue('Filename', 'Rask.Wasm'))"/>
  </ItemGroup>

  <!-- Declared before they exist, so a FIRST build serves them: see the stylesheet's own note above (#1105). -->
  <ItemGroup Condition=" '@(_RaskUiEditorKit)' != '' AND !Exists('$(MSBuildProjectDirectory)/$(_RaskUiEditorOutput)') ">
    <Content Include="$(_RaskUiEditorOutput)" Pack="false"/>
  </ItemGroup>
  <ItemGroup Condition=" '@(_RaskUiEditorKit)' != '' AND !Exists('$(MSBuildProjectDirectory)/$(_RaskUiEditorNotices)') ">
    <Content Include="$(_RaskUiEditorNotices)" Pack="false"/>
  </ItemGroup>

  <!--
    The copy an EARLIER build wrote into the server half's wwwroot, before that half left the file to its
    browser app. The Web SDK's wwwroot glob has already picked it up, so it is taken back out of what is
    published — it is the collision again otherwise — and deleted, or the server's own static files would
    answer /js/rask-ui-editor.js with whatever version that build left there.
  -->
  <ItemGroup Condition="'$(RaskClient)' == 'true'">
    <Content Remove="$(_RaskUiEditorOutput);$(_RaskUiEditorNotices)"/>
  </ItemGroup>

  <Target Name="RaskUiLeaveEditorToClient"
          Condition="'$(RaskClient)' == 'true'"
          BeforeTargets="BeforeBuild">
    <Delete Files="$(MSBuildProjectDirectory)/$(_RaskUiEditorOutput);$(MSBuildProjectDirectory)/$(_RaskUiEditorNotices)"/>
  </Target>

  <Target Name="RaskUiWriteEditor"
          Condition="'@(_RaskUiEditorKit)' != ''"
          BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <!-- From the package: beside these targets. In this repository: the committed bundle in the kit's sources. -->
      <_RaskUiEditorSource Condition="Exists('$(MSBuildThisFileDirectory)rask-ui-editor.js')">$(MSBuildThisFileDirectory)rask-ui-editor.js</_RaskUiEditorSource>
      <_RaskUiEditorSource Condition="'$(_RaskUiEditorSource)' == ''">$(MSBuildThisFileDirectory)../Resources/ui-editor.js</_RaskUiEditorSource>
      <_RaskUiEditorNoticesSource Condition="Exists('$(MSBuildThisFileDirectory)rask-ui-editor.LICENSES.txt')">$(MSBuildThisFileDirectory)rask-ui-editor.LICENSES.txt</_RaskUiEditorNoticesSource>
      <_RaskUiEditorNoticesSource Condition="'$(_RaskUiEditorNoticesSource)' == ''">$(MSBuildThisFileDirectory)../Resources/ui-editor.LICENSES.txt</_RaskUiEditorNoticesSource>
    </PropertyGroup>

    <Error Condition="!Exists('$(_RaskUiEditorSource)')"
           Text="Rask.Ui: the editor's engine could not be found ($(_RaskUiEditorSource)), so $(_RaskUiEditorOutput) cannot be written and every Ui.Editor would stay a block of plain markup. From the package it ships beside these targets as build/rask-ui-editor.js; in this repository it is src/Rask.Ui/Resources/ui-editor.js, built by Resources/editor/build.mjs. An app that draws no editor can say &lt;RaskUiEditorEngine&gt;false&lt;/RaskUiEditorEngine&gt;."/>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(MSBuildProjectDirectory)/$(_RaskUiEditorOutput)'))"/>
    <Copy SourceFiles="$(_RaskUiEditorSource)"
          DestinationFiles="$(MSBuildProjectDirectory)/$(_RaskUiEditorOutput)"
          SkipUnchangedFiles="true"/>
    <Copy SourceFiles="$(_RaskUiEditorNoticesSource)"
          DestinationFiles="$(MSBuildProjectDirectory)/$(_RaskUiEditorNotices)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_RaskUiEditorNoticesSource)')"/>
  </Target>

</Project>
