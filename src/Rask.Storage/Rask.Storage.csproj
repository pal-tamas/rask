<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Server-only: the files are kept by the server and their rows live in the application's database.
         Single-targeted (no net10.0-browser), so that constraint is enforced by the compiler. -->
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Storage</PackageId>
    <Title>Rask.Storage — keep uploaded files, on disk or in a bucket</Title>
    <Description>File upload storage for ASP.NET Core and .NET: keep user uploads on disk, in S3-compatible storage or in Azure Blob Storage, with a row per file in your database. Save an upload in one call and get back a StoredFile row on the application's own database; hand out a public URL, a temporary URL that expires, or a download behind your own authorization check. Files go to a directory on the deploy volume by default, or to S3-compatible storage (AWS, Cloudflare R2, Backblaze B2, MinIO) or Azure Blob Storage by configuration — with no cloud SDK behind it. Content types are sniffed from the bytes rather than trusted from the browser, and only images, audio and video are ever served inline. Server-side; pairs with EF Core and SQLite.</Description>
    <!-- Override the framework default tags (web/component/wasm) — a server-side storage battery. -->
    <PackageTags>file-storage object-storage blob-storage file-upload s3 azure-blob r2 minio presigned-url entity-framework-core sqlite dotnet net10 net11</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- IResult and endpoint routing (the file routes and Download), Data Protection (temporary URL tokens)
       and HttpClient all come with the shared framework. The Microsoft.Extensions.* abstractions do too;
       naming them here as well is what NU1510 rejects. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
  </ItemGroup>

  <!-- No Rask.Core reference, deliberately (#1086). Core is IsPackable=false and travels inside the hosts that
       render components, so the SPA and meta lanes have none, and an app there died before Main the moment
       MapRaskStorage named a Core type. The path base arrives through AppContext data instead (see RaskPathBase),
       and an upload is saved from its opener rather than from Core's RaskFile. -->

  <!-- StorageOptions binds Rask:Storage. The configuration binding source generator writes that bind at compile time,
       so no reflection binder runs; the SDK leaves it off unless a project asks. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!-- Source-linked: the batteries share no common assembly. The boot-time "is this battery mapped?" check, and the
       one registration every server-side options type binds its Rask:<Area> section through. -->
  <ItemGroup>
    <Compile Include="..\Rask.Batteries.Shared\BatteryModelCheck.cs" Link="Shared\BatteryModelCheck.cs"/>
    <Compile Include="..\Rask.Batteries.Shared\Counting.cs" Link="Shared\Counting.cs"/>
    <Compile Include="..\Rask.Batteries.Shared\HousekeepingContexts.cs" Link="Shared\HousekeepingContexts.cs"/>
    <Compile Include="..\Rask.Hosting.Shared\RaskOptionsRegistration.cs" Link="Shared\RaskOptionsRegistration.cs"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Storage.Tests"/>
  </ItemGroup>

  <!-- Ship the global `using Rask.Storage;` to downstream consumers. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
    <None Include="build\**" Pack="true" PackagePath="buildTransitive\%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>


  <!--
    The table is an Entity<TId> so that it has a read face, which is what this brings. EF Core was already a
    dependency of this package; what is new is Rask.Data itself.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Data\Rask.Data.csproj"/>
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Rask.Batteries.Generators\Rask.Batteries.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    READ FACES ONLY — see Rask.Outbox.csproj for the argument in full. This package maps its own table through
    modelBuilder.AddRaskStorage(), so a registry contribution here would map it into every app that merely references
    the package and a second time for one that calls AddRaskStorage. Nothing posts one of these rows either, so the
    form surface would be meaningless.
  -->
  <PropertyGroup>
    <RaskReadFacesOnly>true</RaskReadFacesOnly>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RaskReadFacesOnly"/>
  </ItemGroup>

</Project>
