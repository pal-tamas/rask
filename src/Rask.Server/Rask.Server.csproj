<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rask.Server</RootNamespace>

    <PackageId>Rask.Server</PackageId>
    <Title>Rask — ASP.NET server host, batteries included</Title>
    <Description>The ASP.NET host for Rask, a full-stack .NET web framework, with every battery: database (SQLite, PostgreSQL or SQL Server, picked by Rask:Database:Provider), mediator and query cache, accounts, background jobs, transactional email, cache, file storage, outbox, operator dashboard, durable logs, Web Push, SQLite snapshots and continuous backup. Renders Rask components with live updates over a WebSocket. RaskApp.Create(args).Run&lt;App&gt;() is the whole Program.cs; app.Configure(c => c.Jobs.Off()) is how an app does without one. Depends on Rask, the shared core.</Description>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      The shared core, as an ordinary dependency — the `Rask` package. PrivateAssets="none" so the nuspec
      dependency carries its analyzers to the app: the default excludes them, and an app referencing this
      package alone would then compile with no chain generator. ExcludeAssets="build" keeps the dependency's
      build/ folder out — its hooks reach the app through buildTransitive/, and importing both would run the
      scoped-asset globs twice.
    -->
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    THE BATTERIES. Declaring them here rather than in every scaffolded csproj is what makes "batteries
    included" a property of the package instead of a property of whatever `rask new` happened to write — it
    stays true for an app somebody assembled by hand. RaskApp (App/) wires every one of them and turns off the
    ones the app says it does without. PrivateAssets="none" throughout, so each battery's implicit `using`
    reaches the app.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Cqrs\Rask.Cqrs.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Query\Rask.Query.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Data\Rask.Data.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.SQLite.EntityFrameworkCore\Rask.SQLite.EntityFrameworkCore.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <!-- The other databases Rask:Database:Provider can name. Bundled rather than left to the app so switching is a
         configuration edit and nothing else: UseRaskDatabase(sp) calls these directly, with no reflection. -->
    <ProjectReference Include="..\Rask.Postgres\Rask.Postgres.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.SqlServer\Rask.SqlServer.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Auth\Rask.Auth.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <!-- HTTP endpoints: Rask.Api carries the hosting and the client generator, Rask.Api.Client the runtime the
         generated client calls — a component that calls its own API renders on the server too. -->
    <ProjectReference Include="..\Rask.Api\Rask.Api.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Api.Client\Rask.Api.Client.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Jobs\Rask.Jobs.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Mail\Rask.Mail.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Cache\Rask.Cache.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Storage\Rask.Storage.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Outbox\Rask.Outbox.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Dashboard\Rask.Dashboard.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <!-- The kit is the framework's own component vocabulary; an app builds with it, not merely the console. -->
    <ProjectReference Include="..\Rask.Ui\Rask.Ui.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.Logging\Rask.Logging.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.WebPush\Rask.WebPush.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <!-- DataAnnotations is in the core; this is the other half — an AbstractValidator&lt;T&gt; in the app is
         discovered and wired by the generator. -->
    <ProjectReference Include="..\Rask.Validation.FluentValidation\Rask.Validation.FluentValidation.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.SQLite.Snapshots\Rask.SQLite.Snapshots.csproj" PrivateAssets="none" ExcludeAssets="build"/>
    <ProjectReference Include="..\Rask.SQLite.Litestream\Rask.SQLite.Litestream.csproj" PrivateAssets="none" ExcludeAssets="build"/>
  </ItemGroup>

  <!--
    Microsoft.JSInterop (IJSRuntime + JSRuntime base + DotNetDispatcher) is already supplied
    transitively by the Microsoft.AspNetCore.App framework reference above, so no explicit
    PackageReference is needed. This is the abstractions-only surface — it does not drag in
    the Blazor renderer or circuit, so Rask's component model stays independent of
    Microsoft.AspNetCore.Components.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Core.Tests"/>
    <InternalsVisibleTo Include="Rask.Server.Tests"/>
    <!-- Same surface as Rask.Server.Tests; a separate assembly so MetadataUpdaterSupport can be on. -->
    <InternalsVisibleTo Include="Rask.Server.HotReload.Tests"/>
    <!--
      The session-footprint / session-churn capacity reports construct real LiveSessions to measure
      per-session retained memory. LiveSession, LiveSessionStore.Create and RenderInitialRoot are all
      internal, and measuring through the public HTTP/WebSocket surface would fold Kestrel's own
      per-connection buffers into the per-session number.
    -->
    <InternalsVisibleTo Include="Rask.Benchmarks"/>
    <!-- The devtools map their endpoints through IRaskServerDevTools, which MapRask calls. -->
    <InternalsVisibleTo Include="Rask.DevTools"/>
    <InternalsVisibleTo Include="Rask.DevTools.Tests"/>
  </ItemGroup>

  <!--
    The host defaults every Rask web host applies, source-linked rather than shared through a package —
    the same arrangement Rask.Spa.Hosting already uses for this folder. Named file
    by file instead of globbing it: the rest of Rask.Hosting.Shared is static-file serving that a live
    server host has no use for, and pulling it in would put two unused types in this assembly.
  -->
  <ItemGroup>
    <Compile Include="..\Rask.Hosting.Shared\RaskDataProtectionSetup.cs" Link="Shared\RaskDataProtectionSetup.cs"/>
    <Compile Include="..\Rask.Hosting.Shared\RaskShutdownDefaults.cs" Link="Shared\RaskShutdownDefaults.cs"/>
    <Compile Include="..\Rask.Hosting.Shared\RaskOptionsRegistration.cs" Link="Shared\RaskOptionsRegistration.cs"/>
    <!-- The request validators the mediator runs, on both hosts: the same rules a Form applies, again at dispatch. -->
    <Compile Include="..\Rask.Hosting.Shared\Batteries\RequestValidators.cs" Link="Shared\Batteries\RequestValidators.cs"/>
    <!-- One file, two hosts: Rask.Data's browser build registers it from AddRaskData; the server build does not
         reference Rask.Query, so the server host compiles the same file in and registers it itself (RaskBatteryWiring). -->
    <Compile Include="..\Rask.Data\Browser\QueryDataChanges.cs" Link="App\QueryDataChanges.cs"/>
    <!-- An app VS Code's F5 launched starts its islands' Vite dev server itself (Dev/IslandDevServer). -->
    <Compile Include="..\Rask.Hosting.Shared\Dev\EditorDevSession.cs" Link="Shared\Dev\EditorDevSession.cs"/>
    <Compile Include="..\Rask.Hosting.Shared\Dev\IslandDevPointer.cs" Link="Shared\Dev\IslandDevPointer.cs"/>
    <Compile Include="..\Rask.Hosting.Shared\Dev\DevServerProcess.cs" Link="Shared\Dev\DevServerProcess.cs"/>
  </ItemGroup>

  <!-- The live, server, culture and upload options bind Rask:Live / Rask:Server / Rask:Culture / Rask:Uploads.
       The configuration binding source generator writes those binds at compile time, so no reflection binder
       runs; the SDK leaves it off unless a project asks. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!--
    Every file the two bundles can reach, so an edit to any of them re-bundles. Stated as an
    ItemGroup rather than in the targets' Inputs because a target's Inputs does not expand
    wildcards — it would treat the pattern as a literal filename and rebuild unconditionally.
  -->
  <ItemGroup>
    <_RaskServerClientTs Include="Resources\rask.ts;Resources\rask-http-transport.ts;..\Rask.Core\Resources\**\*.ts"
                         Exclude="..\Rask.Core\Resources\rask-sw-shared.ts;..\Rask.Core\Resources\**\*.d.ts"/>
    <_RaskServerSwTs Include="Resources\rask-sw.ts;..\Rask.Core\Resources\rask-sw-shared.ts"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)rask.js" LogicalName="Rask.Server.Resources.rask.js"/>
    <EmbeddedResource Include="$(IntermediateOutputPath)rask-sw.js" LogicalName="Rask.Server.Resources.rask-sw.js"/>
  </ItemGroup>

  <!--
    The embedded Server client runtime. Resources/rask.ts is the host entry point: it IMPORTS the
    shared modules it needs from Rask.Core/Resources and esbuild bundles the graph into one script.

    This replaces an MSBuild string-replace splice that pasted nine files into this one at
    `// @@RASK_*@@` markers. The order was load-bearing, the cross-module references were implicit
    `window.__rask*` globals, and nothing checked either. Both are now the compiler's problem.

    Format is iife, not esm: the runtime is delivered by a plain `<script src>` that Rask writes into
    the shell, and a module script would defer past the first frame.
  -->
  <Target Name="_RaskBundleClientJs" BeforeTargets="PrepareForBuild" DependsOnTargets="ResolveProjectReferences"
          Inputs="@(_RaskServerClientTs)"
          Outputs="$(IntermediateOutputPath)rask.js">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(IntermediateOutputPath)"/>

    <!--
      Minified in Release only, so a Debug build stays readable in the browser's debugger. This is
      REAL minification now — the hand-rolled stripper it replaces could only remove comments and
      blank lines, and three source files carried comments working around its regex-literal bug.
    -->
    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;$(MSBuildProjectDirectory)/Resources/rask.ts&quot; --bundle --format=iife --target=es2019 --log-level=warning --outfile=&quot;$(IntermediateOutputPath)rask.js&quot; $(_RaskEsbuildMinify)"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!--
    The embedded Server service worker. Resources/rask-sw.ts holds the offline-fallback strategy (NOT
    app-shell caching — see the file for why that would be unsafe here) and IMPORTS the Core shared
    push / notificationclick handlers; esbuild bundles the two into one classic worker script. Served
    at {PathBase}/rask-sw.js by AddRaskPwa; see RaskEndpointExtensions.

    This replaces an MSBuild string-replace splice over a @@RASK_SW@@ marker. The dependency is now
    stated in the file that has it and checked by the compiler, rather than assembled by a target that
    could not tell whether the marker was still there.

    Format is iife, not esm: the worker is registered classically, and an ES-module worker would need
    `{type:"module"}` at every registration site — including ones in consumers' own code.
  -->
  <Target Name="_RaskBundleServiceWorker" BeforeTargets="PrepareForBuild" DependsOnTargets="ResolveProjectReferences"
          Inputs="@(_RaskServerSwTs)"
          Outputs="$(IntermediateOutputPath)rask-sw.js">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(IntermediateOutputPath)"/>

    <!--
      Minified in Release only, so a Debug build stays readable in the browser's worker inspector.
      This is REAL minification now — the hand-rolled stripper it replaces could only remove comments
      and blank lines, and its doc comment claimed a regex-literal safety it did not have.
    -->
    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;$(MSBuildProjectDirectory)/Resources/rask-sw.ts&quot; --bundle --format=iife --target=es2019 --log-level=warning --outfile=&quot;$(IntermediateOutputPath)rask-sw.js&quot; $(_RaskEsbuildMinify)"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <PropertyGroup>
    <_RaskEsbuildMinify Condition=" '$(Configuration)' == 'Release' ">--minify</_RaskEsbuildMinify>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
    <None Include="build\**" Pack="true" PackagePath="buildTransitive\%(RecursiveDir)%(Filename)%(Extension)"/>
  </ItemGroup>

  <!-- Tailwind's build integration, packed beside this package's own targets and imported from them. The core's
       integration and the analyzers arrive through the `Rask` dependency. -->
  <Import Project="..\RaskTailwindBuildPack.targets"/>

</Project>
