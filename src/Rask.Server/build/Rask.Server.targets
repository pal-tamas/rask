<Project>

  <!--
    Rask.Server's NuGet auto-import entry point. NuGet imports only build/<PackageId>.{props,targets},
    so Rask.Core's build integration — packed alongside this file by src\RaskCoreBuildPack.targets —
    has to be pulled in from here. Without this import a consuming app gets no scoped CSS/JS at all (#544).

    The Exists guard is for the source tree: Rask.Core.targets is packed from Rask.Core's own build/
    folder and has no sibling here, so in-repo projects take the Directory.Build.targets route instead
    and this import is a no-op.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Rask.Core.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)Rask.Core.targets') "/>

  <!-- The one-project build: generates and drives the browser half on publish. Gates itself on
       RaskBrowserRung, so importing it unconditionally costs an app that has not opted in nothing. -->
  <Import Project="$(MSBuildThisFileDirectory)Rask.Server.Browser.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)Rask.Server.Browser.targets') "/>

  <!--
    Tailwind. Packed alongside this file by src\RaskTailwindBuildPack.targets, and imported from here
    because NuGet auto-imports only build/<PackageId>.{props,targets}. Referencing this host package is
    the whole of how an app gets Tailwind: there is no Rask.Tailwind package to add and no flag to pass.

    It gates itself on the project having a stylesheet to compile, so importing it unconditionally costs
    a project without one nothing.

    The Exists guard is for the source tree: Rask.Tailwind.targets is packed from Rask.Tailwind's own
    build/ folder and has no sibling here, so in-repo projects take the Directory.Build.targets route
    instead and this import is a no-op.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Rask.Tailwind.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)Rask.Tailwind.targets') "/>

</Project>
