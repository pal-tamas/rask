<Project>

  <!--
    Rask.Server's NuGet auto-import entry point. The core's build integration (scoped CSS/TypeScript) is
    not here any more: it ships in the `Rask` package this one depends on, and NuGet imports it from there.
  -->
  <!-- The one-project build for a WebAssembly client in Client/. Gates itself on Client/Program.cs, so
       importing it unconditionally costs an app without one nothing. -->
  <Import Project="$(MSBuildThisFileDirectory)Rask.Server.Client.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)Rask.Server.Client.targets') "/>

  <!--
    The CQRS wire codec (and RASK053) only where messages cross a wire: a project with a browser client — a
    WebAssembly one in Client/, or a TypeScript front end found the way Rask.Spa.Hosting finds it (RaskSpaClientDir,
    else a client/ or Client/ folder holding a package.json). The codec also carries
    the TypeScript contracts, so a front end without it would compile against none. Rask.Server carries the server
    transport for Serve(), and a server-rendered app's messages never leave the process. Resolved here rather than
    read from Rask.Spa.Hosting's properties: the order NuGet imports two packages' targets in is not ours to rely on.
    Here, in the package's own entry point, rather than in Rask.Server.Client.targets: that file is also imported
    into every project of this repository, where it would switch the codec off for the client's own tests.
  -->
  <PropertyGroup>
    <RaskCqrsCodec Condition=" '$(RaskCqrsCodec)' == '' AND ('$(RaskSpaClientDir)' != '' OR Exists('$(MSBuildProjectDirectory)/client/package.json') OR Exists('$(MSBuildProjectDirectory)/Client/package.json')) ">true</RaskCqrsCodec>
    <RaskCqrsCodec Condition=" '$(RaskCqrsCodec)' == '' ">$(RaskClient)</RaskCqrsCodec>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="RaskCqrsCodec"/>
  </ItemGroup>

  <!--
    The host's own namespace, so a hand-wired Web-SDK host finds AddRask() and MapRask<TApp>() the way it finds
    every other AddX/MapX (#1236). A RaskApp scaffold never names it, so it gains nothing to clash with: the
    namespace holds the host's extension classes, RaskServerOptions and LiveSessionStore, none of them a name an
    app writes for something else. Here rather than in Rask.Server.props because this repository imports that
    file into its WebAssembly site, which does not reference this package. RaskServerUsing=false turns it off.

    NOT Rask.Core.Routing, although [Route] lives there: in an existing app its RouteAttribute meets
    Microsoft.AspNetCore.Mvc's on every controller (CS0104) and its QueryString meets Microsoft.AspNetCore.Http's,
    so importing it for the whole project breaks the code that was already there. The page files import it
    themselves — docs/spa.md shows the line.
  -->
  <ItemGroup Condition=" '$(RaskServerUsing)' != 'false' ">
    <Using Include="Rask.Server"/>
  </ItemGroup>

  <!--
    Tailwind. Packed alongside this file by src\RaskTailwindBuildPack.targets, and imported from here
    because NuGet auto-imports only build/<PackageId>.{props,targets}. Referencing this host package is
    the whole of how an app gets Tailwind: there is no Rask.Tailwind package to add and no flag to pass.

    It gates itself on the project having a stylesheet to compile, so importing it unconditionally costs
    a project without one nothing.

    The Exists guard is for the source tree: Rask.Tailwind.targets is packed from Rask.Tailwind's own
    build/ folder and has no sibling here, so in-repo projects take the Directory.Build.targets route
    instead and this import is a no-op.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Rask.Tailwind.targets"
          Condition=" Exists('$(MSBuildThisFileDirectory)Rask.Tailwind.targets') "/>

</Project>
