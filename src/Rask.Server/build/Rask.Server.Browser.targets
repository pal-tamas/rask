<Project>

  <!--
    The one-project build.

    A .csproj carries exactly one SDK, and the two halves of a Rask app need different ones:
    Microsoft.NET.Sdk.Web on net10.0 for the server, Microsoft.NET.Sdk.WebAssembly on
    net10.0-browser/browser-wasm for the browser. One authored project therefore cannot be both — so
    the build generates the second one and drives it, rather than asking the author to maintain a
    parallel project whose only job is to compile the same files again.

    The companion lives in obj/, is never opened, and is rebuilt from scratch each publish. What it
    compiles is the app's own sources: the same App.cs, the same pages, minus the server's Program.cs
    (it gets a generated entry point instead) and minus anything under Server/, which is the
    convention for "this code only exists on the server".

    Browser/ is the mirror of that, and the SERVER is what excludes it. It is the only place a file can
    reference something from RaskBrowserPackageReference: that reference reaches the companion alone, so
    a file using it would otherwise fail to compile in the server half, where the package is absent by
    design. One project means one source glob, and these two folders are how a file says which half it
    belongs to.

    Opt in with <RaskBrowserRung>true</RaskBrowserRung>, alongside RenderModes.Wasm in Program.cs. The
    build cannot read Program.cs, which is why this is a separate switch rather than inferred.

    Publish-only. A browser bundle takes minutes to link and buys nothing during development, where
    the page is server-live and hot-reloaded.
  -->

  <!--
    The server half does not compile Browser/. Only under RaskBrowserRung: without the one-project
    build there is no second half, so a folder of that name is just a folder and removing its sources
    would silently drop code the app expects to be compiled.
  -->
  <ItemGroup Condition=" '$(RaskBrowserRung)' == 'true' ">
    <Compile Remove="Browser\**\*.cs"/>
  </ItemGroup>

  <PropertyGroup>
    <RaskBrowserRung Condition=" '$(RaskBrowserRung)' == '' ">false</RaskBrowserRung>
    <RaskBrowserCompanionDir Condition=" '$(RaskBrowserCompanionDir)' == '' ">$(BaseIntermediateOutputPath)rask-browser\</RaskBrowserCompanionDir>
    <RaskBrowserCompanionName Condition=" '$(RaskBrowserCompanionName)' == '' ">$(AssemblyName).Browser</RaskBrowserCompanionName>
    <RaskBrowserCompanionProject>$(RaskBrowserCompanionDir)$(RaskBrowserCompanionName).csproj</RaskBrowserCompanionProject>
    <!--
      A SIBLING of the companion's project directory, never a child of it. The companion globs its own
      folder for sources and scoped assets, so publishing into it makes the previous publish an input
      to the next one: the bundle's own main.js and dotnet.js come back as candidate scoped-JS files
      and fail the build with RASK017. The first publish succeeds and every one after it fails, which
      is the worst version of this to diagnose.
    -->
    <RaskBrowserCompanionOutput Condition=" '$(RaskBrowserCompanionOutput)' == '' ">$(BaseIntermediateOutputPath)rask-browser-out\</RaskBrowserCompanionOutput>
    <!--
      The app's root component, used for the generated entry point. Defaults to <RootNamespace>.App —
      where a hand-written app puts its root. An app that puts it elsewhere says so; `rask new` does,
      because its layout keeps cross-cutting code in Features/Shared.
    -->
    <RaskBrowserRootComponent Condition=" '$(RaskBrowserRootComponent)' == '' ">$(RootNamespace).App</RaskBrowserRootComponent>
  </PropertyGroup>

  <!--
    The typed API client crosses into the bundle as a FILE, not as a second generator run.

    An API controller lives under Server/, which the companion does not compile — so the generator
    cannot see it there and the browser half would have no client at all. What it can compile is the
    one the SERVER's generator already produced, and EmitCompilerGeneratedFiles is what puts that on
    disk instead of only in the server's compilation.

    Deliberately not the shape Rask.Cqrs uses for its TypeScript. There the generated text has to
    travel as a string constant inside the assembly, because a .ts file cannot be compiled into one
    and an MSBuild task has to lift it back out of the PE metadata. C# has no such problem: the
    compiler will write the file itself, so the client needs no task assembly, no escaping, and — the
    part that matters at run time — no copy of itself embedded in every server assembly forever.

    It also cannot go stale. The file is an output of CoreCompile, so it is rewritten whenever the
    controllers are, and a build that skips CoreCompile skips it for the same reason the assembly is
    already current.
  -->
  <PropertyGroup Condition=" '$(RaskBrowserRung)' == 'true' ">
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath Condition=" '$(CompilerGeneratedFilesOutputPath)' == '' ">$(IntermediateOutputPath)rask-generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <Target Name="RaskGenerateBrowserCompanion" Condition=" '$(RaskBrowserRung)' == 'true' ">

    <Error Condition=" '$(RootNamespace)' == '' And '$(RaskBrowserRootComponent)' == '' "
           Text="RaskBrowserRung is on but the app's root component could not be determined. Set &lt;RaskBrowserRootComponent&gt; to its full type name (e.g. MyApp.App)."/>

    <!--
      How the companion references Rask mirrors how the APP references it. An app consuming the
      packages gets a PackageReference at the same version; the framework's own repo and its tests
      wire by project path, and RaskBrowserCompanionSrc is how they say so. Guessing one form would
      break the other, and both are real.
    -->
    <PropertyGroup>
      <_RaskBrowserBySource Condition=" '$(RaskBrowserCompanionSrc)' != '' ">true</_RaskBrowserBySource>
    </PropertyGroup>

    <ItemGroup>
      <_RaskServerPackage Include="@(PackageReference)" Condition=" '%(Identity)' == 'Rask.Server' "/>

      <!--
        Globbed rather than named: the compiler nests its output under the generator's assembly and
        full type name, and pinning that path would make renaming the generator a silent loss of the
        client rather than a build error. Absent is the ordinary state of an app with no API.
      -->
      <_RaskApiClientFile Include="$(CompilerGeneratedFilesOutputPath)\**\__RaskApiClients.g.cs"/>
    </ItemGroup>

    <PropertyGroup>
      <_RaskBrowserVersion>@(_RaskServerPackage->'%(Version)')</_RaskBrowserVersion>
    </PropertyGroup>

    <Error Condition=" '$(_RaskBrowserBySource)' != 'true' And '$(_RaskBrowserVersion)' == '' "
           Text="RaskBrowserRung is on but no Rask.Server PackageReference was found to take a version from. The browser half is published as a separate project and needs to reference the same framework build as this one."/>

    <ItemGroup>
      <!--
        %2A is '*' and %3B is ';', escaped. These lines are DATA, but MSBuild reads an item Include as
        a file glob and splits it on semicolons — so an unescaped wildcard line matches nothing on disk
        and vanishes from the output entirely, and every line carrying a semicolon is cut in two. Both
        happened; the missing line was the one that includes the app's own sources, which is the whole
        point of the file.
      -->
      <_RaskCompanionLine Include="&lt;Project Sdk=&quot;Microsoft.NET.Sdk.WebAssembly&quot;&gt;"/>
      <_RaskCompanionLine Include="  &lt;!-- GENERATED by Rask on publish. Edits are lost%3B change the app instead. --&gt;"/>

      <_RaskCompanionLine Condition=" '$(_RaskBrowserBySource)' == 'true' "
                          Include="  &lt;Import Project=&quot;$(RaskBrowserCompanionSrc)\Rask.Wasm\build\Rask.Wasm.props&quot; /&gt;"/>

      <_RaskCompanionLine Include="  &lt;PropertyGroup&gt;"/>
      <_RaskCompanionLine Include="    &lt;TargetFramework&gt;net10.0-browser&lt;/TargetFramework&gt;"/>
      <_RaskCompanionLine Include="    &lt;RuntimeIdentifier&gt;browser-wasm&lt;/RuntimeIdentifier&gt;"/>
      <_RaskCompanionLine Include="    &lt;OutputType&gt;Exe&lt;/OutputType&gt;"/>
      <_RaskCompanionLine Include="    &lt;Nullable&gt;$(Nullable)&lt;/Nullable&gt;"/>
      <_RaskCompanionLine Include="    &lt;ImplicitUsings&gt;$(ImplicitUsings)&lt;/ImplicitUsings&gt;"/>
      <_RaskCompanionLine Include="    &lt;LangVersion&gt;$(LangVersion)&lt;/LangVersion&gt;"/>
      <_RaskCompanionLine Include="    &lt;RootNamespace&gt;$(RootNamespace)&lt;/RootNamespace&gt;"/>
      <_RaskCompanionLine Include="    &lt;AssemblyName&gt;$(RaskBrowserCompanionName)&lt;/AssemblyName&gt;"/>
      <_RaskCompanionLine Include="    &lt;RaskWasm&gt;true&lt;/RaskWasm&gt;"/>
      <!--
        The takeover boots from a server-rendered page, which carries no import map. Fingerprinted
        framework assets are mapped through one the SDK writes into the bundle's own index.html — a
        document nobody loads here — so the boot would 404 in a publish and work in a build.
      -->
      <_RaskCompanionLine Include="    &lt;WasmFingerprintAssets&gt;false&lt;/WasmFingerprintAssets&gt;"/>
      <_RaskCompanionLine Include="    &lt;EnableDefaultCompileItems&gt;false&lt;/EnableDefaultCompileItems&gt;"/>
      <!--
        Belt and braces against CS0101. The companion compiles the client the server generated, so a
        generator running HERE too would declare every client type a second time. It normally cannot:
        the generator ships with Rask.Api, a server-side package the bundle never references. This
        makes that a property rather than a coincidence, for the app that adds Rask.Api to
        RaskBrowserPackageReference by mistake.
      -->
      <_RaskCompanionLine Include="    &lt;RaskApiClientBaked&gt;true&lt;/RaskApiClientBaked&gt;"/>
      <_RaskCompanionLine Include="  &lt;/PropertyGroup&gt;"/>
      <_RaskCompanionLine Include="  &lt;ItemGroup&gt;"/>
      <_RaskCompanionLine Include="    &lt;CompilerVisibleProperty Include=&quot;RaskApiClientBaked&quot; /&gt;"/>
      <_RaskCompanionLine Include="  &lt;/ItemGroup&gt;"/>

      <!--
        Remove rather than Exclude: an Exclude attribute takes a semicolon-separated list, and every
        one of those semicolons would split this generated line into separate items on the way out.
      -->
      <_RaskCompanionLine Include="  &lt;ItemGroup&gt;"/>
      <_RaskCompanionLine Include="    &lt;Compile Include=&quot;$(MSBuildProjectDirectory)\%2A%2A\%2A.cs&quot; /&gt;"/>
      <_RaskCompanionLine Include="    &lt;Compile Remove=&quot;$(MSBuildProjectDirectory)\obj\%2A%2A&quot; /&gt;"/>
      <_RaskCompanionLine Include="    &lt;Compile Remove=&quot;$(MSBuildProjectDirectory)\bin\%2A%2A&quot; /&gt;"/>
      <_RaskCompanionLine Include="    &lt;Compile Remove=&quot;$(MSBuildProjectDirectory)\Program.cs&quot; /&gt;"/>
      <_RaskCompanionLine Include="    &lt;Compile Remove=&quot;$(MSBuildProjectDirectory)\Server\%2A%2A&quot; /&gt;"/>
      <_RaskCompanionLine Include="    &lt;Compile Include=&quot;Program.g.cs&quot; /&gt;"/>
      <!--
        The typed API client the server's own generator wrote. An Include AFTER the obj\** Remove, so
        it survives it: the file lives under obj by construction, and the blanket removal above is
        what stops the companion compiling the server's other generated output.
      -->
      <_RaskCompanionLine Condition=" '@(_RaskApiClientFile)' != '' "
                          Include="@(_RaskApiClientFile->'    &lt;Compile Include=&quot;%(FullPath)&quot; /&gt;')"/>
      <_RaskCompanionLine Include="  &lt;/ItemGroup&gt;"/>

      <!--
        References the BROWSER half needs and the server half must not have.
        <RaskBrowserPackageReference Include="Rask.Cqrs.Client" Version="..." /> is how an app says
        "this belongs to the bundle only".

        One project, two halves, one reference list — and some pairs are designed so that neither half
        carries the other's. Rask.Cqrs.Client and Rask.Cqrs.Server are exactly that: putting the client
        transport in the server would ship endpoint-calling code into the process that answers the
        endpoints. A single list cannot express that, so this item is the seam.
      -->
      <_RaskCompanionLine Include="  &lt;ItemGroup&gt;"/>
      <_RaskCompanionLine Include="@(RaskBrowserPackageReference->'    &lt;PackageReference Include=&quot;%(Identity)&quot; Version=&quot;%(Version)&quot; /&gt;')"
                          Condition=" '%(RaskBrowserPackageReference.Version)' != '' "/>
      <_RaskCompanionLine Include="@(RaskBrowserPackageReference->'    &lt;PackageReference Include=&quot;%(Identity)&quot; /&gt;')"
                          Condition=" '%(RaskBrowserPackageReference.Version)' == '' "/>
      <_RaskCompanionLine Include="@(RaskBrowserProjectReference->'    &lt;ProjectReference Include=&quot;%(FullPath)&quot; /&gt;')"/>
      <!--
        The client runtime the baked file compiles against, added because the file is there rather
        than because the app asked. The companion's reference list is closed — RaskBrowserPackageReference
        plus Rask.Wasm — so without this the bake produces a file the companion cannot compile, and the
        author meets it as a missing-type error inside generated code they never wrote.

        Note this is NOT the Rask.Cqrs.Client arrangement, and the difference is deliberate: that split
        exists because AddRaskCqrsClient() rewrites a process-wide registry, so having it in the server
        would make the server bounce its own messages back out. A typed API client has no such property
        — it dials routes that are public anyway — so both halves may hold it, and the server half must,
        since a component that calls its API renders on both.
      -->
      <_RaskCompanionLine Condition=" '@(_RaskApiClientFile)' != '' And '$(_RaskBrowserBySource)' != 'true' "
                          Include="    &lt;PackageReference Include=&quot;Rask.Api.Client&quot; Version=&quot;$(_RaskBrowserVersion)&quot; /&gt;"/>
      <_RaskCompanionLine Condition=" '@(_RaskApiClientFile)' != '' And '$(_RaskBrowserBySource)' == 'true' "
                          Include="    &lt;ProjectReference Include=&quot;$(RaskBrowserCompanionSrc)\Rask.Api.Client\Rask.Api.Client.csproj&quot; /&gt;"/>

      <_RaskCompanionLine Condition=" '$(_RaskBrowserBySource)' != 'true' "
                          Include="    &lt;PackageReference Include=&quot;Rask.Wasm&quot; Version=&quot;$(_RaskBrowserVersion)&quot; /&gt;"/>
      <_RaskCompanionLine Condition=" '$(_RaskBrowserBySource)' == 'true' "
                          Include="    &lt;ProjectReference Include=&quot;$(RaskBrowserCompanionSrc)\Rask.Core\Rask.Core.csproj&quot; /&gt;"/>
      <_RaskCompanionLine Condition=" '$(_RaskBrowserBySource)' == 'true' "
                          Include="    &lt;ProjectReference Include=&quot;$(RaskBrowserCompanionSrc)\Rask.Html\Rask.Html.csproj&quot; /&gt;"/>
      <_RaskCompanionLine Condition=" '$(_RaskBrowserBySource)' == 'true' "
                          Include="    &lt;ProjectReference Include=&quot;$(RaskBrowserCompanionSrc)\Rask.Wasm\Rask.Wasm.csproj&quot; /&gt;"/>
      <_RaskCompanionLine Condition=" '$(_RaskBrowserBySource)' == 'true' "
                          Include="    &lt;ProjectReference Include=&quot;$(RaskBrowserCompanionSrc)\Rask.Generators\Rask.Generators.csproj&quot; OutputItemType=&quot;Analyzer&quot; ReferenceOutputAssembly=&quot;false&quot; /&gt;"/>
      <_RaskCompanionLine Include="  &lt;/ItemGroup&gt;"/>

      <_RaskCompanionLine Condition=" '$(_RaskBrowserBySource)' == 'true' "
                          Include="  &lt;Import Project=&quot;$(RaskBrowserCompanionSrc)\Rask.Wasm\build\Rask.Wasm.targets&quot; /&gt;"/>
      <_RaskCompanionLine Condition=" '$(_RaskBrowserBySource)' == 'true' "
                          Include="  &lt;Import Project=&quot;$(RaskBrowserCompanionSrc)\Rask.Core\build\Rask.Core.targets&quot; /&gt;"/>

      <_RaskCompanionLine Include="&lt;/Project&gt;"/>
    </ItemGroup>

    <ItemGroup>
      <_RaskCompanionProgram Include="// GENERATED by Rask on publish. The browser half's entry point."/>
      <_RaskCompanionProgram Include="//"/>
      <_RaskCompanionProgram Include="// The app authored one Program.cs and it is the server's. RunAsync decides for itself whether to"/>
      <_RaskCompanionProgram Include="// paint: arriving into a page a live server runtime is already driving, it prepares and waits to be"/>
      <_RaskCompanionProgram Include="// handed the document instead."/>
      <!--
        Without a startup hook this is one line. With one it is three, because the browser half has no
        Program.cs of its own to register services in — that file is the server's, and the companion
        excludes it. RaskBrowserStartup names a type in the app whose Configure(IServiceCollection) the
        bundle calls, which is where anything browser-only gets wired.
      -->
      <_RaskCompanionProgram Condition=" '$(RaskBrowserStartup)' == '' "
                             Include="await Rask.Wasm.WasmHostBuilder.CreateDefault().RunAsync&lt;$(RaskBrowserRootComponent)&gt;()%3B"/>

      <_RaskCompanionProgram Condition=" '$(RaskBrowserStartup)' != '' "
                             Include="var host = Rask.Wasm.WasmHostBuilder.CreateDefault()%3B"/>
      <_RaskCompanionProgram Condition=" '$(RaskBrowserStartup)' != '' "
                             Include="$(RaskBrowserStartup).Configure(host.Services)%3B"/>
      <_RaskCompanionProgram Condition=" '$(RaskBrowserStartup)' != '' "
                             Include="await host.RunAsync&lt;$(RaskBrowserRootComponent)&gt;()%3B"/>
    </ItemGroup>

    <MakeDir Directories="$(RaskBrowserCompanionDir)"/>
    <WriteLinesToFile File="$(RaskBrowserCompanionProject)" Lines="@(_RaskCompanionLine)" Overwrite="true" WriteOnlyWhenDifferent="true"/>
    <WriteLinesToFile File="$(RaskBrowserCompanionDir)Program.g.cs" Lines="@(_RaskCompanionProgram)" Overwrite="true" WriteOnlyWhenDifferent="true"/>

    <Message Importance="high" Text="Rask: generated the browser companion at $(RaskBrowserCompanionProject)"/>
  </Target>

  <!--
    Driven with `dotnet publish` rather than the MSBuild task on purpose: the companion carries a
    different SDK and a different TargetFramework, and building it in this process shares global
    properties and the SDK resolution of the project that started it. A separate process is the same
    isolation the WebAssembly SDK uses for its own inner builds.
  -->
  <Target Name="RaskPublishBrowserCompanion"
          Condition=" '$(RaskBrowserRung)' == 'true' "
          DependsOnTargets="RaskGenerateBrowserCompanion"
          BeforeTargets="PrepareForPublish">

    <Message Importance="high" Text="Rask: publishing the browser companion (this links a WebAssembly runtime and takes a while)"/>

    <!-- nodeReuse:false — a reused node holds the previous build's assemblies loaded, and this is a
         nested build of a project that did not exist when the outer one started. -->
    <Exec Command="dotnet publish &quot;$(RaskBrowserCompanionProject)&quot; -c $(Configuration) -o &quot;$(RaskBrowserCompanionOutput)&quot; --nologo -v:minimal -nodeReuse:false"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <Target Name="RaskCollectBrowserAssets"
          Condition=" '$(RaskBrowserRung)' == 'true' "
          DependsOnTargets="RaskPublishBrowserCompanion"
          BeforeTargets="PrepareForPublish">

    <ItemGroup>
      <_RaskBrowserAsset Include="$(RaskBrowserCompanionOutput)wwwroot\**\*"/>

      <!-- Into the server's own wwwroot, which is where UseRaskWasmAssets points by default. -->
      <ResolvedFileToPublish Include="@(_RaskBrowserAsset)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>

    <Error Condition=" '@(_RaskBrowserAsset)' == '' "
           Text="Rask: the browser companion published nothing into wwwroot. Expected a bundle at $(RaskBrowserCompanionOutput)wwwroot."/>

    <Message Importance="high" Text="Rask: browser bundle staged (@(_RaskBrowserAsset->Count()) files)"/>
  </Target>

</Project>
