<Project>
  <ItemGroup>
    <Using Include="Rask.Core"/>
    <!-- Auto-generated HTML tag factories live in Rask.Core.Components.Components. -->
    <Using Include="Rask.Core.Components.Generated" Static="true"/>
    <!-- The HTML/SVG element family moved to Rask.Html. Only the .Generated static is imported, exactly
         as for Rask.Core above and for the same reason: importing the NAMESPACE would put the tag
         TYPES in scope, and a type beats a same-named builder-entry property (CS0119). Entries reach
         an app's own components by injection into their partials, the tags' types by the entry. -->
    <Using Include="Rask.Html.Components.Generated" Static="true"/>
    <!-- Routing helpers (Router/Outlet/Route<T>) come from the generator in Rask.Core.Routing.Components. -->
    <Using Include="Rask.Core.Routing.Generated" Static="true"/>
  </ItemGroup>
</Project>
