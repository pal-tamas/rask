<Project>
  <!-- The framework usings (Rask.Core, Rask, the markup primitives) come from the `Rask` package's own props. -->

  <!--
    The Tailwind defaults (pinned version, input sheet, output path, engine, cache root). Packed
    alongside this file by src\RaskTailwindBuildPack.targets. Props rather than targets because these
    are the knobs a consuming project overrides, and an override in the .csproj has to win — which it
    only does if the defaults are conditioned and imported first.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Rask.Tailwind.props"
          Condition=" Exists('$(MSBuildThisFileDirectory)Rask.Tailwind.props') "/>

</Project>
