<Project>

  <!--
    Consumer-facing knobs for the Tailwind build. Override any of these in your host project, or with -p:.
  -->
  <PropertyGroup>
    <!--
      There is no master switch. Tailwind is not a feature of a Rask app, it is how a Rask app is
      styled: the stylesheet ships with the host package, every scaffolded project is written in
      utilities, and a build that quietly produced no CSS would render every page as unstyled HTML —
      which is not a failure anybody notices until it is in front of a user.

      What decides whether the compiler runs is whether the project HAS a stylesheet to compile
      (RaskTailwindInput, below). That is what makes this file safe to import into every project in a
      solution — a class library with no wwwroot has nothing to compile and does nothing — while
      leaving no switch that turns styling off for a project that does.
    -->

    <!--
      PINNED, never floating. Tailwind is a compiler: a different version emits different CSS, so a
      build that silently picked up a new one would change what your pages look like without a diff.
      (Tailwind.MSBuild, the community package, defaults this to `latest` — which is exactly the
      reproducibility hazard this avoids.) Bump it deliberately.
    -->
    <RaskTailwindVersion Condition="'$(RaskTailwindVersion)' == ''">4.3.3</RaskTailwindVersion>

    <!--
      `auto` prefers Tailwind's standalone binary and falls back to npm where none is published.

      Standalone first because "the SDK is all you need" is why anyone picks a C# host, and the binary
      keeps that true on macOS, Linux (glibc and musl) and Windows x64. npm second because it covers
      strictly more — Tailwind's npm engine ships native builds for win32-arm64, 32-bit ARM and FreeBSD
      that the standalone release has no equivalent of, plus a wasm32-wasi build that runs anywhere Node
      does. So no platform is simply unsupported.

      Force one with `standalone` or `npm`. On Windows on ARM, `npm` gets you a native engine instead of
      the x64 binary under emulation.
    -->
    <RaskTailwindEngine Condition="'$(RaskTailwindEngine)' == ''">auto</RaskTailwindEngine>

    <!-- Never reach the network: fail instead, naming the file to place and where it goes. For a build
         that must be hermetic. -->
    <RaskTailwindOffline Condition="'$(RaskTailwindOffline)' == ''">false</RaskTailwindOffline>

    <!-- Your stylesheet: the one that says `@import "tailwindcss";` plus whatever you add. -->
    <RaskTailwindInput Condition="'$(RaskTailwindInput)' == ''">Styles/app.css</RaskTailwindInput>

    <!-- Where the generated CSS lands. Under wwwroot so the host serves it with no extra wiring. -->
    <RaskTailwindOutput Condition="'$(RaskTailwindOutput)' == ''">wwwroot/css/app.css</RaskTailwindOutput>

    <!-- Minify in Release only, so a Debug build stays readable in devtools. -->
    <RaskTailwindMinify Condition="'$(RaskTailwindMinify)' == '' AND '$(Configuration)' == 'Release'">true</RaskTailwindMinify>
    <RaskTailwindMinify Condition="'$(RaskTailwindMinify)' == ''">false</RaskTailwindMinify>

    <!--
      Where fetched binaries are cached: per user, shared by every project. Deliberately outside the
      repository — an 80 MB file in obj/ is re-downloaded by every clean and committed by somebody
      eventually.
    -->
    <RaskTailwindCacheRoot Condition="'$(RaskTailwindCacheRoot)' == '' AND '$(OS)' == 'Windows_NT'">$(LOCALAPPDATA)\rask\tailwind</RaskTailwindCacheRoot>
    <RaskTailwindCacheRoot Condition="'$(RaskTailwindCacheRoot)' == ''">$(HOME)/.rask/tailwind</RaskTailwindCacheRoot>
  </PropertyGroup>

  <!--
    Name the generated stylesheet as a LITERAL Content item, here, at evaluation — before it exists.

    The SDK globs `wwwroot/**` into @(Content) at evaluation time, which is before any target runs. The
    Tailwind build writes its output at BeforeBuild, so on the FIRST build in a clone that glob cannot
    have matched it. For an app (Sdk.Web, Sdk.WebAssembly) that turns out not to matter: static-web-asset
    discovery re-enumerates during the build and picks the file up anyway. For a RAZOR CLASS LIBRARY it
    matters completely — the RCL's assets come from the evaluated @(Content), so a file generated later
    never enters its manifest and never reaches the consuming app's publish.

    That is not a theory. It shipped: from #914 (Tailwind built in, Bootstrap gone) until this change,
    every CI deploy of the docs showcase served `_content/Rask.Example.Shared/css/app.css` as a 404 and
    rendered the whole site unstyled, while a committed file two directories away in the same wwwroot
    served fine. It was invisible locally because a previous build always left the file on disk, so the
    glob matched and every local publish — and every local E2E — was correct.

    A literal Include is the fix because it does not consult the disk at evaluation. The item exists
    regardless; the file is only required when it is COPIED, which is after the generating target has
    run. This is the same distinction #852 turned on for pack, applied to the other side of it: there, a
    glob silently collected nothing and shipped a package without its task assembly.

    Guarded on !Exists so the second build — where the glob DOES match — does not declare it twice.
    Guarded on the input existing so projects with no stylesheet (a class library, a test project, the
    static-file half of a hosted WASM app) declare nothing, exactly as _RaskTailwindDoBuild decides.
  -->
  <ItemGroup Condition=" '$(RaskTailwindOutput)' != ''
                         AND Exists('$(MSBuildProjectDirectory)/$(RaskTailwindInput)')
                         AND !Exists('$(MSBuildProjectDirectory)/$(RaskTailwindOutput)') ">
    <Content Include="$(RaskTailwindOutput)"/>
  </ItemGroup>

</Project>
