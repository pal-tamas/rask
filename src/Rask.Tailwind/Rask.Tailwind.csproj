<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- No code of its own: this project IS the props/targets pair plus the task assembly. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!--
      NOT a package. Tailwind is built into the host packages: src\RaskTailwindBuildPack.targets packs
      the props, the targets and the task assembly below into Rask.Server and Rask.Wasm, and each of
      those imports them from its own build/<PackageId>.{props,targets}.

      Publishing this as a package as well would be actively harmful, not merely redundant: an app that
      referenced both would import the same targets twice and run the Tailwind compiler twice over one
      output file. Rask.Core and Rask.Html are IsPackable=false for the same reason. Guarded by
      PackageDependencyTests.

      What is left here is a build-order shim: this project exists so that Rask.Tailwind.Tasks has
      somewhere to drop its assembly (build/, below) and so the files have one home to be packed FROM.
    -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Build-order-only edge to the task project, which drops Rask.Tailwind.Tasks.dll into build/ here
      (CopyTaskAssemblyToRaskTailwindBuild) for <UsingTask> to load and for RaskTailwindBuildPack to
      pack into the host packages. Same arrangement as Rask.Wasm/Rask.Wasm.Tasks and
      Rask.Spa.Hosting/Rask.Spa.Tasks.
    -->
    <ProjectReference Include="..\Rask.Tailwind.Tasks\Rask.Tailwind.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
  </ItemGroup>

</Project>
