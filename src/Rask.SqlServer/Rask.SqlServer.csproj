<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.SqlServer</PackageId>
    <Title>Rask.SqlServer — production SQL Server for EF Core</Title>
    <Description>SQL Server for .NET apps on Entity Framework Core: `UseRaskSqlServer(...)` is a drop-in replacement for `UseSqlServer` that applies `SET XACT_ABORT ON` and a `LOCK_TIMEOUT` on every connection the context opens, sets a client command timeout, turns on transient-failure retrying, and fits Rask's cache key inside SQL Server's index key limit. SQLite stays Rask's default; this is for when SQL Server is the house database.</Description>
    <!-- Override the framework default tags (web/component/wasm) — a standalone data-layer helper. -->
    <PackageTags>sqlserver mssql azure-sql database entity-framework-core efcore interceptor dotnet net11</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    <!-- Lifts the vulnerable transitive copy; see Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs"/>
  </ItemGroup>

  <!-- UseRaskSqlServer(services) binds Rask:SqlServer and reads Rask:ConnectionStrings:App. The configuration binding
       source generator writes the bind at compile time, so no reflection binder runs. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Rask.Hosting.Shared\RaskOptionsRegistration.cs" Link="Shared\RaskOptionsRegistration.cs"/>
    <!-- Rask's migrations differ, registered by RaskSqlServerOptionsExtension. Linked, since this package does not
         reference Rask.Data; internal in both, so an app holding both sees neither. -->
    <Compile Include="..\Rask.Data\RaskMigrationsModelDiffer.cs" Link="Shared\RaskMigrationsModelDiffer.cs"/>
    <!-- The differ's constraint renames: Rask's pk_/fk_/uq_ names over an existing database. -->
    <Compile Include="..\Rask.Data\ConstraintRenames.cs" Link="Shared\ConstraintRenames.cs"/>
    <Compile Include="..\Rask.Data\CaseOnlyRenames.cs" Link="Shared\CaseOnlyRenames.cs"/>
    <!-- The one-time rewrite the differ emits when the model starts storing its uniqueidentifier columns by time. -->
    <Compile Include="..\Rask.Data\GuidOrderRewrite.cs" Link="Shared\GuidOrderRewrite.cs"/>
    <Compile Include="..\Rask.Data\SqlServerGuidOrder.cs" Link="Shared\SqlServerGuidOrder.cs"/>
    <!-- The convention that stores every uniqueidentifier by time, for a model Rask.Data's conventions did not build. -->
    <Compile Include="..\Rask.Data\SqlServerGuidOrderConvention.cs" Link="Shared\SqlServerGuidOrderConvention.cs"/>
    <Compile Include="..\Rask.Data\StoredGuidConverter.cs" Link="Shared\StoredGuidConverter.cs"/>
    <Compile Include="..\Rask.Data\ProviderNames.cs" Link="Shared\ProviderNames.cs"/>
    <Compile Include="..\Rask.Data\ExclusiveMigrations.cs" Link="Shared\ExclusiveMigrations.cs"/>
    <!-- The rebuild of a battery table whose key turns from a store-numbered integer into a Guid. -->
    <Compile Include="..\Rask.Data\StoreKeyRebuild.cs" Link="Shared\StoreKeyRebuild.cs"/>
    <Compile Include="..\Rask.Data\StoreKeyRebuildOperations.cs" Link="Shared\StoreKeyRebuildOperations.cs"/>
    <Compile Include="..\Rask.Data\StoreKeyRebuildSql.cs" Link="Shared\StoreKeyRebuildSql.cs"/>
    <!-- An optional value object whose members are all optional, held in its row's columns (RaskSqlServerModelValidator). -->
    <Compile Include="..\Rask.Data\OptionalComplexValues.cs" Link="Shared\OptionalComplexValues.cs"/>
    <Compile Include="..\Rask.Data\TenantReference.cs" Link="Shared\TenantReference.cs"/>
    <!-- The triggers b.NoOverlap(…) is held by, which the differ adds to a migration. -->
    <Compile Include="..\Rask.Data\NoOverlapRule.cs" Link="Shared\NoOverlapRule.cs"/>
    <Compile Include="..\Rask.Data\NoOverlapSql.cs" Link="Shared\NoOverlapSql.cs"/>
    <!-- The rewrite of a column of moments from the wall clock to UTC, which the differ adds and the generator writes. -->
    <Compile Include="..\Rask.Data\MomentsInUtc.cs" Link="Shared\MomentsInUtc.cs"/>
    <!-- The zone in every compiled query's cache key, as a moment's day writes it into the SQL. -->
    <Compile Include="..\Rask.Data\ZonedQueryCacheKeys.cs" Link="Shared\ZonedQueryCacheKeys.cs"/>
    <!-- end - start between two dates in a query, which SQL Server's own provider does not translate. -->
    <Compile Include="..\Rask.Data\QueryDuration.cs" Link="Shared\QueryDuration.cs"/>
    <Compile Include="..\Rask.Data\DurationTranslation.cs" Link="Shared\DurationTranslation.cs"/>
  </ItemGroup>

  <!-- Clock.Zone: the app's zone, which a moment's rewrite to UTC and its day on the wall calendar are read in. -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Wire\Rask.Wire.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.SqlServer.Tests"/>
  </ItemGroup>

</Project>
