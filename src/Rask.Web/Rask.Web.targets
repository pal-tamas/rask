<Project>
  <!--
    Rask.Web is generated from the same MDN snapshot as Rask.Core's elements (src/Rask.Core/Dom/mdn.snapshot.json,
    which Rask.Core's build keeps on MDN's latest stable data). Before the compile, RaskWebEmit writes MDN's globals
    and interfaces into obj/. Nothing it writes is committed. Imported by Rask.Web.csproj and, with RaskWebWasm=true,
    by Rask.Wasm.csproj, which gets what only WebAssembly can run (src/Rask.Dom.Tasks/WebHost.cs).
  -->
  <PropertyGroup>
    <RaskWebWasm Condition="'$(RaskWebWasm)' == ''">false</RaskWebWasm>
    <RaskMdnSnapshot>$(MSBuildThisFileDirectory)..\Rask.Core\Dom\mdn.snapshot.json</RaskMdnSnapshot>
    <RaskDomTasksAssembly>$(MSBuildThisFileDirectory)..\Rask.Dom.Tasks\bin\$(Configuration)\netstandard2.0\Rask.Dom.Tasks.dll</RaskDomTasksAssembly>
    <RaskWebOutput>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\web\</RaskWebOutput>
  </PropertyGroup>

  <UsingTask TaskName="Rask.Core.Dom.Build.RaskWebEmit" AssemblyFile="$(RaskDomTasksAssembly)" TaskFactory="TaskHostFactory"/>

  <!-- Before the SDK hashes @(Compile) into CoreCompileInputs.cache, the only thing that notices a generated file going away. -->
  <Target Name="_RaskWebEmit" BeforeTargets="_GenerateCompileDependencyCache;CoreCompile" DependsOnTargets="ResolveProjectReferences;_RaskWebEmitCore">
    <ItemGroup>
      <Compile Include="$(RaskWebOutput)*.g.cs" Exclude="@(Compile)"/>
      <FileWrites Include="$(RaskWebOutput)*.g.cs"/>
    </ItemGroup>
  </Target>

  <Target Name="_RaskWebEmitCore" Inputs="$(RaskMdnSnapshot);$(RaskDomTasksAssembly)" Outputs="$(RaskWebOutput).stamp">
    <RaskWebEmit Snapshot="$(RaskMdnSnapshot)" OutputDirectory="$(RaskWebOutput)" Wasm="$(RaskWebWasm)"/>
    <Touch Files="$(RaskWebOutput).stamp" AlwaysCreate="true"/>
  </Target>
</Project>
