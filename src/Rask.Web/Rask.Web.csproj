<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAotCompatible Condition="'$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browser'">true</IsAotCompatible>

    <PackageId>Rask.Web</PackageId>
    <Title>Rask.Web — every web API, from MDN, in C#</Title>
    <Description>Every web API the browser ships, generated from MDN's own data for Rask: MDN's globals and interfaces in C# (await Navigator.Clipboard.WriteText("hi"), await Window.MatchMedia(query).Matches), each chain run in one round trip, on the server host over its socket and in WebAssembly in-process. Members are MDN's names with no Async suffix, their doc comments carry browser support and links to MDN, and an object you keep is a disposable handle.</Description>
    <PackageTags>web-api mdn browser dom javascript-interop navigator clipboard geolocation webassembly blazor-alternative dotnet net10 net11</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md"/>
    <None Remove="NUGET.md"/>
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj"/>

    <!-- Builds the MDN emitter Rask.Web.targets runs, first; an ordering edge only, never shipped. -->
    <ProjectReference Include="..\Rask.Dom.Tasks\Rask.Dom.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Rask.Wasm declares what only WebAssembly runs, over these proxies' chains. -->
    <InternalsVisibleTo Include="Rask.Wasm"/>
  </ItemGroup>

  <Import Project="Rask.Web.targets"/>
</Project>
