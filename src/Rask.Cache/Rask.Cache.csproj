<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Cache</PackageId>
    <Title>Rask.Cache — a developer-facing cache on your database</Title>
    <Description>A developer-facing cache for a Rask app, stored in its own database — no broker, no Redis. Implements the standard `IDistributedCache` (so it drops into ASP.NET session and output caching), plus a typed `ICache` convenience layer with `GetOrCreateAsync&lt;T&gt;`. Entries carry absolute and sliding expirations; a background `CachePurger` sweeps expired rows. Server-side; pairs with EF Core and SQLite.</Description>
    <!-- Override the framework default tags (web/component/wasm) — a standalone server-side cache. -->
    <PackageTags>cache distributed-cache idistributedcache entity-framework-core efcore background-service sqlite dotnet net10 net11</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <!-- CacheOptions binds Rask:Cache. The configuration binding source generator writes that bind at compile time,
       so no reflection binder runs; the SDK leaves it off unless a project asks. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!-- The boot-time "is this battery mapped?" check and the options registration, source-linked rather than
       referenced: the batteries share no common assembly, and this project deliberately has no Rask dependency
       at all. -->
  <ItemGroup>
    <Compile Include="..\Rask.Batteries.Shared\BatteryModelCheck.cs" Link="Shared\BatteryModelCheck.cs"/>
    <Compile Include="..\Rask.Hosting.Shared\RaskOptionsRegistration.cs" Link="Shared\RaskOptionsRegistration.cs"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Cache.Tests"/>
  </ItemGroup>

  <!-- Ship the global `using Rask.Cache;` to downstream consumers. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
  </ItemGroup>

</Project>
