<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Rask.Templates</PackageId>
    <Title>Rask Templates</Title>
    <Description>Project templates for the Rask framework — server-side, standalone browser-WASM, WASM-hosted, and native iOS/Android scenarios. Provides `rask-server`, `rask-wasm`, `rask-wasm-hosted`, and `rask-native` via `dotnet new`.</Description>
    <PackageTags>dotnet-new;templates;rask;web;wasm;mobile;ios;android;net10</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!--
      A template pack has no assembly output, so there are no debug symbols
      to ship. Directory.Build.props turns symbols on globally; override here
      otherwise NuGet attempts to build an empty .snupkg and fails with NU5017.
    -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!--
      Hook the staging target into NuGet pack via the canonical
      TargetsForTfmSpecificContentInPackage extension point. Items added to
      TfmSpecificPackageFile inside the hooked target flow directly into
      _PackageFiles (see NuGet.Build.Tasks.Pack.targets), so they reach both
      the .nupkg zip and the .nuspec metadata that PackTask validates against.
    -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_RaskStageTemplates</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**/*"/>
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <UsingTask TaskName="RaskReplaceInFile"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true"/>
      <OldValue ParameterType="System.String" Required="true"/>
      <NewValue ParameterType="System.String" Required="true"/>
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = System.IO.File.ReadAllText(FilePath);
        var replaced = text.Replace(OldValue, NewValue);
        if (replaced != text) System.IO.File.WriteAllText(FilePath, replaced);
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Stage content/ to obj/.../templates/, rewrite the RASK_PKG_VERSION
    placeholder in every staged csproj with the MinVer-resolved
    $(PackageVersion), then expose the staged tree to pack as
    TfmSpecificPackageFile items rooted under content/.
  -->
  <Target Name="_RaskStageTemplates" DependsOnTargets="MinVer">
    <PropertyGroup>
      <_RaskStageDir>$(IntermediateOutputPath)templates\</_RaskStageDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_RaskStageDir)" Condition="Exists('$(_RaskStageDir)')"/>
    <ItemGroup>
      <_RaskSourceContent Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**"/>
    </ItemGroup>
    <Copy SourceFiles="@(_RaskSourceContent)"
          DestinationFiles="@(_RaskSourceContent->'$(_RaskStageDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"/>
    <ItemGroup>
      <_RaskStagedCsproj Include="$(_RaskStageDir)**\*.csproj"/>
    </ItemGroup>
    <RaskReplaceInFile FilePath="%(_RaskStagedCsproj.FullPath)"
                       OldValue="RASK_PKG_VERSION"
                       NewValue="$(PackageVersion)"/>
    <ItemGroup>
      <_RaskStagedAll Include="$(_RaskStageDir)**\*"/>
      <!--
        Files with an extension: NuGet treats a PackagePath that has a file extension as a full
        file path, so give it the complete content/-rooted path.
      -->
      <TfmSpecificPackageFile Include="@(_RaskStagedAll)" Condition="'%(_RaskStagedAll.Extension)' != ''">
        <PackagePath>content/%(_RaskStagedAll.RecursiveDir)%(_RaskStagedAll.Filename)%(_RaskStagedAll.Extension)</PackagePath>
      </TfmSpecificPackageFile>
      <!--
        Extensionless files (the templates' Dockerfiles): NuGet treats a PackagePath WITHOUT an
        extension as a directory and copies the file into it under its own RecursiveDir + name — so a
        full path would double the folder (content/rask-server/Dockerfile/rask-server/Dockerfile).
        Point at the content root instead and let NuGet append RecursiveDir + filename itself.
      -->
      <TfmSpecificPackageFile Include="@(_RaskStagedAll)" Condition="'%(_RaskStagedAll.Extension)' == ''">
        <PackagePath>content</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
