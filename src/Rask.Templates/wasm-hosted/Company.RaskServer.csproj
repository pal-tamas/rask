<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- rask:if cqrs data -->
    <!-- The litestream binary ships in the Docker image, not fetched at build time. -->
    <RaskLitestreamDownload>false</RaskLitestreamDownload>
    <!-- rask:end -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The host and every battery, and what serves the browser app in Client/ beside the endpoints it calls.
         A battery this app does without is switched off in Program.cs. -->
    <PackageReference Include="Rask.Server" Version="{{RaskVersion}}"/>
    <!-- In-page devtools: present in a Debug build in Development, absent from a Release publish. -->
    <PackageReference Include="Rask.DevTools" Version="{{RaskVersion}}"/>
  </ItemGroup>

  <!--
    The browser app lives in Client/ (and what both halves share in Shared/). Its project is generated
    into obj/ from those folders — Client/Program.cs is what switches that on — so the references only the
    browser needs are declared here, and never reach this server.
  -->
  <ItemGroup>
    <RaskClientPackageReference Include="Rask.Ui" Version="{{RaskVersion}}"/>
    <!-- rask:if cqrs -->
    <RaskClientPackageReference Include="Rask.Cqrs.Client" Version="{{RaskVersion}}"/>
    <RaskClientPackageReference Include="Rask.Query" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
  </ItemGroup>

</Project>
