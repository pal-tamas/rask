<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The Razor Class Library holding this app's Blazor components. A separate project on purpose: a
    .razor compiled in the SAME project as the island that hosts it is generated during that same
    compilation, so Rask cannot read its [Parameter]s and generates no chain steps for them (RASK066).
    From a referenced library they come out of metadata and are checked.

    This is also where a third-party kit goes — MudBlazor, Radzen — if you add one: reference it here
    and host its components the same way.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Company.RaskServer.Components</RootNamespace>
  </PropertyGroup>

  <!--
    The package rather than the ASP.NET shared framework: a browser-WASM app has no shared framework to
    reference, and the same components build for both hosts this way.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12"/>
  </ItemGroup>

</Project>
