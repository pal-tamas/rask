<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      The one property that turns this lane on. It is named here rather than passed to
      AddRaskMeta() because the BUILD needs it anyway — to install, build and publish the right
      front end — and baking it into the assembly is what lets AddRaskMeta() take no argument and
      still be certain it is fronting the framework that was actually built.
    -->
    <RaskMetaFramework>tanstack-start</RaskMetaFramework>
    <!-- rask:if cqrs data -->
    <!-- The litestream binary ships in the Docker image, not fetched at build time. -->
    <RaskLitestreamDownload>false</RaskLitestreamDownload>
    <!-- rask:end -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rask.Cqrs" Version="{{RaskVersion}}"/>
    <PackageReference Include="Rask.Cqrs.Server" Version="{{RaskVersion}}"/>
    <!--
      Runs the front end's own toolchain during `dotnet build` (npm ci, npm run build), copies its
      output on publish, and supervises `node` beside Kestrel at runtime. Your C# message records
      are projected into TypeScript on every build, into src/rask/.
      -p:RaskMetaBuild=false skips node entirely — the app still compiles and its API still works.
    -->
    <PackageReference Include="Rask.Meta.Hosting" Version="{{RaskVersion}}"/>
    <PackageReference Include="Rask.Ui" Version="{{RaskVersion}}"/>
    <!-- rask:if cqrs data -->
    <PackageReference Include="Rask.Data" Version="{{RaskVersion}}"/>
    <PackageReference Include="Rask.SQLite.EntityFrameworkCore" Version="{{RaskVersion}}"/>
    <PackageReference Include="Rask.SQLite.Litestream" Version="{{RaskVersion}}"/>
    <PackageReference Include="Rask.Auth" Version="{{RaskVersion}}"/>
    <!-- rask:if outbox -->
    <PackageReference Include="Rask.Outbox" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if jobs -->
    <PackageReference Include="Rask.Jobs" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if mail -->
    <PackageReference Include="Rask.Mail" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if cache -->
    <PackageReference Include="Rask.Cache" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if snapshots -->
    <PackageReference Include="Rask.SQLite.Snapshots" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:end -->
    <!-- rask:if logs -->
    <PackageReference Include="Rask.Logging" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if cqrs data ops -->
    <PackageReference Include="Rask.Dashboard" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
  </ItemGroup>

</Project>
