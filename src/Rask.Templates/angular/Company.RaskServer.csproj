<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Angular nests its output under the project name. -->
    <RaskSpaDistDir>dist/company-raskserver-client/browser</RaskSpaDistDir>
    <RaskSpaDevServerUrl>http://localhost:4200</RaskSpaDevServerUrl>
    <!-- rask:if data -->
    <!-- The litestream binary ships in the Docker image, not fetched at build time. -->
    <RaskLitestreamDownload>false</RaskLitestreamDownload>
    <!-- rask:end -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rask.Cqrs" Version="{{RaskVersion}}"/>
    <PackageReference Include="Rask.Cqrs.Server" Version="{{RaskVersion}}"/>
    <!--
      Finds the Client folder in this project by convention (a `Client` directory holding a
      package.json), runs its install and build, writes the generated TypeScript
      contracts into its src/rask/, and copies the bundle into wwwroot on publish. Set
      RaskSpaClientDir to point somewhere else, or -p:RaskSpaBuild=false to skip node entirely —
      the API still works, and the site serves a page saying there is nothing built yet.
    -->
    <PackageReference Include="Rask.Spa.Hosting" Version="{{RaskVersion}}"/>
    <!-- rask:if data -->
    <PackageReference Include="Rask.Data" Version="{{RaskVersion}}"/>
    <PackageReference Include="Rask.SQLite.EntityFrameworkCore" Version="{{RaskVersion}}"/>
    <PackageReference Include="Rask.SQLite.Litestream" Version="{{RaskVersion}}"/>
    <!-- Accounts as JSON only. Rask.Auth is the same battery plus the built-in sign-in PAGES,
         which are Rask components — and this host renders none, so it carries no Rask.Core for
         them to render with. -->
    <PackageReference Include="Rask.Auth.Api" Version="{{RaskVersion}}"/>
    <!-- rask:if outbox -->
    <PackageReference Include="Rask.Outbox" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if jobs -->
    <PackageReference Include="Rask.Jobs" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if mail -->
    <PackageReference Include="Rask.Mail" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if cache -->
    <PackageReference Include="Rask.Cache" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if storage -->
    <PackageReference Include="Rask.Storage" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if snapshots -->
    <PackageReference Include="Rask.SQLite.Snapshots" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:end -->
    <!-- rask:if logs -->
    <PackageReference Include="Rask.Logging" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if push pwa -->
    <PackageReference Include="Rask.WebPush" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
  </ItemGroup>

</Project>
