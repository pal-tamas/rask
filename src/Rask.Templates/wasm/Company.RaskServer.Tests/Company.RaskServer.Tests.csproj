<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app's tests: `dotnet test` from the folder above runs them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 runs the tests as their own program; `dotnet test` drives it through VSTest. -->
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <!-- The app's own sources compile here too, and they expect its Routes class in its namespace. -->
    <RootNamespace>Company.RaskServer</RootNamespace>
    <!-- rask:if islands -->
    <!-- The home page renders the islands, so their C# half compiles here. Their front-end files are the
         app's to type and bundle: with no package.json here nothing is bundled, and this stops the
         prop-type step reporting each island as one this project will not build. -->
    <RaskExternalPropTypes>false</RaskExternalPropTypes>
    <!-- rask:end -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Renders a page in-process and drives it the way a person would. No browser, no server. -->
    <PackageReference Include="Rask.Testing" Version="{{RaskVersion}}"/>
    <PackageReference Include="Rask.Wasm" Version="{{RaskVersion}}"/>
    <PackageReference Include="Rask.Ui" Version="{{RaskVersion}}"/>
    <!-- rask:if islands -->
    <PackageReference Include="Rask.External" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if islands-blazor -->
    <PackageReference Include="Rask.Blazor" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1"/>
    <PackageReference Include="xunit.v3" Version="4.0.1"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Rask.Testing"/>
    <Using Include="Xunit"/>
  </ItemGroup>

  <!-- A browser app cannot be referenced from a test, so its C# is compiled here a second time, against
       Rask.Wasm's desktop build. Program.cs stays out: it boots the browser. -->
  <ItemGroup>
    <Compile Include="..\**\*.cs"
             Exclude="..\Company.RaskServer.Tests\**;..\**\bin\**;..\**\obj\**;..\**\node_modules\**;..\Program.cs"
             LinkBase="App"/>
  </ItemGroup>

  <!-- rask:if islands-blazor -->
  <ItemGroup>
    <!-- The Razor Class Library the Blazor island hosts its component from. -->
    <ProjectReference Include="..\Company.RaskServer.Components\Company.RaskServer.Components.csproj"/>
  </ItemGroup>
  <!-- rask:end -->

</Project>
