{
  // Rask's own settings for this browser app. The BUILD reads them, so a change needs a rebuild, and the file is
  // published with the app — anyone can read it, so it holds no secrets. Every section: docs/configuration.md.
  "Rask": {
    // The languages this app ships. The FIRST is the default a visitor falls back to; add an entry to ship
    // another, with a Resources/Strings.{culture}.json beside it. A language other than English ships the
    // culture data that formats it (ICU, roughly a megabyte) — see docs/localization.md.
    "Cultures": [ "en" ]
  }
}
