{
  "version": "2.0.0",
  "tasks": [
    {
      // The build F5 runs first. RaskDevSession=true is the same switch `rask dev` passes: islands and the
      // front end come from their dev servers instead of a production bundle, and the app knows to start
      // those dev servers itself.
      "label": "rask: build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Company.RaskServer.csproj",
        "--property:RaskDevSession=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
