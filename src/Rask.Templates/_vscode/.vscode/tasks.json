{
  "version": "2.0.0",
  "tasks": [
    {
      // The build F5 runs first. RaskDevSession=true is the same switch `rask dev` passes: the app knows it
      // runs in a dev session and prepares its https://<name>.test address itself.
      "label": "rask: build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Company.RaskServer.csproj",
        "--property:RaskDevSession=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
