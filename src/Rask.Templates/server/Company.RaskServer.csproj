<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- rask:if cqrs data -->
    <!-- The litestream binary ships in the Docker image, not fetched at build time. -->
    <RaskLitestreamDownload>false</RaskLitestreamDownload>
    <!-- rask:end -->
    <!-- The UI kit's compiled sheet as a cached file in wwwroot, rather than inlined in every
         document. Linked FIRST in Features/Shared/App.cs: it declares the @layer order. -->
    <RaskUiWriteStylesheet>true</RaskUiWriteStylesheet>
    <!-- daisyUI's plugin, copied beside Styles/app.css so this project compiles daisyUI itself.
         No npm and no node_modules: `dotnet build` is still the whole toolchain. -->
    <RaskUiWriteDaisyUiPlugin>true</RaskUiWriteDaisyUiPlugin>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host and every battery. A battery this app does without is switched off in Program.cs. -->
    <PackageReference Include="Rask.Server" Version="{{RaskVersion}}"/>
    <!-- In-page devtools: present in a Debug build in Development, absent from a Release publish. -->
    <PackageReference Include="Rask.DevTools" Version="{{RaskVersion}}"/>
    <!-- rask:if islands -->
    <!-- Islands: the base classes a .tsx/.vue/.svelte/.ts component derives from, plus the MSBuild
         layer that discovers each pair, generates its prop types and bundles it with Vite. -->
    <PackageReference Include="Rask.External" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
    <!-- rask:if islands-blazor -->
    <!-- A real Blazor component hosted as an ordinary Rask component. No npm side: the Razor SDK
         compiles the .razor and Rask renders it into the first response. -->
    <PackageReference Include="Rask.Blazor" Version="{{RaskVersion}}"/>
    <!-- rask:end -->
  </ItemGroup>

  <!-- rask:if islands-blazor -->
  <ItemGroup>
    <!-- The Razor Class Library holding this app's Blazor components. A separate project because a
         .razor compiled in THIS project is generated during this same compilation, so Rask cannot
         read its [Parameter]s and generates no chain steps for them (RASK066). -->
    <ProjectReference Include="Company.RaskServer.Components\Company.RaskServer.Components.csproj"/>
  </ItemGroup>
  <!-- rask:end -->

</Project>
