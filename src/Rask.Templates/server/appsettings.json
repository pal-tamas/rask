{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // Rask reports framework faults through these categories — a lifecycle hook that threw with
      // no ErrorBoundary above it, a duplicate sibling Key, a handler fault, a rejected WebSocket
      // frame. See docs/observability.md for the full table.
      "Rask.Lifecycle": "Warning",
      "Rask.Live": "Warning",
      "Rask.Diff": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Rask's own settings. Every battery reads its section here — Mail reads Rask:Mail, the host reads
  // Rask:Server and Rask:Culture — and every key has a default, so a section appears only when this app
  // sets something. An environment variable overrides any key with double underscores (Rask__Mail__From);
  // an app.Configure block in Program.cs overrides both. Every section: docs/configuration.md.
  "Rask": {
    // The languages this app ships. The FIRST is the default a visitor falls back to; add an entry to
    // ship another, with a Resources/Strings.{culture}.json beside it.
    "Culture": {
      "SupportedCultures": [ "en" ]
    },
    // rask:if cqrs
    // rask:end
    "ConnectionStrings": {
      // rask:if cqrs data
      // A local file while developing. `rask deploy` sets Rask__ConnectionStrings__App to a path on a
      // mounted volume, so the database survives redeploys.
      "App": "Data Source=app.db",
      // rask:end
      // rask:if logs
      // The log store's own file, deliberately not the app's database: a line written while a transaction
      // fails must not roll back with it. Not covered by `rask db backup` or Litestream, and log lines can
      // hold secrets, so keep it on the same private volume (`rask deploy` does).
      "Logs": "Data Source=logs.db",
      // rask:end
    },
    // rask:if cqrs data
    "Sqlite": {
      // SQLite enforces each column's declared type instead of coercing whatever it is handed —
      // without it the text "lots" stores happily in an INTEGER column and surfaces as a cast error
      // much later. It applies to tables as they are created, so it costs nothing now and is awkward
      // to adopt once there is data. Drop it if you need a column type outside SQLite's
      // INT/INTEGER/REAL/TEXT/BLOB/ANY.
      "StrictTables": true
    },
    // Continuous backup is off until this names a replica — set it at deploy time with
    // rask deploy --env "Rask__Litestream__ReplicaUrl=s3://your-bucket/app" (docs/sqlite.md).
    "Litestream": {
      "ReplicaUrl": ""
    },
    // rask:if mail
    "Mail": {
      "From": "no-reply@example.com",
      // With no "Smtp" section, each message is written here as an .eml file you can open. To send
      // for real add "Smtp": { "Host": "…", "Port": 587, "User": "…" }, and put the password in
      // the environment (Rask__Mail__Smtp__Password), never in this committed file.
      "PickupDirectory": "mail-pickup"
    },
    // rask:end
    // rask:if snapshots
    "Snapshots": {
      "DestinationDirectory": "snapshots",
      "Interval": "06:00:00",
      "Retain": 7
    },
    // rask:end
    // rask:end
    // rask:if push pwa
    // Who a push service contacts if this app misbehaves.
    //
    // The VAPID key pair is NOT here, and must never be: the private key signs every push this app
    // sends. `rask new` minted a development pair into appsettings.Development.json, which the
    // .gitignore beside this file keeps out of the repository — that file is where to look, and
    // VapidKeys.Generate() is how to mint another if it goes missing.
    //
    // Deployed, both keys come from the environment instead, which is what `rask deploy --env` sets:
    // Rask__WebPush__VapidKeys__PublicKey and Rask__WebPush__VapidKeys__PrivateKey. Use a pair of its
    // own there; replacing a pair unsubscribes everyone already subscribed to the old one.
    "WebPush": {
      "Subject": "mailto:admin@example.com"
    },
    // rask:end
  }
}
