{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // Rask reports framework faults through these categories — a lifecycle hook that threw with
      // no ErrorBoundary above it, a duplicate sibling Key, a handler fault, a rejected WebSocket
      // frame. See docs/observability.md for the full table.
      "Rask.Lifecycle": "Warning",
      "Rask.Live": "Warning",
      "Rask.Diff": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Rask's own settings. Every call in Program.cs reads its section here — AddRaskMail reads Rask:Mail,
  // AddRask reads Rask:Server and Rask:Culture — and every key has a default, so a section appears only
  // when this app sets something. An environment variable overrides any key with double underscores
  // (Rask__Mail__From); a callback in Program.cs overrides both. Every section: docs/configuration.md.
  "Rask": {
    // The languages this app ships. The FIRST is the default a visitor falls back to; add an entry to
    // ship another, with a Resources/Strings.{culture}.json beside it.
    "Culture": {
      "SupportedCultures": [ "en" ]
    },
    // rask:if wasm
    // Lets a page that needs it move into WebAssembly, served from this project's own wwwroot.
    "Server": {
      "RenderModes": {
        "Wasm": true
      }
    },
    // rask:end
    // rask:if cqrs
    // rask:if wasm
    // rask:ifnot data
    // OFF because this app has no database, so it has no accounts to require — left on, every message
    // would answer 401 and nothing would work. Add --data (or a scheme of your own) and DELETE this:
    // the default is on for a reason, and a message reachable by anyone is a decision worth making.
    "Cqrs": {
      "Server": {
        "RequireAuthenticatedUser": false
      }
    },
    // rask:end
    // rask:end
    // rask:end
    "ConnectionStrings": {
      // rask:if cqrs data
      // A local file while developing. `rask deploy` sets Rask__ConnectionStrings__App to a path on a
      // mounted volume, so the database survives redeploys.
      "App": "Data Source=app.db",
      // rask:end
      // rask:if logs
      // The log store's own file — deliberately not the app's database (see Program.cs).
      "Logs": "Data Source=logs.db",
      // rask:end
    },
    // rask:if cqrs data
    "Sqlite": {
      // SQLite enforces each column's declared type instead of coercing whatever it is handed —
      // without it the text "lots" stores happily in an INTEGER column and surfaces as a cast error
      // much later. It applies to tables as they are created, so it costs nothing now and is awkward
      // to adopt once there is data. Drop it if you need a column type outside SQLite's
      // INT/INTEGER/REAL/TEXT/BLOB/ANY.
      "StrictTables": true
    },
    // Continuous backup is off until this names a replica — set it at deploy time with
    // rask deploy --env "Rask__Litestream__ReplicaUrl=s3://your-bucket/app" (docs/sqlite.md).
    "Litestream": {
      "ReplicaUrl": ""
    },
    // rask:if mail
    "Mail": {
      "From": "no-reply@example.com",
      // With no "Smtp" section, each message is written here as an .eml file you can open. To send
      // for real add "Smtp": { "Host": "…", "Port": 587, "User": "…" }, and put the password in
      // the environment (Rask__Mail__Smtp__Password), never in this committed file.
      "PickupDirectory": "mail-pickup"
    },
    // rask:end
    // rask:if snapshots
    "Snapshots": {
      "DestinationDirectory": "snapshots",
      "Interval": "06:00:00",
      "Retain": 7
    },
    // rask:end
    // rask:end
    // rask:if push pwa
    // Who a push service contacts if this app misbehaves. The key pair goes in user-secrets or the
    // environment (Rask__WebPush__VapidKeys__PublicKey / __PrivateKey), never in this committed file.
    "WebPush": {
      "Subject": "mailto:admin@example.com"
    },
    // rask:end
  }
}
