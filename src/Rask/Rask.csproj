<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      One package, both halves. A .nupkg is a folder per target framework plus a dependency list per
      target framework, so a `net10.0` project restores the server group and a `net10.0-browser` project
      restores the browser one — and the end user writes the same single PackageReference either way. The
      conditional ProjectReferences below become those groups in the generated nuspec.

      Rask.Core and Rask.Wasm already multi-target exactly like this, so the shape is the repo's, not new.
    -->
    <TargetFrameworks>$(RaskNetTargets);$(RaskBrowserTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rask</RootNamespace>

    <PackageId>Rask</PackageId>
    <Title>Rask — batteries included</Title>
    <Description>The one reference a Rask application needs, server or browser. On a server target (net10.0 or net11.0) it brings the ASP.NET host plus every battery — database (SQLite, PostgreSQL or SQL Server, picked by Rask:Database:Provider), mediator, background jobs, transactional email, cache, file storage, outbox, operator dashboard, durable logs, Web Push, and SQLite snapshots and continuous backup — with RaskApp.Create(args) as the entry point. On a browser target it brings the WebAssembly host, the source-generated mediator, the query cache and remote dispatch. Everything referenced is wired and on; app.Configure(c =&gt; c.Jobs.Off()) is how an app does without one. Reference Rask.Server for a lean host with no database.</Description>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == '' ">
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <!-- ApiValidationTests pins RaskApiValidation.ProblemType against the literal Rask.Cqrs.Server sends:
         the constant is what a client branches on, and nothing else stops the two drifting apart. -->
    <InternalsVisibleTo Include="Rask.Tests"/>
  </ItemGroup>

  <!-- build/Rask.props roots this assembly for the trimmer; without it the browser half is trimmed out
       of the bundle entirely and the batteries silently do nothing. A `build\**` glob has NO discovery
       pass behind it, so it can pack silently missing with exit 0 (#852) — PackagedBuildPropsTests reads
       the built .nupkg back to prove the file is really in there. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
  </ItemGroup>

  <!--
    Shared by both halves: the on/off switch itself is pure and has no host in it.
  -->
  <ItemGroup>
    <!-- PrivateAssets="all": Rask.Core is IsPackable=false and ships transitively inside the host
         packages' lib/, so listing it as a nuspec dependency would name a package on no feed. The same
         arrangement Rask.Dashboard and Rask.Mail use, guarded by PackageDependencyTests. -->
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj" PrivateAssets="all"/>
    <!--
      The devtools, on both faces. Referenced unconditionally because a package's dependency list cannot
      depend on the CONSUMER's configuration — restore is configuration-agnostic. What keeps them out of a
      Release publish is Rask.DevTools.targets, which arrives through buildTransitive/ for exactly this
      case: an app that names only `Rask`.
    -->
    <ProjectReference Include="..\Rask.DevTools\Rask.DevTools.csproj"/>
  </ItemGroup>

  <!--
    THE SERVER HALF. Declaring the batteries in one place rather than in every scaffolded csproj is what
    makes "batteries included" a property of the package instead of a property of whatever `rask new`
    happened to write — it stays true for an app somebody assembled by hand.

    Not PrivateAssets: a consumer must see these, since referencing Rask IS referencing all of them.
  -->
  <ItemGroup Condition=" '$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == '' ">
    <ProjectReference Include="..\Rask.Server\Rask.Server.csproj"/>

    <ProjectReference Include="..\Rask.Cqrs\Rask.Cqrs.csproj"/>
    <ProjectReference Include="..\Rask.Query\Rask.Query.csproj"/>
    <ProjectReference Include="..\Rask.Data\Rask.Data.csproj"/>
    <ProjectReference Include="..\Rask.SQLite.EntityFrameworkCore\Rask.SQLite.EntityFrameworkCore.csproj"/>
    <!-- The other databases Rask:Database:Provider can name. Bundled rather than left to the app so switching is a
         configuration edit and nothing else: UseRaskDatabase(sp) calls these directly, with no reflection. -->
    <ProjectReference Include="..\Rask.Postgres\Rask.Postgres.csproj"/>
    <ProjectReference Include="..\Rask.SqlServer\Rask.SqlServer.csproj"/>

    <ProjectReference Include="..\Rask.Auth\Rask.Auth.csproj"/>

    <!--
      HTTP endpoints. Rask.Api carries the hosting and the client generator; Rask.Api.Client carries the
      runtime the generated client calls, and belongs in BOTH halves — a component that calls its own
      API renders on the server as well as in the browser.
    -->
    <ProjectReference Include="..\Rask.Api\Rask.Api.csproj"/>
    <ProjectReference Include="..\Rask.Api.Client\Rask.Api.Client.csproj"/>

    <ProjectReference Include="..\Rask.Jobs\Rask.Jobs.csproj"/>
    <ProjectReference Include="..\Rask.Mail\Rask.Mail.csproj"/>
    <ProjectReference Include="..\Rask.Cache\Rask.Cache.csproj"/>
    <ProjectReference Include="..\Rask.Storage\Rask.Storage.csproj"/>
    <ProjectReference Include="..\Rask.Outbox\Rask.Outbox.csproj"/>

    <ProjectReference Include="..\Rask.Dashboard\Rask.Dashboard.csproj"/>
    <!-- Named explicitly even though Rask.Dashboard already brings it: the kit is the framework's own
         component vocabulary and an app is meant to build with it, not merely inherit it from the
         console it happens to mount. -->
    <ProjectReference Include="..\Rask.Ui\Rask.Ui.csproj"/>
    <ProjectReference Include="..\Rask.Logging\Rask.Logging.csproj"/>
    <ProjectReference Include="..\Rask.WebPush\Rask.WebPush.csproj"/>

    <!-- DataAnnotations needs no reference at all — it is in Rask.Core, which every host bundles. This
         is the other half: an AbstractValidator<T> in the app is discovered and wired by the generator
         that ships in the host's analyzer payload. -->
    <ProjectReference Include="..\Rask.Validation.FluentValidation\Rask.Validation.FluentValidation.csproj"/>

    <ProjectReference Include="..\Rask.SQLite.Snapshots\Rask.SQLite.Snapshots.csproj"/>
    <ProjectReference Include="..\Rask.SQLite.Litestream\Rask.SQLite.Litestream.csproj"/>
  </ItemGroup>

  <!--
    THE BROWSER HALF, and what it deliberately leaves out.

    Rask.Data, Rask.SQLite.Browser and Rask.Jobs all need EF Core, and EF CORE DOES NOT SURVIVE THE
    TRIMMER IN THE BROWSER — Rask.SQLite.Browser's own readme says so, and the showcase publishes
    trimmed at 3.28 MB brotli. Putting them in this group would force PublishTrimmed=false on every WASM
    app, and the cost would be paid by every visitor on first load, including apps with no database at
    all. A local-first app references those three itself and accepts the untrimmed build knowingly.

    What is here is source-generated and reflection-free, so the bundle stays trimmed.

    Validation is the one deliberate exception, and it is a measured one rather than an assumption: the
    WASM showcase has published FluentValidation at TrimMode=full with zero IL warnings since long
    before it was a battery. A form is the same component on both hosts, so leaving it out here would
    mean a shared component library whose rules run on the server and silently do not in the browser —
    the failure this repo treats as its worst.
  -->
  <ItemGroup Condition=" '$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browser' ">
    <ProjectReference Include="..\Rask.Wasm\Rask.Wasm.csproj"/>
    <ProjectReference Include="..\Rask.Cqrs\Rask.Cqrs.csproj"/>
    <ProjectReference Include="..\Rask.Query\Rask.Query.csproj"/>
    <ProjectReference Include="..\Rask.Auth.Client\Rask.Auth.Client.csproj"/>
    <ProjectReference Include="..\Rask.Cqrs.Client\Rask.Cqrs.Client.csproj"/>
    <!--
      The client runtime, but NOT Rask.Api: that one carries MVC and the generator, which belong to the
      half that answers endpoints rather than the half that calls them. The generated client itself
      arrives as a baked file, not from a package.
    -->
    <ProjectReference Include="..\Rask.Api.Client\Rask.Api.Client.csproj"/>
    <ProjectReference Include="..\Rask.Validation.FluentValidation\Rask.Validation.FluentValidation.csproj"/>
    <!-- The kit is on BOTH faces, unlike the console it was extracted from. Rask.Dashboard is
         server-only because its panels read a DbContext; this is markup, and the browser is where the
         surfaces that need it most run. -->
    <ProjectReference Include="..\Rask.Ui\Rask.Ui.csproj"/>
  </ItemGroup>

  <!-- RaskApp needs WebApplicationBuilder, so the server files compile into the server half only. -->
  <ItemGroup Condition=" '$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browser' ">
    <Compile Remove="RaskApp.cs"/>
    <Compile Remove="RaskAppOptions.cs"/>
    <Compile Remove="RaskAppDbContext.cs"/>
    <Compile Remove="RaskBatteryWiring.cs"/>
    <Compile Remove="RaskDatabase.cs"/>
    <!-- Endpoint and MVC filters: ASP.NET hosting types, so the server half only. -->
    <Compile Remove="ApiValidation.cs"/>
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == '' ">
    <Compile Remove="Browser\**\*.cs"/>
  </ItemGroup>

</Project>
