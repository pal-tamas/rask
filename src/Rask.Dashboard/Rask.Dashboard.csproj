<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Server-only: every panel reads the application's DbContext, and a WASM app has no database.
         Single-targeted (no net10.0-browser) so that constraint is enforced by the compiler. -->
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Dashboard</PackageId>
    <Title>Rask — Batteries Dashboard</Title>
    <Description>A built-in operator dashboard for the Rask One Person Framework batteries. Mounts at /_rask and shows the outbox, background jobs, queued mail, cache and stored files from the application's own database — queue depth, dead letters, the errors behind them, stored email previews, the recurring-job schedule, SQLite pragmas and backup status. A live log tail is built in, and becomes a searchable history when Rask.Logging is installed. Panels appear only for the batteries the app actually registered. Protected by an authorization policy that fails closed outside Development.</Description>
    <PackageTags>dotnet csharp aspnetcore net10 dashboard ops admin observability jobs outbox mail cache sqlite</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Dashboard.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="all": Rask.Core is IsPackable=false and ships transitively from the host
         packages (Rask.Server), so listing it as a nuspec dependency would reference a package that
         exists on no feed and make Rask.Dashboard unrestorable. Guarded by PackageDependencyTests. -->
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj"/>

    <!-- The component kit the console is drawn with — every page. A real package dependency, not
         PrivateAssets: the types are Rask.Ui's and an app restoring Rask.Dashboard has to be able to
         resolve them. Its styles are compiled into the console's own sheet, below. -->
    <ProjectReference Include="..\Rask.Ui\Rask.Ui.csproj"/>

    <!-- Build-order edge only: it puts Rask.Tailwind.Tasks.dll in Rask.Tailwind's build/ folder before
         the import loads it with <UsingTask>. Nothing is referenced and nothing flows. UndefineProperties
         because this project's inner build hands TargetFramework to everything it references, and
         Rask.Tailwind is netstandard2.0 (NETSDK1005) — as in Rask.Ui. -->
    <ProjectReference Include="..\Rask.Tailwind\Rask.Tailwind.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework"/>

    <!-- The panels read these packages' entity types directly. Referencing all four is what lets a
         single package light up whichever batteries an app registered, with no glue from the caller. -->
    <ProjectReference Include="..\Rask.Cache\Rask.Cache.csproj"/>
    <ProjectReference Include="..\Rask.Jobs\Rask.Jobs.csproj"/>
    <ProjectReference Include="..\Rask.Logging\Rask.Logging.csproj"/>
    <ProjectReference Include="..\Rask.Mail\Rask.Mail.csproj"/>
    <ProjectReference Include="..\Rask.Outbox\Rask.Outbox.csproj"/>
    <ProjectReference Include="..\Rask.Storage\Rask.Storage.csproj"/>

    <!-- Emits this assembly's own Generated.* factories and the __RaskRoutesRegistry module
         initializer that registers the dashboard's [Route] pages into the host's RouteRegistry. -->
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    THE CONSOLE'S OWN STYLESHEET, with the kit compiled in — one sheet, as an app has.

    The console owns its whole document, so it takes the kit the way an app does: Styles/dashboard.css
    imports the kit's Tailwind sources (written into Styles/vendor/ by Rask.Ui's targets) and this
    project's Tailwind build compiles them beside whatever class a page here writes. It used to inline the
    kit's precompiled sheet, which carries only what the KIT's sources name — so a utility written in a
    console page would have been a correct class in the markup naming a rule that exists nowhere.

    Compiled into obj/ and embedded: nothing serves a file out of this package (DashboardStylesheet).

    Conditioned on an inner build, and embedded from a target rather than a static item, for the two
    reasons Rask.Ui.csproj records beside the same lines: the TFM-less outer pass would name
    `obj//dashboard.generated.css`, and a static item is evaluated before the sheet exists on a clean
    clone, so the first package would ship with no stylesheet at all (#916).
  -->
  <PropertyGroup Condition=" '$(TargetFramework)' != '' ">
    <RaskTailwindInput>Styles/dashboard.css</RaskTailwindInput>
    <RaskTailwindOutput>obj/$(TargetFramework)/dashboard.generated.css</RaskTailwindOutput>
    <RaskTailwindMinify>true</RaskTailwindMinify>
  </PropertyGroup>

  <Target Name="EmbedRaskDashboardStylesheet"
          AfterTargets="_RaskTailwindBuild"
          BeforeTargets="PrepareResourceNames"
          Condition=" '$(TargetFramework)' != '' AND '$(DesignTimeBuild)' != 'true' ">
    <Error Condition="!Exists('$(RaskTailwindOutput)')"
           Text="Rask.Dashboard: $(RaskTailwindOutput) was not produced. The console's stylesheet is compiled by _RaskTailwindBuild from $(RaskTailwindInput) and embedded here; shipping without it renders every console page unstyled."/>
    <ItemGroup>
      <EmbeddedResource Include="$(RaskTailwindOutput)" LogicalName="Rask.Dashboard.dashboard.css"/>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
    <!-- The system panel reads SQLite PRAGMAs through the open DbConnection. Relational (not a provider)
         is what exposes DatabaseFacade.GetDbConnection; every app with a relational provider already has
         it, and depending on it here keeps the dashboard provider-agnostic. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
    <!-- The dashboard defines its own authorization policy default, so it references authorization
         directly rather than relying on Rask.Core's (PrivateAssets) transitive reference. -->
    <PackageReference Include="Microsoft.AspNetCore.Authorization"/>
    <!-- OpsOptions binds Rask:Ops. Named here because this package takes no FrameworkReference. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Rask.Hosting.Shared\RaskOptionsRegistration.cs" Link="Shared\RaskOptionsRegistration.cs"/>
  </ItemGroup>

  <!-- The configuration binding source generator writes the Rask:Ops bind at compile time, so no
       reflection binder runs; the SDK leaves it off unless a project asks. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

</Project>
