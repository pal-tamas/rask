<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Postgres</PackageId>
    <Title>Rask.Postgres — production PostgreSQL for EF Core</Title>
    <Description>PostgreSQL for a Rask app: `UseRaskPostgres(...)`, a drop-in replacement for `UseNpgsql` that registers a `ConnectionOpened` interceptor applying the production session settings (`statement_timeout`, `lock_timeout`, `idle_in_transaction_session_timeout`) to every connection the context opens, and turns on transient-failure retrying. SQLite remains Rask's default; this is the door out when one box is no longer enough. Unlike Rask.SQLite there is no separate raw-ADO package — Npgsql already provides the pooling and transient-retry that Rask.SQLite had to add by hand.</Description>
    <!-- Override the framework default tags (web/component/wasm) — a standalone data-layer helper. -->
    <PackageTags>postgres postgresql npgsql entity-framework-core efcore interceptor dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Update="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Postgres.Tests"/>
  </ItemGroup>

</Project>
