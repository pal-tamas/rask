<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(RaskNetTargets)</TargetFrameworks>
    <!-- Npgsql's release-candidate EF Core 11 provider pins EF Core exactly; see the references below. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Postgres</PackageId>
    <Title>Rask.Postgres — production PostgreSQL for EF Core</Title>
    <Description>PostgreSQL for .NET apps on Entity Framework Core: `UseRaskPostgres(...)` is a drop-in replacement for `UseNpgsql` that applies the production session settings (`statement_timeout`, `lock_timeout`, `idle_in_transaction_session_timeout`) to every connection the context opens and turns on Npgsql's transient-failure retrying. It also implements Rask.Data's full-text search (`HasFullTextSearch`, `Search(text)`, `FullText.Highlight`/`Snippet`) on a stored generated tsvector column with a GIN index, ranked by `ts_rank_cd`. SQLite stays Rask's default; this is the door out when one box is no longer enough.</Description>
    <!-- Override the framework default tags (web/component/wasm) — a standalone data-layer helper. -->
    <PackageTags>postgres postgresql npgsql database entity-framework-core efcore interceptor dotnet net11</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Npgsql's EF Core 11 provider is a release candidate (11.0.0-rc.3) that pins EF Core to EXACTLY its own rc.3
      build. The two direct references lift EF Core to the 11.0.0 release the rest of Rask is on (a direct reference
      is nearest, so it wins), which turns the NU1107 conflict into the NU1608 warning "outside the dependency
      constraint", silenced below and in tests/Directory.Build.props: a release candidate is API-frozen against its
      GA. An app that adds this package sees the same NU1608 (docs/data-access.md). All of it goes with the move to
      Npgsql's stable provider: the two references, the NoWarns, RaskPostgresPreRelease, and Rask.Server bundles
      this package again.
    -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
  </ItemGroup>

  <!-- UseRaskPostgres(services) binds Rask:Postgres and reads Rask:ConnectionStrings:App. The configuration binding
       source generator writes the bind at compile time, so no reflection binder runs. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Rask.Hosting.Shared\RaskOptionsRegistration.cs" Link="Shared\RaskOptionsRegistration.cs"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Postgres.Tests"/>
  </ItemGroup>

  <!-- HasFullTextSearch's declaration and markers live in Rask.Data; this package implements them on PostgreSQL. -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Data\Rask.Data.csproj"/>
  </ItemGroup>

  <!--
    HELD AS A RELEASE CANDIDATE while Npgsql.EntityFrameworkCore.PostgreSQL, the EF Core 11 provider this package rides on,
    is one. A stable tag (v0.24.0) packs this package as 0.24.0-rc.1 and every other package as 0.24.0, so nothing
    stable depends on a prerelease (NU5104) — Rask.Server no longer references it; a Postgres app adds it. A nightly
    is a prerelease already and keeps MinVer's version. Goes away with the move to Npgsql's stable provider, together
    with the NU1608 NoWarn above and Rask.Server's PostgresLoader (which becomes a reference again): PostgresHoldTests
    fails the day Directory.Packages.props pins a stable Npgsql while this property is still set (#1320).
  -->
  <PropertyGroup>
    <RaskPostgresPreRelease>rc.1</RaskPostgresPreRelease>
  </PropertyGroup>

  <Target Name="RaskPostgresHeldAsPreRelease" AfterTargets="MinVer"
          Condition=" '$(RaskPostgresPreRelease)' != '' AND '$(MinVerPreRelease)' == '' AND '$(MinVerMajor)' != '' ">
    <PropertyGroup>
      <PackageVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch)-$(RaskPostgresPreRelease)</PackageVersion>
    </PropertyGroup>
  </Target>

</Project>
