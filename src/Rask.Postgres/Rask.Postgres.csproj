<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Postgres</PackageId>
    <Title>Rask.Postgres — production PostgreSQL for EF Core</Title>
    <Description>PostgreSQL for .NET apps on Entity Framework Core: `UseRaskPostgres(...)` is a drop-in replacement for `UseNpgsql` that applies the production session settings (`statement_timeout`, `lock_timeout`, `idle_in_transaction_session_timeout`) to every connection the context opens and turns on Npgsql's transient-failure retrying. SQLite stays Rask's default; this is the door out when one box is no longer enough.</Description>
    <!-- Override the framework default tags (web/component/wasm) — a standalone data-layer helper. -->
    <PackageTags>postgres postgresql npgsql database entity-framework-core efcore interceptor dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <!-- UseRaskPostgres(services) binds Rask:Postgres and reads Rask:ConnectionStrings:App. The configuration binding
       source generator writes the bind at compile time, so no reflection binder runs. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Rask.Hosting.Shared\RaskOptionsRegistration.cs" Link="Shared\RaskOptionsRegistration.cs"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Postgres.Tests"/>
  </ItemGroup>

</Project>
