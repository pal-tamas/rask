<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Data</PackageId>
    <Title>Rask.Data — declare a model, and that is the data layer</Title>
    <Description>A data layer for Entity Framework Core apps in which you declare models and nothing else: no DbContext class, no DbSet property, no IEntityTypeConfiguration, no registration, and no IDbContextFactory injected to read a row. A `Model&lt;TId&gt;` base carries Id, CreatedAt/UpdatedAt and a domain-events buffer; a source generator builds the EF model from every one it finds, so nothing is reflected and a trimmed publish cannot drop a table. The model type is its own DbSet (`Product.Where(...)`, `Product.FindAsync(id)`, `Product.Add(...)`) via C# 14 static extension members, reads are no-tracking by default, and `Db.Begin()` gives one short-lived ambient context per unit of work. Value objects map as EF complex types, strongly-typed ids get a generated value converter, and mapping rules live in a static Configure on the model. Opt-in `ISoftDeletable` / `IVersioned` markers drive transparent soft delete and optimistic concurrency through `ISaveChangesInterceptor`s, with after-commit domain-event publication through Rask.Cqrs. A class that does not derive from Model stays ordinary EF Core.</Description>
    <!-- Override the framework default tags (web/component/wasm) — a standalone EF Core data helper. -->
    <PackageTags>ddd entity entity-framework-core efcore interceptor soft-delete concurrency domain-events dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
    <!-- The SkipChangeTracking writer reads the table/column mapping and the store type mappings off the
         model to build its INSERT. Every relational provider already brings this in; the reference only makes
         the dependency this package actually has explicit. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Cqrs\Rask.Cqrs.csproj"/>
  </ItemGroup>

  <!-- Ship the global `using Rask.Data;` to downstream consumers (mirrors Rask.Cqrs). -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
  </ItemGroup>

</Project>
