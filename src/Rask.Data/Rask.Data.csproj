<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Data</PackageId>
    <Title>Rask.Data — declare a model, and that is the data layer</Title>
    <Description>A .NET data layer for Entity Framework Core apps where you declare C# models and nothing else: no DbContext class, no DbSet property, no IEntityTypeConfiguration, no registration, and no IDbContextFactory injected to read a row or save a form. A `Model&lt;TId&gt;` base carries Id and a domain-events buffer; a source generator builds the EF model from every one it finds, so nothing is reflected and a trimmed publish cannot drop a table. Reads live on the model type (`Product.Where(...)`, `Product.FindAsync(id)`, `Product.AsQueryable()`) via C# 14 static extension members, always untracked, each on its own short-lived context. The generator also writes a form-shaped `ProductModel` for every entity, with `Product.CreateAsync`, `Product.UpdateAsync`, `Product.DeleteAsync` and `ToModel()`; domain operations and transactions are plain EF Core through an injected context. Value objects map as EF complex types, strongly-typed ids get a generated value converter, and mapping rules live in a static Configure on the model. Opt-in `ITimestamped` / `ISoftDeletable` / `IVersioned` markers drive audit stamps, transparent soft delete and optimistic concurrency through `ISaveChangesInterceptor`s, with after-commit domain-event publication through Rask.Cqrs. A class that does not derive from Model stays ordinary EF Core.</Description>
    <!-- Override the framework default tags (web/component/wasm) — a standalone EF Core data helper. -->
    <PackageTags>ddd entity entity-framework-core efcore source-generator forms interceptor soft-delete concurrency domain-events dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
    <!-- The SkipChangeTracking writer reads the table/column mapping and the store type mappings off the
         model to build its INSERT. Every relational provider already brings this in; the reference only makes
         the dependency this package actually has explicit. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
    <!-- AddRaskData<TContext> registers a startup check refusing a HasNonOverlappingRange rule the provider
         would silently ignore; it runs as an IHostedService, like the batteries' model checks. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    <!-- RaskDataOptions binds Rask:Data. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
  </ItemGroup>

  <!-- The configuration binding source generator writes the Rask:Data bind at compile time, so no reflection binder
       runs; the SDK leaves it off unless a project asks. The source-linked options helper the other batteries use is
       deliberately NOT linked here — see AddOptions in RaskDataServiceCollectionExtensions. -->
  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Cqrs\Rask.Cqrs.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The provider packages implement IRangeExclusionEnforcer, an internal marker: it is how the startup
         check tells a context that enforces HasNonOverlappingRange from one that would silently ignore it,
         without a public name nobody but a provider would ever type. -->
    <InternalsVisibleTo Include="Rask.SQLite.EntityFrameworkCore"/>
    <InternalsVisibleTo Include="Rask.Data.Tests"/>
  </ItemGroup>

  <!-- Ship the global `using Rask.Data;` to downstream consumers (mirrors Rask.Cqrs). -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
  </ItemGroup>

</Project>
