<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Cqrs.Client</PackageId>
    <Title>Rask.Cqrs.Client — Remote Dispatch for Browser and Native Clients</Title>
    <Description>The client half of Rask.Cqrs remote dispatch. Register it and a message with no local handler is sent to the server through the same `IDispatcher` call — queries as GET, commands as POST, files as multipart — with no HttpClient at the call site. Reflection-free: the wire codecs are source-generated, so it publishes clean under the WASM/AOT trimmer.</Description>
    <PackageTags>cqrs mediator rpc remote-dispatch wasm blazor source-generator reflection-free aot trimming</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Cqrs\Rask.Cqrs.csproj"/>
    <!-- For the file bridge: RaskFile -> RemoteFile, and Navigator.Download(FileDownload). The transport
         only ever ships inside a Rask app, so the dependency costs nothing a consumer did not already
         have — and without it every upload and download call site grows a four-line adapter.

         PrivateAssets="all" — Rask.Core is IsPackable=false; without it the nuspec declares a dependency on
         a nonexistent "Rask.Core" package and every restore fails with NU1101. Core.dll reaches consumers
         from the Rask.Wasm / Rask.Server package this add-on sits alongside, which bundle it
         into lib/; re-packing it here would ship a duplicate assembly instead. -->
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj" PrivateAssets="all"/>
  </ItemGroup>

  <!-- The dispatch/codec generator, as an analyzer only: consumers get the code generation without a
       runtime reference, exactly as Rask.Cqrs wires it. -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Cqrs.Generators\Rask.Cqrs.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    The generator is deliberately NOT packed here. This package depends on Rask.Cqrs, which already ships
    it under analyzers/dotnet/cs/, and analyzer assets DO flow through a package dependency. Packing a
    second copy loads the generator twice in one compilation — two instances, each emitting
    __RaskCqrsCodecs.g.cs under its own path — and the consumer gets CS0101/CS0111 on every codec.

    In-repo this is invisible: a ProjectReference does not flow analyzers, so the test projects that name
    the generator explicitly only ever load one. It appears solely when the packages are consumed as
    packages, which is what the CLI build gate exercises and what found it.
  -->

</Project>
