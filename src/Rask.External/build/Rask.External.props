<Project>

  <!-- The Static Web Assets SDK normally auto-generates this build/$(PackageId).props to import the
       static-web-asset wiring. We provide it ourselves (StaticWebAssetsDisableProjectBuildPropsFileGeneration
       in the csproj) so the same file can ALSO carry the RaskExternal* knobs below — the SDK-documented
       extension point. These imports must stay, or NuGet consumers won't get wwwroot/rask-external.js on
       a URL and every island fails to mount. They are guarded by Exists() because Directory.Build.props
       imports THIS file in-repo (for the knobs), where the sibling SDK props live only in the packed
       layout, not on disk. Same shape as Rask.Bootstrap. -->
  <Import Project="$(MSBuildThisFileDirectory)Microsoft.AspNetCore.StaticWebAssets.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Microsoft.AspNetCore.StaticWebAssets.props')"/>
  <Import Project="$(MSBuildThisFileDirectory)Microsoft.AspNetCore.StaticWebAssetEndpoints.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Microsoft.AspNetCore.StaticWebAssetEndpoints.props')"/>

  <!--
    Consumer-facing knobs for the island bundle. Override any of these in your project, or with -p:.

    Everything here is inert until the project actually HAS an island. That is the Node-free
    guarantee: a Rask app with no front-end file beside a component, and an app whose islands are all
    .razor, never probes for node, never runs npm, and never learns this package has a build step.
  -->
  <PropertyGroup>
    <!--
      Master switch. False skips the install, the bundle and the node probe entirely — the app still
      compiles, the islands still render their host elements, and the client runtime reports the
      missing chunk rather than the page failing.

      Same shape as RaskSpaBuild and RaskWasmDevBundle.

      Note the repo's own unit gate does NOT pass false: since the showcase gained islands it carries a
      package.json, so `dotnet build Rask.slnx` runs npm and Vite for it and the gate needs node. A
      machine without node builds a solution containing islands by passing this false explicitly.
    -->
    <RaskExternalBuild Condition="'$(RaskExternalBuild)' == ''">true</RaskExternalBuild>

    <!--
      Whether a `.ts` beside a `.cs` of the same name is assumed to be a LIT island.

      That rule is what lets a Lit component be found by convention — and it is character-for-character
      the rule Rask's SCOPED TypeScript already uses. Nothing in MSBuild can separate them: the only
      difference is whether the C# class derives from LitComponent, which Roslyn knows and a glob does
      not. So in a project holding both, every scoped `.ts` is also offered to the bundler as a Lit
      island, and the build fails on a module that never default-exported a tag name.

      A project with scoped TypeScript and no Lit islands sets this false and loses nothing. A project
      with both sets it false and declares its Lit islands explicitly, which is what
      <RaskExternal Include="widgets/gauge.ts" Runtime="lit"/> has always been for. The other three
      runtimes have extensions of their own and are never ambiguous.
    -->
    <RaskExternalLitAutoPair Condition="'$(RaskExternalLitAutoPair)' == ''">true</RaskExternalLitAutoPair>

    <!--
      Where the built chunks land. Under wwwroot on purpose: the SDK already publishes wwwroot, so the
      bundle reaches a deployed app with no publish target of its own — the gap that made the WASM
      host's baked absolute path fail inside a container.
    -->
    <RaskExternalOutputDir Condition="'$(RaskExternalOutputDir)' == ''">wwwroot/_rask/external</RaskExternalOutputDir>

    <!--
      ...but kept OUT of the wwwroot glob that runs at evaluation. The SDK discovers static web assets
      from @(Content) matched against wwwroot/**, and @(Content) is globbed before the bundler has
      written anything — so on a clean tree the chunks are absent from the endpoints manifest that
      MapStaticAssets serves from, and on the NEXT build they are present, discovered, and then
      registered a second time by _RaskExternalStaticWebAssets below, which trips the SDK's duplicate
      guard. Excluding here leaves exactly one registration path on every build (#884).
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(RaskExternalOutputDir)/**</DefaultItemExcludes>

    <!-- The URL prefix those files are served from. Must match RaskExternalOutputDir's position under
         wwwroot, and is what the generated manifest prefixes every chunk with. -->
    <RaskExternalPublicBase Condition="'$(RaskExternalPublicBase)' == ''">/_rask/external/</RaskExternalPublicBase>

    <!--
      `npm ci` where it can run: reproducible, faster, and it fails loudly when package-lock.json has
      drifted rather than quietly rewriting it. It needs the lockfile, which a project that has never
      installed does not have — so the targets pick between these two by looking for it, rather than
      shelling `npm ci || npm install`, which prints a wall of npm errors on every first build and
      reads exactly like a failure.
    -->
    <!--
      Dev-server mode, set by `rask dev`. The islands are served by a Vite dev server instead of being
      bundled into wwwroot, so each framework's own hot-replacement works on them.

      This is NOT RaskExternalBuild=false. That switch turns the whole feature off — no entry modules,
      no manifest, no prop types — and an app run that way has islands that never mount. This one
      keeps every input being written and skips exactly one step: the production `vite build`. The
      manifest is still written, pointing at the dev server rather than at chunks.
    -->
    <RaskExternalDevServer Condition="'$(RaskExternalDevServer)' == ''">false</RaskExternalDevServer>

    <!--
      The port the island dev server listens on, and the origin the page imports modules from.

      Not 5173: that is the SPA lane's, and a solution with both would have them fight for it. Baked
      into the manifest at build time, which is why the generated config sets strictPort — Vite
      quietly picking the next free port would leave the page importing from one nothing is on, with
      no symptom but islands that never appear.
    -->
    <RaskExternalDevServerPort Condition="'$(RaskExternalDevServerPort)' == ''">5174</RaskExternalDevServerPort>
    <RaskExternalDevServerUrl Condition="'$(RaskExternalDevServerUrl)' == ''">http://localhost:$(RaskExternalDevServerPort)</RaskExternalDevServerUrl>

    <RaskExternalInstallCommand Condition="'$(RaskExternalInstallCommand)' == ''">npm ci</RaskExternalInstallCommand>
    <RaskExternalFirstInstallCommand Condition="'$(RaskExternalFirstInstallCommand)' == ''">npm install</RaskExternalFirstInstallCommand>

    <!-- Vite is invoked directly with the generated config rather than through a package.json script,
         so the project does not have to carry a script whose name Rask would then depend on. -->
    <RaskExternalBuildCommand Condition="'$(RaskExternalBuildCommand)' == ''">npx --no-install vite build --config</RaskExternalBuildCommand>

    <!-- Vite's own floor. The probe reports anything older rather than letting vite fail with an
         engines error nobody reads. -->
    <RaskExternalMinimumNode Condition="'$(RaskExternalMinimumNode)' == ''">20.19.0</RaskExternalMinimumNode>
  </PropertyGroup>

</Project>
