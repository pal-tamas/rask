<Project>

  <!--
    Rask.External build integration: turn the front-end files sitting beside components into one
    bundled chunk each, plus the manifest the client runtime resolves names through.

      1. Find the island sources (a .tsx/.jsx beside a .cs, or an explicit <RaskExternal> item).
      2. No islands -> stop. Nothing below runs, and node is never probed.
      3. Vendor the adapters into obj/, so the generated entries import a stable path.
      4. Write one entry module per island, plus the Vite config, into obj/.
      5. `npm ci` / `npm install`, then `vite build` with that config.

    Everything is conditioned on an island actually existing, because this file is imported into EVERY
    project of every consumer — same as Rask.Spa.Hosting.targets.

    The MSBuild rules that shape all of it, both learned the hard way in the SPA targets:

      * Item-list references are illegal in a property Condition (MSB4099), so "do we have islands?"
        cannot be a property computed from @(_RaskExternalFile). It is a target Condition instead.
      * Properties evaluate in an EARLIER PASS than items, so a property that reads @(SomeItem) reads
        nothing at all — silently, producing an empty string rather than an error.
  -->

  <PropertyGroup>
    <!--
      ABSOLUTE, deliberately. IntermediateOutputPath is relative to the project, and these paths are
      written into generated JavaScript as import specifiers — where a relative path with no leading
      './' is not a relative path at all but a BARE specifier, which the bundler resolves against
      node_modules and fails on. The failure names a package nobody wrote.
    -->
    <_RaskExternalObj>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)rask-external'))\</_RaskExternalObj>
    <_RaskExternalAdapters>$(_RaskExternalObj)rask\</_RaskExternalAdapters>
    <!-- Where the generated prop types land. Under obj/ because they are build output: a generated
         file in the source tree is one somebody edits by hand and loses on the next build. -->
    <_RaskExternalTypes>$(_RaskExternalObj)types\</_RaskExternalTypes>
    <_RaskExternalOut>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(RaskExternalOutputDir)'))</_RaskExternalOut>
    <_RaskExternalManifest>$(_RaskExternalOut)\manifest.json</_RaskExternalManifest>

    <!--
      A project can only bundle islands if it has a package.json, so its absence is the cheapest
      correct gate — one file probe, and it is what makes this file free to import into every project
      of every consumer. The glob below would otherwise walk each project's source tree on every
      evaluation, design-time builds included, to discover that almost none of them have a .tsx.

      The cost of gating here is that "I added Chart.tsx and nothing happened" gets no diagnostic in a
      project that has no package.json. That is the trade taken deliberately: the bundle could not
      have run there anyway, the CLI's island scaffolding writes the package.json, and
      docs/islands.md says so up front.
    -->
    <_RaskExternalBundlable Condition="Exists('$(MSBuildProjectDirectory)/package.json')">true</_RaskExternalBundlable>

    <!-- Design-time builds are excluded everywhere below: an IDE reloading the project must never
         shell out to npm. -->
    <_RaskExternalEnabled Condition="'$(RaskExternalBuild)' != 'false' AND '$(DesignTimeBuild)' != 'true' AND '$(_RaskExternalBundlable)' == 'true'">true</_RaskExternalEnabled>
  </PropertyGroup>

  <!--
    The island sources.

    A .tsx/.jsx anywhere in the project pairs with the component of the same name beside it — the same
    convention scoped CSS and scoped JS already use, so there is nothing new to learn and nothing to
    register.

    A .ts is only picked up when a .cs of the SAME NAME sits beside it, and that filter is what makes
    Lit workable here. A bare **/*.ts glob would sweep up every piece of TypeScript in the project;
    requiring the C# sibling narrows it to exactly the pairs a LitComponent declares. It has to match,
    too: the C# side now infers `./Name.ts` from the base class, so a build that ignored those files
    would render a module the bundle never built — markup pointing at a chunk that does not exist,
    with nothing failing until the browser asks for it.

    The excludes are narrow on purpose. A **/* walk that reached node_modules would enumerate tens of
    thousands of files on every evaluation, costing far more than the build it feeds.

    Discovered whether or not the project can BUNDLE. A project with no package.json still has front
    end files worth type-checking against their C# props — a Lit or plain custom element imports
    nothing from npm and checks cleanly with nothing installed. Gating discovery on the bundler would
    have left the guarantee dormant in exactly the projects the no-npm path exists for.
  -->
  <ItemGroup>
    <_RaskExternalFile Include="$(MSBuildProjectDirectory)/**/*.tsx;$(MSBuildProjectDirectory)/**/*.jsx"
                     Exclude="$(MSBuildProjectDirectory)/obj/**/*;$(MSBuildProjectDirectory)/bin/**/*;$(MSBuildProjectDirectory)/node_modules/**/*;$(MSBuildProjectDirectory)/wwwroot/**/*">
      <IslandName>%(Filename)</IslandName>
      <Runtime>react</Runtime>
    </_RaskExternalFile>

    <!-- .d.ts carries no code, and its %(Filename) still ends in '.d' — so it would pair with nothing
         and name a component nobody declared. Filtered to the .cs-paired ones in
         _RaskExternalPairLitFiles below, which is a TARGET because the filter needs metadata
         batching: %(Item.Metadata) in an item Condition is illegal outside one (MSB4191), and the
         failure is not a warning — the whole project stops being a valid project file, so every
         `dotnet run` of it dies before Main. -->
    <_RaskExternalLitCandidate Include="$(MSBuildProjectDirectory)/**/*.ts"
                     Exclude="$(MSBuildProjectDirectory)/obj/**/*;$(MSBuildProjectDirectory)/bin/**/*;$(MSBuildProjectDirectory)/node_modules/**/*;$(MSBuildProjectDirectory)/wwwroot/**/*;$(MSBuildProjectDirectory)/**/*.d.ts">
      <Sibling>%(RootDir)%(Directory)%(Filename).cs</Sibling>
    </_RaskExternalLitCandidate>

    <!-- Still available for a file convention cannot reach — the build-side counterpart of overriding
         Module in C#. The two have to agree; nothing checks that they do. -->
    <_RaskExternalFile Include="@(RaskExternal)">
      <IslandName Condition="'%(RaskExternal.IslandName)' == ''">%(Filename)</IslandName>
      <Runtime Condition="'%(RaskExternal.Runtime)' == ''">lit</Runtime>
    </_RaskExternalFile>

    <_RaskExternalAdapterSource Include="$(MSBuildThisFileDirectory)../client/*.ts"/>
  </ItemGroup>

  <UsingTask TaskName="Rask.External.Tasks.WriteExternalPropTypesTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.External.Tasks.dll"/>

  <!--
    The typed boundary: each component's props, as TypeScript the front-end file imports.

    Deliberately NOT gated on _RaskExternalEnabled. The types are worth having in a project that
    never runs a bundler at all — an editor resolves them, `tsc` checks against them, and a Lit
    component with no dependencies needs no build step to be worth type-checking. Gating this on the
    bundler would mean the guarantee only holds for projects that already had one.

    AfterTargets="CoreCompile" because the constants only exist once Roslyn has produced the
    assembly, and before anything that compiles the front end.
  -->
  <Target Name="_RaskExternalWritePropTypes"
          AfterTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences;_RaskExternalPairLitFiles"
          Condition="'$(RaskExternalPropTypes)' != 'false' AND '$(DesignTimeBuild)' != 'true'"
          Inputs="@(IntermediateAssembly)"
          Outputs="$(_RaskExternalObj)types.stamp">
    <WriteExternalPropTypesTask AssemblyPath="@(IntermediateAssembly->'%(FullPath)')"
                                OutputDirectory="$(_RaskExternalTypes)"
                                TsConfigPath="$(_RaskExternalObj)tsconfig.paths.json"
                                CheckConfigPath="$(_RaskExternalObj)tsconfig.check.json"
                                FrontEndFiles="@(_RaskExternalFile)"
                                ProjectDirectory="$(MSBuildProjectDirectory)"/>
    <MakeDir Directories="$(_RaskExternalObj)"/>
    <Touch Files="$(_RaskExternalObj)types.stamp" AlwaysCreate="true"/>
  </Target>

  <UsingTask TaskName="Rask.External.Tasks.WriteExternalBuildInputsTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.External.Tasks.dll"/>

  <!--
    The adapters, vendored into obj/ rather than into the author's source tree. They are refreshed
    from the package on every build, which is what keeps the client half wire-locked to the C# half:
    upgrading Rask.External upgrades both together or the pair drifts.
  -->
  <!--
    Pairs each candidate .ts with a .cs of the same name, which is what makes a LitComponent's module
    discoverable by convention rather than by hand.

    A target rather than an ItemGroup because the filter reads %(Sibling) per item, and metadata
    batching is only legal inside one.
  -->
  <!--
    Type-checks each front-end file against the props its C# declares. This is what makes the
    two-way contract hold by DEFAULT rather than only for people who happen to run tsc.

    When it runs, and why it is not simply "when node_modules exists" — measured, not assumed:

      * a component with no npm imports (a Lit element, a plain custom element) type-checks with
        nothing installed at all, and CATCHES prop drift while doing it. Requiring node_modules
        would leave the guarantee dormant in exactly the projects the no-npm path is aimed at.
      * a component that imports react cannot be checked before `npm install`, and there is no way
        to weaken the check into working. Measured: tsgo's no-resolve mode does not merely tolerate
        the missing package, it stops resolving the generated props too, so the contract error never
        fires and correct and incorrect code fail identically with the same three resolution errors.

    So the gate is the package.json probe already used for bundling: no package.json means no npm
    dependencies to be missing, and the check runs. A package.json without node_modules means the
    front end cannot build yet either, so it is skipped with a message rather than failed.

    Roughly 0.2s for a small project. RaskExternalTypeCheck=false turns it off for anyone
    mid-refactor with a deliberately red front end.
  -->
  <Target Name="_RaskExternalTypeCheck"
          AfterTargets="_RaskExternalWritePropTypes"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(RaskExternalTypeCheck)' != 'false' AND '$(DesignTimeBuild)' != 'true' AND '@(_RaskExternalFile)' != ''">
    <!--
      ResolveTypeScriptToolTask belongs to Rask.Core's build integration, not this one, and this
      target cannot register it: the task assembly lives in Rask.Core's build folder, whose path is
      not knowable from inside this package.

      In practice a project referencing Rask.External also references a host package that brings
      Rask.Core's targets, so it is there. But "in practice" is how a dependency stays undeclared
      until it is not — a scratch app built exactly as a consumer would build it failed here with
      MSB4036, naming a task nobody wrote and pointing at the SDK directory.

      RaskTsgoVersion is set by those same targets, so its absence means the toolchain is not here.
      Skipped with a message rather than silently: a check that stops running and says nothing is
      the failure this whole feature exists to avoid.
    -->
    <Message Importance="high"
             Condition="'$(RaskTsgoVersion)' == ''"
             Text="Rask.External: skipping the prop type-check — Rask.Core's TypeScript toolchain is not imported in this project, so tsgo cannot be resolved."/>

    <PropertyGroup>
      <_RaskExternalDepsMissing Condition="Exists('$(MSBuildProjectDirectory)/package.json') AND !Exists('$(MSBuildProjectDirectory)/node_modules')">true</_RaskExternalDepsMissing>
    </PropertyGroup>

    <Message Importance="high"
             Condition="'$(_RaskExternalDepsMissing)' == 'true'"
             Text="Rask.External: skipping the prop type-check — this project has a package.json but no node_modules, so its imports cannot resolve. Run the install to enable it."/>

    <ResolveTypeScriptToolTask Tool="tsgo"
                               Condition="'$(RaskTsgoVersion)' != '' AND '$(_RaskExternalDepsMissing)' != 'true' AND Exists('$(_RaskExternalObj)tsconfig.check.json')"
                               Version="$(RaskTsgoVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskExternalTsgoPath"/>
    </ResolveTypeScriptToolTask>

    <Exec Command="&quot;$(_RaskExternalTsgoPath)&quot; --project &quot;$(_RaskExternalObj)tsconfig.check.json&quot;"
          Condition="'$(_RaskExternalTsgoPath)' != ''"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"
          CustomErrorRegularExpression="error TS[0-9]+"/>
  </Target>

  <Target Name="_RaskExternalPairLitFiles">
    <ItemGroup>
      <_RaskExternalFile Include="@(_RaskExternalLitCandidate)" Condition="Exists('%(_RaskExternalLitCandidate.Sibling)')">
        <IslandName>%(Filename)</IslandName>
        <Runtime>lit</Runtime>
      </_RaskExternalFile>
    </ItemGroup>
  </Target>

  <Target Name="_RaskExternalVendorAdapters"
          DependsOnTargets="_RaskExternalPairLitFiles"
          Condition="'$(_RaskExternalEnabled)' == 'true'"
          Inputs="@(_RaskExternalAdapterSource)"
          Outputs="@(_RaskExternalAdapterSource->'$(_RaskExternalAdapters)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(_RaskExternalAdapterSource)" DestinationFolder="$(_RaskExternalAdapters)"
          SkipUnchangedFiles="true"/>
  </Target>

  <!--
    AFTER the compile: the island's C# has to be valid before its front end is worth bundling, and a
    bundle that preceded the compile would build against a component the generator has not accepted.
  -->
  <Target Name="_RaskExternalWriteInputs"
          AfterTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences;_RaskExternalVendorAdapters"
          Condition="'$(_RaskExternalEnabled)' == 'true' AND '@(_RaskExternalFile)' != ''">
    <WriteExternalBuildInputsTask Islands="@(_RaskExternalFile)"
                                IntermediateDirectory="$(_RaskExternalObj)"
                                AdapterDirectory="$(_RaskExternalAdapters)"
                                OutputDirectory="$(_RaskExternalOut)"
                                ManifestPath="$(_RaskExternalManifest)"
                                PublicBase="$(RaskExternalPublicBase)">
      <Output TaskParameter="ConfigPath" PropertyName="_RaskExternalConfig"/>
    </WriteExternalBuildInputsTask>
  </Target>

  <!-- Its own target with its own up-to-date check, because it is the expensive one. -->
  <Target Name="_RaskExternalInstall"
          DependsOnTargets="_RaskExternalWriteInputs"
          Condition="'$(_RaskExternalEnabled)' == 'true' AND '@(_RaskExternalFile)' != ''"
          Inputs="$(MSBuildProjectDirectory)/package.json"
          Outputs="$(IntermediateOutputPath)rask-external.install.stamp">
    <PropertyGroup>
      <_RaskExternalInstall Condition="Exists('$(MSBuildProjectDirectory)/package-lock.json')">$(RaskExternalInstallCommand)</_RaskExternalInstall>
      <_RaskExternalInstall Condition="'$(_RaskExternalInstall)' == ''">$(RaskExternalFirstInstallCommand)</_RaskExternalInstall>
    </PropertyGroup>
    <Message Importance="high" Text="Rask.External: $(_RaskExternalInstall) in $(MSBuildProjectDirectory)"/>
    <Exec Command="$(_RaskExternalInstall)" WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"/>
    <MakeDir Directories="$(IntermediateOutputPath)"/>
    <Touch Files="$(IntermediateOutputPath)rask-external.install.stamp" AlwaysCreate="true"/>
  </Target>

  <!--
    The manifest is listed first among the Outputs so that deleting the bundle by hand forces a
    rebuild even though the stamp file survives.
  -->
  <Target Name="_RaskExternalBundle"
          AfterTargets="CoreCompile"
          DependsOnTargets="_RaskExternalInstall"
          Condition="'$(_RaskExternalEnabled)' == 'true' AND '@(_RaskExternalFile)' != ''"
          Inputs="@(_RaskExternalFile);$(_RaskExternalConfig)"
          Outputs="$(_RaskExternalManifest);$(IntermediateOutputPath)rask-external.build.stamp">
    <Message Importance="high" Text="Rask.External: bundling @(_RaskExternalFile->Count()) island(s) ($(Configuration))"/>
    <Exec Command="$(RaskExternalBuildCommand) &quot;$(_RaskExternalConfig)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"/>
    <Error Condition="!Exists('$(_RaskExternalManifest)')"
           Code="RASKISLAND002"
           Text="Rask.External: the bundler finished but wrote no manifest at '$(_RaskExternalManifest)'. The client runtime resolves an island's chunk through that file, so every island on the page would fail to mount."/>
    <MakeDir Directories="$(IntermediateOutputPath)"/>
    <Touch Files="$(IntermediateOutputPath)rask-external.build.stamp" AlwaysCreate="true"/>
  </Target>

</Project>
