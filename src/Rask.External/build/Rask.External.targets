<Project>

  <!--
    Rask.External build integration: turn the front-end files sitting beside components into one
    bundled chunk each, plus the manifest the client runtime resolves names through.

      1. Find the island sources (a .tsx/.jsx beside a .cs, or an explicit <RaskExternal> item).
      2. No islands -> stop. Nothing below runs, and node is never probed.
      3. Vendor the adapters into obj/, so the generated entries import a stable path.
      4. Write one entry module per island, plus the Vite config, into obj/.
      5. `npm ci` / `npm install`, then `vite build` with that config.

    Everything is conditioned on an island actually existing, because this file is imported into EVERY
    project of every consumer — same as Rask.Spa.Hosting.targets.

    The MSBuild rules that shape all of it, both learned the hard way in the SPA targets:

      * Item-list references are illegal in a property Condition (MSB4099), so "do we have islands?"
        cannot be a property computed from @(_RaskExternalFile). It is a target Condition instead.
      * Properties evaluate in an EARLIER PASS than items, so a property that reads @(SomeItem) reads
        nothing at all — silently, producing an empty string rather than an error.
  -->

  <PropertyGroup>
    <!--
      A class library's islands publish under its own content base, not the app's (#939).

      The SDK serves a Razor class library's static web assets from `_content/<PackageId>/`, so a
      library-built bundle and its manifest land there — while the client, which assumed the app's
      `/_rask/external/`, looked somewhere else entirely. The manifest URL derived here travels to the
      island component as a generated `ManifestUrl` and from there onto each host element, so one page
      can carry islands from the app AND from any number of libraries at once.

      Decided HERE rather than beside the app default in the .props, because that file is imported
      before OutputType is set and cannot tell an app from a library. Applied only when the author did
      not name a base themselves.
    -->
    <_RaskExternalContentBase Condition="'$(_RaskExternalContentBase)' == ''">$(PackageId)</_RaskExternalContentBase>
    <_RaskExternalContentBase Condition="'$(_RaskExternalContentBase)' == ''">$(AssemblyName)</_RaskExternalContentBase>
    <RaskExternalPublicBase Condition="'$(_RaskExternalPublicBaseIsDefault)' == 'true' AND '$(OutputType)' == 'Library'">/_content/$(_RaskExternalContentBase)/_rask/external/</RaskExternalPublicBase>

    <!-- What the client fetches. Handed to the generator, which writes it onto the component. -->
    <RaskExternalManifestUrl Condition="'$(RaskExternalManifestUrl)' == ''">$(RaskExternalPublicBase)manifest.json</RaskExternalManifestUrl>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RaskExternalManifestUrl"/>
  </ItemGroup>

  <PropertyGroup>
    <!--
      ABSOLUTE, deliberately. IntermediateOutputPath is relative to the project, and these paths are
      written into generated JavaScript as import specifiers — where a relative path with no leading
      './' is not a relative path at all but a BARE specifier, which the bundler resolves against
      node_modules and fails on. The failure names a package nobody wrote.
    -->
    <!-- Combined rather than concatenated, so an ABSOLUTE IntermediateOutputPath (BenchmarkDotNet's generated
         projects set one) is used as it is instead of being nested under the project directory. -->
    <_RaskExternalObj>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)rask-external'))))\</_RaskExternalObj>
    <_RaskExternalAdapters>$(_RaskExternalObj)rask\</_RaskExternalAdapters>
    <!-- Where the generated prop types land. Under obj/ because they are build output: a generated
         file in the source tree is one somebody edits by hand and loses on the next build. -->
    <_RaskExternalTypes>$(_RaskExternalObj)types\</_RaskExternalTypes>
    <!--
      The ONE path an author writes by hand, so it cannot carry the configuration in it.

      Everything else here lives under $(IntermediateOutputPath) — obj/Debug/net10.0/... — which is
      correct for build inputs and wrong for this one file: `tsconfig.json` is committed, it names a
      single `extends`, and that name has to mean the same thing in Debug and in Release. Pointed at
      the intermediate path it resolves in whichever configuration was built last and fails in the
      other, which on Vite is not a warning — esbuild refuses a tsconfig whose extends is missing, so
      the BUNDLE dies rather than the type-check degrading.

      The mapping inside it still points into the configuration's own types directory; only the file
      naming it is stable.
    -->
    <_RaskExternalStableObj>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/obj/rask-external'))\</_RaskExternalStableObj>
    <_RaskExternalOut>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(RaskExternalOutputDir)'))</_RaskExternalOut>
    <_RaskExternalManifest>$(_RaskExternalOut)\manifest.json</_RaskExternalManifest>

    <!--
      A project can only bundle islands if it has a package.json, so its absence is the cheapest
      correct gate — one file probe, and it is what makes this file free to import into every project
      of every consumer. The glob below would otherwise walk each project's source tree on every
      evaluation, design-time builds included, to discover that almost none of them have a .tsx.

      The cost of gating here is that "I added Chart.tsx and nothing happened" gets no diagnostic in a
      project that has no package.json. That is the trade taken deliberately: the bundle could not
      have run there anyway, `rask new` writes the package.json when asked for an island runtime, and
      docs/islands.md says so up front.

      That second clause was false for the whole of this file's life until #1009: there WAS no island
      scaffolding, so the only way to get a package.json was to read the docs and write one. It is true
      now, which is the only reason the sentence stays. (The flag is not spelled out here because an
      XML comment may not contain two consecutive hyphens.)
    -->
    <_RaskExternalBundlable Condition="Exists('$(MSBuildProjectDirectory)/package.json')">true</_RaskExternalBundlable>

    <!-- Design-time builds are excluded everywhere below: an IDE reloading the project must never
         shell out to npm. -->
    <_RaskExternalEnabled Condition="'$(RaskExternalBuild)' != 'false' AND '$(DesignTimeBuild)' != 'true' AND '$(_RaskExternalBundlable)' == 'true'">true</_RaskExternalEnabled>

    <!-- Non-empty only under `rask dev`. Everything dev-server-shaped keys off this one property, so
         an ordinary build cannot half-enter the mode. -->
    <_RaskExternalDevUrl Condition="'$(RaskExternalDevServer)' == 'true'">$(RaskExternalDevServerUrl)</_RaskExternalDevUrl>
  </PropertyGroup>

  <!--
    The island sources.

    A .tsx/.jsx anywhere in the project pairs with the component of the same name beside it — the same
    convention scoped CSS and scoped JS already use, so there is nothing new to learn and nothing to
    register.

    A .ts is only picked up when a .cs of the SAME NAME sits beside it, and that filter is what makes
    Lit workable here. A bare **/*.ts glob would sweep up every piece of TypeScript in the project;
    requiring the C# sibling narrows it to exactly the pairs a LitComponent declares. It has to match,
    too: the C# side now infers `./Name.ts` from the base class, so a build that ignored those files
    would render a module the bundle never built — markup pointing at a chunk that does not exist,
    with nothing failing until the browser asks for it.

    The excludes are narrow on purpose. A **/* walk that reached node_modules would enumerate tens of
    thousands of files on every evaluation, costing far more than the build it feeds.

    Discovered whether or not the project can BUNDLE. A project with no package.json still has front
    end files worth type-checking against their C# props — a Lit or plain custom element imports
    nothing from npm and checks cleanly with nothing installed. Gating discovery on the bundler would
    have left the guarantee dormant in exactly the projects the no-npm path exists for.
  -->
  <!--
    A note on %(Runtime) below: it is a FALLBACK, not the answer.

    An extension used to identify a runtime. It no longer does — React, Preact and Solid all write
    .tsx, and Angular writes the same .ts Lit does — so what these globs establish is the FAMILY, and
    the C# base class settles which member of it. WriteExternalBuildInputsTask reads the declared
    runtime out of the compiled assembly and overrides what is written here; the value survives only
    for a front-end file no component has claimed yet, or a hand-written <RaskExternal> item.
  -->
  <ItemGroup>
    <_RaskExternalFile Include="$(MSBuildProjectDirectory)/**/*.tsx;$(MSBuildProjectDirectory)/**/*.jsx"
                     Exclude="$(MSBuildProjectDirectory)/obj/**/*;$(MSBuildProjectDirectory)/bin/**/*;$(MSBuildProjectDirectory)/node_modules/**/*;$(MSBuildProjectDirectory)/wwwroot/**/*">
      <IslandName>%(Filename)</IslandName>
      <Runtime>react</Runtime>
    </_RaskExternalFile>

    <!-- A single-file component needs no .cs-sibling filter the way a Lit .ts does: the extension is
         the framework's own and belongs to nothing else in a .NET project, so the glob is already as
         narrow as the pairing rule would make it. -->
    <_RaskExternalFile Include="$(MSBuildProjectDirectory)/**/*.vue"
                     Exclude="$(MSBuildProjectDirectory)/obj/**/*;$(MSBuildProjectDirectory)/bin/**/*;$(MSBuildProjectDirectory)/node_modules/**/*;$(MSBuildProjectDirectory)/wwwroot/**/*">
      <IslandName>%(Filename)</IslandName>
      <Runtime>vue</Runtime>
    </_RaskExternalFile>

    <_RaskExternalFile Include="$(MSBuildProjectDirectory)/**/*.svelte"
                     Exclude="$(MSBuildProjectDirectory)/obj/**/*;$(MSBuildProjectDirectory)/bin/**/*;$(MSBuildProjectDirectory)/node_modules/**/*;$(MSBuildProjectDirectory)/wwwroot/**/*">
      <IslandName>%(Filename)</IslandName>
      <Runtime>svelte</Runtime>
    </_RaskExternalFile>

    <!-- .d.ts carries no code, and its %(Filename) still ends in '.d' — so it would pair with nothing
         and name a component nobody declared. Narrowed to the files a component actually declares as
         its module by _RaskExternalPairLitFiles below, which reads the C# rather than the file name:
         `Name.ts` beside `Name.cs` is ALSO how scoped TypeScript is spelled, and only the base class
         separates them (#938). -->
    <_RaskExternalLitCandidate Include="$(MSBuildProjectDirectory)/**/*.ts"
                     Exclude="$(MSBuildProjectDirectory)/obj/**/*;$(MSBuildProjectDirectory)/bin/**/*;$(MSBuildProjectDirectory)/node_modules/**/*;$(MSBuildProjectDirectory)/wwwroot/**/*;$(MSBuildProjectDirectory)/**/*.d.ts"/>

    <!-- Still available for a file convention cannot reach — the build-side counterpart of overriding
         Module in C#. The two have to agree; nothing checks that they do. -->
    <_RaskExternalFile Include="@(RaskExternal)">
      <IslandName Condition="'%(RaskExternal.IslandName)' == ''">%(Filename)</IslandName>
      <Runtime Condition="'%(RaskExternal.Runtime)' == ''">lit</Runtime>
    </_RaskExternalFile>

    <!-- The .svelte files are the Svelte adapter's host components: a child island has to become a real
         `children` snippet, which only Svelte markup can express. -->
    <_RaskExternalAdapterSource Include="$(MSBuildThisFileDirectory)../client/*.ts;$(MSBuildThisFileDirectory)../client/*.svelte"/>

    <!--
      Committed props snapshots, as additional files the island and factory generators read. Globbed at
      EVALUATION, so a design-time build (the IDE) sees every generated chain step with nothing extracted, and
      ungated like the front-end globs above: a snapshot generates C# with no package.json in sight.

      Kept out of @(Content) by pattern, so the web SDK never publishes one.
    -->
    <_RaskExternalSnapshot Include="$(MSBuildProjectDirectory)/**/*.props.json"
                           Exclude="$(MSBuildProjectDirectory)/obj/**/*;$(MSBuildProjectDirectory)/bin/**/*;$(MSBuildProjectDirectory)/node_modules/**/*;$(MSBuildProjectDirectory)/wwwroot/**/*"/>
    <AdditionalFiles Include="@(_RaskExternalSnapshot)"/>
    <Content Remove="**/*.props.json"/>
  </ItemGroup>

  <UsingTask TaskName="Rask.External.Tasks.WriteExternalPropTypesTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.External.Tasks.dll"/>

  <!--
    The typed boundary: each component's props, as TypeScript the front-end file imports.

    Deliberately NOT gated on _RaskExternalEnabled. The types are worth having in a project that
    never runs a bundler at all — an editor resolves them, `tsc` checks against them, and a Lit
    component with no dependencies needs no build step to be worth type-checking. Gating this on the
    bundler would mean the guarantee only holds for projects that already had one.

    AfterTargets="CoreCompile" because the constants only exist once Roslyn has produced the
    assembly, and before anything that compiles the front end.

    The Exists() guard is for THIS repo, not for consumers. Directory.Build.targets imports this file
    into every project here, but Rask.External.Tasks.dll is produced by a ProjectReference edge only
    projects referencing Rask.External have — so on a cold tree every other project died with MSB4062
    naming a file nobody had written yet. Locally a previous build always left the DLL on disk, which
    is why only CI ever saw it.

    A target Condition rather than a guard on the import or on @(_RaskExternalFile), because neither
    works: an Import Condition is evaluated in the property/import pass, before items exist, so it
    excludes every project; and the Lit half of @(_RaskExternalFile) is not populated until
    _RaskExternalPairLitFiles has run, so gating on it silently emits no prop types for a Lit-only
    project. A target Condition is evaluated at execution time, by which point ResolveProjectReferences
    has built the DLL for any project holding the edge. In the shipped package the DLL always sits
    beside this file, so the guard never fires there.
  -->
  <!--
    Is the task assembly beside this file the one this file was written for? (#965)

    MSBuild loads a <UsingTask> assembly while it evaluates the consuming project, which is BEFORE the
    ProjectReference that would rebuild it. So a pull that adds a task parameter cannot heal itself: the
    stale DLL is loaded, the new targets pass it a parameter it does not have, and every build fails as
    MSB4064 naming a parameter that is right there in the source. The only escape was knowing to delete
    a gitignored file by hand.

    The stamp is written by CopyTaskAssemblyToRaskExternalBuild at the moment the DLL is deployed, so a
    matching pair always agrees. A NuGet consumer gets both from the same package and never sees this.

    On a mismatch the build DEGRADES to the bootstrap path it already has for a tree with no DLL at all,
    rather than failing: the task-driven targets skip, the ProjectReference rebuilds the assembly during
    this same build, and the next one is correct. A missing stamp is NOT a mismatch — an older package
    ships no stamp, and treating that as stale would disable the feature for everyone who has one.

    Known limit: this compares the TARGETS, which is the change the failure reports. A change to the task
    SOURCE alone leaves the stamp valid, and that DLL is refreshed one build later by the ProjectReference.

    The verdict gates the TASKS, never a target Condition. A target's Condition is evaluated before its
    DependsOnTargets run, so in a project where nothing ran this check earlier the property still reads empty
    there, and the stale DLL was handed the new parameter anyway: MSB4064 in Rask.TypeScript.Tasks, the moment
    a task gained one. A task's Condition is evaluated after the dependencies have run.
  -->
  <Target Name="_RaskExternalCheckTaskStamp"
          Condition="'$(DesignTimeBuild)' != 'true'
                     AND Exists('$(MSBuildThisFileDirectory)Rask.External.Tasks.dll')
                     AND Exists('$(MSBuildThisFileDirectory)Rask.External.Tasks.contract')">
    <GetFileHash Files="$(MSBuildThisFileDirectory)Rask.External.targets" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_RaskExternalTargetsNow"/>
    </GetFileHash>

    <PropertyGroup>
      <_RaskExternalTargetsNowHash>@(_RaskExternalTargetsNow->'%(FileHash)')</_RaskExternalTargetsNowHash>
    </PropertyGroup>

    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)Rask.External.Tasks.contract">
      <Output TaskParameter="Lines" ItemName="_RaskExternalTaskContract"/>
    </ReadLinesFromFile>

    <PropertyGroup>
      <_RaskExternalTaskStale
        Condition="'@(_RaskExternalTaskContract)' != '' AND '@(_RaskExternalTaskContract)' != '$(_RaskExternalTargetsNowHash)'"
      >true</_RaskExternalTaskStale>
    </PropertyGroup>

    <Message Importance="high"
             Condition="'$(_RaskExternalTaskStale)' == 'true'"
             Text="Rask.External: build/Rask.External.Tasks.dll was built against a different Rask.External.targets, so the island targets are skipped for this build. The ProjectReference rebuilds it now; build again and they run. (Delete build/Rask.External.Tasks.dll if it persists.)"/>
  </Target>

  <Target Name="_RaskExternalWritePropTypes"
          AfterTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences;_RaskExternalPairLitFiles;_RaskExternalFindPackageIslands;_RaskExternalCheckTaskStamp"
          Condition="'$(RaskExternalPropTypes)' != 'false' AND '$(DesignTimeBuild)' != 'true'
                     AND Exists('$(MSBuildThisFileDirectory)Rask.External.Tasks.dll')"
          Inputs="@(IntermediateAssembly);@(_RaskExternalFile)"
          Outputs="$(_RaskExternalObj)types.stamp">
    <WriteExternalPropTypesTask Condition="'$(_RaskExternalTaskStale)' != 'true'"
                                AssemblyPath="@(IntermediateAssembly->'%(FullPath)')"
                                OutputDirectory="$(_RaskExternalTypes)"
                                TsConfigPath="$(_RaskExternalStableObj)tsconfig.paths.json"
                                CheckConfigPath="$(_RaskExternalObj)tsconfig.check.json"
                                VueConfigPath="$(_RaskExternalObj)tsconfig.vue.json"
                                SvelteConfigPath="$(_RaskExternalObj)tsconfig.svelte.json"
                                SolidConfigPath="$(_RaskExternalObj)tsconfig.solid.json"
                                PreactConfigPath="$(_RaskExternalObj)tsconfig.preact.json"
                                AngularConfigPath="$(_RaskExternalObj)tsconfig.angular.json"
                                IslandAssemblyPath="@(IntermediateAssembly->'%(FullPath)')"
                                FrontEndFiles="@(_RaskExternalFile)"
                                PackageIslandsScanned="$(_RaskExternalBundlable)"
                                ProjectDirectory="$(MSBuildProjectDirectory)"/>
    <MakeDir Directories="$(_RaskExternalObj)" Condition="'$(_RaskExternalTaskStale)' != 'true'"/>
    <Touch Files="$(_RaskExternalObj)types.stamp" AlwaysCreate="true" Condition="'$(_RaskExternalTaskStale)' != 'true'"/>
  </Target>

  <UsingTask TaskName="Rask.External.Tasks.WriteExternalBuildInputsTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.External.Tasks.dll"/>

  <!--
    The adapters, vendored into obj/ rather than into the author's source tree. They are refreshed
    from the package on every build, which is what keeps the client half wire-locked to the C# half:
    upgrading Rask.External upgrades both together or the pair drifts.
  -->
  <!--
    Type-checks each front-end file against the props its C# declares. This is what makes the
    two-way contract hold by DEFAULT rather than only for people who happen to run tsc.

    When it runs, and why it is not simply "when node_modules exists" — measured, not assumed:

      * a component with no npm imports (a Lit element, a plain custom element) type-checks with
        nothing installed at all, and CATCHES prop drift while doing it. Requiring node_modules
        would leave the guarantee dormant in exactly the projects the no-npm path is aimed at.
      * a component that imports react cannot be checked before `npm install`, and there is no way
        to weaken the check into working. Measured: tsgo's no-resolve mode does not merely tolerate
        the missing package, it stops resolving the generated props too, so the contract error never
        fires and correct and incorrect code fail identically with the same three resolution errors.

    So the gate is the package.json probe already used for bundling: no package.json means no npm
    dependencies to be missing, and the check runs. A package.json without node_modules means the
    front end cannot build yet either, so it is skipped with a message rather than failed.

    Roughly 0.2s for a small project. RaskExternalTypeCheck=false turns it off for anyone
    mid-refactor with a deliberately red front end.
  -->
  <!--
    DependsOnTargets carries _RaskExternalInstall (#967).

    The check reads the island's imports, so it needs the packages that satisfy them. Reaching the
    install only through _RaskExternalBundle put it AFTER this target, so a pull that added a package
    failed here first — as TS2307 on an import that is perfectly correct, naming the author's own file.
    The install has its own package.json stamp, so depending on it costs nothing when it is current.
  -->
  <Target Name="_RaskExternalTypeCheck"
          AfterTargets="_RaskExternalWritePropTypes"
          DependsOnTargets="ResolveProjectReferences;_RaskExternalInstall"
          Condition="'$(RaskExternalTypeCheck)' != 'false' AND '$(DesignTimeBuild)' != 'true' AND '@(_RaskExternalFile)' != ''">
    <!--
      ResolveTypeScriptToolTask belongs to Rask.Core's build integration, not this one, and this
      target cannot register it: the task assembly lives in Rask.Core's build folder, whose path is
      not knowable from inside this package.

      In practice a project referencing Rask.External also references a host package that brings
      Rask.Core's targets, so it is there. But "in practice" is how a dependency stays undeclared
      until it is not — a scratch app built exactly as a consumer would build it failed here with
      MSB4036, naming a task nobody wrote and pointing at the SDK directory.

      RaskTsgoVersion is set by those same targets, so its absence means the toolchain is not here.
      Skipped with a message rather than silently: a check that stops running and says nothing is
      the failure this whole feature exists to avoid.
    -->
    <Message Importance="high"
             Condition="'$(RaskTsgoVersion)' == ''"
             Text="Rask.External: skipping the prop type-check — Rask.Core's TypeScript toolchain is not imported in this project, so tsgo cannot be resolved."/>

    <PropertyGroup>
      <_RaskExternalDepsMissing Condition="Exists('$(MSBuildProjectDirectory)/package.json') AND !Exists('$(MSBuildProjectDirectory)/node_modules')">true</_RaskExternalDepsMissing>

    </PropertyGroup>

    <!--
      node_modules present but OLDER than the package.json beside it (#966).

      Through %(ModifiedTime) rather than a property function: System.IO.File is not on MSBuild's
      property-function allowlist (MSB4185), and a target's own Inputs/Outputs answers "should this
      target run", which is a different question and leaves nothing a later task can read. The metadata
      is a sortable timestamp, so an ordinal string compare orders it correctly.

      npm rewrites node_modules/.package-lock.json on every install, so it is the install's own receipt
      and the only file in there whose timestamp means anything.
    -->
    <ItemGroup>
      <_RaskExternalManifest Include="$(MSBuildProjectDirectory)/package.json"/>
      <_RaskExternalInstallReceipt Include="$(MSBuildProjectDirectory)/node_modules/.package-lock.json"/>
    </ItemGroup>

    <PropertyGroup>
      <_RaskExternalManifestTime>@(_RaskExternalManifest->'%(ModifiedTime)')</_RaskExternalManifestTime>
      <_RaskExternalReceiptTime>@(_RaskExternalInstallReceipt->'%(ModifiedTime)')</_RaskExternalReceiptTime>
      <_RaskExternalDepsStale
        Condition="'$(_RaskExternalManifestTime)' != '' AND '$(_RaskExternalReceiptTime)' != ''
                   AND $([System.String]::Compare('$(_RaskExternalManifestTime)', '$(_RaskExternalReceiptTime)')) &gt; 0"
      >true</_RaskExternalDepsStale>
    </PropertyGroup>

    <Message Importance="high"
             Condition="'$(_RaskExternalDepsMissing)' == 'true'"
             Text="Rask.External: skipping the prop type-check — this project has a package.json but no node_modules, so its imports cannot resolve. Run the install to enable it."/>

    <!--
      A node_modules OLDER than the package.json beside it (#966). The directory exists, so the probe
      above is satisfied and every checker runs — against packages that predate the manifest. What that
      produces is not a missing-package error but a cascade of TS7026 on intrinsic JSX elements, because
      the types the runtime's JSX depends on are the ones that are absent: 19 errors on a file nobody
      touched. Named here rather than left to the checker, which cannot know why.

      Not an error: RaskExternalBuild=false is a supported way to build without node, and the install
      that would fix this is exactly what that turns off.
    -->
    <Message Importance="high"
             Condition="'$(_RaskExternalDepsStale)' == 'true' AND '$(_RaskExternalDepsMissing)' != 'true'"
             Text="Rask.External: '$(MSBuildProjectName)' has a node_modules older than its package.json, so the type-check is reading packages that predate the manifest. If it reports errors on code you have not changed, run the install first."/>

    <!-- Resolved when ANY tsgo config exists. Gated on tsconfig.check.json alone, a project whose only
         islands are Solid or Angular resolved no tool, and every Exec below was skipped silently — a
         green build that checked nothing. -->
    <ResolveTypeScriptToolTask Tool="tsgo"
                               Condition="'$(RaskTsgoVersion)' != '' AND '$(_RaskExternalDepsMissing)' != 'true'
                                          AND (Exists('$(_RaskExternalObj)tsconfig.check.json')
                                               OR Exists('$(_RaskExternalObj)tsconfig.solid.json')
                                               OR Exists('$(_RaskExternalObj)tsconfig.preact.json')
                                               OR Exists('$(_RaskExternalObj)tsconfig.angular.json'))"
                               Version="$(RaskTsgoVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskExternalTsgoPath"/>
    </ResolveTypeScriptToolTask>

    <!--
      One tsgo run per JSX dialect, not one for all of them.

      Solid, Preact and React each need a different `jsx`/`jsxImportSource`, and Angular's decorators
      need `experimentalDecorators` that Lit 3's standard decorators need OFF — so a single config
      cannot describe them. Merged into one, the check does not get weaker: it reports errors that are
      not in the author's code (Solid's `class=` under React's JSX types, Preact's hooks resolving to
      React's) and fails a build whose TypeScript is fine.

      Each config is written only when an island of that runtime exists, and the Exists() guard is what
      keeps a React-only project running exactly one check.
    -->
    <Exec Command="&quot;$(_RaskExternalTsgoPath)&quot; --project &quot;$(_RaskExternalObj)tsconfig.check.json&quot;"
          Condition="'$(_RaskExternalTsgoPath)' != '' AND Exists('$(_RaskExternalObj)tsconfig.check.json')"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"
          CustomErrorRegularExpression="error TS[0-9]+"/>

    <Exec Command="&quot;$(_RaskExternalTsgoPath)&quot; --project &quot;$(_RaskExternalObj)tsconfig.solid.json&quot;"
          Condition="'$(_RaskExternalTsgoPath)' != '' AND Exists('$(_RaskExternalObj)tsconfig.solid.json')"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"
          CustomErrorRegularExpression="error TS[0-9]+"/>

    <Exec Command="&quot;$(_RaskExternalTsgoPath)&quot; --project &quot;$(_RaskExternalObj)tsconfig.preact.json&quot;"
          Condition="'$(_RaskExternalTsgoPath)' != '' AND Exists('$(_RaskExternalObj)tsconfig.preact.json')"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"
          CustomErrorRegularExpression="error TS[0-9]+"/>

    <Exec Command="&quot;$(_RaskExternalTsgoPath)&quot; --project &quot;$(_RaskExternalObj)tsconfig.angular.json&quot;"
          Condition="'$(_RaskExternalTsgoPath)' != '' AND Exists('$(_RaskExternalObj)tsconfig.angular.json')"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"
          CustomErrorRegularExpression="error TS[0-9]+"/>

    <!--
      Single-file components need their FRAMEWORK'S checker, not tsgo. tsgo parses TypeScript and JSX;
      a .vue or a .svelte is neither, and there is no plugin seam to teach it one — so this is the
      second and third toolchain the "Why Vite, and only Vite" argument declined for BUNDLERS. It is
      accepted here because the alternative is not a weaker check, it is no check: there is no single
      tool that reads all four file types, and the two-way contract is the whole point of the feature.

      Run from the project's own node_modules, at the version its package.json pinned. Rask does not
      fetch these the way it fetches tsgo: they are the same packages the front end already builds
      with, and a second copy on a different version would disagree with the bundler about the same
      file.

      A missing checker SKIPS LOUDLY. Both configs exist only when an island of that runtime does, so
      silence here would mean a project whose Vue components are checked by nothing while the build
      still says it type-checked the islands.
    -->
    <PropertyGroup>
      <_RaskVueTsc Condition="'$(_RaskVueTsc)' == ''">$(MSBuildProjectDirectory)/node_modules/.bin/vue-tsc</_RaskVueTsc>
      <_RaskSvelteCheck Condition="'$(_RaskSvelteCheck)' == ''">$(MSBuildProjectDirectory)/node_modules/.bin/svelte-check</_RaskSvelteCheck>
      <_RaskVueTsc Condition="'$(OS)' == 'Windows_NT'">$(_RaskVueTsc).cmd</_RaskVueTsc>
      <_RaskSvelteCheck Condition="'$(OS)' == 'Windows_NT'">$(_RaskSvelteCheck).cmd</_RaskSvelteCheck>
    </PropertyGroup>

    <Message Importance="high"
             Condition="Exists('$(_RaskExternalObj)tsconfig.vue.json') AND '$(_RaskExternalDepsMissing)' != 'true'
                        AND !Exists('$(_RaskVueTsc)')"
             Text="Rask.External: skipping the Vue prop type-check — this project has .vue islands but no vue-tsc in node_modules. Add it as a devDependency to enable it."/>

    <Exec Command="&quot;$(_RaskVueTsc)&quot; --noEmit --project &quot;$(_RaskExternalObj)tsconfig.vue.json&quot;"
          Condition="Exists('$(_RaskExternalObj)tsconfig.vue.json') AND '$(_RaskExternalDepsMissing)' != 'true'
                     AND Exists('$(_RaskVueTsc)')"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"
          CustomErrorRegularExpression="error TS[0-9]+"/>

    <Message Importance="high"
             Condition="Exists('$(_RaskExternalObj)tsconfig.svelte.json') AND '$(_RaskExternalDepsMissing)' != 'true'
                        AND !Exists('$(_RaskSvelteCheck)')"
             Text="Rask.External: skipping the Svelte prop type-check — this project has .svelte islands but no svelte-check in node_modules. Add it as a devDependency to enable it."/>

    <!--
      svelte-check reports on stdout and exits non-zero on error, but its output is not in MSBuild's
      diagnostic shape, so the exit code is what fails the build rather than a matched line. Machine
      output keeps the error text one-per-line and parseable by eye.
    -->
    <Exec Command="&quot;$(_RaskSvelteCheck)&quot; --tsconfig &quot;$(_RaskExternalObj)tsconfig.svelte.json&quot; --output machine"
          Condition="Exists('$(_RaskExternalObj)tsconfig.svelte.json') AND '$(_RaskExternalDepsMissing)' != 'true'
                     AND Exists('$(_RaskSvelteCheck)')"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"/>
  </Target>

  <UsingTask TaskName="Rask.External.Tasks.FindExternalIslandsTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.External.Tasks.dll"/>

  <!--
    Which `.ts` files are island modules, and which are scoped TypeScript (#938).

    This is the discovery path for BOTH runtimes that write a plain .ts — Lit and Angular — and it is
    also the one place that can tell either of them from an ordinary scoped asset, because `Name.ts`
    beside `Name.cs` is exactly how BOTH features are spelled. The task reads the C# base list out of
    the source, which is where the difference is written; the assembly read in _RaskExternalWriteInputs
    still overrides the runtime, and _RaskExternalWritePropTypes warns about any island the scan missed.

    Runs BEFORE the compile, not after it, because _RaskExternalExcludeIslandsFromScopedTs needs the
    answer while the scoped-TypeScript list is still being decided — that list is compiled and handed
    to csc, so it cannot wait for the assembly csc produces.

    Guarded like _RaskExternalWritePropTypes: an in-repo tree whose task assembly has not been built
    yet, or was built against a different targets file, pairs NOTHING rather than pairing everything.
    That degrades to "the islands are not discovered on this build", which the ProjectReference fixes
    on the next one — where pairing everything is the defect this target exists to remove.
  -->
  <Target Name="_RaskExternalPairLitFiles"
          DependsOnTargets="ResolveProjectReferences;_RaskExternalCheckTaskStamp"
          Condition="'@(_RaskExternalLitCandidate)' != '' AND '$(DesignTimeBuild)' != 'true'
                     AND Exists('$(MSBuildThisFileDirectory)Rask.External.Tasks.dll')">
    <FindExternalIslandsTask Condition="'$(_RaskExternalTaskStale)' != 'true'"
                             Sources="@(Compile)"
                             Candidates="@(_RaskExternalLitCandidate)"
                             ScopedFiles="@(_RaskScopedTs)">
      <Output TaskParameter="Islands" ItemName="_RaskExternalTsIsland"/>
      <Output TaskParameter="ScopedIslands" ItemName="_RaskExternalScopedIsland"/>
    </FindExternalIslandsTask>

    <ItemGroup>
      <_RaskExternalFile Include="@(_RaskExternalTsIsland)"/>
    </ItemGroup>
  </Target>

  <!--
    The other direction of the same collision: an island's module is not a scoped asset.

    Left in @(_RaskScopedTs) it is compiled into obj/ and registered against its own component as a
    scoped script — so `window.Rask["Gauge"]` is the island's module, the component gains a <script>
    it never asked for, and a no-emit `tsgo` pass over the scoped files reports `@rask/Gauge.props`, a
    mapping that exists only in the island's own generated tsconfig.

    BeforeTargets names all three scoped-TypeScript entry points rather than only the compile: one
    resolves the compiler, one compiles, and one turns the outputs into AdditionalFiles, and each is
    reachable without the others. A target named here that does not exist — a project without
    Rask.Core's build integration — is simply ignored.

    Removing by the item identity the scoped glob produced is load-bearing. Rebuilding the list would
    drop %(RecursiveDir), which is populated only by the ** in that Include and which both the compile's
    Outputs and the AdditionalFiles transform resolve through.
  -->
  <Target Name="_RaskExternalExcludeIslandsFromScopedTs"
          BeforeTargets="_RaskResolveTsgo;_RaskCompileScopedTs;_RaskAddCompiledScopedTs"
          DependsOnTargets="_RaskExternalPairLitFiles"
          Condition="'@(_RaskExternalLitCandidate)' != '' AND '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_RaskScopedTs Remove="@(_RaskExternalScopedIsland)"/>
    </ItemGroup>
  </Target>

  <UsingTask TaskName="Rask.External.Tasks.FindExternalPackageIslandsTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.External.Tasks.dll"/>
  <UsingTask TaskName="Rask.External.Tasks.WriteExternalPropsRequestTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.External.Tasks.dll"/>
  <UsingTask TaskName="Rask.External.Tasks.SyncExternalPropsSnapshotsTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.External.Tasks.dll"/>
  <UsingTask TaskName="Rask.External.Tasks.CheckExternalPropsSnapshotsTask"
             AssemblyFile="$(MSBuildThisFileDirectory)Rask.External.Tasks.dll"/>

  <!--
    Package islands' props, extracted BEFORE the compile.

    Before it, because the snapshot is an additional file the compile reads: the first build of a new package
    island has to extract it to generate the island's steps at all. Anchored beside Rask.Core's scoped
    TypeScript (GenerateMSBuildEditorConfigFileShouldRun), where additional files are still being decided.

    Every gate on the TOOLCHAIN (RaskTsgoVersion) is a target condition, never a property: this file is imported
    before Rask.Core.targets, so at evaluation the pin reads empty.

    A target's Condition is evaluated before its DependsOnTargets run, which is why the ORDER below carries the
    logic: discovery first, then the check or the extraction, each conditioned on what discovery produced, then
    the snapshots a first extraction created join the compile.
  -->
  <Target Name="_RaskExternalPackageProps"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile"
          DependsOnTargets="_RaskExternalFindPackageIslands;_RaskExternalCheckSnapshots;_RaskExternalExtractProps;_RaskExternalAddSnapshots"
          Condition="'$(DesignTimeBuild)' != 'true'"/>

  <!--
    Gated on package.json: a package island needs its package installed to bundle at all, and scanning every .cs
    file of every project with no package.json would be a cost paid for nothing. Such a project still compiles
    from its committed snapshots, and WriteExternalPropTypesTask is told the scan did not run.
  -->
  <Target Name="_RaskExternalFindPackageIslands"
          DependsOnTargets="ResolveProjectReferences;_RaskExternalCheckTaskStamp"
          Condition="'$(_RaskExternalBundlable)' == 'true' AND '$(DesignTimeBuild)' != 'true'
                     AND Exists('$(MSBuildThisFileDirectory)Rask.External.Tasks.dll')">
    <FindExternalPackageIslandsTask Condition="'$(_RaskExternalTaskStale)' != 'true'"
                                    Sources="@(Compile)"
                                    ProjectDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="PackageIslands" ItemName="_RaskExternalPackageIsland"/>
    </FindExternalPackageIslandsTask>

    <!-- Joined to the island list, so the probe, the install, the entries and the bundle all include them. -->
    <ItemGroup>
      <_RaskExternalFile Include="@(_RaskExternalPackageIsland)"/>
    </ItemGroup>

    <!-- Decided here, once, where every property it reads is known: RaskTsgoVersion is empty at evaluation. -->
    <PropertyGroup>
      <_RaskExternalCanExtract Condition="'$(_RaskExternalEnabled)' == 'true' AND '$(RaskExternalPropsExtract)' != 'false' AND '$(RaskTsgoVersion)' != ''">true</_RaskExternalCanExtract>
    </PropertyGroup>
  </Target>

  <!-- A build that cannot extract still needs a snapshot to generate from, so it says which one is missing. -->
  <Target Name="_RaskExternalCheckSnapshots"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'@(_RaskExternalPackageIsland)' != '' AND '$(_RaskExternalCanExtract)' != 'true'">
    <PropertyGroup>
      <_RaskExternalNoExtract Condition="'$(RaskExternalBuild)' == 'false'">RaskExternalBuild=false</_RaskExternalNoExtract>
      <_RaskExternalNoExtract Condition="'$(_RaskExternalNoExtract)' == '' AND '$(RaskExternalPropsExtract)' == 'false'">RaskExternalPropsExtract=false</_RaskExternalNoExtract>
      <_RaskExternalNoExtract Condition="'$(_RaskExternalNoExtract)' == ''">Rask.Core's TypeScript toolchain is not imported</_RaskExternalNoExtract>
    </PropertyGroup>
    <CheckExternalPropsSnapshotsTask Islands="@(_RaskExternalPackageIsland)"
                                     Reason="$(_RaskExternalNoExtract)"
                                     LockFile="$(MSBuildProjectDirectory)/package-lock.json"/>
  </Target>

  <PropertyGroup>
    <_RaskExternalPropsStamp>$(_RaskExternalObj)props-$(RaskExternalTypeScriptVersion)-$(RaskExternalPropsLocked).stamp</_RaskExternalPropsStamp>
    <!-- npm's install receipt, only where it exists: a MISSING input makes MSBuild run the target on every build,
         and under npm workspaces or pnpm node_modules is not laid out here at all. -->
    <_RaskExternalPropsInstallReceipt Condition="Exists('$(MSBuildProjectDirectory)/node_modules/.package-lock.json')">$(MSBuildProjectDirectory)/node_modules/.package-lock.json</_RaskExternalPropsInstallReceipt>
    <_RaskExternalPropsInstallReceipt Condition="'$(_RaskExternalPropsInstallReceipt)' == '' AND Exists('$(MSBuildProjectDirectory)/package-lock.json')">$(MSBuildProjectDirectory)/package-lock.json</_RaskExternalPropsInstallReceipt>
  </PropertyGroup>

  <!--
    Re-extracts when a declaring class, a committed snapshot, the installed packages, the extractor or the pinned
    compiler changes. The snapshots are inputs too, so a snapshot edited or deleted by hand is put back: a
    missing input makes MSBuild run the target rather than skip it.
  -->
  <Target Name="_RaskExternalExtractProps"
          DependsOnTargets="ResolveProjectReferences;_RaskExternalProbeNode;_RaskExternalInstallCore"
          Condition="'@(_RaskExternalPackageIsland)' != '' AND '$(_RaskExternalCanExtract)' == 'true'"
          Inputs="@(_RaskExternalPackageIsland->'%(DeclaringFile)');@(_RaskExternalPackageIsland);$(MSBuildProjectDirectory)/package.json;$(_RaskExternalPropsInstallReceipt);$(MSBuildThisFileDirectory)rask-extract-props.mjs"
          Outputs="$(_RaskExternalPropsStamp)">
    <ResolveTypeScriptToolTask Tool="typescript"
                               Version="$(RaskExternalTypeScriptVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskExternalTypeScriptPath"/>
    </ResolveTypeScriptToolTask>

    <Delete Files="$(_RaskExternalObj)props/result.json"/>
    <WriteExternalPropsRequestTask Islands="@(_RaskExternalPackageIsland)"
                                   TypeScriptPath="$(_RaskExternalTypeScriptPath)"
                                   ProjectDirectory="$(MSBuildProjectDirectory)"
                                   OutputDirectory="$(_RaskExternalObj)props"
                                   RequestPath="$(_RaskExternalObj)props/request.json"/>

    <Message Importance="high" Text="Rask.External: reading the props of @(_RaskExternalPackageIsland->Count()) package island(s)"/>
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)rask-extract-props.mjs&quot; &quot;$(_RaskExternalObj)props/request.json&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"/>

    <SyncExternalPropsSnapshotsTask Islands="@(_RaskExternalPackageIsland)"
                                    OutputDirectory="$(_RaskExternalObj)props"
                                    Locked="$(RaskExternalPropsLocked)"/>

    <Touch Files="$(_RaskExternalPropsStamp)" AlwaysCreate="true"/>
  </Target>

  <!-- A snapshot the extraction just created did not exist when the glob above ran, so it joins here. -->
  <Target Name="_RaskExternalAddSnapshots" Condition="'@(_RaskExternalPackageIsland)' != ''">
    <ItemGroup>
      <AdditionalFiles Remove="@(_RaskExternalPackageIsland)"/>
      <AdditionalFiles Include="@(_RaskExternalPackageIsland)" Condition="Exists('%(FullPath)')"/>
    </ItemGroup>
  </Target>

  <Target Name="_RaskExternalVendorAdapters"
          DependsOnTargets="_RaskExternalPairLitFiles"
          Condition="'$(_RaskExternalEnabled)' == 'true'"
          Inputs="@(_RaskExternalAdapterSource)"
          Outputs="@(_RaskExternalAdapterSource->'$(_RaskExternalAdapters)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(_RaskExternalAdapterSource)" DestinationFolder="$(_RaskExternalAdapters)"
          SkipUnchangedFiles="true"/>
  </Target>

  <!--
    AFTER the compile: the island's C# has to be valid before its front end is worth bundling, and a
    bundle that preceded the compile would build against a component the generator has not accepted.
  -->
  <Target Name="_RaskExternalWriteInputs"
          AfterTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences;_RaskExternalVendorAdapters"
          Condition="'$(_RaskExternalEnabled)' == 'true' AND '@(_RaskExternalFile)' != ''">
    <!-- AssemblyPath is what makes the C# base class, not the file extension, decide the runtime.
         React, Preact and Solid all write .tsx and Lit and Angular both write .ts, so the glob that
         found the file cannot tell which runtime owns it — and the wrong guess is silent. -->
    <WriteExternalBuildInputsTask Islands="@(_RaskExternalFile)"
                                IntermediateDirectory="$(_RaskExternalObj)"
                                AdapterDirectory="$(_RaskExternalAdapters)"
                                OutputDirectory="$(_RaskExternalOut)"
                                ManifestPath="$(_RaskExternalManifest)"
                                PublicBase="$(RaskExternalPublicBase)"
                                AssemblyPath="@(IntermediateAssembly->'%(FullPath)')"
                                DevServerUrl="$(_RaskExternalDevUrl)">
      <Output TaskParameter="ConfigPath" PropertyName="_RaskExternalConfig"/>
    </WriteExternalBuildInputsTask>
  </Target>

  <!--
    Probe for node before npm and vite need it.

    RaskExternalMinimumNode was declared with a comment promising exactly this ("the probe reports
    anything older rather than letting vite fail with an engines error nobody reads") and then read by
    nothing at all — the same defect Rask.Spa.Hosting had, and fixed for the same reason. Setting the
    property insisted on nothing, and an old Node reached `npm` and failed with vite's engines error,
    which is the message this exists to replace.

    The floor matches RaskSpaMinimumNode, and for the same reason: vite asks for
    `^20.19.0 || >=22.12.0`, and a numeric floor cannot express a disjoint range — a floor of 20.19.0
    would ACCEPT 21.x, which vite refuses. 22.12.0 is the lowest version that satisfies vite with no
    hole beneath it. NodeRequirementTests.The_islands_floor_matches_the_spa_floor holds the two files to the
    same number.
  -->
  <Target Name="_RaskExternalProbeNode"
          Condition="'$(_RaskExternalEnabled)' == 'true' AND '@(_RaskExternalFile)' != ''">
    <Exec Command="node --version" ContinueOnError="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_RaskExternalNodeExit"/>
      <Output TaskParameter="ConsoleOutput" PropertyName="_RaskExternalNodeVersion"/>
    </Exec>

    <Error Condition="'$(_RaskExternalNodeExit)' != '0'"
           Code="RASKISLAND001"
           Text="Rask.External: building the islands in $(MSBuildProjectName) needs Node.js, but 'node --version' did not run. Install Node.js $(RaskExternalMinimumNode) or newer from https://nodejs.org (macOS: brew install node; Windows: winget install OpenJS.NodeJS.LTS; Linux: your distro's nodejs package), then build again."/>

    <PropertyGroup Condition="'$(_RaskExternalNodeExit)' == '0'">
      <_RaskExternalNodeFound>$(_RaskExternalNodeVersion.Trim().TrimStart('v'))</_RaskExternalNodeFound>
      <_RaskExternalNodeComparable>$([System.Text.RegularExpressions.Regex]::IsMatch($(_RaskExternalNodeFound), '^[0-9]+\.[0-9]+\.[0-9]+$'))</_RaskExternalNodeComparable>
    </PropertyGroup>

    <!--
      A version string that is not exactly X.Y.Z (a nightly, a release candidate) is SKIPPED rather
      than failed: refusing to build on an unparseable version would be a worse failure than the one
      this prevents. Same call as the SPA probe.
    -->
    <Error Condition="'$(_RaskExternalNodeComparable)' == 'true' AND $([MSBuild]::VersionLessThan('$(_RaskExternalNodeFound)', '$(RaskExternalMinimumNode)'))"
           Code="RASKISLAND001"
           Text="Rask.External: building the islands in $(MSBuildProjectName) needs Node.js $(RaskExternalMinimumNode) or newer, but 'node --version' reported $(_RaskExternalNodeFound). Vite asks for ^20.19.0 || >=22.12.0, so a 20.19.x or 21.x Node fails inside the bundler instead. Install the current LTS (nvm install --lts, or https://nodejs.org), then build again. Set RaskExternalMinimumNode if you want a different bar."/>
  </Target>

  <!--
    Its own target with its own up-to-date check, because it is the expensive one.

    Split from _RaskExternalInstall so the props extraction can install BEFORE the compile without dragging the
    post-compile entry writing along: MSBuild never runs a target twice, so depending on the whole of
    _RaskExternalInstall there would have written the entries with no assembly to read runtimes from. A project
    with only file islands still installs after the compile, exactly as before.
  -->
  <Target Name="_RaskExternalInstallCore"
          DependsOnTargets="_RaskExternalProbeNode"
          Condition="'$(_RaskExternalEnabled)' == 'true' AND '@(_RaskExternalFile)' != ''"
          Inputs="$(MSBuildProjectDirectory)/package.json"
          Outputs="$(IntermediateOutputPath)rask-external.install.stamp">
    <PropertyGroup>
      <_RaskExternalInstall Condition="Exists('$(MSBuildProjectDirectory)/package-lock.json')">$(RaskExternalInstallCommand)</_RaskExternalInstall>
      <_RaskExternalInstall Condition="'$(_RaskExternalInstall)' == ''">$(RaskExternalFirstInstallCommand)</_RaskExternalInstall>
    </PropertyGroup>
    <Message Importance="high" Text="Rask.External: $(_RaskExternalInstall) in $(MSBuildProjectDirectory)"/>
    <Exec Command="$(_RaskExternalInstall)" WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"/>
    <MakeDir Directories="$(IntermediateOutputPath)"/>
    <Touch Files="$(IntermediateOutputPath)rask-external.install.stamp" AlwaysCreate="true"/>
  </Target>

  <Target Name="_RaskExternalInstall"
          DependsOnTargets="_RaskExternalWriteInputs;_RaskExternalProbeNode;_RaskExternalInstallCore"
          Condition="'$(_RaskExternalEnabled)' == 'true' AND '@(_RaskExternalFile)' != ''"/>

  <!--
    The bundle is written INTO wwwroot but after @(Content) has already been globbed, so nothing the
    SDK discovered at evaluation knows about it. MapStaticAssets serves only what reached the
    endpoints manifest, so without this the chunk and manifest.json fall through to the UseRask
    catch-all and come back as the page's own HTML — the client then reports
    `Unexpected token '<'` and no component mounts (#884). app.UseStaticFiles() papered over it by
    serving the physical directory; that is a workaround for a missing registration, not a fix.

    Registered in the BUILD computed pass only. The assets are AssetKind=All, so they flow into the
    publish manifest on their own; contributing in both passes double-registers the same ItemSpec and
    trips the SDK's duplicate-key guard — the same rule Rask.Wasm's scoped bake documents.

    ContentRoot is wwwroot rather than the bundle directory, with RelativePathPattern="wwwroot/**",
    exactly as the SDK's own ResolveProjectStaticWebAssets does it: the relative path has to keep the
    _rask/external/ prefix or the files would be served from the root. FingerprintCandidates stays
    false because Vite has already hashed the chunk names and the generated manifest points at them —
    a second fingerprint would rename the file out from under it.
  -->
  <Target Name="_RaskExternalStaticWebAssets"
          BeforeTargets="GenerateComputedBuildStaticWebAssets"
          DependsOnTargets="_RaskExternalBundle"
          Condition="'$(_RaskExternalEnabled)' == 'true' AND '@(_RaskExternalFile)' != ''">
    <ItemGroup>
      <_RaskExternalBundled Include="$(RaskExternalOutputDir)/**/*"/>
    </ItemGroup>
    <DefineStaticWebAssets Condition=" '@(_RaskExternalBundled)' != '' "
                           CandidateAssets="@(_RaskExternalBundled)"
                           SourceType="Computed"
                           SourceId="$(PackageId)"
                           ContentRoot="$(MSBuildProjectDirectory)\wwwroot\"
                           BasePath="$(StaticWebAssetBasePath)"
                           RelativePathPattern="wwwroot/**"
                           FingerprintCandidates="false">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset"/>
      <Output TaskParameter="Assets" ItemName="_RaskExternalStaticWebAsset"/>
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints Condition=" '@(_RaskExternalStaticWebAsset)' != '' "
                                   CandidateAssets="@(_RaskExternalStaticWebAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint"/>
    </DefineStaticWebAssetEndpoints>
  </Target>

  <!--
    Assert on the SHIPPED artifact, not on the files.

    #884 published every chunk correctly and still served none of them: the files reached
    $(PublishDir)wwwroot but never reached the endpoints manifest, and MapStaticAssets serves only
    what is in that manifest. A guard that checked for the files on disk — which is what the scoped
    asset guard in Rask.Wasm does — would have passed the whole time the feature was broken. So this
    one reads the manifest that decides whether a URL answers.
  -->
  <Target Name="_RaskExternalVerifyPublishedAssets"
          AfterTargets="Publish"
          Condition="'$(_RaskExternalEnabled)' == 'true' AND '@(_RaskExternalFile)' != ''">
    <PropertyGroup>
      <_RaskExternalEndpoints>$(PublishDir)$(AssemblyName).staticwebassets.endpoints.json</_RaskExternalEndpoints>
      <_RaskExternalEndpointsText Condition="Exists('$(_RaskExternalEndpoints)')">$([System.IO.File]::ReadAllText('$(_RaskExternalEndpoints)'))</_RaskExternalEndpointsText>
      <!-- The manifest stores routes without a leading slash, so probe on the trimmed prefix. -->
      <_RaskExternalRouteProbe>$(RaskExternalPublicBase.TrimStart('/'))</_RaskExternalRouteProbe>
    </PropertyGroup>
    <Error Condition="Exists('$(_RaskExternalEndpoints)') AND !$(_RaskExternalEndpointsText.Contains('$(_RaskExternalRouteProbe)'))"
           Code="RASKISLAND003"
           Text="Rask.External: the bundle was published but no endpoint serves it. '$(_RaskExternalEndpoints)' contains no route under '$(RaskExternalPublicBase)', and app.MapStaticAssets() serves only what that manifest lists — so every chunk request would fall through to the UseRask catch-all and come back as the page's HTML, and the client would report `Unexpected token '&lt;'` with nothing mounted. The bundle output has to be registered as a static web asset, which _RaskExternalStaticWebAssets does; check it ran and that RaskExternalOutputDir still sits under wwwroot (#884)."/>

    <!--
      What this does NOT cover (#944).

      The check above is conditioned on the endpoints manifest existing. A host that sets
      StaticWebAssetsEnabled=false writes none and serves the bundle from disk, so the guard would pass
      by skipping there — #884's own failure shape wearing the opposite sign.

      That case turns out to be unreachable for the WASM lane rather than merely unguarded, which is
      worth writing down because the issue assumed otherwise. The islands live in the browser-WASM app
      project, not in an ASP.NET host in front of it — and the host, which is what sets the property,
      owns no island files, so this target's own condition excludes it. Setting the property on the app
      project instead is refused by the WASM SDK itself: `error MSB4057: The target
      "LoadStaticWebAssetsBuildManifest" does not exist in the project`.

      So for the WASM lane the endpoints manifest IS written into PublishDir and the check above is live.
      Verified by publishing the repo's browser-WASM app and finding both
      publish/{App}.staticwebassets.endpoints.json and publish/wwwroot/_rask/external/manifest.json.

      An Error for the serve-from-disk case was written and then removed rather than shipped: it could
      not be made to fire in this repository under any configuration that builds, and a guard nobody has
      watched fail is the thing this repository keeps a casebook about.

      The browser half is now covered: WasmIslandsExampleTests drives the published WASM host and asserts
      every runtime mounts, takes its C# props, re-enters C# through a callback, and reconciles a prop
      change rather than remounting. So #944 is closed — what is left here is the note above about why
      the StaticWebAssetsEnabled=false branch is unreachable rather than unguarded, which is still true.
    -->
  </Target>

  <!--
    Where `rask dev` finds the dev server it should start.

    Written to the STABLE obj path — obj/rask-external/, not obj/Debug/net10.0/rask-external/ — for
    the same reason tsconfig.paths.json is: the CLI has to name this file without knowing which
    configuration or target framework the build chose, and a path that moved between Debug and
    Release would be one the CLI could only guess at.

    It carries the config's real path rather than a recipe for computing one, so the CLI stays out of
    the business of knowing how Rask lays out obj/.
  -->
  <Target Name="_RaskExternalAnnounceDevServer"
          AfterTargets="_RaskExternalWriteInputs"
          Condition="'$(_RaskExternalDevUrl)' != '' AND '@(_RaskExternalFile)' != ''
                     AND '$(_RaskExternalEnabled)' == 'true' AND '$(_RaskExternalConfig)' != ''">
    <Message Importance="high"
             Text="Rask.External: @(_RaskExternalFile->Count()) island(s) served from $(_RaskExternalDevUrl) (hot reload); the production bundle is skipped."/>

    <MakeDir Directories="$(_RaskExternalStableObj)"/>
    <WriteLinesToFile File="$(_RaskExternalStableObj)dev.json"
                      Lines="{ &quot;url&quot;: &quot;$(_RaskExternalDevUrl)&quot;, &quot;config&quot;: &quot;$(_RaskExternalConfig.Replace('%5C','/'))&quot; }"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"/>
  </Target>

  <!--
    The manifest is listed first among the Outputs so that deleting the bundle by hand forces a
    rebuild even though the stamp file survives.
  -->
  <Target Name="_RaskExternalBundle"
          AfterTargets="CoreCompile"
          DependsOnTargets="_RaskExternalInstall"
          Condition="'$(_RaskExternalEnabled)' == 'true' AND '@(_RaskExternalFile)' != ''
                     AND '$(_RaskExternalDevUrl)' == ''"
          Inputs="@(_RaskExternalFile);$(_RaskExternalConfig)"
          Outputs="$(_RaskExternalManifest);$(IntermediateOutputPath)rask-external.build.stamp">
    <Message Importance="high" Text="Rask.External: bundling @(_RaskExternalFile->Count()) island(s) ($(Configuration))"/>
    <Exec Command="$(RaskExternalBuildCommand) &quot;$(_RaskExternalConfig)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreStandardErrorWarningFormat="true"/>
    <Error Condition="!Exists('$(_RaskExternalManifest)')"
           Code="RASKISLAND002"
           Text="Rask.External: the bundler finished but wrote no manifest at '$(_RaskExternalManifest)'. The client runtime resolves an island's chunk through that file, so every island on the page would fail to mount."/>
    <MakeDir Directories="$(IntermediateOutputPath)"/>
    <Touch Files="$(IntermediateOutputPath)rask-external.build.stamp" AlwaysCreate="true"/>
  </Target>

</Project>
