<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <PackageId>Rask.Cqrs</PackageId>
    <Title>Rask.Cqrs — Source-Generated CQRS/Mediator</Title>
    <Description>Source-generated, reflection-free CQRS/mediator for .NET. Define `IQuery&lt;T&gt;`, `ICommand`, `ICommand&lt;T&gt;` and `INotification` messages with their handlers, then dispatch through `IDispatcher` with the response type inferred — no runtime reflection and no assembly scanning, so it publishes clean under the WASM/AOT trimmer. Pipeline behaviors provide the decorator hook for cross-cutting logging/validation/transactions. Standalone: depends only on Microsoft.Extensions.DependencyInjection.Abstractions.</Description>
    <!-- Override the framework default tags (web/component/wasm) — Rask.Cqrs is a standalone,
         host-agnostic mediator with no web/UI coupling. -->
    <PackageTags>cqrs mediator dispatcher source-generator reflection-free aot trimming dotnet net10</PackageTags>
  </PropertyGroup>

  <!-- Ship a package-specific README (this project's NUGET.md) instead of the shared framework
       overview that Directory.Build.props packs by default; PackageReadmeFile=NUGET.md is inherited. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\NUGET.md" />
    <None Remove="NUGET.md" />
    <None Include="NUGET.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
  </ItemGroup>

  <!--
    The JSON primitives the generated codecs call, and the two file carriers. They live in their own
    package because Rask.Api generates codecs against the same primitives: duplicating them would put
    two of each type on the path of an app using both, and having Rask.Api depend on this package
    would drag a mediator into an app that only wanted REST.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Wire\Rask.Wire.csproj"/>
  </ItemGroup>

  <!--
    The batteries source generator is referenced as an analyzer (no runtime assembly reference),
    keeping Rask.Cqrs self-contained: consumers get the generator without pulling in the Rask
    component/routes generators. See src/Rask.Batteries.Generators.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Rask.Batteries.Generators\Rask.Batteries.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!-- Ship the global `using Rask.Cqrs;` to downstream consumers. -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\"/>
  </ItemGroup>

  <!--
    Pack the batteries source generator into analyzers/dotnet/cs/ so NuGet consumers run it.

    This package is the ONLY one that ships it, and that is load-bearing rather than incidental. The
    assembly holds the jobs and outbox registry generators as well as the CQRS ones, and Rask.Jobs and
    Rask.Outbox both take a package dependency on Rask.Cqrs — so the analyzer reaches every consumer
    transitively, and reaches it exactly ONCE. Packing it from Rask.Jobs or Rask.Outbox too would put
    the same generator on the analyzer path two or three times for anything referencing more than one
    battery (the Rask metapackage references all of them), and each copy emits the same registry type
    again.
  -->
  <ItemGroup>
    <None Include="..\Rask.Batteries.Generators\bin\$(Configuration)\netstandard2.0\Rask.Batteries.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false"/>
  </ItemGroup>

  <!--
    Fail loud at pack time if the analyzer is missing, instead of shipping a package that silently
    generates nothing: a <None Include> of an absent file packs nothing and emits no error. Mirrors
    _RaskVerifyAnalyzersPacked in RaskAnalyzerPack.targets, which guards the host packages the same way.
  -->
  <Target Name="_RaskVerifyBatteriesAnalyzerPacked" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('..\Rask.Batteries.Generators\bin\$(Configuration)\netstandard2.0\Rask.Batteries.Generators.dll')"
           Text="Rask.Batteries.Generators.dll not found at '..\Rask.Batteries.Generators\bin\$(Configuration)\netstandard2.0\Rask.Batteries.Generators.dll' — build Rask.Batteries.Generators before packing, or consumers get no CQRS dispatch, job registry or outbox registry generation." />
  </Target>

</Project>
