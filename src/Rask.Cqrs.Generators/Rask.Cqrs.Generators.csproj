<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The wire model and its emitters are internal: they are an implementation detail of the
         generated code, not an API. The tests assert the TypeScript an emitter produces, which is
         cheaper and far more legible than round-tripping it through a full generator run. -->
    <InternalsVisibleTo Include="Rask.Cqrs.Generators.Tests"/>
  </ItemGroup>

  <!--
    Shares the registerability rules with the jobs/outbox registry generators (whether a type can be
    named in a valid typeof(...) from a generated file), and the wire model + TypeScript emitter with
    the island generator. This generator keeps its own DiagnosticHelp and IsExternalInit, so link the
    files rather than globbing the folder.

    Source-level sharing, not an assembly reference: an analyzer that referenced another analyzer
    assembly would have to ship it, and a type reaching a consumer through two packages is emitted
    twice. Each generator compiles its own copy of these internals instead.
  -->
  <ItemGroup>
    <Compile Include="..\Rask.Generators.Shared\SymbolRegistration.cs" Link="Shared\SymbolRegistration.cs"/>
    <Compile Include="..\Rask.Generators.Shared\WireShape.cs" Link="Shared\WireShape.cs"/>
    <Compile Include="..\Rask.Generators.Shared\TypeScriptEmitter.cs" Link="Shared\TypeScriptEmitter.cs"/>
  </ItemGroup>

</Project>
