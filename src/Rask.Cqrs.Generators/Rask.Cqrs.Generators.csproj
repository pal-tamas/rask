<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The wire model and its emitters are internal: they are an implementation detail of the
         generated code, not an API. The tests assert the TypeScript an emitter produces, which is
         cheaper and far more legible than round-tripping it through a full generator run. -->
    <InternalsVisibleTo Include="Rask.Cqrs.Generators.Tests"/>
  </ItemGroup>

  <!--
    Shares only the registerability rules with the jobs/outbox registry generators: whether a type can
    be named in a valid typeof(...) from a generated file. This generator keeps its own DiagnosticHelp
    and IsExternalInit, so link the one file rather than globbing the folder.
  -->
  <ItemGroup>
    <Compile Include="..\Rask.Generators.Shared\SymbolRegistration.cs" Link="Shared\SymbolRegistration.cs"/>
  </ItemGroup>

</Project>
