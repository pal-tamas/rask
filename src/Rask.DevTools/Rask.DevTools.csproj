<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both faces: the devtools attach to a Server host and to a browser-WASM host alike. -->
    <TargetFrameworks>$(RaskNetTargets);$(RaskBrowserTargets)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <!--
      Trimmable, so a trimmed browser publish that never roots this assembly drops it WHOLE. That is the
      browser half of "a Release build carries no devtools": the feature switch folds the loader away, and
      with nothing left referencing the assembly the trimmer removes it. A Debug build roots it instead
      (see buildTransitive/Rask.DevTools.targets).
    -->
    <IsTrimmable Condition="'$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browser'">true</IsTrimmable>
    <IsAotCompatible Condition="'$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browser'">true</IsAotCompatible>
    <!-- The browser face's [JSImport] declarations: the generator marshals through unsafe code. -->
    <AllowUnsafeBlocks Condition="'$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browser'">true</AllowUnsafeBlocks>

    <PackageId>Rask.DevTools</PackageId>
    <Title>Rask — DevTools</Title>
    <Description>Debug-only developer tools for Rask apps on ASP.NET Core and .NET WebAssembly. Referencing it attaches the tools to both hosts in a Debug build with no code in the app, and a Release publish carries none of it: the build strips the assembly and its deps.json entry, then fails if either remains. The in-page tools themselves are in progress.</Description>
    <PackageTags>dotnet csharp aspnetcore webassembly wasm net10 devtools debugging developer-tools</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.DevTools.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="all": Rask.Core is IsPackable=false and ships transitively inside the host
         packages, so naming it as a nuspec dependency would reference a package on no feed. -->
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      The component kit the panel is drawn with — the APP's copy, not one this package brings. PrivateAssets="all" keeps
      Rask.Ui out of the nuspec: as a dependency it rode into every Release publish of an app that never referenced it,
      and left a Rask.DevTools entry in deps.json that failed the publish guard. Every `rask new` template and the Rask
      meta-package reference Rask.Ui; an app without it gets no devtools and one startup warning (DevToolsUiKit).
    -->
    <ProjectReference Include="..\Rask.Ui\Rask.Ui.csproj" PrivateAssets="all"/>
    <!-- Emits this assembly's chain entries and the module initializer that registers the panel's [Route] pages. -->
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    The Server face. Rask.Server is PrivateAssets="all" too: only its AddRask runs the Server half of the
    bootstrap, so any app in which that code runs already references the host. Declaring it would pull the
    Server host into a net10.0 app that referenced the devtools without one.

    It also carries the editor-launched dev session (Server/): an app VS Code's F5 started under its debugger is
    served on https://<name>.test when `rask dev` has already set that name up, and says where the browser should
    go. The dev-host layout is source-linked from the one place `rask dev` also compiles it from, so the name and
    the certificate this finds are exactly the ones `rask dev` made. Only the layout files: EditorDevSession and
    IslandDevPointer arrive with Rask.Server, whose internals this assembly sees, and a second copy of either
    would conflict with that one (CS0436).
  -->
  <ItemGroup Condition=" '$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == '' ">
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <ProjectReference Include="..\Rask.Server\Rask.Server.csproj" PrivateAssets="all"/>
    <EmbeddedResource Include="$(IntermediateOutputPath)rask-devtools-host.js"
                      LogicalName="Rask.DevTools.Resources.rask-devtools-host.js"/>
    <!-- No browser runtime here: no page origin to read, no module to import, no panel to run in the page. -->
    <Compile Remove="DevToolsBootstrap.Browser.cs;Browser\**"/>
    <Compile Include="..\Rask.Hosting.Shared\Dev\DevHostName.cs" Link="Shared\Dev\DevHostName.cs"/>
    <Compile Include="..\Rask.Hosting.Shared\Dev\DevHostFiles.cs" Link="Shared\Dev\DevHostFiles.cs"/>
    <Compile Include="..\Rask.Hosting.Shared\Dev\DevHostPaths.cs" Link="Shared\Dev\DevHostPaths.cs"/>
  </ItemGroup>

  <!--
    The browser face has no Server host to map endpoints on, and no Kestrel to bind. It reads the page's origin from
    Rask.Wasm, which is PrivateAssets="all" for Rask.Server's reason: only a WASM host runs this half of the bootstrap, so
    every app in which it runs already references Rask.Wasm. Its scripts are embedded, like the Server face's, so a
    Release publish that strips the assembly strips them with it.
  -->
  <ItemGroup Condition=" '$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browser' ">
    <Compile Remove="DevToolsBootstrap.Server.cs;Endpoints\**;Server\**"/>
    <ProjectReference Include="..\Rask.Wasm\Rask.Wasm.csproj" PrivateAssets="all"/>
    <EmbeddedResource Include="$(IntermediateOutputPath)rask-devtools-wasm.js"
                      LogicalName="Rask.DevTools.Resources.rask-devtools-wasm.js"/>
    <EmbeddedResource Include="$(IntermediateOutputPath)rask-devtools-frame.js"
                      LogicalName="Rask.DevTools.Resources.rask-devtools-frame.js"/>
  </ItemGroup>

  <!--
    Every file the host bundle can reach, so an edit to any of them re-bundles (a target's Inputs does not
    expand wildcards itself). Under Resources/ like the hosts' own runtimes, and for the same reason: the
    scoped-TypeScript glob in Rask.Core.targets excludes that folder. Anywhere else the host script would be
    compiled as a component's scoped asset and handed to the generators.
  -->
  <ItemGroup>
    <_RaskDevToolsHostTs Include="Resources\**\*.ts" Exclude="Resources\**\*.d.ts"/>
    <!-- The WASM panel frame bundles Rask.Core's DOM, morph and event modules, so their edits re-bundle it too. -->
    <_RaskDevToolsFrameTs Include="@(_RaskDevToolsHostTs);..\Rask.Core\Resources\*.ts"/>
  </ItemGroup>

  <PropertyGroup>
    <!-- Minified in Release only, so a Debug build stays readable in the browser's debugger. -->
    <_RaskEsbuildMinify Condition=" '$(Configuration)' == 'Release' ">--minify</_RaskEsbuildMinify>
  </PropertyGroup>

  <!--
    The host script, bundled the way Rask.Server bundles rask.js: an iife delivered by a plain <script src>,
    es2019 like the runtime it sits beside, embedded for the endpoint to serve.
  -->
  <Target Name="_RaskDevToolsBundleHostJs" BeforeTargets="PrepareForBuild" DependsOnTargets="ResolveProjectReferences"
          Condition=" '$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == '' "
          Inputs="@(_RaskDevToolsHostTs)"
          Outputs="$(IntermediateOutputPath)rask-devtools-host.js">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(IntermediateOutputPath)"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;$(MSBuildProjectDirectory)/Resources/rask-devtools-host.ts&quot; --bundle --format=iife --target=es2019 --log-level=warning --outfile=&quot;$(IntermediateOutputPath)rask-devtools-host.js&quot; $(_RaskEsbuildMinify)"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <!--
    The browser face's two scripts. The page module is an ES module, because [JSImport] calls its exports by name; the
    panel frame's client is an iife, inlined into the frame's document.
  -->
  <Target Name="_RaskDevToolsBundleWasmJs" BeforeTargets="PrepareForBuild" DependsOnTargets="ResolveProjectReferences"
          Condition=" '$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'browser' "
          Inputs="@(_RaskDevToolsFrameTs)"
          Outputs="$(IntermediateOutputPath)rask-devtools-wasm.js;$(IntermediateOutputPath)rask-devtools-frame.js">
    <ResolveTypeScriptToolTask Tool="esbuild"
                               Version="$(RaskEsbuildVersion)"
                               CacheRoot="$(RaskTypeScriptCacheRoot)"
                               Registry="$(RaskTypeScriptRegistry)"
                               Offline="$(RaskTypeScriptOffline)">
      <Output TaskParameter="ToolPath" PropertyName="_RaskEsbuildPath"/>
    </ResolveTypeScriptToolTask>

    <MakeDir Directories="$(IntermediateOutputPath)"/>

    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;$(MSBuildProjectDirectory)/Resources/rask-devtools-wasm.ts&quot; --bundle --format=esm --target=es2020 --log-level=warning --outfile=&quot;$(IntermediateOutputPath)rask-devtools-wasm.js&quot; $(_RaskEsbuildMinify)"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
    <Exec Command="&quot;$(_RaskEsbuildPath)&quot; &quot;$(MSBuildProjectDirectory)/Resources/rask-devtools-frame.ts&quot; --bundle --format=iife --target=es2020 --log-level=warning --outfile=&quot;$(IntermediateOutputPath)rask-devtools-frame.js&quot; $(_RaskEsbuildMinify)"
          WorkingDirectory="$(MSBuildProjectDirectory)"/>
  </Target>

  <ItemGroup>
    <!--
      Packed to BOTH folders. NuGet imports build/ for a direct PackageReference (the scaffolded apps) and
      buildTransitive/ for a package that arrives through another one (the `Rask` meta-package). Named
      literally rather than globbed: a glob that matches nothing packs nothing and still exits 0 (#852).

      Each destination is a full FILE path, not a folder. `PackagePath="build\;buildTransitive\"` packs
      `build//Rask.DevTools.targets` — a doubled separator NuGet does not match against the package id, so
      pack fails NU5129 and a consumer's restore would not import the targets at all. In-repo nothing can
      see that: Directory.Build.targets imports the file straight off disk. Only `dotnet pack` can.
    -->
    <None Include="buildTransitive\Rask.DevTools.targets" Pack="true"
          PackagePath="build\Rask.DevTools.targets;buildTransitive\Rask.DevTools.targets"/>
  </ItemGroup>

</Project>
