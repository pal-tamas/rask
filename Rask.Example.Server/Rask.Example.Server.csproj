<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\Rask.Server\Rask.Server.csproj"/>
    <ProjectReference Include="..\Rask.Example.Components\Rask.Example.Components.csproj"/>
    <ProjectReference Include="..\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!--
    The ASP.NET Web SDK's static-web-assets loader instantiates a
    PhysicalFileProvider over the project's source wwwroot/ at startup, and throws
    DirectoryNotFoundException if the directory is missing. This example has no
    static files of its own — but the directory must exist for the SDK to be happy.
  -->
  <Target Name="EnsureEmptyWwwroot" BeforeTargets="BeforeBuild">
    <MakeDir Directories="wwwroot"/>
  </Target>

</Project>
