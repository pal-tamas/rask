<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Rask WASM marker: gates build/Rask.Wasm.targets (wwwroot staging + scoped-asset bake). -->
    <RaskWasm>true</RaskWasm>
    <!--
      Render every route to real HTML at publish. This is the framework's own front door, and without it
      the first thing every visitor and every crawler received was the boot shell — a spinner and the
      word "Loading" — because the real markup did not exist until megabytes of runtime had downloaded.
      That is what a search engine indexed and what a social card previewed.

      Publish-only, so the inner loop does not pay for it. The pass writes into the published wwwroot and
      splices each page into the boot shell, so the bundle still boots and takes the page over.
    -->
    <RaskPrerender>true</RaskPrerender>
    <!-- Fingerprint framework assets + fill the index.html import map / preload placeholders at
         publish, so static-host (GitHub Pages) redeploys stay subresource-integrity-safe. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Full WASM AOT is opt-in (-p:RaskWasmAot=true); the default keeps the Mono interpreter.
         Both are gated off the fast no-native build (-p:WasmBuildNative=false, used by the CI unit
         gate), which records an empty runtime-pack default that conflicts with a relink. -->
    <RunAOTCompilation Condition=" '$(RaskWasmAot)' == 'true' ">true</RunAOTCompilation>
    <RunAOTCompilation Condition=" '$(RaskWasmAot)' != 'true' and '$(WasmBuildNative)' != 'false' ">false</RunAOTCompilation>
    <!-- Enforce AOT/trim-safety on every build under warnings-as-errors, long before the slow relink. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Trimming is safe: page types reach the runtime via the route registry's generated module
         initialiser ([DynamicDependency] per registered page). -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!--
      NO RaskGlobalization, so the ~2.6 MB of ICU data stays out of the bundle. The landing page formats
      no culture-sensitive value: every number on it is a literal in the markup.

      It used to opt in, under a comment describing a different application — "this app hosts the
      guides, and the localization guide's demo formats the same values across four languages". That is
      the docs showcase, at /docs/. The comment arrived here with a copy of the showcase's csproj and
      nothing contradicted it, so the front door carried the largest single asset in the bundle for a
      feature it does not have.
    -->
    <!-- Suppress IL2104 from Microsoft.JSInterop's reflection-driven [JSInvokable] scanner. This page
         no longer references that package directly — it ships no JavaScript and injects no IJSRuntime —
         but it still arrives transitively through the WASM host, and a trimmed publish still fails on
         its warnings. This app marks nothing [JSInvokable], so the scanned path is never taken. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Wasm\Rask.Wasm.csproj"/>
    <!-- Rask.Wasm marks Rask.Core / Rask.Html PrivateAssets="all" (kept out of its nuspec deps),
         so an in-repo consumer referencing the host by ProjectReference must pull them in directly. -->
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <!-- The component kit the operator console and the docs showcase are drawn with. The landing page
         takes the parts that fit a marketing page — buttons, metrics, detail lists, code blocks, icons
         and the palette — and builds its own sections from Tailwind; it has no tab bar to put in a
         UiNav and no breadcrumb to switch. -->
    <ProjectReference Include="..\..\src\Rask.Ui\Rask.Ui.csproj"/>
    <!-- Build-order edge only. The Tailwind wiring itself arrives from Directory.Build.{props,targets}
         (and, for a scaffolded app, from inside the host package) — this reference exists so that
         Rask.Tailwind.Tasks.dll is on disk before the UsingTask that loads it runs. Build-only: an
         MSBuild task and a CLI run, not an assembly, so the payload is unchanged. -->
    <ProjectReference Include="..\..\src\Rask.Tailwind\Rask.Tailwind.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>



  <PropertyGroup>
    <!--
      Take the kit's stylesheet as a cached FILE rather than inlining it. Opt-in, because referencing
      the kit is not the same as wanting a file in wwwroot — see Rask.Ui's build targets. Linked in
      App.HeadAssets with UiStylesheet.Href().
    -->
    <RaskUiWriteStylesheet>true</RaskUiWriteStylesheet>
  </PropertyGroup>

</Project>
