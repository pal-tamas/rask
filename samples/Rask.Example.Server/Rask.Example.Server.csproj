<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      This app has no scoped TypeScript. Its only .ts is LitBadge.ts — a Lit ISLAND — and the two
      features share a convention exactly: scoped TS is `Name.ts` beside `Name.cs`, and so is a Lit
      island. Nothing in MSBuild can tell them apart, because the only difference is whether the C#
      class derives from LitComponent, which Roslyn knows and a glob does not.

      Left on, the scoped pipeline compiles the island's file as a component asset AND the island
      build bundles it, and the repo-wide scoped type-check fails on `@rask/LitBadge.props` — a
      mapping that exists only in the island's own generated tsconfig. Turning it off here is exact
      rather than a workaround: there is no scoped TypeScript in this project to turn off.
    -->
    <RaskScopedTsAutoInclude>false</RaskScopedTsAutoInclude>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Signaling\Rask.Signaling.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Server\Rask.Server.csproj"/>
    <ProjectReference Include="..\..\src\Rask.WebPush\Rask.WebPush.csproj"/>
    <!-- The islands showcase. This is the sample carrying a package.json, so it is the one that can
         build React, Vue, Svelte and Lit components. -->
    <ProjectReference Include="..\..\src\Rask.External\Rask.External.csproj"/>
    <!-- The Blazor island showcase, on the host where a hosted component's browser call has to come
         back over a WebSocket. The WASM showcase gates trimming; this one gates the live path. -->
    <ProjectReference Include="..\..\src\Rask.Blazor\Rask.Blazor.csproj"/>
    <ProjectReference Include="..\Rask.Example.Razor\Rask.Example.Razor.csproj"/>
    <ProjectReference Include="..\Rask.Example.Shared\Rask.Example.Shared.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!-- Embed the Server-only demo sources verbatim so CodeSample can show the real file text beside the
       live Result (the Server PWA demo lives here, not in Rask.Example.Shared). EmbeddedSource reads them
       as raksrc/{leaf}; Program.cs registers this app assembly with EmbeddedSource so the lookup finds
       them. A .cs stays compiled too; this only adds its text as a manifest resource. -->
  <ItemGroup>
    <EmbeddedResource Include="Features/**/*.cs;Features/**/*.js;Features/**/*.css;Features/**/*.ts;Features/**/*.tsx;Features/**/*.vue;Features/**/*.svelte">
      <LogicalName>raksrc/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Guard the bare-leaf LogicalName: a duplicate leaf would silently overwrite another in the manifest
       (last writer wins). Only raksrc/ items are checked. -->
  <Target Name="VerifyUniqueEmbeddedSourceNames" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_RaskEmbeddedLeaf Include="@(EmbeddedResource->'%(LogicalName)')"
                         Condition="$([System.String]::Copy('%(LogicalName)').StartsWith('raksrc/'))"/>
    </ItemGroup>
    <Error Condition="'@(_RaskEmbeddedLeaf->Distinct()->Count())' != '@(_RaskEmbeddedLeaf->Count())'"
           Text="Duplicate embedded-source leaf name(s) under Features/. EmbeddedSource resolves by bare filename (raksrc/{leaf}), so every embedded .cs/.js/.css must have a unique file name across the project (and not collide with a Rask.Example.Shared leaf). Rename the collision." />
  </Target>

  <!-- The kit's namespace, project-wide. Its icons and components are named in markup all over this
       project, and a per-file using on ~60 files would be noise. Mirrors how Rask.Html imports
       Rask.Core for the same reason. -->
  <ItemGroup>
    <Using Include="Rask.Ui"/>
  </ItemGroup>

</Project>
