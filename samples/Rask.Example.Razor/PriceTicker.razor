@* A real Blazor component, compiled by the Razor SDK, that knows nothing about Rask.

   Hosted by Rask.Example.Wasm's PriceTickerIsland (a BlazorComponent<PriceTicker>), which is what
   puts it on the page — parameters arrive as live C# objects, and the @onclick and @bind below
   travel Rask's own handler channel rather than a Blazor circuit.

   Styled with inline `style` rather than utilities on purpose: Tailwind emits only the classes it can
   SEE, and it scans the app's project directory, not this library's. A class library that wants
   utilities ships its own compiled stylesheet — see docs/blazor-components.md. *@

<div data-testid="price-ticker"
     style="display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;padding:.75rem 1rem;
            border:1px solid #cbd5e1;border-radius:.5rem;font-family:system-ui,sans-serif">

    <strong data-testid="ticker-symbol" style="font-size:1.125rem">@Symbol</strong>

    <span data-testid="ticker-price" style="font-variant-numeric:tabular-nums">
        @Price.ToString("0.00", CultureInfo.InvariantCulture)
    </span>

    @* The hosted component's OWN event. No circuit, no SignalR: Blazor mints a handler id during the
       static render and the island writes Rask's data-rask-on-click in its place. *@
    <button type="button" data-testid="ticker-watch" @onclick="() => _watches++"
            style="padding:.25rem .75rem;border:1px solid #6366f1;border-radius:.375rem;
                   background:#eef2ff;color:#3730a3;cursor:pointer">
        Watch
    </button>

    <span data-testid="ticker-watches">watching: @_watches</span>

    @* @bind round-trips through Rask's INPUT channel, which is the one that carries a value. *@
    <input data-testid="ticker-note" @bind="_note" @bind:event="oninput" placeholder="note"
           style="padding:.25rem .5rem;border:1px solid #cbd5e1;border-radius:.375rem"/>

    @if (!string.IsNullOrWhiteSpace(_note))
    {
        <em data-testid="ticker-note-echo">@_note</em>
    }
</div>

@code {
    /// <summary>The instrument. Mandatory, and Blazor says so — which becomes a required chain step.</summary>
    [Parameter, EditorRequired]
    public string Symbol { get; set; } = "";

    /// <summary>The last price, as a live decimal rather than a serialized one.</summary>
    [Parameter]
    public decimal Price { get; set; }

    private int _watches;
    private string? _note;
}
