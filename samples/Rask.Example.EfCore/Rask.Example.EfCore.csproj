<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Server\Rask.Server.csproj"/>
    <!-- The grid slice (ProductGridPage) uses BsDataGrid. The rest of this sample stays plain Core
         components over the Bootstrap CSS the shell links from a CDN. -->
    <ProjectReference Include="..\..\src\Rask.Bootstrap\Rask.Bootstrap.csproj"/>
    <!-- UseRaskSqlite: the production SQLite pragmas (WAL, foreign_keys, busy_timeout) on every connection. -->
    <ProjectReference Include="..\..\src\Rask.SQLite.EntityFrameworkCore\Rask.SQLite.EntityFrameworkCore.csproj"/>
    <!-- The mail slice (SendMailPage) queues transactional email on the same SQLite database. -->
    <ProjectReference Include="..\..\src\Rask.Mail\Rask.Mail.csproj"/>
    <!-- The cache slice (CacheReportPage) caches computed values on the same SQLite database. -->
    <ProjectReference Include="..\..\src\Rask.Cache\Rask.Cache.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
    <!-- Security: pulls the patched SQLitePCLRaw 3.x bundle over the 2.1.11 one
         Microsoft.Data.Sqlite / EF Core pin (CVE-2025-6965). A direct reference is the only
         lever under CPM — transitive pinning does not move it. See Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Bs* types and their generated factories, matching how a consuming app gets them. -->
    <Using Include="Rask.Bootstrap"/>
    <Using Include="Rask.Bootstrap.Generated" Static="true"/>
  </ItemGroup>

  <!-- The ASP.NET Web SDK requires a wwwroot to exist even when there are no static files. -->
  <Target Name="EnsureEmptyWwwroot" BeforeTargets="BeforeBuild">
    <MakeDir Directories="wwwroot"/>
  </Target>

</Project>
