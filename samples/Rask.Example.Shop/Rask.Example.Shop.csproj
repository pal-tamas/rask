<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    This project is the committed output of the `rask` CLI, not a hand-written lookalike. The exact
    commands are listed in README.md, and tests/Rask.Example.Shop.Tests re-runs the generators to prove
    the committed files still match what the CLI produces today.

    The one deviation from what the CLI writes is here: the generated csproj carries a PackageReference
    per Rask package, which an in-repo sample can't use — it has to build against this commit's sources
    rather than a published version. Everything else is the CLI's output.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The litestream binary is installed on the server (or in the Docker image), not fetched at build time. -->
    <RaskLitestreamDownload>false</RaskLitestreamDownload>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Server\Rask.Server.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Bootstrap\Rask.Bootstrap.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Cqrs\Rask.Cqrs.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Data\Rask.Data.csproj"/>
    <ProjectReference Include="..\..\src\Rask.SQLite.EntityFrameworkCore\Rask.SQLite.EntityFrameworkCore.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Outbox\Rask.Outbox.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Jobs\Rask.Jobs.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Mail\Rask.Mail.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Cache\Rask.Cache.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Logging\Rask.Logging.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Dashboard\Rask.Dashboard.csproj"/>
    <ProjectReference Include="..\..\src\Rask.SQLite.Snapshots\Rask.SQLite.Snapshots.csproj"/>
    <ProjectReference Include="..\..\src\Rask.SQLite.Litestream\Rask.SQLite.Litestream.csproj"/>
    <ProjectReference Include="..\..\src\Rask.WebPush\Rask.WebPush.csproj"/>
  </ItemGroup>

  <!--
    Analyzers do NOT flow transitively through an in-repo ProjectReference — only the packed
    analyzers/dotnet/cs path reaches a NuGet consumer. Omitting one of these compiles cleanly and then
    fails at RUNTIME: an unregistered job or outbox event fails to deserialize and dead-letters. All
    four are load-bearing.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\src\Rask.Cqrs.Generators\Rask.Cqrs.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\src\Rask.Jobs.Generators\Rask.Jobs.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\src\Rask.Outbox.Generators\Rask.Outbox.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
    <!-- Security: pulls the patched SQLitePCLRaw 3.x bundle over the 2.1.11 one
         Microsoft.Data.Sqlite / EF Core pin (CVE-2025-6965). A direct reference is the only
         lever under CPM — transitive pinning does not move it. See Directory.Packages.props. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"/>
  </ItemGroup>

</Project>
