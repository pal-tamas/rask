<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rask.Example.Wasm.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rask.Example.Shared\Rask.Example.Shared.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Wasm.Hosting\Rask.Wasm.Hosting.csproj"/>
    <ProjectReference Include="..\Rask.Example.Wasm\Rask.Example.Wasm.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"/>
  </ItemGroup>

  <!--
    The ASP.NET Web SDK's static-web-assets loader instantiates a
    PhysicalFileProvider over the project's source wwwroot/ at startup, and throws
    DirectoryNotFoundException if the directory is missing. Wasm.Hosting serves
    the WASM AppBundle directly, so this host has no static files of its own —
    but the directory must exist for the SDK to be happy.
  -->
  <Target Name="EnsureEmptyWwwroot" BeforeTargets="BeforeBuild">
    <MakeDir Directories="wwwroot"/>
  </Target>

</Project>
