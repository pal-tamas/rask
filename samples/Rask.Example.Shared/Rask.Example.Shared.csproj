<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- wwwroot/ carries the vendored third-party libraries the showcase demos wrap (frappe-gantt).
         The Razor SDK publishes it as static web assets under _content/$(PackageId); set the base path
         explicitly so Server (MapStaticAssets) and WASM (the publish bundle) resolve the same URL. -->
    <StaticWebAssetBasePath>_content/Rask.Example.Shared</StaticWebAssetBasePath>
  </PropertyGroup>

  <!--
    The islands' front-end files, which this project does not contain. Styles/app.css names the same two
    directories in `@source`, and that is a TAILWIND-side path — nothing hands it to MSBuild, so without
    this the sheet is built from them once and then never rebuilt when one changes.

    The two have to be stated together: `@source` decides what Tailwind SCANS, this decides what the
    build WATCHES, and a file in one but not the other goes stale silently.
  -->
  <ItemGroup>
    <RaskTailwindSource Include="../Rask.Example.Server/Features/Islands/**/*.vue;../Rask.Example.Server/Features/Islands/**/*.tsx;../Rask.Example.Server/Features/Islands/**/*.svelte;../Rask.Example.Server/Features/Islands/**/*.ts"/>
    <RaskTailwindSource Include="../Rask.Example.Wasm/Features/Islands/**/*.vue;../Rask.Example.Wasm/Features/Islands/**/*.tsx;../Rask.Example.Wasm/Features/Islands/**/*.svelte"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Example.Shared.Tests"/>
    <!-- Build-order edge only. The Tailwind wiring itself arrives from Directory.Build.{props,targets}
         (and, for a scaffolded app, from inside the host package) — this reference exists so that
         Rask.Tailwind.Tasks.dll is on disk before the UsingTask that loads it runs. Build-only: an
         MSBuild task and a CLI run, not an assembly, so the payload is unchanged. -->
    <ProjectReference Include="..\..\src\Rask.Tailwind\Rask.Tailwind.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Validation.DataAnnotations\Rask.Validation.DataAnnotations.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Validation.FluentValidation\Rask.Validation.FluentValidation.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Cqrs\Rask.Cqrs.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\..\src\Rask.Batteries.Generators\Rask.Batteries.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ColorCode.HTML"/>
    <PackageReference Include="Markdig"/>
  </ItemGroup>

  <!-- Embed the repo's user-facing guides (docs/*.md) so the showcase can render them on-site as the
       Guides section. GuideContent reads them as raskdoc/{leaf} and renders to HTML with Markdig at
       render time (cached). The bare leaf is the slug, e.g. raskdoc/routing.md -> /guides/routing. -->
  <ItemGroup>
    <!-- Recurse so subfolder guides (tutorial/, apis/, architecture/) are surfaced too. LogicalName is
         the bare leaf (raskdoc/{leaf}.md), so the slug is the file name with no folder — matching how
         Markdown.RewriteLinks routes an in-doc "dir/foo.md" link to /guides/foo. Leaf names are unique
         across docs/, and the VerifyUniqueEmbeddedSourceNames guard below fails the build if that ever
         breaks. GuideCatalog carries each subfolder guide's real path for the "edit on GitHub" link. -->
    <EmbeddedResource Include="..\..\docs\**\*.md">
      <LogicalName>raskdoc/%(Filename)%(Extension)</LogicalName>
      <Link>Docs/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Embed the feature/shared sources verbatim so CodeSample can show the *real* file text
       beside the live Result (EmbeddedSource reads them as raksrc/{file}). A .cs stays compiled
       too — this only adds its text as a manifest resource; the .ts/.css remain scoped
       assets. Guarantees the shown snippet always compiles and matches what runs.
       LogicalName is the bare leaf name, so leaf names must be unique across the assembly —
       VerifyUniqueEmbeddedSourceNames below fails the build if two embedded files collide. -->
  <ItemGroup>
    <EmbeddedResource Include="Features/**/*.cs;Features/**/*.ts;Features/**/*.css;Shared/**/*.cs;Shared/**/*.ts;Shared/**/*.css">
      <LogicalName>raksrc/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Guard the bare-leaf LogicalName above: a duplicate leaf name would silently let one
       embedded source overwrite another in the manifest (last writer wins), so EmbeddedSource
       would show the wrong file at runtime. Turn that into a build error instead. -->
  <Target Name="VerifyUniqueEmbeddedSourceNames" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_RaskEmbeddedLeaf Include="@(EmbeddedResource->'%(LogicalName)')"/>
    </ItemGroup>
    <Error Condition="'@(_RaskEmbeddedLeaf->Distinct()->Count())' != '@(_RaskEmbeddedLeaf->Count())'"
           Text="Duplicate embedded-source leaf name(s) under Features/ or Shared/. EmbeddedSource resolves by bare filename (raksrc/{leaf}), so every embedded .cs/.ts/.css must have a unique file name across the project. Rename the collision." />
  </Target>


</Project>
