<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rask.Example.Shared.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Validation.DataAnnotations\Rask.Validation.DataAnnotations.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Validation.FluentValidation\Rask.Validation.FluentValidation.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ColorCode.HTML"/>
  </ItemGroup>

  <!-- Embed the feature/shared sources verbatim so CodeSample can show the *real* file text
       beside the live Result (EmbeddedSource reads them as raksrc/{file}). A .cs stays compiled
       too — this only adds its text as a manifest resource; the .js/.css remain scoped
       assets. Guarantees the shown snippet always compiles and matches what runs.
       LogicalName is the bare leaf name, so leaf names must be unique across the assembly —
       VerifyUniqueEmbeddedSourceNames below fails the build if two embedded files collide. -->
  <ItemGroup>
    <EmbeddedResource Include="Features/**/*.cs;Features/**/*.js;Features/**/*.css;Shared/**/*.cs;Shared/**/*.js;Shared/**/*.css">
      <LogicalName>raksrc/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Guard the bare-leaf LogicalName above: a duplicate leaf name would silently let one
       embedded source overwrite another in the manifest (last writer wins), so EmbeddedSource
       would show the wrong file at runtime. Turn that into a build error instead. -->
  <Target Name="VerifyUniqueEmbeddedSourceNames" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_RaskEmbeddedLeaf Include="@(EmbeddedResource->'%(LogicalName)')"/>
    </ItemGroup>
    <Error Condition="'@(_RaskEmbeddedLeaf->Distinct()->Count())' != '@(_RaskEmbeddedLeaf->Count())'"
           Text="Duplicate embedded-source leaf name(s) under Features/ or Shared/. EmbeddedSource resolves by bare filename (raksrc/{leaf}), so every embedded .cs/.js/.css must have a unique file name across the project. Rename the collision." />
  </Target>

</Project>
