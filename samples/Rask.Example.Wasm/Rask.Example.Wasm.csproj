<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Rask WASM marker: gates the framework's build/Rask.Wasm.targets (wwwroot staging +
         scoped-asset bake). Replaces the old WasmGenerateAppBundle marker. -->
    <RaskWasm>true</RaskWasm>
    <!--
      NOT prerendered yet, deliberately — see the note below before turning it on.

      Only 5 of this app's 20 routes can be prerendered: the browser-API demos (media devices,
      fullscreen, serial, USB, HID, Bluetooth…) have nothing to bind to off a browser, throw during the
      pass, and are skipped by design. That leaves the bundle serving a MIXTURE, and the mixture is the
      problem: a static host answers an un-prerendered deep link with its SPA fallback, which is the
      root index.html — and once the root is prerendered, that fallback stops being a neutral boot shell
      and becomes a fully rendered guides index. Deep-linking into one of the fifteen then misroutes.

      The landing site does not hit this because it is a single route: everything it serves is
      prerendered, so there is no mixture and no fallback to get wrong.

      Turning this on needs the un-prerendered-route story settled first — most likely a fallback
      document that is still the boot shell rather than any one rendered page. The framework fix that
      this attempt did surface (RASK_PRERENDER_PATH_BASE, so a sub-path publish bakes prefixed asset
      URLs) is landed separately and is a prerequisite for it.
    -->
    <!-- <RaskPrerender>true</RaskPrerender> -->
    <!-- Fingerprint framework assets + fill the index.html import map / preload placeholders
         at publish (Microsoft.NET.Sdk.WebAssembly). Makes static-host redeploys cache-safe. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Full WASM AOT is opt-in: publish with -p:RaskWasmAot=true (needs the wasm-tools workload)
         to AOT-compile IL->WASM; the default keeps the Mono interpreter. Both are gated off the fast
         no-native build (-p:WasmBuildNative=false, used by the CI unit gate): the SDK records the
         runtime-pack default as empty, so even 'false' counts as a relink trigger that conflicts
         with WasmBuildNative=false. -->
    <RunAOTCompilation Condition=" '$(RaskWasmAot)' == 'true' ">true</RunAOTCompilation>
    <RunAOTCompilation Condition=" '$(RaskWasmAot)' != 'true' and '$(WasmBuildNative)' != 'false' ">false</RunAOTCompilation>
    <!-- Continuously enforce AOT-safety on every build (not just at publish): the trim + AOT Roslyn
         analysers run under warnings-as-errors, so a new RequiresDynamicCode/trim hazard fails the
         build long before the slow emscripten relink. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Trimming is safe: page types reach the runtime via the route registry's generated
         module initialiser, which emits [DynamicDependency] per registered page; the reflection
         sites in RouteChainRenderer / PageBinder / RouteValueParser are either DAM-annotated or
         carry a documented suppression. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <!-- This app hosts the guides, and the localization guide's demo formats the same values across
         four languages — which needs real culture data. So it ships ICU (~2.6 MB of icudt*.dat under
         _framework/) rather than dropping it. One property covers both halves: it also clears
         PredefinedCulturesOnly, which otherwise defaults to true under invariant globalization and
         makes CultureInfo.GetCultureInfo("hu-HU") THROW rather than fall back.

         This also makes the showcase the repo's ICU canary: the opt-in is exercised by the browser
         E2E gate on every push rather than only by an MSBuild property assertion. -->
    <RaskGlobalization>true</RaskGlobalization>
    <!-- Suppress IL2104 from Microsoft.JSInterop. The underlying warnings (IL2065 / IL2111)
         live in DotNetDispatcher.ScanAssemblyForCallableMethods — Blazor's reflection-driven
         [JSInvokable] scanner. Rask apps that only INVOKE JS (the common case) never trigger
         that path. WASM apps that DO mark methods [JSInvokable] should add a
         [DynamicDependency] on those methods (standard Blazor WASM mitigation). -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <!--
      This app has scoped TypeScript (PictureInPictureDemo.ts) AND islands, and a Lit island is
      spelled exactly like a scoped file: `Name.ts` beside `Name.cs`. Left on, convention-pairing
      offers every scoped file to the bundler as a Lit island and the build dies on a module that
      never default-exported a tag name. There are no Lit islands here — the Server showcase
      carries that case — so turning the pairing off costs nothing and says what is true.
    -->
    <RaskExternalLitAutoPair>false</RaskExternalLitAutoPair>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one reference. On net10.0-browser this resolves to the WebAssembly host plus the trim-safe
         batteries; the same PackageReference on a net10.0 project resolves to the ASP.NET host plus the
         server batteries. -->
    <ProjectReference Include="..\..\src\Rask\Rask.csproj"/>

    <!-- A real consumer gets this from the package's own build/Rask.props. In-repo we reference the
         PROJECT, and a ProjectReference does not import a package's build props, so the same rooting is
         spelled out here. Without it the trimmer drops Rask.dll — nothing references it statically, since
         its wiring is handed to the host from a [ModuleInitializer] — and the batteries silently do
         nothing. Measured: Rask.dll and Rask.Query were absent from the published bundle entirely. -->
    <TrimmerRootAssembly Include="Rask"/>
    <ProjectReference Include="..\Rask.Example.Shared\Rask.Example.Shared.csproj"/>
    <!-- The islands showcase. Same front-end files as the Server sample, bundled here because the
         client runtime resolves the manifest app-rooted at /_rask/external/manifest.json. -->
    <ProjectReference Include="..\..\src\Rask.External\Rask.External.csproj"/>
    <!--
      The Blazor island page, and the reason it lives in the TRIMMED showcase rather than in a fixture.
      A hosted Blazor component's parameters are assigned by reflection inside
      Microsoft.AspNetCore.Components, so under PublishTrimmed above the trimmer can remove the setters
      and the island renders EMPTY — with no analyser warning, no exception and nothing in the console.
      Publishing it here on every build, with a browser E2E asserting the hosted component's own output,
      is what makes that a red gate instead of a discovery in someone's app.

      Rask.Blazor is deliberately outside the Rask meta-package on both frameworks, so an app that hosts
      a Blazor component names it — as this one does.
    -->
    <ProjectReference Include="..\..\src\Rask.Blazor\Rask.Blazor.csproj"/>
    <ProjectReference Include="..\Rask.Example.Razor\Rask.Example.Razor.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>

  <!-- Vendored third-party assets (Bootstrap, Bootstrap Icons + fonts, Highlight.js), the
       placeholder image, and the HTTP-demo JSON fixture live under wwwroot/ and are
       discovered as static web assets by Microsoft.NET.Sdk.WebAssembly automatically,
       served at /lib, /img, /data. The framework's build targets additionally stage
       index.html / main.js / rask.wasm.js into wwwroot (see build/Rask.Wasm.targets). -->

  <!-- Embed the WASM-only demo sources verbatim so CodeSample can show the real file text
       beside the live Result, exactly like Rask.Example.Shared — these demos can't live in
       the shared project (they reference Rask.Wasm.Browser). EmbeddedSource reads them as
       raksrc/{leaf}; Program.cs registers this app assembly with EmbeddedSource so the lookup
       finds them. A .cs stays compiled too; this only adds its text as a manifest resource. -->
  <ItemGroup>
    <EmbeddedResource Include="Features/**/*.cs;Features/**/*.js;Features/**/*.css;Features/**/*.tsx;Features/**/*.vue;Features/**/*.svelte">
      <LogicalName>raksrc/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Guard the bare-leaf LogicalName: a duplicate leaf would silently overwrite another in
       the manifest (last writer wins), so EmbeddedSource would show the wrong file. Only the
       raksrc/ items are checked, so unrelated SDK EmbeddedResource items don't trip it. -->
  <Target Name="VerifyUniqueEmbeddedSourceNames" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_RaskEmbeddedLeaf Include="@(EmbeddedResource->'%(LogicalName)')"
                         Condition="$([System.String]::Copy('%(LogicalName)').StartsWith('raksrc/'))"/>
    </ItemGroup>
    <Error Condition="'@(_RaskEmbeddedLeaf->Distinct()->Count())' != '@(_RaskEmbeddedLeaf->Count())'"
           Text="Duplicate embedded-source leaf name(s) under Features/. EmbeddedSource resolves by bare filename (raksrc/{leaf}), so every embedded .cs/.js/.css must have a unique file name across the project (and not collide with a Rask.Example.Shared leaf). Rename the collision." />
  </Target>

</Project>
