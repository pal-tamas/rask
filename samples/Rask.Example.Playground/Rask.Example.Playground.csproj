<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Rask WASM marker: gates build/Rask.Wasm.targets (wwwroot staging + scoped-asset bake). -->
    <RaskWasm>true</RaskWasm>
    <!-- Fingerprint framework assets + fill the index.html import map / preload placeholders at publish
         (cache-safe static-host redeploys), exactly like the showcase. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!-- The playground compiles user C# in the browser with Roslyn, which reads the shipped
         _framework/*.wasm assemblies as metadata references. Trimming would strip members Roslyn needs to
         see, so this app is deliberately UNTRIMMED — the one place in the repo that opts out. This also
         keeps Roslyn's reflection-heavy code off the trim/AOT analysers, so those stay disabled here (the
         showcase remains trim-full + zero-IL; this isolation is exactly why the playground is a separate
         sub-app). ICU is still dropped: Roslyn and the playground format nothing culture-sensitive. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- ICU is dropped: this app formats nothing culture-sensitive, so the ~2.6 MB of icudt*.dat is
         pure payload. Owned by Rask.Wasm.targets now rather than set here — RaskGlobalization is the
         one property, and it also handles PredefinedCulturesOnly, which defaults to true under
         invariant globalization and makes CultureInfo.GetCultureInfo("hu-HU") throw rather than fall
         back. Set <RaskGlobalization>true</RaskGlobalization> to ship ICU. -->
    <!-- Ship managed assemblies as plain PE, not WebCIL. The in-browser compiler downloads the shipped
         _framework assemblies and hands them to Roslyn as MetadataReferences, and Roslyn can only read a
         PE/COFF image — it cannot parse the WebCIL wrapper the WASM SDK emits by default. -->
    <WasmEnableWebcil>false</WasmEnableWebcil>

    <!-- Full WASM AOT is pointless here: user code is Assembly.Load-ed at runtime and always runs
         interpreted regardless, and AOT-compiling Roslyn would balloon publish time for no user benefit.
         Guarded off the fast no-native build (-p:WasmBuildNative=false, the CI unit gate): the SDK forbids
         RunAOTCompilation=false when WasmBuildNative is already false, so only set it otherwise. -->
    <RunAOTCompilation Condition=" '$(WasmBuildNative)' != 'false' ">false</RunAOTCompilation>

    <!-- The tutorial's data chapters run EF Core against a real SQLite database in the browser, which
         needs e_sqlite3 (a static archive, runtimes/browser-wasm/nativeassets/*/e_sqlite3.a) linked into
         the runtime — i.e. a native relink, the same thing the two guards above key off. So the fast
         no-native build (-p:WasmBuildNative=false, used by the unit gate) simply ships without those
         packages: the app still builds and runs, and the data chapters are offered read-only with an
         explanation. Publishing normally (pages.yml, the E2E gate) gets the full track. -->
    <RaskPlaygroundData Condition=" '$(RaskPlaygroundData)' == '' and '$(WasmBuildNative)' != 'false' ">true</RaskPlaygroundData>
    <DefineConstants Condition=" '$(RaskPlaygroundData)' == 'true' ">$(DefineConstants);RASK_PLAYGROUND_DATA</DefineConstants>
    <!-- WASM0001: the relink reports that SQLite's variadic natives (sqlite3_config / sqlite3_db_config)
         "will fail at runtime" — WebAssembly has no varargs calling convention. True, and irrelevant here:
         nothing on the connection/EF Core path calls them (verified in a browser: open, ADO round-trip,
         EnsureCreated, SaveChanges, LINQ, ExecuteUpdate all work). Without this the repo-wide
         TreatWarningsAsErrors turns the two warnings into a failed publish. -->
    <NoWarn Condition=" '$(RaskPlaygroundData)' == 'true' ">$(NoWarn);WASM0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rask.Wasm\Rask.Wasm.csproj"/>
    <!-- Rask.Wasm references Rask.Core with PrivateAssets="all" (kept out of its nuspec), so it doesn't
         flow transitively — reference it directly, as any Rask app that doesn't go through the showcase
         shared library would. Microsoft.JSInterop likewise, for IJSRuntime in the editor interop. -->
    <ProjectReference Include="..\..\src\Rask.Core\Rask.Core.csproj"/>
    <ProjectReference Include="..\..\src\Rask.Html\Rask.Html.csproj"/>
    <!-- Build-order edge only. The Tailwind wiring itself arrives from Directory.Build.{props,targets}
         (and, for a scaffolded app, from inside the host package) — this reference exists so that
         Rask.Tailwind.Tasks.dll is on disk before the UsingTask that loads it runs. Build-only: an
         MSBuild task and a CLI run, not an assembly, so the payload is unchanged. -->
    <ProjectReference Include="..\..\src\Rask.Tailwind\Rask.Tailwind.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"/>
    <PackageReference Include="Microsoft.JSInterop"/>
    <!-- Roslyn, shipped to the browser (a normal reference, so Microsoft.CodeAnalysis.* land in
         _framework and load at runtime). This is the ~15-20 MB the sub-app isolation exists to contain.
         CSharp.Features (transitively pulling Workspaces + Features) powers the in-editor IDE experience:
         CompletionService for IntelliSense and a workspace-backed diagnostics pass that never Emits. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features"/>
    <!-- Rask.Generators referenced BOTH ways: as an Analyzer so this app's own build gets the factories,
         AND as a normal assembly (ReferenceOutputAssembly=true) so Rask.Generators.dll ships and the
         in-browser compile can `new ComponentFactoryGenerator()` + run the analyzers for live RASK hints. -->
    <ProjectReference Include="..\..\src\Rask.Generators\Rask.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true"/>
  </ItemGroup>

  <!-- The data chapters' reference set. None of the playground's OWN code touches EF Core: these are here
       purely so the assemblies land in _framework, where WasmReferenceLoader picks up every managed boot
       resource and hands it to Roslyn. Microsoft.Data.Sqlite finds its native provider by reflecting for
       SQLitePCLRaw.batteries_v2, which resolves because this app is untrimmed — so there is no host-side
       initialisation to write either. bundle_e_sqlite3 is a direct reference because that is the only way
       to lift SQLitePCLRaw to the 3.x family (CVE-2025-6965; see Directory.Packages.props). -->
  <ItemGroup Condition=" '$(RaskPlaygroundData)' == 'true' ">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"/>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"/>
    <!-- Entity<TId>, ApplyRaskConventions and the auditing/soft-delete interceptors the chapters teach —
         the same conventions `rask generate feature` scaffolds into a real project. -->
    <ProjectReference Include="..\..\src\Rask.Data\Rask.Data.csproj"/>
  </ItemGroup>

  <!--
    The Roslyn reference set, shipped as DATA rather than read off the live _framework.

    The compiler used to download this app's OWN shipped assemblies and hand them to Roslyn as metadata
    references. That worked, and it is why the whole app had to be PublishTrimmed=false: trimming strips
    members Roslyn must see, so the app could not be trimmed without breaking the thing it exists to do.
    53 MB of assemblies, and every page of a merged site would have carried them.

    @(ReferencePathWithRefAssemblies) is a better answer on its own terms, not just a smaller one: it is
    exactly what the C# compiler saw when it built this project — reference assemblies, metadata only, no
    IL — so the in-browser compiler now offers precisely the surface the playground itself compiles
    against. Reading the live _framework offered whatever happened to survive into the bundle, which is a
    different set and one that changes with unrelated build settings.

    Staged into obj/ and contributed as computed static web assets, the same shape Rask.Wasm.targets uses
    for its own boot files, so publish carries them without a wwwroot glob having to see them at
    evaluation.
  -->
  <!--
    DependsOnTargets, not AfterTargets. With both an AfterTargets and a BeforeTargets hook MSBuild runs
    the target at whichever fires FIRST, and GenerateComputedBuildStaticWebAssets fires before
    ResolveReferences — so the first version of this ran with @(ReferencePathWithRefAssemblies) empty and
    staged nothing, silently, while the build stayed green. Depending on the target that produces the
    item is the only ordering that actually guarantees it is populated.
  -->
  <Target Name="_PlaygroundStageReferenceAssemblies"
          DependsOnTargets="ResolveReferences;FindReferenceAssembliesForReferences"
          BeforeTargets="GenerateComputedBuildStaticWebAssets">
    <PropertyGroup>
      <_PlaygroundRefDir>$(IntermediateOutputPath)playground-refs\</_PlaygroundRefDir>
    </PropertyGroup>

    <MakeDir Directories="$(_PlaygroundRefDir)refs"/>

    <!--
      Roslyn's own assemblies are excluded. They are here because THIS project compiles against them to
      host the compiler; a snippet written in the playground never references them, and the samples say
      as much ("uses only types in the shipped _framework — BCL + Rask.Core"). Keeping them would ship
      the compiler's machinery as a reference set for compiling against the compiler.

      Measured: 31 MB staged, 22 MB of it Roslyn. Dropping it leaves 8 MB — against the 53 MB of
      untrimmed implementation assemblies this replaces.
    -->
    <ItemGroup>
      <_PlaygroundReference Include="@(ReferencePathWithRefAssemblies)"
                            Exclude="@(ReferencePathWithRefAssemblies->WithMetadataValue('Filename','Microsoft.CodeAnalysis'))"/>
      <_PlaygroundReference Remove="@(_PlaygroundReference)"
                            Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.CodeAnalysis'))"/>
    </ItemGroup>

    <!-- SkipUnchangedFiles: this runs on every build and the set is megabytes. -->
    <Copy SourceFiles="@(_PlaygroundReference)"
          DestinationFolder="$(_PlaygroundRefDir)refs"
          SkipUnchangedFiles="true"/>

    <!--
      A manifest, because the browser cannot list a directory. Written from the same item the copy used,
      so it cannot describe a set the copy did not produce.
    -->
    <WriteLinesToFile
      File="$(_PlaygroundRefDir)refs.txt"
      Lines="@(_PlaygroundReference->'%(Filename)%(Extension)')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"/>

    <ItemGroup>
      <_PlaygroundRefAsset Include="$(_PlaygroundRefDir)**\*"/>
    </ItemGroup>

    <DefineStaticWebAssets Condition=" '@(_PlaygroundRefAsset)' != '' "
                           CandidateAssets="@(_PlaygroundRefAsset)"
                           SourceType="Computed"
                           SourceId="$(PackageId)"
                           ContentRoot="$(_PlaygroundRefDir)"
                           BasePath="$(StaticWebAssetBasePath)"
                           RelativePathPattern="**"
                           FingerprintCandidates="false">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset"/>
      <Output TaskParameter="Assets" ItemName="_PlaygroundRefStaticWebAsset"/>
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints Condition=" '@(_PlaygroundRefStaticWebAsset)' != '' "
                                   CandidateAssets="@(_PlaygroundRefStaticWebAsset)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint"/>
    </DefineStaticWebAssetEndpoints>
  </Target>

</Project>
