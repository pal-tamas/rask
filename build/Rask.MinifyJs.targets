<Project>

  <!--
    Conservative JS stripper used in Release builds for the framework's embedded
    client scripts (rask.js, rask.wasm.js). Strips:
      - /* ... */ block comments (state-aware; skips inside strings)
      - full-line // comments (lines whose first non-whitespace is //)
      - blank lines and leading/trailing whitespace on the remaining lines

    Does NOT do:
      - mid-line whitespace collapsing (would interact with template literals,
        regex literals, and significant whitespace in console.log arguments)
      - identifier renaming
      - mid-line // comment stripping (a `//` inside a string literal would be
        misclassified; only full-line // comments are safe to strip without a
        full tokenizer)

    State machine: scan char by char, track if inside "..." / '...' / `...`,
    honouring backslash escapes. Only the block-comment stripper runs in this
    pass — line comments + blank lines are removed by line-level filtering
    on the result.
  -->

  <UsingTask TaskName="RaskMinifyJs"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <InputFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
var src = File.ReadAllText(InputFile);

// Pass 1: strip /* ... */ block comments, skipping inside strings.
var sb = new StringBuilder(src.Length);
int i = 0;
char quote = '\0'; // 0 = code, otherwise the active string delimiter
while (i < src.Length)
{
    char c = src[i];

    if (quote != '\0')
    {
        sb.Append(c);
        if (c == '\\' && i + 1 < src.Length)
        {
            sb.Append(src[i + 1]);
            i += 2;
            continue;
        }
        if (c == quote) quote = '\0';
        i++;
        continue;
    }

    // In code: detect string starts.
    if (c == '"' || c == '\'' || c == '`')
    {
        quote = c;
        sb.Append(c);
        i++;
        continue;
    }

    // /* ... */ block comment: skip until matching */
    if (c == '/' && i + 1 < src.Length && src[i + 1] == '*')
    {
        int end = src.IndexOf("*/", i + 2);
        if (end < 0) { sb.Append(src, i, src.Length - i); break; }
        i = end + 2;
        continue;
    }

    sb.Append(c);
    i++;
}

// Pass 2: drop blank lines and full-line // comments. Mid-line // is preserved.
var lines = sb.ToString().Split('\n');
var keep = new StringBuilder(sb.Length);
foreach (var raw in lines)
{
    var trimmed = raw.TrimEnd('\r').Trim();
    if (trimmed.Length == 0) continue;
    if (trimmed.StartsWith("//")) continue;
    keep.Append(trimmed);
    keep.Append('\n');
}

File.WriteAllText(OutputFile, keep.ToString());
Log.LogMessage(MessageImportance.Normal,
    $"RaskMinifyJs: {src.Length} -> {keep.Length} bytes ({InputFile})");
]]>
      </Code>
    </Task>
  </UsingTask>

</Project>
