<Project>

  <!--
    The pinned TypeScript toolchain.

    Two native binaries, fetched once into a per-user cache and verified against the checksum their
    registry publishes: esbuild turns TypeScript into JavaScript, tsgo checks that the TypeScript was
    right. Neither needs npm or Node to run — an npm package is a gzipped tarball at a predictable
    URL, and these two contain a statically linked Go executable and nothing else that matters. That
    is what keeps "no npm required" true for Rask's own build and for every consumer of it.

    This file is the single source of truth for the pins. A test resolves both tools using exactly
    these values and runs them, so a bump that names a version the registry does not have fails in
    the unit gate rather than in somebody's first build.

    Pinned rather than floating for the usual reproducibility reason, and for one specific to tsgo:
    @typescript/native-preview publishes dated development builds to its `latest` tag, so "latest"
    there means "whatever was built the morning you ran it".
  -->
  <PropertyGroup>
    <RaskEsbuildVersion Condition="'$(RaskEsbuildVersion)' == ''">0.28.2</RaskEsbuildVersion>
    <RaskTsgoVersion Condition="'$(RaskTsgoVersion)' == ''">7.0.0-dev.20260707.2</RaskTsgoVersion>

    <!-- The registry to fetch from. Overridable for a mirror or an internal proxy. -->
    <RaskTypeScriptRegistry Condition="'$(RaskTypeScriptRegistry)' == ''">https://registry.npmjs.org</RaskTypeScriptRegistry>

    <!--
      Refuse to fetch, and fail if nothing is cached. For an air-gapped or reproducible build that
      wants a missing tool to be an error rather than a download.
    -->
    <RaskTypeScriptOffline Condition="'$(RaskTypeScriptOffline)' == ''">false</RaskTypeScriptOffline>

    <!--
      The master switch. Turning it off builds and runs the app with no TypeScript compiled — the
      same shape as RaskTailwindBuild=false and RaskSpaBuild=false, and the thing to reach for on a
      machine that cannot or must not download.
    -->
    <RaskTypeScriptBuild Condition="'$(RaskTypeScriptBuild)' == ''">true</RaskTypeScriptBuild>

    <!--
      Shared by every project for this user. Outside any repository on purpose: tsgo alone unpacks to
      ~27 MB, which in obj/ is re-downloaded by every clean and committed by somebody eventually.
    -->
    <RaskTypeScriptCacheRoot Condition="'$(RaskTypeScriptCacheRoot)' == '' AND '$(OS)' == 'Windows_NT'">$(LOCALAPPDATA)\rask\typescript</RaskTypeScriptCacheRoot>
    <RaskTypeScriptCacheRoot Condition="'$(RaskTypeScriptCacheRoot)' == ''">$(HOME)/.rask/typescript</RaskTypeScriptCacheRoot>
  </PropertyGroup>

</Project>
